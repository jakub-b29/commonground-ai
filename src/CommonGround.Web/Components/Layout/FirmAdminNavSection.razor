@code {
    private Action? _stateHandler;
    private bool _visible;

    protected override async Task OnInitializedAsync()
    {
        _stateHandler = () => InvokeAsync(ReloadAsync);
        UiState.OnChange += _stateHandler;
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        try
        {
            var fullAdmin = await Access.HasPermissionAsync(WorkspacePermissionFlags.FirmFullAdministration);
            var canInvite = await Access.HasPermissionAsync(WorkspacePermissionFlags.InviteAndApproveMembers);
            _visible = fullAdmin || canInvite;
        }
        catch
        {
            _visible = false;
        }

        StateHasChanged();
    }

    public void Dispose()
    {
        if (_stateHandler is not null)
        {
            UiState.OnChange -= _stateHandler;
        }
    }
}
