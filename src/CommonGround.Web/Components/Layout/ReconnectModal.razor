@inject WorkspaceLocalization Loc
@implements IDisposable

<script type="module" src="@Assets["Components/Layout/ReconnectModal.razor.js"]"></script>

<dialog id="components-reconnect-modal" data-nosnippet>
    <div class="components-reconnect-container">
        <div class="components-rejoining-animation" aria-hidden="true">
            <div></div>
            <div></div>
        </div>
        <p class="components-reconnect-first-attempt-visible">
            @Loc.T("shell.reconnectRejoining")
        </p>
        <p class="components-reconnect-repeated-attempt-visible">
            @Loc.T("shell.reconnectRetryingPrefix") <span id="components-seconds-to-next-attempt"></span> @Loc.T("shell.reconnectRetryingSuffix")
        </p>
        <p class="components-reconnect-failed-visible">
            @Loc.T("shell.reconnectFailed")<br />@Loc.T("shell.reconnectRetryHint")
        </p>
        <button id="components-reconnect-button" class="components-reconnect-failed-visible">
            @Loc.T("action.retry")
        </button>
        <p class="components-pause-visible">
            @Loc.T("shell.sessionPaused")
        </p>
        <p class="components-resume-failed-visible">
            @Loc.T("shell.sessionResumeFailed")<br />@Loc.T("shell.reconnectRetryHint")
        </p>
        <button id="components-resume-button" class="components-pause-visible components-resume-failed-visible">
            @Loc.T("action.resume")
        </button>
    </div>
</dialog>

@code {
    private Action? _locHandler;

    protected override async Task OnInitializedAsync()
    {
        _locHandler = () => InvokeAsync(StateHasChanged);
        Loc.OnChange += _locHandler;
        await Loc.EnsureLoadedAsync();
    }

    public void Dispose()
    {
        if (_locHandler is not null)
        {
            Loc.OnChange -= _locHandler;
        }
    }
}
