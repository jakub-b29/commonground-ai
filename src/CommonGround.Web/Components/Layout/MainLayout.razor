@inherits LayoutComponentBase
@inject WorkspaceUiState UiState
@inject WorkspaceLocalization Loc
@implements IDisposable

<a class="skip-link" href="#main-content">@Loc.T("shell.skipLink")</a>
<RadzenComponents @rendermode="new InteractiveServerRenderMode(prerender: false)" />

<div class="page">
    <aside class="sidebar" aria-label="Primary navigation">
        <NavMenu />
    </aside>

    <div class="workspace-shell">
        <div class="workspace-container">
            <TopCommandHeader />
            <EmergencyContactsStrip />
            <div role="status" aria-live="polite" class="@(string.IsNullOrWhiteSpace(UiState.StatusBannerMessage) ? "visually-hidden" : "cg-status-banner")">
                <span>@UiState.StatusBannerMessage</span>
            </div>
            <main id="main-content" tabindex="-1">
                @Body
            </main>
            <PortfolioQueryDrawer />
        </div>
    </div>
</div>

<div id="blazor-error-ui" data-nosnippet>
    @Loc.T("error.unhandled")
    <a href="." class="reload">@Loc.T("error.reload")</a>
    <span class="dismiss">x</span>
</div>

@code {
    private Action? _stateHandler;
    private Action? _locHandler;

    protected override async Task OnInitializedAsync()
    {
        _stateHandler = () => InvokeAsync(StateHasChanged);
        UiState.OnChange += _stateHandler;
        _locHandler = () => InvokeAsync(StateHasChanged);
        Loc.OnChange += _locHandler;
        await Loc.EnsureLoadedAsync();
    }

    public void Dispose()
    {
        if (_stateHandler is not null)
        {
            UiState.OnChange -= _stateHandler;
        }
        if (_locHandler is not null)
        {
            Loc.OnChange -= _locHandler;
        }
    }
}
