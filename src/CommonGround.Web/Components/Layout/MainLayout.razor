@inherits LayoutComponentBase
@inject WorkspaceUiState UiState
@inject WorkspaceLocalization Loc
@inject WorkspaceAccessService Access
@implements IDisposable

<a class="skip-link" href="#main-content">@Loc.T("shell.skipLink")</a>

<AuthorizeView>
    <Authorized>
        <div class="page @(UiState.IsSidebarCollapsed ? "page-sidebar-collapsed" : "")">
            <aside class="sidebar @(UiState.IsSidebarCollapsed ? "sidebar-collapsed" : "")" aria-label="Primary navigation">
                <NavMenu />
            </aside>

            <div class="workspace-shell">
                <TopCommandHeader />
                <div class="workspace-container">
                    @if (UiState.IsEmergencyDrawerOpen)
                    {
                        <EmergencyContactsStrip />
                    }
                    <div role="status" aria-live="polite" class="@(string.IsNullOrWhiteSpace(UiState.StatusBannerMessage) ? "visually-hidden" : "cg-status-banner")">
                        <div style="display: inline-flex; align-items: center; gap: 0.5rem;">
                            <span class="ai-dot" aria-hidden="true"></span>
                            <span>@UiState.StatusBannerMessage</span>
                        </div>
                        <button type="button" class="cg-btn cg-btn-sm cg-btn-ghost" @onclick="ClearBanner" aria-label="@Loc.T("action.dismiss")">@Loc.T("action.dismiss")</button>
                    </div>
                    <main id="main-content" tabindex="-1">
                        @Body
                    </main>
                    <PortfolioQueryDrawer />
                    <SparkAutomationChatBubble />
                </div>
            </div>
        </div>
    </Authorized>
    <NotAuthorized>
        <RedirectToLogin />
    </NotAuthorized>
</AuthorizeView>

<div id="blazor-error-ui" data-nosnippet>
    @Loc.T("error.unhandled")
    <a href="." class="reload">@Loc.T("error.reload")</a>
    <span class="dismiss">x</span>
</div>

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }
    private Action? _stateHandler;
    private Action? _locHandler;

    protected override async Task OnInitializedAsync()
    {
        _stateHandler = () => InvokeAsync(StateHasChanged);
        UiState.OnChange += _stateHandler;
        _locHandler = () => InvokeAsync(StateHasChanged);
        Loc.OnChange += _locHandler;
        await Loc.EnsureLoadedAsync();
        await SyncIdentityAsync();
    }

    private async Task SyncIdentityAsync()
    {
        try
        {
            if (AuthState is null) return;
            var state = await AuthState;
            var user = state.User;
            if (!(user.Identity?.IsAuthenticated ?? false))
            {
                UiState.ClearCommunitySelection();
                return;
            }
            var role = await Access.GetRoleAsync();
            var account = await Access.GetAccountAsync();
            if (!role.HasValue || role.Value == WorkspaceSecurityRole.Resident)
            {
                if (account?.Role is not null && account.Role != WorkspaceSecurityRole.Resident)
                {
                    role = account.Role;
                }
                else
                {
                    role ??= WorkspaceClaims.GetRole(user);
                }
            }
            WorkspaceClaims.TryGetFirmId(user, out var firmId);
            if (firmId == Guid.Empty)
            {
                var accessFirmId = await Access.GetFirmIdAsync();
                if (accessFirmId.HasValue) firmId = accessFirmId.Value;
            }
            var firmCode = user.FindFirst(WorkspaceClaimTypes.FirmCode)?.Value ?? string.Empty;
            WorkspaceClaims.TryGetCommunityId(user, out var primary);
            UiState.SyncFromClaims(role.Value, firmId == Guid.Empty ? null : firmId, firmCode, primary == Guid.Empty ? null : primary, account);
        }
        catch
        {
        }
    }

    private void ClearBanner()
    {
        UiState.Announce(string.Empty);
    }

    public void Dispose()
    {
        if (_stateHandler is not null) UiState.OnChange -= _stateHandler;
        if (_locHandler is not null) Loc.OnChange -= _locHandler;
    }
}
