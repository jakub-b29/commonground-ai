@inject NavigationManager Nav
@inject WorkspaceLocalization Loc
@implements IDisposable

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private Action? _locHandler;

    protected override async Task OnInitializedAsync()
    {
        _locHandler = () => InvokeAsync(StateHasChanged);
        Loc.OnChange += _locHandler;
        await Loc.EnsureLoadedAsync();
        var returnUrl = new Uri(Nav.Uri).PathAndQuery;
        if (AuthState is not null)
        {
            var state = await AuthState;
            if (state.User.Identity?.IsAuthenticated == true)
                return;
        }
        Nav.NavigateTo($"/login?returnUrl={Uri.EscapeDataString(returnUrl)}", forceLoad: true);
    }

    public void Dispose()
    {
        if (_locHandler is not null)
        {
            Loc.OnChange -= _locHandler;
        }
    }
}
