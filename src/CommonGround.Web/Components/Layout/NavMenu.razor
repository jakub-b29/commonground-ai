@inject WorkspaceLocalization Loc
@inject WorkspaceUiState UiState
@implements IDisposable

<div class="cg-brand-row">
    <a class="cg-brand" href="/" title="@Loc.T("shell.brandHint")">
        <span class="brand-mark">CG</span>
        @if (!UiState.IsSidebarCollapsed)
        {
            <span class="brand-text">
                <strong>CommonGround</strong>
                <small>@Loc.T("nav.workspace")</small>
            </span>
        }
    </a>
    <button type="button"
            class="sidebar-collapse-btn"
            title="@Loc.T(UiState.IsSidebarCollapsed ? "shell.expandSidebar" : "shell.collapseSidebar")"
            aria-label="@Loc.T(UiState.IsSidebarCollapsed ? "shell.expandSidebar" : "shell.collapseSidebar")"
            @onclick="ToggleCollapse">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            @if (UiState.IsSidebarCollapsed)
            {
                <polyline points="9 18 15 12 9 6"></polyline>
            }
            else
            {
                <polyline points="15 18 9 12 15 6"></polyline>
            }
        </svg>
    </button>
</div>

<input type="checkbox" title="@Loc.T("shell.navMenuToggle")" class="navbar-toggler" aria-label="@Loc.T("shell.navMenuToggle")" />

<div class="nav-scrollable @(UiState.IsSidebarCollapsed ? "nav-scrollable-collapsed" : "")">
    <AuthorizeView>
        <Authorized>
            <FirmAdminNavSection />
            <PropertyWorkspaceNavSection />
            <PersonalNavSection />
        </Authorized>
    </AuthorizeView>
</div>

@code {
    private Action? _locHandler;
    private Action? _stateHandler;

    protected override async Task OnInitializedAsync()
    {
        _locHandler = () => InvokeAsync(StateHasChanged);
        Loc.OnChange += _locHandler;
        _stateHandler = () => InvokeAsync(StateHasChanged);
        UiState.OnChange += _stateHandler;
        await Loc.EnsureLoadedAsync();
    }

    private void ToggleCollapse()
    {
        UiState.ToggleSidebarCollapsed();
    }

    public void Dispose()
    {
        if (_locHandler is not null)
        {
            Loc.OnChange -= _locHandler;
        }
        if (_stateHandler is not null)
        {
            UiState.OnChange -= _stateHandler;
        }
    }
}
