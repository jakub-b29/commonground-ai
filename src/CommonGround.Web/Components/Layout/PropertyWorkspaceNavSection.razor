@inject WorkspaceUiState UiState
@inject WorkspaceAccessService Access
@implements IDisposable

@if (_allowed.Count > 0)
{
    <div class="nav-section-label">
        <span>Property workspace</span>
        <span class="mono" style="font-size: 0.64rem; opacity: 0.8;">@_allowed.Count</span>
    </div>
    <nav class="cg-nav-list" aria-label="Property workspace">
        @foreach (var property in _allowed)
        {
            var basePath = $"properties/{property.Id}";
            var isCollapsed = _collapsedPropertyIds.Contains(property.Id);
            <div class="nav-item nav-item-group" @key="property.Id">
                <button type="button"
                        class="nav-group-header"
                        title="@property.Name"
                        aria-expanded="@(!isCollapsed)"
                        @onclick="() => TogglePropertyGroup(property.Id)">
                    <span class="nav-group-name">
                        <span class="nav-icon" aria-hidden="true">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path><polyline points="9 22 9 12 15 12 15 22"></polyline></svg>
                        </span>
                        <span>@property.Name</span>
                        @if (!UiState.IsSidebarCollapsed && !string.IsNullOrWhiteSpace(property.CommunityAccountNumber))
                        {
                            <small class="mono num" style="font-size: 0.65rem; opacity: 0.72; margin-inline-start: 0.25rem;">@property.CommunityAccountNumber</small>
                        }
                    </span>
                    @if (!UiState.IsSidebarCollapsed)
                    {
                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            @if (isCollapsed)
                            {
                                <polyline points="9 18 15 12 9 6"></polyline>
                            }
                            else
                            {
                                <polyline points="6 9 12 15 18 9"></polyline>
                            }
                        </svg>
                    }
                </button>
                @if (!isCollapsed)
                {
                    <div class="nav-sublist">
                        <div class="nav-item">
                            <NavLink class="nav-link" href="@($"{basePath}/overview")" title="@($"{property.Name} · Overview")">
                                <span class="nav-icon" aria-hidden="true"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"></polyline></svg></span>
                                <span>Overview</span>
                            </NavLink>
                        </div>
                        <div class="nav-item">
                            <NavLink class="nav-link" href="@($"{basePath}/units")" title="@($"{property.Name} · Units")">
                                <span class="nav-icon" aria-hidden="true"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2"></rect><line x1="3" y1="9" x2="21" y2="9"></line><line x1="9" y1="21" x2="9" y2="9"></line></svg></span>
                                <span>Units</span>
                            </NavLink>
                        </div>
                        <div class="nav-item">
                            <NavLink class="nav-link" href="@($"{basePath}/infrastructure")" title="@($"{property.Name} · Infrastructure")">
                                <span class="nav-icon" aria-hidden="true"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="12 2 2 7 12 12 22 7 12 2"></polygon><polyline points="2 17 12 22 22 17"></polyline><polyline points="2 12 12 17 22 12"></polyline></svg></span>
                                <span>Infrastructure</span>
                            </NavLink>
                        </div>
                        <div class="nav-item">
                            <NavLink class="nav-link" href="@($"{basePath}/maintenance")" title="@($"{property.Name} · Maintenance")">
                                <span class="nav-icon" aria-hidden="true"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"></path></svg></span>
                                <span>Maintenance</span>
                            </NavLink>
                        </div>
                        <div class="nav-item">
                            <NavLink class="nav-link" href="@($"{basePath}/financials")" title="@($"{property.Name} · Financials")">
                                <span class="nav-icon" aria-hidden="true"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="1" x2="12" y2="23"></line><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path></svg></span>
                                <span>Financials</span>
                            </NavLink>
                        </div>
                        <div class="nav-item">
                            <NavLink class="nav-link" href="@($"{basePath}/governance")" title="@($"{property.Name} · Governance")">
                                <span class="nav-icon" aria-hidden="true"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line></svg></span>
                                <span>Governance</span>
                            </NavLink>
                        </div>
                        <div class="nav-item">
                            <NavLink class="nav-link" href="@($"{basePath}/team")" title="@($"{property.Name} · Team")">
                                <span class="nav-icon" aria-hidden="true"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle></svg></span>
                                <span>Team</span>
                            </NavLink>
                        </div>
                        <div class="nav-item">
                            <NavLink class="nav-link" href="@($"{basePath}/settings")" title="@($"{property.Name} · Settings")">
                                <span class="nav-icon" aria-hidden="true"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"></circle><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path></svg></span>
                                <span>Settings</span>
                            </NavLink>
                        </div>
                    </div>
                }
            </div>
        }
    </nav>
}

@code {
    private Action? _stateHandler;
    private List<Community> _allowed = new();
    private readonly HashSet<Guid> _collapsedPropertyIds = new();

    protected override async Task OnInitializedAsync()
    {
        _stateHandler = () => InvokeAsync(ReloadAsync);
        UiState.OnChange += _stateHandler;
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        try
        {
            _allowed = (await Access.GetAllowedCommunitiesAsync()).ToList();
        }
        catch
        {
            _allowed = new List<Community>();
        }

        StateHasChanged();
    }

    private void TogglePropertyGroup(Guid propertyId)
    {
        if (!_collapsedPropertyIds.Remove(propertyId))
        {
            _collapsedPropertyIds.Add(propertyId);
        }
    }

    public void Dispose()
    {
        if (_stateHandler is not null)
        {
            UiState.OnChange -= _stateHandler;
        }
    }
}
