@inject WorkspaceLocalization Loc
@implements IDisposable

<AuthorizeView>
    <Authorized>
        <div class="nav-section-label">Personal</div>
        <nav class="cg-nav-list" aria-label="Personal">
            <div class="nav-item">
                <NavLink class="nav-link" href="my-unit" title="My unit dossier">
                    <span class="nav-icon" aria-hidden="true">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path><polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline><line x1="12" y1="22.08" x2="12" y2="12"></line></svg>
                    </span>
                    <span>My unit</span>
                </NavLink>
            </div>
            <div class="nav-item">
                <NavLink class="nav-link" href="account" title="Account & profile">
                    <span class="nav-icon" aria-hidden="true">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
                    </span>
                    <span>Account</span>
                </NavLink>
            </div>
            <div class="nav-item">
                <NavLink class="nav-link" href="pending" title="Pending status">
                    <span class="nav-icon" aria-hidden="true">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
                    </span>
                    <span>Pending status</span>
                </NavLink>
            </div>
            <div class="nav-item">
                <NavLink class="nav-link" href="choose-membership" title="Choose membership">
                    <span class="nav-icon" aria-hidden="true">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="16 3 21 3 21 8"></polyline><line x1="4" y1="20" x2="21" y2="3"></line><polyline points="21 16 21 21 16 21"></polyline><line x1="15" y1="15" x2="21" y2="21"></line><line x1="4" y1="4" x2="9" y2="9"></line></svg>
                    </span>
                    <span>Choose membership</span>
                </NavLink>
            </div>
            <div class="nav-item">
                <form method="post" action="/auth/logout" class="cg-nav-logout">
                    <button type="submit" class="nav-link cg-nav-button" title="Sign out">
                        <span class="nav-icon" aria-hidden="true">
                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path><polyline points="16 17 21 12 16 7"></polyline><line x1="21" y1="12" x2="9" y2="12"></line></svg>
                        </span>
                        <span>Sign out</span>
                    </button>
                </form>
            </div>
        </nav>
    </Authorized>
</AuthorizeView>

@code {
    private Action? _locHandler;

    protected override async Task OnInitializedAsync()
    {
        _locHandler = () => InvokeAsync(StateHasChanged);
        Loc.OnChange += _locHandler;
        await Loc.EnsureLoadedAsync();
    }

    public void Dispose()
    {
        if (_locHandler is not null)
        {
            Loc.OnChange -= _locHandler;
        }
    }
}
