@inject CommonGroundWorkspaceService Workspace
@inject WorkspaceAccessService Access
@inject WorkspaceLocalization Loc
@implements IDisposable

<div class="cg-card">
    <div class="cg-section-header">
        <h2>@Loc.T("firm.chatTitle")</h2>
        <span class="cg-badge">@_messages.Count @Loc.T("panel.messagesCount")</span>
    </div>
    <div class="cg-grid-2">
        <div>
            <label for="firm-group">@Loc.T("firm.groupLabel")</label>
            <select id="firm-group" value="@_groupId" @onchange="OnGroupChanged">
                @foreach (var g in _groups)
                {
                    <option value="@g.Id" selected="@(_groupId == g.Id)">@g.Name</option>
                }
            </select>
        </div>
        <div>
            <label for="firm-scope">@Loc.T("firm.scopeLabel")</label>
            <input id="firm-scope" @bind="_scope" placeholder="All Firm Properties" />
        </div>
    </div>
    @if (_isManager)
    {
        <div style="margin-block-start: 0.5rem;">
            <label for="firm-new-group">@Loc.T("firm.newGroup")</label>
            <div style="display: flex; gap: 0.375rem;">
                <input id="firm-new-group" @bind="_newGroupName" placeholder="Operations Sync" style="flex: 1;" />
                <input @bind="_newGroupTopic" placeholder="Weekly sync" style="flex: 1;" />
                <button type="button" class="cg-btn" disabled="@_isBusy" @onclick="OnCreateGroup">@Loc.T("action.createGroup")</button>
            </div>
        </div>
    }
    <div class="cg-table-wrap" style="margin-block-start: 0.75rem; max-height: 320px; overflow-y: auto;">
        <table class="cg-table">
            <thead>
                <tr>
                    <th>@Loc.T("table.sender")</th>
                    <th>@Loc.T("table.subject")</th>
                    <th>@Loc.T("table.status")</th>
                </tr>
            </thead>
            <tbody>
                @if (_messages.Count == 0)
                {
                    <tr><td colspan="3" style="color: var(--color-text-secondary);">@Loc.T("msg.noMessages")</td></tr>
                }
                @foreach (var m in _messages)
                {
                    <tr @key="m.Id">
                        <td>
                            <strong>@m.SenderName</strong>
                            <div style="font-size: 0.72rem; color: var(--color-text-secondary);">@m.SenderRole · @m.SentAtUtc.ToString("yyyy-MM-dd HH:mm")</div>
                            <div style="font-size: 0.72rem;">@m.PropertyScopeName · @m.GroupName</div>
                        </td>
                        <td>
                            <strong>@m.Subject</strong>
                            <div style="font-size: 0.75rem; color: var(--color-text-secondary);">@m.Body</div>
                        </td>
                        <td>
                            @if (m.IsPriorityNotice)
                            {
                                <span class="cg-badge cg-badge-err">@Loc.T("msg.pinned")</span>
                            }
                            else
                            {
                                <span class="cg-badge">@m.GroupName</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    @if (_isManager && _groupId != Guid.Empty)
    {
        <div class="cg-grid-2" style="margin-block-start: 0.75rem;">
            <div>
                <label for="firm-subject">@Loc.T("form.subject")</label>
                <input id="firm-subject" @bind="_subject" />
            </div>
            <div style="display: flex; align-items: end; gap: 0.375rem;">
                <label style="display: flex; align-items: center; gap: 0.375rem; font-weight: 500;">
                    <input type="checkbox" @bind="_priority" /> @Loc.T("groups.postPinned")
                </label>
            </div>
        </div>
        <div style="margin-block-start: 0.5rem;">
            <label for="firm-body">@Loc.T("form.body")</label>
            <textarea id="firm-body" rows="3" @bind="_body"></textarea>
        </div>
        <div class="cg-toolbar">
            <button type="button" class="cg-btn cg-btn-primary" disabled="@_isBusy" @onclick="OnPost">@Loc.T("action.postMessage")</button>
        </div>
    }
    @if (!string.IsNullOrWhiteSpace(_message))
    {
        <div role="status" aria-live="polite" class="cg-callout">@_message</div>
    }
</div>

@code {
    [Parameter] public Guid? FirmId { get; set; }
    private List<FirmManagerGroup> _groups = new();
    private List<FirmManagerMessage> _messages = new();
    private Guid _groupId = Guid.Empty;
    private string _scope = "All Firm Properties";
    private string _subject = string.Empty;
    private string _body = string.Empty;
    private bool _priority;
    private string _newGroupName = string.Empty;
    private string _newGroupTopic = string.Empty;
    private string _message = string.Empty;
    private bool _isBusy;
    private bool _isManager;
    private WorkspaceSecurityRole _role = WorkspaceSecurityRole.PropertyManager;
    private Action? _locHandler;

    protected override async Task OnInitializedAsync()
    {
        _locHandler = () => InvokeAsync(StateHasChanged);
        Loc.OnChange += _locHandler;
        await Loc.EnsureLoadedAsync();
        try
        {
            _role = await Access.GetRoleAsync();
            _isManager = _role == WorkspaceSecurityRole.FirmManager || _role == WorkspaceSecurityRole.PropertyManager;
        }
        catch { }
        await ReloadAsync();
    }

    protected override async Task OnParametersSetAsync() => await ReloadAsync();

    private async Task ReloadAsync()
    {
        if (!FirmId.HasValue) return;
        try
        {
            var myFirm = await Access.GetFirmIdAsync();
            if (myFirm is null || myFirm.Value != FirmId.Value) return;
            _groups = (await Workspace.GetFirmManagerGroupsAsync(FirmId.Value)).ToList();
            if (_groupId == Guid.Empty && _groups.Count > 0) _groupId = _groups[0].Id;
            _messages = _groupId == Guid.Empty
                ? (await Workspace.GetFirmManagerMessagesAsync(FirmId.Value, null)).ToList()
                : (await Workspace.GetFirmManagerMessagesAsync(FirmId.Value, _groupId)).ToList();
        }
        catch { }
        StateHasChanged();
    }

    private async Task OnGroupChanged(ChangeEventArgs e)
    {
        if (Guid.TryParse(e.Value?.ToString(), out var id))
        {
            _groupId = id;
            await ReloadAsync();
        }
    }

    private async Task OnCreateGroup()
    {
        if (!FirmId.HasValue || string.IsNullOrWhiteSpace(_newGroupName)) return;
        _isBusy = true;
        try
        {
            var g = await Workspace.CreateFirmManagerGroupAsync(FirmId.Value, _newGroupName.Trim(), string.IsNullOrWhiteSpace(_newGroupTopic) ? _newGroupName.Trim() : _newGroupTopic.Trim(), _role);
            _groupId = g.Id;
            _newGroupName = _newGroupTopic = string.Empty;
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            _message = ex.Message;
        }
        finally
        {
            _isBusy = false;
        }
    }

    private async Task OnPost()
    {
        if (!FirmId.HasValue || _groupId == Guid.Empty || string.IsNullOrWhiteSpace(_subject) || string.IsNullOrWhiteSpace(_body)) return;
        _isBusy = true;
        try
        {
            var sender = await Access.GetAccountAsync();
            await Workspace.PostFirmManagerMessageAsync(FirmId.Value, _groupId, sender?.FullName ?? _role.ToString(), _role, sender?.Email ?? string.Empty, sender?.Phone ?? string.Empty, _scope, _subject.Trim(), _body.Trim(), _priority);
            _subject = _body = string.Empty;
            _priority = false;
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            _message = ex.Message;
        }
        finally
        {
            _isBusy = false;
        }
    }

    public void Dispose()
    {
        if (_locHandler is not null) Loc.OnChange -= _locHandler;
    }
}
