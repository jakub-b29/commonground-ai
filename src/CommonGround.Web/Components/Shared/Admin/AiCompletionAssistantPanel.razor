@using CommonGround.Application.Interfaces
@inject WorkspaceLocalization Loc
@implements IDisposable

<div class="bento-card bento-card-ai">
    <div class="bento-card-header">
        <div class="cg-panel-title">
            <span class="ai-dot" aria-hidden="true"></span>
            <span>@Loc.T("admin.assistant.stepTitle")</span>
        </div>
        <AIBadge Label="Web Grounded" Model="muse-spark-1.3-contributor" ShowPulseDot="false" />
    </div>
    <div class="bento-card-body">
        <p style="color: var(--text-secondary); font-size: 0.8rem; margin-bottom: 0.75rem;">@Loc.T("admin.assistant.lead")</p>
        <div class="cg-toolbar">
            <button type="button" class="cg-btn cg-btn-primary" disabled="@(IsBusy || !CanRun)" @onclick="OnHarvest">@Loc.T("admin.assistant.harvest")</button>
        </div>
        @if (IsRunning || ProgressPercent > 0)
        {
            <div role="status" aria-live="polite" style="margin-block-start: 0.75rem;">
                <div style="display: flex; justify-content: space-between; font-size: 0.78rem; margin-bottom: 0.3rem;">
                    <strong>@ProgressStage</strong>
                    <span class="mono num">@ProgressPercent%</span>
                </div>
                <div class="ai-progress-track">
                    <div class="ai-progress-fill" style="width: @(ProgressPercent)%;"></div>
                </div>
                <p style="font-size: 0.78rem; color: var(--text-secondary); margin-top: 0.35rem;">@ProgressDetail</p>
                <ModelThinkingLog ThinkingLog="ThinkingLog" IsRunning="IsRunning" ModelId="muse-spark-1.3-contributor" />
                @if (IsRunning)
                {
                    <ul style="font-size: 0.78rem; padding-inline-start: 1.1rem; color: var(--text-secondary); margin-top: 0.5rem;">
                        <li><strong>@Loc.T("admin.assistant.stepSanitize")</strong></li>
                        <li><strong>@Loc.T("admin.assistant.stepContact")</strong></li>
                        <li><strong>@Loc.T("admin.assistant.stepSearch")</strong></li>
                        <li>@Loc.T("admin.assistant.stepParse")</li>
                        <li>@Loc.T("admin.assistant.stepMerge")</li>
                        <li>@Loc.T("admin.assistant.stepReady")</li>
                    </ul>
                }
            </div>
        }
        @if (IsOfflineFallback)
        {
            <div role="status" aria-live="polite" class="cg-callout" style="margin-block-start: 0.65rem;">@Loc.T("admin.assistant.offlineFallback")</div>
        }
        @if (Dossier is not null && Editable is not null)
        {
            <div style="margin-block-start: 0.85rem;">
                <AddressAiDiscoveryReviewPanel Dossier="Dossier" Selected="Selected" SelectedChanged="SelectedChanged" Editable="Editable" />
            </div>
            <div class="cg-toolbar" style="margin-top: 0.75rem;">
                <button type="button" class="cg-btn cg-btn-primary" disabled="@(IsBusy || Selected == DossierSectionFlags.None)" @onclick="OnApply">@Loc.T("admin.assistant.apply")</button>
            </div>
        }
    </div>
</div>

@code {
    [Parameter] public bool IsBusy { get; set; }
    [Parameter] public bool IsRunning { get; set; }
    [Parameter] public bool CanRun { get; set; } = true;
    [Parameter] public int ProgressPercent { get; set; }
    [Parameter] public string ProgressStage { get; set; } = string.Empty;
    [Parameter] public string ProgressDetail { get; set; } = string.Empty;
    [Parameter] public IReadOnlyList<string> ThinkingLog { get; set; } = [];
    [Parameter] public bool IsOfflineFallback { get; set; }
    [Parameter] public PropertyAiDiscoveryDossier? Dossier { get; set; }
    [Parameter] public AddressAiDiscoveryReviewPanel.EditableDossier? Editable { get; set; }
    [Parameter] public DossierSectionFlags Selected { get; set; } = DossierSectionFlags.All;
    [Parameter] public EventCallback<DossierSectionFlags> SelectedChanged { get; set; }
    [Parameter, EditorRequired] public EventCallback OnHarvest { get; set; }
    [Parameter, EditorRequired] public EventCallback OnApply { get; set; }

    private Action? _locHandler;

    protected override async Task OnInitializedAsync()
    {
        _locHandler = () => InvokeAsync(StateHasChanged);
        Loc.OnChange += _locHandler;
        await Loc.EnsureLoadedAsync();
    }

    public void Dispose()
    {
        if (_locHandler is not null) Loc.OnChange -= _locHandler;
    }
}
