@using CommonGround.Application.Interfaces
@using CommonGround.Application.Persistence
@using Microsoft.EntityFrameworkCore
@inject IInvitationService InvitationService
@inject IAppDbContextFactory DbFactory
@inject WorkspaceAccessService Access
@inject WorkspaceLocalization Loc
@implements IDisposable

<div class="cg-card">
    <div class="cg-section-header">
        <h2>@Loc.T("admin.invite.title")</h2>
        <span class="cg-badge mono">@FirmId.ToString("N").Substring(0, 8)</span>
    </div>
    <p style="color: var(--text-secondary); font-size: 0.8rem; margin-bottom: 0.85rem;">@Loc.T("admin.invite.lead")</p>
    <div class="cg-grid-3">
        <div>
            <label for="inv-email-@FirmId">@Loc.T("form.workEmail")</label>
            <input id="inv-email-@FirmId" @bind="_email" type="email" autocomplete="off" placeholder="@Loc.T("admin.invite.emailPh")" />
        </div>
        <div>
            <label for="inv-name-@FirmId">@Loc.T("form.name")</label>
            <input id="inv-name-@FirmId" @bind="_name" autocomplete="off" placeholder="@Loc.T("admin.invite.namePh")" />
        </div>
        <div>
            <label for="inv-role-@FirmId">@Loc.T("form.requestedRole")</label>
            <select id="inv-role-@FirmId" value="@_role" @onchange="OnRoleChanged">
                @foreach (var role in AvailableRoles)
                {
                    <option value="@role" @key="role">@role</option>
                }
            </select>
        </div>
    </div>
    <div style="margin-block-start: 0.85rem;">
        <label id="inv-perm-label-@FirmId">@Loc.T("admin.invite.permFlags")</label>
        <fieldset aria-labelledby="inv-perm-label-@FirmId" style="border: 1px solid var(--border-default); background: var(--surface-secondary); border-radius: var(--radius-control); padding: 0.65rem 0.85rem; margin: 0;">
            @foreach (var flag in RelevantFlags)
            {
                <label class="cg-check-row" style="margin-block-end: 0.3rem; display: flex !important;" @key="flag">
                    <input type="checkbox" checked="@_granted.HasFlag(flag)" @onchange="(e) => OnPermissionToggled(flag, (bool?)e.Value == true)" />
                    <span>@PermissionLabel(flag)</span>
                </label>
            }
        </fieldset>
        <p style="color: var(--text-secondary); font-size: 0.75rem; margin-block-start: 0.375rem;">@Loc.T("admin.invite.presetHint")</p>
    </div>
    <div style="margin-block-start: 0.85rem;">
        <label id="inv-prop-label-@FirmId">@Loc.T("admin.invite.propertyScope")</label>
        <fieldset aria-labelledby="inv-prop-label-@FirmId" style="border: 1px solid var(--border-default); background: var(--surface-secondary); border-radius: var(--radius-control); padding: 0.65rem 0.85rem; margin: 0;">
            @if (_properties.Count == 0)
            {
                <p style="color: var(--text-secondary); font-size: 0.78125rem; margin: 0;">@Loc.T("admin.invite.noProperties")</p>
            }
            @foreach (var property in _properties)
            {
                <label class="cg-check-row" style="margin-block-end: 0.3rem; display: flex !important;" @key="property.Id">
                    <input type="checkbox" checked="@_selectedPropertyIds.Contains(property.Id)" @onchange="(e) => OnPropertyToggled(property.Id, (bool?)e.Value == true)" />
                    <span>@property.Name</span>
                    <span class="mono num" style="font-size: 0.72rem; color: var(--text-secondary);">@property.City</span>
                </label>
            }
        </fieldset>
    </div>
    <div class="cg-grid-3" style="margin-block-start: 0.85rem;">
        <div>
            <label for="inv-unit-@FirmId">@Loc.T("admin.invite.linkedUnit")</label>
            <select id="inv-unit-@FirmId" @bind="_unitIdString">
                <option value="">@Loc.T("admin.invite.noUnit")</option>
                @foreach (var unit in FilteredUnits)
                {
                    <option value="@unit.Id" @key="unit.Id">@unit.CommunityName – @unit.UnitNumber</option>
                }
            </select>
        </div>
        <div>
            <label for="inv-exp-@FirmId">@Loc.T("admin.invite.expiryDays")</label>
            <input id="inv-exp-@FirmId" type="number" min="1" max="30" @bind="_expiresDays" />
        </div>
        <div style="align-self: end;">
            <label class="cg-check-row" for="inv-approval-@FirmId">
                <input id="inv-approval-@FirmId" type="checkbox" @bind="_requiresApproval" />
                <span>@Loc.T("admin.invite.requireApproval")</span>
            </label>
        </div>
    </div>
    <div class="cg-toolbar" style="margin-top: 0.85rem;">
        <button type="button" class="cg-btn cg-btn-primary" disabled="@_isBusy" @onclick="OnInviteAsync">@Loc.T("admin.invite.send")</button>
    </div>
    @if (!string.IsNullOrWhiteSpace(_lastInviteLink))
    {
        <div role="status" aria-live="polite" class="ai-callout" style="overflow-wrap: anywhere; margin-top: 0.65rem;">
            @Loc.T("admin.invite.created") <a href="@_lastInviteLink">@_lastInviteLink</a>
        </div>
    }
    @if (!string.IsNullOrWhiteSpace(_message))
    {
        <div role="status" aria-live="polite" class="cg-callout" style="margin-top: 0.65rem;">@_message</div>
    }
</div>

@code {
    [Parameter, EditorRequired] public Guid FirmId { get; set; }
    [Parameter] public IReadOnlyList<PropertyListItem> Properties { get; set; } = [];
    [Parameter] public EventCallback OnInvitationCreated { get; set; }

    private static readonly WorkspaceSecurityRole[] AvailableRoles =
    [
        WorkspaceSecurityRole.PropertyManager,
        WorkspaceSecurityRole.Accountant,
        WorkspaceSecurityRole.MaintenanceDispatcher,
        WorkspaceSecurityRole.BoardMemberReadOnly,
        WorkspaceSecurityRole.Resident,
        WorkspaceSecurityRole.Contractor,
        WorkspaceSecurityRole.ExternalAuditorView
    ];

    private List<PropertyListItem> _properties = new();
    private List<UnitOption> _units = new();
    private string _email = string.Empty;
    private string _name = string.Empty;
    private WorkspaceSecurityRole _role = WorkspaceSecurityRole.Resident;
    private WorkspacePermissionFlags _granted = WorkspacePermissionPresets.DefaultForRole(WorkspaceSecurityRole.Resident);
    private HashSet<Guid> _selectedPropertyIds = new();
    private string _unitIdString = string.Empty;
    private bool _requiresApproval = true;
    private int _expiresDays = 7;
    private string _message = string.Empty;
    private string _lastInviteLink = string.Empty;
    private bool _isBusy;
    private Action? _locHandler;

    private IReadOnlyList<WorkspacePermissionFlags> RelevantFlags =>
        Enum.GetValues<WorkspacePermissionFlags>()
            .Where(f => f != 0 && WorkspacePermissionPresets.DefaultForRole(_role).HasFlag(f))
            .ToList();

    private IReadOnlyList<UnitOption> FilteredUnits =>
        _selectedPropertyIds.Count == 0
            ? _units
            : _units.Where(u => _selectedPropertyIds.Contains(u.CommunityId)).ToList();

    protected override async Task OnInitializedAsync()
    {
        _locHandler = () => InvokeAsync(StateHasChanged);
        Loc.OnChange += _locHandler;
        await Loc.EnsureLoadedAsync();
        await LoadLookupsAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        if (Properties.Count > 0)
        {
            _properties = Properties.ToList();
        }
        else
        {
            await LoadLookupsAsync();
        }
    }

    private async Task LoadLookupsAsync()
    {
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var communities = await db.Communities.AsNoTracking()
                .Where(c => c.ManagementFirmId == FirmId)
                .OrderBy(c => c.Name)
                .Select(c => new PropertyListItem(c.Id, c.Name, c.City, c.StreetAddress))
                .ToListAsync();
            if (Properties.Count == 0)
            {
                _properties = communities;
            }
            var ids = communities.Select(c => c.Id).ToList();
            var names = communities.ToDictionary(c => c.Id, c => c.Name);
            _units = await db.Units.AsNoTracking()
                .Where(u => ids.Contains(u.CommunityId))
                .OrderBy(u => u.UnitNumber)
                .Take(500)
                .Select(u => new UnitOption(u.Id, u.CommunityId, u.UnitNumber))
                .ToListAsync();
            foreach (var unit in _units)
            {
                unit.CommunityName = names.TryGetValue(unit.CommunityId, out var communityName) ? communityName : string.Empty;
            }
        }
        catch
        {
        }
    }

    private void OnRoleChanged(ChangeEventArgs e)
    {
        if (Enum.TryParse<WorkspaceSecurityRole>(e.Value?.ToString(), out var parsed))
        {
            _role = parsed;
            _granted = WorkspacePermissionPresets.DefaultForRole(_role);
        }
    }

    private void OnPropertyToggled(Guid propertyId, bool isChecked)
    {
        if (isChecked)
        {
            _selectedPropertyIds.Add(propertyId);
        }
        else
        {
            _selectedPropertyIds.Remove(propertyId);
        }
    }

    private void OnPermissionToggled(WorkspacePermissionFlags flag, bool isChecked)
    {
        if (isChecked)
        {
            _granted |= flag;
        }
        else
        {
            _granted &= ~flag;
        }
    }

    private static string PermissionLabel(WorkspacePermissionFlags flag)
    {
        var raw = flag.ToString();
        if (string.IsNullOrWhiteSpace(raw))
        {
            return string.Empty;
        }
        var builder = new System.Text.StringBuilder();
        for (var i = 0; i < raw.Length; i++)
        {
            var c = raw[i];
            if (i > 0 && char.IsUpper(c) && !char.IsUpper(raw[i - 1]))
            {
                builder.Append(' ');
            }
            builder.Append(i == 0 ? c : char.ToLowerInvariant(c));
        }
        return builder.ToString();
    }

    private async Task OnInviteAsync()
    {
        if (string.IsNullOrWhiteSpace(_email))
        {
            _message = Loc.T("msg.recipientEmailRequired");
            return;
        }
        _isBusy = true;
        try
        {
            var actorId = await Access.GetActiveMembershipIdAsync()
                ?? throw new InvalidOperationException("Active membership is required.");
            Guid? unitId = Guid.TryParse(_unitIdString, out var parsedUnit) && parsedUnit != Guid.Empty ? parsedUnit : null;
            var expires = DateTime.UtcNow.AddDays(Math.Clamp(_expiresDays, 1, 30));
            var result = await InvitationService.CreateInvitationAsync(
                FirmId,
                actorId,
                _email.Trim(),
                _name.Trim(),
                _role,
                _granted,
                _requiresApproval,
                _selectedPropertyIds.ToList(),
                unitId,
                expires);
            _lastInviteLink = $"/accept-invite?token={Uri.EscapeDataString(result.PlainToken)}";
            _message = $"{Loc.T("admin.invite.issued")} {_email.Trim()} ({_role}).";
            _email = string.Empty;
            _name = string.Empty;
            _unitIdString = string.Empty;
            await OnInvitationCreated.InvokeAsync();
        }
        catch (Exception ex)
        {
            _message = ex.Message;
        }
        finally
        {
            _isBusy = false;
        }
    }

    public void Dispose()
    {
        if (_locHandler is not null) Loc.OnChange -= _locHandler;
    }

    private sealed class UnitOption
    {
        public UnitOption(Guid id, Guid communityId, string unitNumber)
        {
            Id = id;
            CommunityId = communityId;
            UnitNumber = unitNumber;
        }

        public Guid Id { get; }
        public Guid CommunityId { get; }
        public string UnitNumber { get; }
        public string CommunityName { get; set; } = string.Empty;
    }
}
