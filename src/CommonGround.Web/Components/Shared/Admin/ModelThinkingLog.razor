@inject WorkspaceLocalization Loc
@implements IDisposable

<div class="cg-thinking-log">
    @if (ThinkingLog.Count > 0 || IsRunning)
    {
        <details open style="margin-block-start: 0.65rem;">
            <summary style="display: flex; align-items: center; gap: 0.5rem; cursor: pointer; font-size: 0.78rem; font-weight: 600; color: var(--text-primary);">
                <span class="ai-dot" aria-hidden="true"></span>
                <span>@Loc.T("admin.thinking.trace") — @ModelId</span>
                <span class="ai-badge mono">@ThinkingLog.Count @Loc.T("admin.thinking.steps")</span>
            </summary>
            @if (ThinkingLog.Count == 0)
            {
                <p role="status" aria-live="polite" class="cg-thinking-placeholder" style="margin-top: 0.5rem;">@Loc.T("admin.thinking.waiting") @ModelId…</p>
            }
            else
            {
                <div class="cg-thinking-scroll mono" style="margin-top: 0.5rem; font-size: 0.75rem;" role="log" aria-live="polite" aria-label="@Loc.T("admin.thinking.aria")">
                    @for (var i = 0; i < ThinkingLog.Count; i++)
                    {
                        <div class="cg-thinking-entry" @key="i">@ThinkingLog[i]</div>
                    }
                </div>
            }
        </details>
    }
</div>

@code {
    [Parameter] public IReadOnlyList<string> ThinkingLog { get; set; } = [];
    [Parameter] public bool IsRunning { get; set; }
    [Parameter] public string ModelId { get; set; } = "muse-spark-1.3-contributor";

    private Action? _locHandler;

    protected override async Task OnInitializedAsync()
    {
        _locHandler = () => InvokeAsync(StateHasChanged);
        Loc.OnChange += _locHandler;
        await Loc.EnsureLoadedAsync();
    }

    public void Dispose()
    {
        if (_locHandler is not null) Loc.OnChange -= _locHandler;
    }
}
