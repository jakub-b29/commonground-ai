@inject WorkspaceUiState UiState
@inject WorkspaceLocalization Loc
@inject WorkspaceAccessService Access
@inject CommonGroundWorkspaceService Workspace
@implements IDisposable

<div class="cg-card" style="margin-block-end: 1rem; padding: 0.75rem 1rem; border-color: var(--status-danger-border); background: var(--status-danger-bg);" role="region" aria-label="@Loc.T("shell.emergencyContacts")">
    <div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 0.5rem;">
        <div style="display: flex; align-items: center; gap: 0.5rem; flex-wrap: wrap;">
            <span class="cg-badge cg-badge-err">@Loc.T("shell.dispatch247")</span>
            <strong style="font-size: 0.82rem; color: var(--text-primary);">@Loc.T("shell.emergencyContacts")</strong>
            <span style="font-size: 0.76rem; color: var(--text-secondary);">@_summary</span>
        </div>
        <button type="button" class="cg-btn cg-btn-sm" @onclick="() => UiState.ToggleEmergencyDrawer()">@Loc.T("shell.dismiss")</button>
    </div>
    <div style="display: flex; flex-wrap: wrap; gap: 0.45rem; margin-block-start: 0.55rem;">
        @foreach (var contact in _contacts)
        {
            <span class="cg-badge cg-badge-neutral" style="background: var(--surface-primary); padding: 0.25rem 0.6rem;" @key="contact.Id">
                <span style="color: var(--text-secondary);">@contact.Name:</span>
                <strong class="mono" style="color: var(--text-primary);">@contact.PhoneNumber</strong>
            </span>
        }
    </div>
</div>

@code {
    private Action? _stateHandler;
    private Action? _locHandler;
    private List<EmergencyAndAuthorityContact> _contacts = new();
    private string _summary = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        _stateHandler = () => InvokeAsync(LoadAsync);
        UiState.OnChange += _stateHandler;
        _locHandler = () => InvokeAsync(StateHasChanged);
        Loc.OnChange += _locHandler;
        await Loc.EnsureLoadedAsync();
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        var allowed = await Access.GetAllowedCommunitiesAsync();
        if (allowed.Count == 0)
        {
            return;
        }
        Guid targetId;
        if (UiState.SelectedCommunityId.HasValue && allowed.Any(c => c.Id == UiState.SelectedCommunityId.Value))
        {
            targetId = UiState.SelectedCommunityId.Value;
        }
        else
        {
            var first = allowed.OrderBy(c => c.Name).First();
            UiState.SelectCommunity(first.Id, first.OperatingMode == SystemOperatingMode.UsHoa ? Loc.T("shell.modeUsHoa") : Loc.T("shell.modeHousing"));
            targetId = first.Id;
        }
        if (!await Access.CanAccessCommunityAsync(targetId))
        {
            return;
        }
        var snapshot = await Workspace.GetSnapshotAsync(targetId);
        if (snapshot is null)
        {
            return;
        }
        _contacts = snapshot.Community.EmergencyContacts.OrderBy(c => c.SortOrder).ToList();
        _summary = snapshot.Profile.Mode == SystemOperatingMode.UsHoa
            ? Loc.T("emergency.usSummary")
            : Loc.T("emergency.euSummary");
        StateHasChanged();
    }

    public void Dispose()
    {
        if (_stateHandler is not null)
        {
            UiState.OnChange -= _stateHandler;
        }
        if (_locHandler is not null)
        {
            Loc.OnChange -= _locHandler;
        }
    }
}
