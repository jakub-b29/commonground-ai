@inject WorkspaceUiState UiState
@inject WorkspaceLocalization Loc
@inject WorkspaceAccessService Access
@implements IDisposable

<AuthorizeView>
    <Authorized Context="auth">
        <header class="cg-topbar" role="banner">
            <div class="cg-topbar-group">
                <span class="cg-badge" title="@_firmName">@_firmName</span>
                <div class="cg-topbar-field">
                    <label for="community-select">@Loc.T("form.community")</label>
                    <select id="community-select" value="@UiState.SelectedCommunityId" @onchange="OnCommunityChanged">
                        <option value="">@Loc.T("firm.selectProperty")</option>
                        @foreach (var c in _communities)
                        {
                            <option value="@c.Id" selected="@(UiState.SelectedCommunityId == c.Id)">@c.Name</option>
                        }
                    </select>
                </div>
            </div>
            <div class="cg-topbar-group">
                <div class="cg-topbar-field">
                    <label for="lang-select">@Loc.T("form.language")</label>
                    <select id="lang-select" value="@Loc.CurrentLanguage" @onchange="OnLanguageChanged">
                        @foreach (var lang in Loc.SupportedLanguages)
                        {
                            <option value="@lang" selected="@(Loc.CurrentLanguage == lang)">@lang.ToUpperInvariant()</option>
                        }
                    </select>
                </div>
                <div class="cg-topbar-actions">
                    <button type="button" class="cg-btn" @onclick="OnToggleQuery" title="@Loc.T("action.portfolioQuery")">@Loc.T("action.portfolioQuery")</button>
                    <button type="button" class="cg-btn" @onclick="OnToggleEmergency" title="@Loc.T("shell.emergencyContacts")">@Loc.T("shell.emergencyContacts")</button>
                    <span class="cg-badge cg-badge-ok">@auth.User.Identity?.Name · @WorkspaceClaims.GetRole(auth.User)</span>
                    <form method="post" action="/auth/logout" class="cg-inline-form">
                        <button type="submit" class="cg-btn">@Loc.T("nav.signOut")</button>
                    </form>
                </div>
            </div>
        </header>
        <div class="cg-topbar-sub">
            <span class="cg-badge">@UiState.CurrentTerminology</span>
        </div>
    </Authorized>
</AuthorizeView>

@code {
    private Action? _stateHandler;
    private Action? _locHandler;
    private List<Community> _communities = new();
    private string _firmName = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        _stateHandler = () => InvokeAsync(ReloadAsync);
        UiState.OnChange += _stateHandler;
        _locHandler = () => InvokeAsync(StateHasChanged);
        Loc.OnChange += _locHandler;
        await Loc.EnsureLoadedAsync();
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        try
        {
            var firm = await Access.GetFirmAsync();
            _firmName = firm?.Name ?? string.Empty;
            _communities = (await Access.GetAllowedCommunitiesAsync()).ToList();
            if (UiState.SelectedCommunityId is null && _communities.Count > 0)
            {
                var first = _communities[0];
                UiState.SelectCommunity(first.Id, first.OperatingMode == SystemOperatingMode.UsHoa ? "US HOA & Condo Mode" : "Housing Association Mode");
            }
            else if (UiState.SelectedCommunityId.HasValue && !_communities.Any(c => c.Id == UiState.SelectedCommunityId.Value))
            {
                UiState.SelectedCommunityId = null;
            }
        }
        catch
        {
        }
        StateHasChanged();
    }

    private Task OnCommunityChanged(ChangeEventArgs e)
    {
        if (Guid.TryParse(e.Value?.ToString(), out var id))
        {
            var selected = _communities.FirstOrDefault(c => c.Id == id);
            if (selected is not null)
            {
                UiState.SelectCommunity(id, selected.OperatingMode == SystemOperatingMode.UsHoa ? "US HOA & Condo Mode" : "Housing Association Mode");
            }
        }
        return Task.CompletedTask;
    }

    private async Task OnLanguageChanged(ChangeEventArgs e)
    {
        await Loc.SetLanguageAsync(e.Value?.ToString() ?? "en");
        UiState.NotifyChanged();
    }

    private void OnToggleQuery() => UiState.TogglePortfolioQuery();
    private void OnToggleEmergency() => UiState.ToggleEmergencyDrawer();

    public void Dispose()
    {
        if (_stateHandler is not null) UiState.OnChange -= _stateHandler;
        if (_locHandler is not null) Loc.OnChange -= _locHandler;
    }
}
