                new RecipeItem("spark.recipe.firmCreateSettleTitle", "spark.recipe.firmCreateSettleGoal", RecipeText.FirmCreateSettleTitle, RecipeText.FirmCreateSettleGoal),
                new RecipeItem("spark.recipe.firmReserveAuditTitle", "spark.recipe.firmReserveAuditGoal", RecipeText.FirmReserveAuditTitle, RecipeText.FirmReserveAuditGoal),
