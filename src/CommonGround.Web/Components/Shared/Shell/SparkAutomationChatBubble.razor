@using CommonGround.Application.Interfaces
@using CommonGround.Application.Services
@using CommonGround.Domain.Entities
@using CommonGround.Domain.Enums
@using CommonGround.Web.Services
@using Microsoft.JSInterop
@inject IMuseSparkAutomationAgentService AgentService
@inject IMuseVoiceTranscriber VoiceTranscriber
@inject CommonGroundWorkspaceService Workspace
@inject IJSRuntime JS
@inject WorkspaceUiState UiState
@inject WorkspaceLocalization Loc
@inject WorkspaceAccessService Access
@inject NavigationManager Nav
@implements IDisposable

@if (!UiState.IsSparkAgentChatOpen)
{
    <!-- Persistent Floating Launcher -->
    <button type="button"
            class="cg-spark-launcher @(_isRunning ? "cg-spark-launcher-active" : "")"
            @onclick="OnOpenChat"
            title="@Loc.T("spark.launcherTitle")"
            aria-label="@Loc.T("spark.launcherAria")">
        <span class="cg-spark-icon-wrapper" aria-hidden="true">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="m12 3-1.912 5.813a2 2 0 0 1-1.275 1.275L3 12l5.813 1.912a2 2 0 0 1 1.275 1.275L12 21l1.912-5.813a2 2 0 0 1 1.275-1.275L21 12l-5.813-1.912a2 2 0 0 1-1.275-1.275L12 3Z"/>
            </svg>
        </span>
        <span class="cg-spark-launcher-label">@Loc.T("spark.launcherLabel")</span>
        @if (_isRunning)
        {
            <span class="cg-spark-pulse-dot" aria-hidden="true"></span>
        }
        else if (_steps.Count > 0)
        {
            <span class="cg-spark-step-counter" title="@Loc.T("spark.launcherStepsTitle")">@_steps.Count</span>
        }
    </button>
}
else
{
    <!-- Floating Chat Bubble Window -->
    <aside class="cg-spark-chat-window @(UiState.IsSparkAgentExpanded ? "cg-spark-chat-expanded" : "")"
           role="dialog"
           aria-label="@Loc.T("spark.dialogAria")"
           aria-modal="false">
        
        <!-- Header -->
        <header class="cg-spark-header">
            <div class="cg-spark-header-title-group">
                <span class="cg-spark-icon-wrapper" aria-hidden="true">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="m12 3-1.912 5.813a2 2 0 0 1-1.275 1.275L3 12l5.813 1.912a2 2 0 0 1 1.275 1.275L12 21l1.912-5.813a2 2 0 0 1 1.275-1.275L21 12l-5.813-1.912a2 2 0 0 1-1.275-1.275L12 3Z"/>
                    </svg>
                </span>
                <div>
                    <div style="display: flex; align-items: center; gap: 0.45rem;">
                        <h2 class="cg-spark-title">@Loc.T("spark.chatTitle")</h2>
                        <span class="cg-spark-badge-pill">muse-spark-1.3</span>
                    </div>
                    <div class="cg-spark-subtitle">
                        @Loc.T("spark.chatSubtitle")
                    </div>
                </div>
            </div>

            <div class="cg-spark-header-actions">
                <span class="cg-spark-status-chip @GetStatusChipCssClass()">@_statusText</span>

                <button type="button"
                        class="cg-btn-icon"
                        @onclick="OnToggleExpanded"
                        title="@Loc.T(UiState.IsSparkAgentExpanded ? "spark.restoreWindow" : "spark.expandWindow")"
                        aria-label="@Loc.T(UiState.IsSparkAgentExpanded ? "spark.restoreWindow" : "spark.expandWindow")">
                    @if (UiState.IsSparkAgentExpanded)
                    {
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <polyline points="4 14 10 14 10 20"></polyline>
                            <polyline points="20 10 14 10 14 4"></polyline>
                            <line x1="14" y1="10" x2="21" y2="3"></line>
                            <line x1="3" y1="21" x2="10" y2="14"></line>
                        </svg>
                    }
                    else
                    {
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <polyline points="15 3 21 3 21 9"></polyline>
                            <polyline points="9 21 3 21 3 15"></polyline>
                            <line x1="21" y1="3" x2="14" y2="10"></line>
                            <line x1="3" y1="21" x2="10" y2="14"></line>
                        </svg>
                    }
                </button>

                <button type="button"
                        class="cg-btn-icon"
                        @onclick="OnClearHistory"
                        title="@Loc.T("spark.clearTitle")"
                        aria-label="@Loc.T("spark.clearAria")">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="3 6 5 6 21 6"></polyline>
                        <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                    </svg>
                </button>

                <button type="button"
                        class="cg-btn-icon"
                        @onclick="OnCloseChat"
                        title="@Loc.T("spark.closeTitle")"
                        aria-label="@Loc.T("spark.closeAria")">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="18" y1="6" x2="6" y2="18"></line>
                        <line x1="6" y1="6" x2="18" y2="18"></line>
                    </svg>
                </button>
            </div>
        </header>

        <!-- Controls Toolbar -->
        <div class="cg-spark-controls">
            <div class="cg-spark-mode-segmented">
                <button type="button"
                        class="cg-spark-mode-btn @(!_stepByStepMode ? "active" : "")"
                        @onclick="() => SetStepByStepMode(false)"
                        title="@Loc.T("spark.modeAutoTitle")">
                    <span>@Loc.T("spark.modeAuto")</span>
                </button>
                <button type="button"
                        class="cg-spark-mode-btn @(_stepByStepMode ? "active" : "")"
                        @onclick="() => SetStepByStepMode(true)"
                        title="@Loc.T("spark.modeStepTitle")">
                    <span>@Loc.T("spark.modeStep")</span>
                </button>
            </div>

            <div class="cg-spark-context-tags">
                <span class="cg-context-tag" title="@Loc.T("spark.scopeTitle")">
                    <span class="mono">@(!string.IsNullOrWhiteSpace(_lastResult?.EffectivePropertyName) ? _lastResult.EffectivePropertyName : (UiState.SelectedCommunityId.HasValue ? Loc.T("spark.scopeCommunity") : Loc.T("spark.scopePortfolio")))</span>
                </span>
                <span class="cg-context-tag cg-context-role" title="@StatusTextOrFallback("spark.highestPermissionTitle", "Highest account permission resolved for target property")">
                    <span class="mono">@(UiState.IsFirmManager ? "FirmManager" : (!string.IsNullOrWhiteSpace(_lastResult?.EffectiveRole) ? _lastResult.EffectiveRole : UiState.ActiveSecurityRole.ToString()))</span>
                </span>
            </div>
        </div>

        <!-- Chat & Steps Scroll Body -->
        <div class="cg-spark-body" @ref="_bodyElement">
            @if (_steps.Count == 0 && string.IsNullOrWhiteSpace(_currentGoal))
            {
                <!-- Hero & Quick-Start Recipes -->
                <div class="cg-spark-welcome">
                    <div class="cg-spark-welcome-badge">
                        <span class="ai-dot" aria-hidden="true"></span>
                        <span>@Loc.T("spark.welcomeBadge")</span>
                    </div>
                    <h3 class="cg-spark-welcome-title">@Loc.T("spark.welcomeTitle")</h3>
                    <p class="cg-spark-welcome-desc">
                        @Loc.T("spark.welcomeDesc")
                    </p>

                    <div class="cg-spark-recipes-section">
                        <div class="cg-spark-recipes-header">
                            <span>@Loc.T("spark.recipesHeader") (@UiState.ActiveSecurityRole)</span>
                        </div>
                        <div class="cg-spark-recipes-grid">
                            @foreach (var recipe in GetRoleRecipes())
                            {
                                <button type="button"
                                        class="cg-spark-recipe-card"
                                        @key="recipe.TitleKey"
                                        @onclick="() => SelectRecipe(ResolveRecipeGoal(recipe))">
                                    <div class="cg-spark-recipe-title">@ResolveRecipeTitle(recipe)</div>
                                    <div class="cg-spark-recipe-goal">@ResolveRecipeGoal(recipe)</div>
                                </button>
                            }
                        </div>
                    </div>
                </div>
            }
            else
            {
                <!-- User Goal Message Bubble -->
                @if (!string.IsNullOrWhiteSpace(_currentGoal))
                {
                    <div class="cg-spark-message-user">
                        <div class="cg-spark-message-user-header">
                            <span class="mono">@Loc.T("spark.operatorInstruction")</span>
                        </div>
                        <div class="cg-spark-message-user-text">@_currentGoal</div>
                    </div>
                }

                <!-- Step Stream Cards (Clean Human-Readable Output Only — No Raw JSON) -->
                <div class="cg-spark-steps-list">
                    @foreach (var step in _steps)
                    {
                        <div class="cg-step-card @GetStepCardCssClass(step)" @key="@($"{step.StepNumber}_{step.Phase}_{step.ToolName}")">
                            
                            <!-- Card Header -->
                            <div class="cg-step-header">
                                <div class="cg-step-title-group">
                                    <span class="cg-step-number mono">@Loc.T("spark.stepLabel") @step.StepNumber</span>
                                    <span class="cg-step-phase">@step.Phase</span>
                                    
                                    @if (!string.IsNullOrWhiteSpace(step.ToolName))
                                    {
                                        <span class="cg-step-tool-tag mono">@FormatToolDisplayName(step.ToolName)</span>
                                    }
                                </div>

                                <div class="cg-step-meta">
                                    @if (step.PermissionGranted.HasValue)
                                    {
                                        <span class="cg-perm-badge @(step.PermissionGranted.Value ? "cg-perm-permitted" : "cg-perm-denied")">
                                            @(step.PermissionBadgeText ?? (step.PermissionGranted.Value ? Loc.T("spark.permitted") : Loc.T("spark.denied")))
                                        </span>
                                    }

                                    @if (step.LatencyMs > 0)
                                    {
                                        <span class="cg-step-latency mono">@step.LatencyMs ms</span>
                                    }
                                </div>
                            </div>

                            <!-- Thinking Phase Card Content -->
                            @if (!string.IsNullOrWhiteSpace(step.Thought))
                            {
                                <div class="cg-step-thought">
                                    @if (step.Phase == "Thinking" && _isRunning)
                                    {
                                        <span class="cg-spark-pulse-inline" aria-hidden="true"></span>
                                    }
                                    <span>@step.Thought</span>
                                </div>
                            }

                            <!-- Clean Human-Readable Input Summary -->
                            @if (!string.IsNullOrWhiteSpace(step.HumanInputSummary))
                            {
                                <div class="cg-step-args">
                                    <div class="cg-step-args-label mono">@Loc.T("spark.toolArgsLabel")</div>
                                    <div style="font-size: 0.78rem; color: var(--text-secondary); padding: 0.35rem 0.5rem; background: var(--bg-elevated); border-radius: 6px; border: 1px solid var(--border-subtle);">
                                        @step.HumanInputSummary
                                    </div>
                                </div>
                            }

                            <!-- Clean Human-Readable Observation Summary & Highlights -->
                            @if (!string.IsNullOrWhiteSpace(step.ObservationSummary) || (step.Highlights is { Count: > 0 }) || !string.IsNullOrWhiteSpace(step.GeneratedImageDataUrl) || !string.IsNullOrWhiteSpace(step.DeepLinkUrl))
                            {
                                <div class="cg-step-observation">
                                    @if (!string.IsNullOrWhiteSpace(step.ObservationSummary))
                                    {
                                        <div style="font-size: 0.82rem; font-weight: 600; color: var(--text-primary); margin-bottom: 0.35rem;">
                                            @step.ObservationSummary
                                        </div>
                                    }

                                    @if (step.Highlights is { Count: > 0 })
                                    {
                                        <ul style="margin: 0.25rem 0 0.5rem 1.1rem; padding: 0; font-size: 0.78rem; color: var(--text-secondary);">
                                            @foreach (var hl in step.Highlights)
                                            {
                                                <li @key="hl" style="margin-bottom: 0.18rem;">@hl</li>
                                            }
                                        </ul>
                                    }

                                    @if (!string.IsNullOrWhiteSpace(step.GeneratedImageDataUrl))
                                    {
                                        <div style="margin-top: 0.5rem; padding: 0.55rem; background: var(--bg-elevated); border: 1px solid var(--border-subtle); border-radius: 8px;">
                                            <div style="display: flex; justify-content: space-between; align-items: center; gap: 0.5rem; margin-bottom: 0.4rem;">
                                                <span class="mono cg-text-xs" style="color: var(--accent-primary); font-weight: 600;">
                                                    @(step.GeneratedImageMetaSummary ?? "muse-image-1.0 • 640×400 PNG")
                                                </span>
                                                <a href="@step.GeneratedImageDataUrl"
                                                   download="@($"commonground-visual-{step.StepNumber}.png")"
                                                   class="cg-btn cg-btn-xs cg-btn-outline"
                                                   style="text-decoration: none;">
                                                    @StatusTextOrFallback("image.downloadPng", "Download PNG")
                                                </a>
                                            </div>
                                            <img src="@step.GeneratedImageDataUrl"
                                                 alt="@(step.ObservationSummary ?? "Generated Visual")"
                                                 style="width: 100%; max-height: 240px; object-fit: contain; border-radius: 6px; border: 1px solid var(--border-subtle);" />
                                        </div>
                                    }

                                    @if (!string.IsNullOrWhiteSpace(step.DeepLinkUrl))
                                    {
                                        <div class="cg-step-action-bar">
                                            <button type="button"
                                                    class="cg-btn cg-btn-ai cg-btn-xs"
                                                    @onclick="() => NavigateToDeepLink(step.DeepLinkUrl)">
                                                <span>@Loc.T("spark.openWorkspace")</span>
                                            </button>
                                            <span class="mono cg-text-xs" style="color: var(--text-muted);">@step.DeepLinkUrl</span>
                                        </div>
                                    }
                                </div>
                            }

                            <!-- Final Answer Content -->
                            @if (!string.IsNullOrWhiteSpace(step.FinalMarkdown))
                            {
                                <div class="cg-step-final-answer">
                                    <div class="cg-final-answer-header">
                                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="color: var(--status-success);">
                                            <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                                            <polyline points="22 4 12 14.01 9 11.01"></polyline>
                                        </svg>
                                        <strong>@Loc.T("spark.synthesisTitle")</strong>
                                    </div>
                                    <div class="cg-final-markdown">
                                        @FormatMarkdownToHtml(step.FinalMarkdown)
                                    </div>
                                </div>
                            }
                        </div>
                    }

                    <!-- Interactive Clarification Card (AwaitingClarification) -->
                    @if (_awaitingClarification)
                    {
                        <div class="cg-clarification-card" role="alert">
                            <div class="cg-clarification-header">
                                <span class="cg-spark-icon-wrapper" aria-hidden="true">
                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <circle cx="12" cy="12" r="10"></circle>
                                        <path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"></path>
                                        <line x1="12" y1="17" x2="12.01" y2="17"></line>
                                    </svg>
                                </span>
                                <strong>@Loc.T("spark.clarificationTitle")</strong>
                            </div>

                            <p class="cg-clarification-question">@_clarificationQuestion</p>

                            @if (_clarificationOptions is not null && _clarificationOptions.Count > 0)
                            {
                                <div class="cg-clarification-options">
                                    @foreach (var opt in _clarificationOptions)
                                    {
                                        <button type="button"
                                                class="cg-btn cg-btn-sm cg-btn-ai"
                                                @key="opt"
                                                disabled="@_isRunning"
                                                @onclick="() => SubmitClarificationAsync(opt)">
                                            @opt
                                        </button>
                                    }
                                </div>
                            }

                            <div class="cg-clarification-custom">
                                <label for="cg-clarification-input" class="visually-hidden">@Loc.T("spark.customResponseLabel")</label>
                                <input id="cg-clarification-input"
                                       type="text"
                                       class="cg-input"
                                       @bind="_clarificationCustomAnswer"
                                       placeholder="@Loc.T("spark.customResponsePlaceholder")"
                                       disabled="@_isRunning"
                                       @onkeyup="OnClarificationInputKeyUp" />
                                <button type="button"
                                        class="cg-btn cg-btn-primary cg-btn-sm"
                                        disabled="@(string.IsNullOrWhiteSpace(_clarificationCustomAnswer) || _isRunning)"
                                        @onclick="() => SubmitClarificationAsync(_clarificationCustomAnswer)">
                                    @Loc.T("spark.submitLabel")
                                </button>
                            </div>
                        </div>
                    }

                    <!-- Step-by-Step Pending Execution Card -->
                    @if (_stepByStepMode && !_isRunning && _lastResult != null && !_lastResult.IsCompleted && !_awaitingClarification)
                    {
                        <div class="cg-step-interactive-prompt">
                            <div class="cg-interactive-prompt-header">
                                <span class="mono" style="font-weight: 600; color: var(--accent-ai-light);">@Loc.T("spark.stepPausedTitle")</span>
                                <span class="mono cg-text-xs">@Loc.T("spark.turnComplete")</span>
                            </div>
                            <p class="cg-interactive-prompt-desc">
                                @Loc.T("spark.stepPausedDesc")
                            </p>
                            <div class="cg-interactive-prompt-actions">
                                <button type="button"
                                        class="cg-btn cg-btn-ai cg-btn-sm"
                                        @onclick="ExecuteNextStepAsync">
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <polygon points="5 3 19 12 5 21 5 3"></polygon>
                                    </svg>
                                    <span>@Loc.T("spark.executeNext")</span>
                                </button>
                                <button type="button"
                                        class="cg-btn cg-btn-ghost cg-btn-sm"
                                        @onclick="CancelStepAsync">
                                    <span>@Loc.T("spark.cancelSession")</span>
                                </button>
                            </div>
                        </div>
                    }

                    <!-- Live Running Indicator -->
                    @if (_isRunning && !_awaitingClarification)
                    {
                        <div class="cg-running-indicator">
                            <span class="cg-spark-pulse-dot" aria-hidden="true"></span>
                            <span class="mono" style="font-size: 0.75rem; color: var(--accent-ai-light);">@Loc.T("spark.runningHint")</span>
                        </div>
                    }
                </div>
            }
        </div>

        <!-- Custom Image Studio Panel (Collapsible) -->
        @if (_isImageStudioOpen)
        {
            <div class="cg-voice-tray">
                <div class="cg-voice-tray-header">
                    <div style="display: flex; align-items: center; gap: 0.45rem;">
                        <span class="cg-spark-badge-pill">muse-image-1.0</span>
                        <strong style="font-size: 0.78rem;">@StatusTextOrFallback("image.studioTitle", "Custom Visual & Info Generator (640×400 PNG)")</strong>
                    </div>
                    <button type="button" class="cg-btn-icon-xs" @onclick="ToggleImageStudio" aria-label="@Loc.T("spark.closeAria")">✕</button>
                </div>
                <p style="font-size: 0.72rem; color: var(--text-secondary); margin: 0 0 0.45rem 0;">
                    @StatusTextOrFallback("image.studioDesc", "Render specific property notices, emergency instructions, or inspection details directly onto a 640×400 PNG visual.")
                </p>
                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.4rem; margin-bottom: 0.4rem;">
                    <input type="text"
                           class="cg-input"
                           style="font-size: 0.76rem; padding: 0.35rem 0.5rem;"
                           placeholder="@StatusTextOrFallback("image.titlePlaceholder", "Image headline / title")"
                           @bind="_customImageTitle" />
                    <input type="text"
                           class="cg-input"
                           style="font-size: 0.76rem; padding: 0.35rem 0.5rem;"
                           placeholder="@StatusTextOrFallback("image.subtitlePlaceholder", "Subtitle / building or stairwell")"
                           @bind="_customImageSubtitle" />
                </div>
                <textarea class="cg-input"
                          rows="2"
                          style="font-size: 0.75rem; padding: 0.35rem 0.5rem; margin-bottom: 0.4rem; width: 100%;"
                          placeholder="@StatusTextOrFallback("image.linesPlaceholder", "Specific info lines to render on the image (separate with new line or semicolon ';')")"
                          @bind="_customImageLinesRaw"></textarea>
                <div style="display: flex; justify-content: space-between; align-items: center; gap: 0.5rem;">
                    <input type="text"
                           class="cg-input"
                           style="font-size: 0.74rem; padding: 0.3rem 0.5rem; flex: 1;"
                           placeholder="@StatusTextOrFallback("image.qrPlaceholder", "Optional QR link (e.g. https://commonground.local/notice)")"
                           @bind="_customImageQrUrl" />
                    <button type="button"
                            class="cg-btn cg-btn-ai cg-btn-xs"
                            disabled="@_isGeneratingCustomImage"
                            @onclick="GenerateCustomImageInChatAsync">
                        @(_isGeneratingCustomImage
                            ? StatusTextOrFallback("image.generatingBtn", "Rendering muse-image-1.0...")
                            : StatusTextOrFallback("image.generateBtn", "Generate Image with Info"))
                    </button>
                </div>
            </div>
        }

        <!-- Voice Note Recording Panel (Collapsible — Live WAV Recording + POST /v1/asr/transcribe) -->
        @if (_isVoicePanelOpen)
        {
            <div class="cg-voice-tray">
                <div class="cg-voice-tray-header">
                    <div style="display: flex; align-items: center; gap: 0.45rem;">
                        <span class="cg-voice-mic-pulse" aria-hidden="true"></span>
                        <strong style="font-size: 0.78rem;">@Loc.T("spark.voiceStreamTitle")</strong>
                        <span class="cg-spark-badge-pill">muse-voice-transcribe-1.0</span>
                    </div>
                    <button type="button" class="cg-btn-icon-xs" @onclick="ToggleVoicePanel" aria-label="@Loc.T("spark.voiceCloseAria")">✕</button>
                </div>
                <p style="font-size: 0.72rem; color: var(--text-secondary); margin: 0 0 0.45rem 0;">
                    @Loc.T("spark.voiceHint")
                </p>

                <!-- Live Browser Microphone WAV Recorder (16kHz PCM WAV -> POST /v1/asr/transcribe) -->
                <div style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.5rem; flex-wrap: wrap;">
                    @if (!_isRecordingMic)
                    {
                        <button type="button"
                                class="cg-btn cg-btn-xs cg-btn-ai"
                                disabled="@_isTranscribingVoice"
                                @onclick="StartLiveMicrophoneRecordingAsync">
                            🎙 @StatusTextOrFallback("mic.startRecording", "Record Microphone (WAV)")
                        </button>
                    }
                    else
                    {
                        <button type="button"
                                class="cg-btn cg-btn-xs cg-btn-primary"
                                style="background: var(--color-danger); border-color: var(--color-danger);"
                                @onclick="StopAndTranscribeMicrophoneAsync">
                            ⏹ @StatusTextOrFallback("mic.stopAndTranscribe", "Stop & Transcribe") (@($"{_recordingElapsedSec:0.0}s"))
                        </button>
                        <div style="flex: 1; min-width: 90px; height: 6px; background: var(--bg-elevated); border-radius: 999px; overflow: hidden;">
                            <div style="height: 100%; width: @($"{Math.Clamp(_recordingRmsLevel, 4, 100)}%"); background: var(--accent-primary); transition: width 0.15s ease;"></div>
                        </div>
                    }
                </div>

                @if (!string.IsNullOrWhiteSpace(_liveInterimTranscript))
                {
                    <div class="mono cg-text-xs" style="color: var(--text-secondary); margin-bottom: 0.4rem;">
                        @StatusTextOrFallback("mic.livePreview", "Live speech preview:") "@_liveInterimTranscript"
                    </div>
                }

                <div class="cg-voice-presets-row">
                    <button type="button"
                            class="cg-btn cg-btn-xs cg-btn-outline"
                            disabled="@(_isTranscribingVoice || _isRecordingMic)"
                            @onclick='() => TranscribeVoicePresetAsync("Ceiling Leak", "There is a water leak on the ceiling in my bathroom, the stain is growing since yesterday.")'>
                        @Loc.T("spark.presetCeilingLeak")
