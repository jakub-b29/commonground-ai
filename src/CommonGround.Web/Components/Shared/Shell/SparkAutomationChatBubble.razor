    private string? _voiceStatusMessage;

    // Custom Image Studio state
    private bool _isImageStudioOpen;
    private bool _isGeneratingCustomImage;
    private string _customImageTitle = "Building Inspection & Notice";
    private string _customImageSubtitle = "Stairwell A • Riser STACK-A1";
    private string _customImageLinesRaw = "Shutoff Valve V-A1-01 verified\nContractor access code: #9021*\nEmergency 24/7 dispatch active";
    private string _customImageQrUrl = "https://commonground.local/notice";

    protected override async Task OnInitializedAsync()
    {
        _dotNetRef = DotNetObjectReference.Create(this);
        _stateHandler = () => InvokeAsync(StateHasChanged);
        UiState.OnChange += _stateHandler;
        _locHandler = () => InvokeAsync(StateHasChanged);
        Loc.OnChange += _locHandler;
        await Loc.EnsureLoadedAsync();
        _statusText = Loc.T("spark.status.ready");
        await EnsureFirmManagerRoleSyncAsync();
    }

    private async Task EnsureFirmManagerRoleSyncAsync()
    {
        try
        {
            var r = await Access.GetRoleAsync();
            var acc = await Access.GetAccountAsync();
            if (r == WorkspaceSecurityRole.FirmManager || acc?.Role == WorkspaceSecurityRole.FirmManager)
            {
                UiState.SetRole(WorkspaceSecurityRole.FirmManager);
            }
        }
        catch { }
    }

    private async Task OnOpenChat()
    {
        await EnsureFirmManagerRoleSyncAsync();
        UiState.SetSparkAgentChatOpen(true);
    }

    private void OnCloseChat()
    {
        UiState.SetSparkAgentChatOpen(false);
    }

    private string StatusTextOrFallback(string key, string englishFallback)
    {
        var value = Loc.T(key);
        return string.Equals(value, key, StringComparison.Ordinal) ? englishFallback : value;
    }

    private string StatusReady => StatusTextOrFallback("spark.status.ready", "Ready");
    private string StatusAnalyzing => StatusTextOrFallback("spark.status.analyzing", "Analyzing goal...");
    private string StatusThinking => StatusTextOrFallback("spark.status.thinking", "Thinking...");
    private string StatusVerifying => StatusTextOrFallback("spark.status.verifying", "Verifying Permission...");
    private string StatusRunningTool => StatusTextOrFallback("spark.status.runningTool", "Running Tool...");
    private string StatusObservation => StatusTextOrFallback("spark.status.observation", "Received Observation");
    private string StatusClarification => StatusTextOrFallback("spark.status.clarification", "Clarification Needed");
    private string StatusCompleted => StatusTextOrFallback("spark.status.completed", "Completed");
    private string StatusNeedsClarification => StatusTextOrFallback("spark.status.needsClarification", "Needs Clarification");
    private string StatusStepPaused => StatusTextOrFallback("spark.status.stepPaused", "Step Paused");
    private string StatusCancelled => StatusTextOrFallback("spark.status.cancelled", "Cancelled");
    private string StatusCancelledByOperator => StatusTextOrFallback("spark.status.cancelledByOperator", "Cancelled by Operator");
    private string StatusError => StatusTextOrFallback("spark.status.error", "Error");

    private void OnToggleExpanded()
    {
        UiState.ToggleSparkAgentExpanded();
    }

    private void SetStepByStepMode(bool isStepByStep)
    {
        _stepByStepMode = isStepByStep;
        StateHasChanged();
    }

    private void ToggleVoicePanel()
    {
        _isVoicePanelOpen = !_isVoicePanelOpen;
        if (_isVoicePanelOpen)
        {
            _isImageStudioOpen = false;
        }
        _voiceStatusMessage = null;
    }

    private void ToggleImageStudio()
    {
        _isImageStudioOpen = !_isImageStudioOpen;
        if (_isImageStudioOpen)
        {
            _isVoicePanelOpen = false;
        }
