    private string ResolveRecipeTitle(RecipeItem recipe) => RecipeTitle(recipe.TitleKey, recipe.TitleFallback);

    private string ResolveRecipeGoal(RecipeItem recipe) => RecipeGoal(recipe.GoalKey, recipe.GoalFallback);

    public void Dispose()
    {
        if (_stateHandler is not null)
        {
            UiState.OnChange -= _stateHandler;
        }
        if (_locHandler is not null)
        {
            Loc.OnChange -= _locHandler;
        }
        _dotNetRef?.Dispose();
        _cts.Cancel();
        _cts.Dispose();
    }
