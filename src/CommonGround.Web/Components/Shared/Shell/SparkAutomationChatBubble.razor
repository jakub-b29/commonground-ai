    private string RecipeTitle(string key, string fallback)
    {
        var value = Loc.T(key);
        return string.Equals(value, key, StringComparison.Ordinal) ? fallback : value;
    }

    private string RecipeGoal(string key, string fallback)
    {
        var value = Loc.T(key);
        return string.Equals(value, key, StringComparison.Ordinal) ? fallback : value;
    }

