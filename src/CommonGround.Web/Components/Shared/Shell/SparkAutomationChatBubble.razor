    private async Task StartLiveMicrophoneRecordingAsync()
    {
        _voiceStatusMessage = StatusTextOrFallback("mic.requestingAccess", "Requesting microphone access (16kHz PCM WAV)...");
        _recordingElapsedSec = 0;
        _recordingRmsLevel = 0;
        _liveInterimTranscript = string.Empty;
        StateHasChanged();

        try
        {
            var startRes = await JS.InvokeAsync<JsVoiceStartResult>("cgVoiceRecorder.startRecording", _dotNetRef, Loc.ActiveLocale);
            if (startRes.Ok)
            {
                _isRecordingMic = true;
                _voiceStatusMessage = StatusTextOrFallback("mic.recordingActive", "Recording live WAV audio... Speak now and click Stop & Transcribe.");
            }
            else
            {
                _isRecordingMic = false;
                _voiceStatusMessage = startRes.ErrorMessage ?? StatusTextOrFallback("mic.errorStart", "Could not start microphone.");
            }
        }
        catch (Exception ex)
        {
            _isRecordingMic = false;
            _voiceStatusMessage = string.Format(StatusTextOrFallback("spark.voiceError", "Voice error: {0}"), ex.Message);
        }
        StateHasChanged();
    }

    private async Task StopAndTranscribeMicrophoneAsync()
    {
        if (!_isRecordingMic)
        {
            return;
        }

        _isRecordingMic = false;
        _isTranscribingVoice = true;
        _voiceStatusMessage = StatusTextOrFallback("mic.uploadingWav", "Encoding 16-bit PCM WAV & sending multipart/form-data to POST /v1/asr/transcribe (muse-voice-transcribe-1.0)...");
        StateHasChanged();

        try
        {
            var stopRes = await JS.InvokeAsync<JsVoiceStopResult>("cgVoiceRecorder.stopRecording");
            if (!stopRes.Ok || string.IsNullOrWhiteSpace(stopRes.WavBase64))
            {
                _voiceStatusMessage = stopRes.ErrorMessage ?? StatusTextOrFallback("mic.noAudioCaptured", "No audio captured from microphone.");
                return;
            }

            var (transcript, detectedLang, latencyMs) = await Workspace.TranscribeLiveMicrophoneAudioAsync(
                UiState.SelectedCommunityId,
                stopRes.WavBase64,
                stopRes.LiveTranscript,
                Loc.ActiveLocale,
                _cts.Token);

            _inputGoal = transcript;
            _voiceStatusMessage = string.Format(
                StatusTextOrFallback("spark.voiceTranscribed", "Transcribed ({0} KB WAV): \"{1}\" ({2}, {3}ms)"),
                Math.Max(1, stopRes.ByteLength / 1024),
                transcript,
                detectedLang,
                latencyMs);
        }
        catch (Exception ex)
        {
            _voiceStatusMessage = string.Format(StatusTextOrFallback("spark.voiceError", "Voice error: {0}"), ex.Message);
        }
        finally
        {
            _isTranscribingVoice = false;
            StateHasChanged();
        }
    }

