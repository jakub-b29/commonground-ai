@inject WorkspaceUiState UiState
@inject WorkspaceLocalization Loc
@inject WorkspaceAccessService Access
@inject CommonGroundWorkspaceService Workspace
@implements IDisposable

@if (UiState.IsPortfolioQueryOpen)
{
    <aside class="cg-card cg-drawer" style="position: fixed; inset-inline-end: 1rem; inset-block-start: 4.5rem; width: min(28rem, 92vw); max-height: 80dvh; overflow-y: auto; z-index: 900;" role="dialog" aria-label="@Loc.T("shell.portfolioQuery")">
        <div class="cg-section-header">
            <h2>@Loc.T("shell.portfolioQuery")</h2>
            <button type="button" class="cg-btn" @onclick="OnClose">@Loc.T("action.close")</button>
        </div>
        <p style="color: var(--color-text-secondary); font-size: 0.78125rem;">@Loc.T("shell.queryHint")</p>
        <label for="portfolio-question">@Loc.T("form.question")</label>
        <textarea id="portfolio-question" @bind="_question" rows="3" placeholder="@Loc.T("shell.queryPlaceholder")"></textarea>
        <div class="cg-toolbar">
            <button type="button" class="cg-btn cg-btn-primary" disabled="@(_isBusy || UiState.SelectedCommunityId is null)" @onclick="OnAsk">@Loc.T("action.runQuery")</button>
        </div>
        @if (!string.IsNullOrWhiteSpace(_answer))
        {
            <div role="status" aria-live="polite" class="cg-callout" style="margin-block-start: 0.625rem; white-space: pre-wrap;">@_answer</div>
        }
    </aside>
}

@code {
    private Action? _stateHandler;
    private Action? _locHandler;
    private string _question = string.Empty;
    private string _answer = string.Empty;
    private bool _isBusy;

    protected override async Task OnInitializedAsync()
    {
        _stateHandler = () => InvokeAsync(StateHasChanged);
        UiState.OnChange += _stateHandler;
        _locHandler = () => InvokeAsync(StateHasChanged);
        Loc.OnChange += _locHandler;
        await Loc.EnsureLoadedAsync();
    }

    private async Task OnAsk()
    {
        if (UiState.SelectedCommunityId is null || string.IsNullOrWhiteSpace(_question))
        {
            return;
        }
        if (!await Access.CanAccessCommunityAsync(UiState.SelectedCommunityId.Value))
        {
            _answer = "Access to this property is denied for the current account.";
            return;
        }
        _isBusy = true;
        try
        {
            _answer = await Workspace.AskPortfolioCopilotAsync(UiState.SelectedCommunityId.Value, _question);
        }
        catch (Exception ex)
        {
            _answer = $"Query failed: {ex.Message}";
        }
        finally
        {
            _isBusy = false;
        }
    }

    private void OnClose()
    {
        UiState.TogglePortfolioQuery();
    }

    public void Dispose()
    {
        if (_stateHandler is not null)
        {
            UiState.OnChange -= _stateHandler;
        }
        if (_locHandler is not null)
        {
            Loc.OnChange -= _locHandler;
        }
    }
}
