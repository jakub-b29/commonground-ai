@inject WorkspaceUiState UiState
@inject WorkspaceLocalization Loc
@inject WorkspaceAccessService Access
@inject CommonGroundWorkspaceService Workspace
@implements IDisposable

@if (UiState.IsPortfolioQueryOpen)
{
    <div class="cg-drawer-backdrop" @onclick="OnClose">
        <aside class="cg-drawer" role="dialog" aria-label="@Loc.T("shell.portfolioQuery")" @onclick:stopPropagation="true">
            <div class="bento-card-header" style="background: var(--accent-ai-subtle); border-bottom: 1px solid var(--accent-ai-border); padding: 1rem 1.25rem;">
                <div>
                    <div style="display: flex; align-items: center; gap: 0.5rem;">
                        <span class="ai-dot" aria-hidden="true"></span>
                        <h2 style="font-size: 1rem; font-weight: 600;">@Loc.T("shell.portfolioQuery")</h2>
                        <AIBadge Label="CommonGround Assistant" Model="muse-spark-1.3" ShowPulseDot="false" />
                    </div>
                    <p style="color: var(--text-secondary); font-size: 0.76rem; margin-top: 0.25rem;">@Loc.T("shell.queryHint")</p>
                </div>
                <button type="button" class="cg-btn cg-btn-sm" @onclick="OnClose">@Loc.T("action.close")</button>
            </div>

            <div style="padding: 1.25rem; flex: 1; overflow-y: auto; display: flex; flex-direction: column; gap: 1rem;">
                <div style="display: flex; flex-wrap: wrap; gap: 0.35rem;">
                    <button type="button" class="cg-btn cg-btn-sm cg-btn-ai" @onclick='() => SetPreset(Loc.T("assistant.presetWorkOrders"))'>@Loc.T("assistant.presetWorkOrdersLabel")</button>
                    <button type="button" class="cg-btn cg-btn-sm cg-btn-ai" @onclick='() => SetPreset(Loc.T("assistant.presetReserve"))'>@Loc.T("assistant.presetReserveLabel")</button>
                    <button type="button" class="cg-btn cg-btn-sm cg-btn-ai" @onclick='() => SetPreset(Loc.T("assistant.presetQuorum"))'>@Loc.T("assistant.presetQuorumLabel")</button>
                </div>

                <div class="cg-form-stack">
                    <label for="portfolio-question">@Loc.T("form.question")</label>
                    <textarea id="portfolio-question" @bind="_question" rows="4" placeholder="@Loc.T("shell.queryPlaceholder")"></textarea>
                    <div class="cg-toolbar" style="justify-content: space-between;">
                        <span style="font-size: 0.72rem; color: var(--text-muted);">@Loc.T("assistant.piiNote")</span>
                        <button type="button" class="cg-btn cg-btn-primary" disabled="@(_isBusy || UiState.SelectedCommunityId is null)" @onclick="OnAsk">
                            @(_isBusy ? Loc.T("assistant.analyzing") : Loc.T("action.runQuery"))
                        </button>
                    </div>
                </div>

                @if (!string.IsNullOrWhiteSpace(_answer))
                {
                    <div role="status" aria-live="polite" class="ai-callout" style="white-space: pre-wrap; line-height: 1.55;">
                        <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 0.45rem; padding-bottom: 0.4rem; border-bottom: 1px solid var(--accent-ai-border);">
                            <strong style="font-size: 0.76rem; color: var(--accent-ai-light);">@Loc.T("assistant.synthesis")</strong>
                            <span class="mono" style="font-size: 0.7rem; color: var(--text-muted);">muse-spark-1.3 · @Loc.T("assistant.grounded")</span>
                        </div>
                        @_answer
                    </div>
                }
            </div>
        </aside>
    </div>
}

@code {
    private Action? _stateHandler;
    private Action? _locHandler;
    private string _question = string.Empty;
    private string _answer = string.Empty;
    private bool _isBusy;

    protected override async Task OnInitializedAsync()
    {
        _stateHandler = () => InvokeAsync(StateHasChanged);
        UiState.OnChange += _stateHandler;
        _locHandler = () => InvokeAsync(StateHasChanged);
        Loc.OnChange += _locHandler;
        await Loc.EnsureLoadedAsync();
    }

    private void SetPreset(string prompt)
    {
        _question = prompt;
    }

    private async Task OnAsk()
    {
        if (UiState.SelectedCommunityId is null || string.IsNullOrWhiteSpace(_question))
        {
            return;
        }
        if (!await Access.CanAccessCommunityAsync(UiState.SelectedCommunityId.Value))
        {
            _answer = Loc.T("assistant.accessDenied");
            return;
        }
        _isBusy = true;
        try
        {
            _answer = await Workspace.AskPortfolioAssistantAsync(UiState.SelectedCommunityId.Value, _question, default, Loc.ActiveLocale);
        }
        catch (Exception ex)
        {
            _answer = string.Format(System.Globalization.CultureInfo.InvariantCulture, Loc.T("assistant.queryFailedFmt"), ex.Message);
        }
        finally
        {
            _isBusy = false;
        }
    }

    private void OnClose()
    {
        UiState.TogglePortfolioQuery();
    }

    public void Dispose()
    {
        if (_stateHandler is not null)
        {
            UiState.OnChange -= _stateHandler;
        }
        if (_locHandler is not null)
        {
            Loc.OnChange -= _locHandler;
        }
    }
}
