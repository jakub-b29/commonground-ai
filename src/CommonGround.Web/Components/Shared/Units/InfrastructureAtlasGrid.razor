@using CommonGround.Domain.Calculators
@inject CommonGroundWorkspaceService Workspace
@inject WorkspaceUiState UiState
@inject WorkspaceLocalization Loc
@implements IDisposable

<div class="cg-card">
    <div class="cg-section-header">
        <h2>@Loc.T("panel.atlas")</h2>
        <span class="cg-badge">@Photos.Count @Loc.T("atlas.shutoffPoints")</span>
    </div>
    <div class="cg-grid-4">
        @foreach (var photo in Photos)
        {
            <div @key="photo.Id" class="cg-subcard" style="display: flex; flex-direction: column; justify-content: space-between;">
                <div>
                    <div style="display: flex; align-items: center; justify-content: space-between; gap: 0.35rem; margin-block-end: 0.25rem;">
                        <span class="cg-badge mono">@photo.Category</span>
                        <span class="cg-badge">@photo.RiserStackOrZone</span>
                    </div>
                    <strong style="font-size: 0.8125rem; display: block; margin-block-end: 0.2rem;">@photo.Title</strong>
                    <div style="font-size: 0.72rem; color: var(--color-text-secondary); margin-block-end: 0.45rem;">@photo.PhysicalLocationNote</div>
                    @if (!string.IsNullOrWhiteSpace(photo.SamAnnotatedDataUrl))
                    {
                        <img class="cg-photo-frame" src="@photo.SamAnnotatedDataUrl" alt="SAM overlay @photo.Title" style="max-height: 145px;" />
                    }
                    else if (!string.IsNullOrWhiteSpace(photo.ImageDataUrl))
                    {
                        <img class="cg-photo-frame" src="@photo.ImageDataUrl" alt="@photo.Title" style="max-height: 145px;" />
                    }
                </div>
                <div style="font-size: 0.75rem; color: var(--color-text-primary); margin-block-start: 0.5rem; padding-block-start: 0.45rem; border-block-start: 1px solid var(--color-border-subtle);">
                    @photo.ShutoffInstructions
                </div>
            </div>
        }
    </div>

    <h3>@Loc.T("panel.accessVault")</h3>
    <div class="cg-table-wrap">
        <table class="cg-table">
            <thead>
                <tr>
                    <th>@Loc.T("atlas.target")</th>
                    <th>@Loc.T("atlas.permanent")</th>
                    <th>@Loc.T("atlas.temporary")</th>
                    <th>@Loc.T("atlas.vaultAction")</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var access in AccessCodes)
                {
                    var revealed = UiState.RevealedAccessCodeIds.Contains(access.Id);
                    <tr @key="access.Id">
                        <td>
                            <strong>@access.TargetArea</strong>
                            <div style="font-size: 0.72rem; color: var(--color-text-secondary);">@access.KeySafeLocation</div>
                        </td>
                        <td class="mono">
                            <span class="cg-badge @(revealed ? "cg-badge-warn" : "")">
                                @(revealed ? access.ResidentCode : DataSecurityAndPrivacyGuard.MaskSecretForRole(access.ResidentCode, UiState.ActiveSecurityRole, false))
                            </span>
                        </td>
                        <td class="mono">@access.ContractorOrCourierCode</td>
                        <td>
                            <button type="button" class="cg-btn" disabled="@_isBusy" @onclick="() => OnRevealAsync(access.Id)">@Loc.T("action.reveal")</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    @if (!string.IsNullOrWhiteSpace(_message))
    {
        <div role="status" aria-live="polite" class="cg-callout">@_message</div>
    }
</div>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<InfrastructurePhoto> Photos { get; set; } = [];
    [Parameter, EditorRequired] public IReadOnlyList<BuildingAccessCode> AccessCodes { get; set; } = [];
    [Parameter, EditorRequired] public Guid CommunityId { get; set; }
    private bool _isBusy;
    private string _message = string.Empty;
    private Action? _locHandler;

    protected override async Task OnInitializedAsync()
    {
        _locHandler = () => InvokeAsync(StateHasChanged);
        Loc.OnChange += _locHandler;
        await Loc.EnsureLoadedAsync();
    }

    private async Task OnRevealAsync(Guid id)
    {
        _isBusy = true;
        try
        {
            var code = await Workspace.RevealVaultedAccessCodeAsync(CommunityId, id, UiState.ActiveSecurityRole);
            UiState.RevealedAccessCodeIds.Add(id);
            UiState.Announce(Loc.T("msg.vaultRevealed"));
            _message = $"{Loc.T("msg.vaultRevealed")}: {code}.";
        }
        catch (Exception ex) { _message = $"{Loc.T("msg.revealDenied")} {ex.Message}"; }
        finally { _isBusy = false; }
    }

    public void Dispose()
    {
        if (_locHandler is not null)
        {
            Loc.OnChange -= _locHandler;
        }
    }
}
