@using CommonGround.Domain.Calculators
@inject CommonGroundWorkspaceService Workspace
@inject WorkspaceUiState UiState
<div class="cg-card" style="margin-top: 0.875rem;">
    <h2>Infrastructure atlas and access vault</h2>
    <div class="cg-grid-2">
        @foreach (var photo in Photos)
        {
            <div @key="photo.Id" class="cg-card">
                <div><strong>@photo.Title</strong></div>
                <div style="font-size: 0.75rem; color: var(--color-text-secondary);">@photo.Category · @photo.RiserStackOrZone · @photo.PhysicalLocationNote</div>
                @if (!string.IsNullOrWhiteSpace(photo.ImageDataUrl))
                {
                    <img class="cg-photo-frame" src="@photo.ImageDataUrl" alt="@photo.Title" style="margin-top: 0.375rem;" />
                }
                @if (!string.IsNullOrWhiteSpace(photo.SamAnnotatedDataUrl))
                {
                    <img class="cg-photo-frame" src="@photo.SamAnnotatedDataUrl" alt="SAM overlay @photo.Title" style="margin-top: 0.375rem;" />
                }
                <div style="font-size: 0.8rem; margin-top: 0.375rem;">@photo.ShutoffInstructions</div>
            </div>
        }
    </div>
    <h3 style="margin-top: 0.75rem;">Building access code vault</h3>
    <div class="cg-table-wrap"><table class="cg-table"><thead><tr><th>Area</th><th>Resident code</th><th>Contractor code</th><th>Action</th></tr></thead><tbody>
        @foreach (var access in AccessCodes)
        {
            var revealed = UiState.RevealedAccessCodeIds.Contains(access.Id);
            <tr @key="access.Id">
                <td>@access.TargetArea (@access.KeySafeLocation)</td>
                <td class="mono">@(revealed ? access.ResidentCode : DataSecurityAndPrivacyGuard.MaskSecretForRole(access.ResidentCode, UiState.ActiveSecurityRole, false))</td>
                <td class="mono">@access.ContractorOrCourierCode</td>
                <td><button type="button" class="cg-btn" disabled="@_isBusy" @onclick="() => OnRevealAsync(access.Id)">Reveal secret (logged)</button></td>
            </tr>
        }
    </tbody></table></div>
    @if (!string.IsNullOrWhiteSpace(_message)) { <div role="status" aria-live="polite">@_message</div> }
</div>
@code {
    [Parameter, EditorRequired] public IReadOnlyList<InfrastructurePhoto> Photos { get; set; } = [];
    [Parameter, EditorRequired] public IReadOnlyList<BuildingAccessCode> AccessCodes { get; set; } = [];
    [Parameter, EditorRequired] public Guid CommunityId { get; set; }
    private bool _isBusy;
    private string _message = string.Empty;
    private async Task OnRevealAsync(Guid id)
    {
        _isBusy = true;
        try
        {
            var code = await Workspace.RevealVaultedAccessCodeAsync(CommunityId, id, UiState.ActiveSecurityRole);
            UiState.RevealedAccessCodeIds.Add(id);
            UiState.Announce($"Vaulted code revealed for audit.");
            _message = $"Revealed code: {code}. Logged in SHA-256 audit chain.";
        }
        catch (Exception ex) { _message = $"Reveal denied: {ex.Message}"; }
        finally { _isBusy = false; }
    }
}
