@using CommonGround.Domain.Calculators
@using CommonGround.Domain.Entities
@inject CommonGroundWorkspaceService Workspace
@inject WorkspaceAccessService Access
@inject WorkspaceLocalization Loc
@implements IDisposable

@if (Unit is null)
{
    <div class="cg-card"><p>@Loc.T("msg.selectUnit")</p></div>
}
else
{
    <div class="cg-card">
        <div class="cg-section-header">
            <h2>@Loc.T("panel.unitDossier") – @Unit.UnitNumber</h2>
            <div style="display: flex; gap: 0.375rem;">
                <span class="cg-badge mono">@Unit.VerticalStackCode</span>
                <span class="cg-badge @(Unit.CurrentBalance > 0 ? "cg-badge-warn" : "cg-badge-ok")">@Unit.ArrearsStage</span>
            </div>
        </div>

        <div class="cg-grid-2">
            <div>
                <h3 style="margin-block-start: 0 !important;">@Loc.T("unit.ownershipTitle")</h3>
                <div class="cg-table-wrap">
                    <table class="cg-table">
                        <tbody>
                            <tr><td>@Loc.T("unit.primaryOwner")</td><td><strong>@Unit.PrimaryOwnerName</strong> (@Unit.PreferredLanguage)</td></tr>
                            <tr><td>@Loc.T("unit.floorStorage")</td><td class="num">@Unit.FloorAreaM2.ToString("N2") m² / @Unit.StorageAreaM2.ToString("N2") m²</td></tr>
                            <tr><td>@Loc.T("unit.share")</td><td class="num">@Unit.ShareNumerator / @Unit.ShareDenominator = @Unit.OwnershipShare.ToString("P2")</td></tr>
                            <tr><td>@Loc.T("unit.occupantsStr")</td><td>@Unit.DeclaredOccupants / @(Unit.IsShortTermRental ? Loc.T("unit.strYes") : Loc.T("unit.strNo"))</td></tr>
                            <tr><td>@Loc.T("unit.iban")</td><td class="mono">@DataSecurityAndPrivacyGuard.MaskIban(Unit.VirtualIbanOrLockboxCode, _role, false)</td></tr>
                            <tr><td>@Loc.T("unit.contact")</td><td>@DataSecurityAndPrivacyGuard.MaskContactPii(Unit.PrimaryOwnerEmail, _role) · @DataSecurityAndPrivacyGuard.MaskContactPii(Unit.PrimaryOwnerPhone, _role)</td></tr>
                            <tr><td>@Loc.T("unit.balanceDue")</td><td class="num"><strong>@Unit.CurrentBalance.ToString("N2")</strong> (@Unit.DaysPastDue d)</td></tr>
                        </tbody>
                    </table>
                </div>
            </div>

            <div>
                <h3 style="margin-block-start: 0 !important;">@Loc.T("unit.assessmentTitle")</h3>
                <div class="cg-table-wrap">
                    <table class="cg-table">
                        <thead>
                            <tr><th>@Loc.T("table.component")</th><th class="num">@Loc.T("table.amount") (@Community?.CurrencyCode)</th></tr>
                        </thead>
                        <tbody>
                            <tr><td>@Loc.T("assessment.operating")</td><td class="num">@_assessment?.OperatingFee.ToString("N2")</td></tr>
                            <tr><td>@Loc.T("assessment.repair")</td><td class="num">@_assessment?.RepairFundFee.ToString("N2")</td></tr>
                            <tr><td>@Loc.T("assessment.waste")</td><td class="num">@_assessment?.WasteFee.ToString("N2")</td></tr>
                            <tr><td>@Loc.T("assessment.cold")</td><td class="num">@_assessment?.ColdWaterAdvance.ToString("N2")</td></tr>
                            <tr><td>@Loc.T("assessment.hot")</td><td class="num">@_assessment?.HotWaterAdvance.ToString("N2")</td></tr>
                            <tr><td>@Loc.T("assessment.heating")</td><td class="num">@_assessment?.HeatingAdvance.ToString("N2")</td></tr>
                            <tr><td>@Loc.T("assessment.credit")</td><td class="num">-@_assessment?.CommercialRevenueCredit.ToString("N2")</td></tr>
                            <tr><td><strong>@Loc.T("assessment.total")</strong></td><td class="num"><strong>@_assessment?.TotalAssessment.ToString("N2")</strong></td></tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <h3>@Loc.T("unit.metersTitle")</h3>
        @if (Unit.Meters.Count == 0)
        {
            <p style="color: var(--color-text-secondary); font-size: 0.78125rem;">@Loc.T("msg.noMeters")</p>
        }
        else
        {
            <div class="cg-table-wrap">
                <table class="cg-table">
                    <thead>
                        <tr><th>@Loc.T("meter.kind")</th><th>@Loc.T("meter.serial")</th><th class="num">@Loc.T("meter.last")</th><th class="num">@Loc.T("meter.avg")</th><th>@Loc.T("meter.calibration")</th><th>@Loc.T("table.status")</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var m in Unit.Meters)
                        {
                            <tr @key="m.Id">
                                <td><strong>@m.Kind</strong></td>
                                <td class="mono">@m.SerialNumber</td>
                                <td class="num">@m.LastReadingValue.ToString("N3")</td>
                                <td class="num">@m.RollingMonthlyAverage.ToString("N2")</td>
                                <td class="num">@m.CalibrationExpiryDate.ToString("yyyy-MM-dd")</td>
                                <td>
                                    @if (m.HasSilentLeakAnomaly)
                                    {
                                        <span class="cg-badge cg-badge-err">@Loc.T("meter.leak")</span>
                                        <div style="font-size: 0.72rem; color: var(--status-err-fg); margin-block-start: 0.15rem;">@m.AnomalyNote</div>
                                    }
                                    else
                                    {
                                        <span class="cg-badge cg-badge-ok">@Loc.T("meter.normal")</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="cg-toolbar">
                <button type="button" class="cg-btn cg-btn-primary" disabled="@_isBusy" @onclick="OnReadMeter">@Loc.T("action.readMeter")</button>
            </div>
        }
        @if (!string.IsNullOrWhiteSpace(_message))
        {
            <div role="status" aria-live="polite" class="cg-callout">@_message</div>
        }
    </div>
}

@code {
    [Parameter] public Unit? Unit { get; set; }
    [Parameter] public Community? Community { get; set; }
    [Parameter] public EventCallback OnChanged { get; set; }
    private MonthlyAssessment? _assessment;
    private bool _isBusy;
    private string _message = string.Empty;
    private WorkspaceSecurityRole _role = WorkspaceSecurityRole.Resident;
    private Action? _locHandler;

    protected override async Task OnInitializedAsync()
    {
        _locHandler = () => InvokeAsync(StateHasChanged);
        Loc.OnChange += _locHandler;
        await Loc.EnsureLoadedAsync();
        try
        {
            _role = await Access.GetRoleAsync();
        }
        catch { }
    }

    protected override void OnParametersSet()
    {
        if (Unit is not null && Community is not null)
        {
            var credit = AncillaryRevenueEngine.CreditForUnit(Community.CommercialContracts, Unit);
            _assessment = AssessmentCalculator.Compute(Community, Unit, "2026-11", credit);
        }
    }

    private async Task OnReadMeter()
    {
        if (Unit is null || Community is null) return;
        var meter = Unit.Meters.FirstOrDefault();
        if (meter is null) return;
        _isBusy = true;
        try
        {
            var reading = await Workspace.SubmitPhotoOrVoiceMeterReadingAsync(Community.Id, meter.Id, meter.LastReadingValue + meter.RollingMonthlyAverage);
            _message = reading.IsAnomaly ? $"Silent leak suspected: {reading.AnomalyReason}" : $"Reading {reading.ReadingValue:N3} recorded. Consumption normal.";
            await OnChanged.InvokeAsync();
        }
        catch (Exception ex) { _message = $"{Loc.T("msg.verifyFailed")} {ex.Message}"; }
        finally { _isBusy = false; }
    }

    public void Dispose()
    {
        if (_locHandler is not null)
        {
            Loc.OnChange -= _locHandler;
        }
    }
}
