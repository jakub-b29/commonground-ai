@using CommonGround.Domain.Calculators
@using CommonGround.Domain.Entities
@inject CommonGroundWorkspaceService Workspace
@inject WorkspaceUiState UiState

@if (Unit is null)
{
    <div class="cg-card"><p>Select a unit in the riser grid to view its dossier.</p></div>
}
else
{
    <div class="cg-card">
        <div class="cg-section-header">
            <h2>Unit dossier – @Unit.UnitNumber</h2>
            <div style="display: flex; gap: 0.375rem;">
                <span class="cg-badge mono">@Unit.VerticalStackCode</span>
                <span class="cg-badge @(Unit.CurrentBalance > 0 ? "cg-badge-warn" : "cg-badge-ok")">@Unit.ArrearsStage</span>
            </div>
        </div>

        <div class="cg-grid-2">
            <div>
                <h3 style="margin-block-start: 0 !important;">Ownership & registry details</h3>
                <div class="cg-table-wrap">
                    <table class="cg-table">
                        <tbody>
                            <tr><td>Primary owner</td><td><strong>@Unit.PrimaryOwnerName</strong> (@Unit.PreferredLanguage)</td></tr>
                            <tr><td>Floor / storage area</td><td class="num">@Unit.FloorAreaM2.ToString("N2") m² / @Unit.StorageAreaM2.ToString("N2") m²</td></tr>
                            <tr><td>Ownership share</td><td class="num">@Unit.ShareNumerator / @Unit.ShareDenominator = @Unit.OwnershipShare.ToString("P2")</td></tr>
                            <tr><td>Occupants / STR</td><td>@Unit.DeclaredOccupants / @(Unit.IsShortTermRental ? "Yes (1.5× waste)" : "No")</td></tr>
                            <tr><td>Virtual IBAN / lockbox</td><td class="mono">@DataSecurityAndPrivacyGuard.MaskIban(Unit.VirtualIbanOrLockboxCode, UiState.ActiveSecurityRole, false)</td></tr>
                            <tr><td>Owner contact</td><td>@DataSecurityAndPrivacyGuard.MaskContactPii(Unit.PrimaryOwnerEmail, UiState.ActiveSecurityRole) · @DataSecurityAndPrivacyGuard.MaskContactPii(Unit.PrimaryOwnerPhone, UiState.ActiveSecurityRole)</td></tr>
                            <tr><td>Balance / past due</td><td class="num"><strong>@Unit.CurrentBalance.ToString("N2")</strong> (@Unit.DaysPastDue d)</td></tr>
                        </tbody>
                    </table>
                </div>
            </div>

            <div>
                <h3 style="margin-block-start: 0 !important;">Monthly assessment breakdown</h3>
                <div class="cg-table-wrap">
                    <table class="cg-table">
                        <thead>
                            <tr><th>Component</th><th class="num">Amount (@Community?.CurrencyCode)</th></tr>
                        </thead>
                        <tbody>
                            <tr><td>Operating fee</td><td class="num">@_assessment?.OperatingFee.ToString("N2")</td></tr>
                            <tr><td>Repair fund fee</td><td class="num">@_assessment?.RepairFundFee.ToString("N2")</td></tr>
                            <tr><td>Waste fee</td><td class="num">@_assessment?.WasteFee.ToString("N2")</td></tr>
                            <tr><td>Cold water advance</td><td class="num">@_assessment?.ColdWaterAdvance.ToString("N2")</td></tr>
                            <tr><td>Hot water advance</td><td class="num">@_assessment?.HotWaterAdvance.ToString("N2")</td></tr>
                            <tr><td>Heating advance</td><td class="num">@_assessment?.HeatingAdvance.ToString("N2")</td></tr>
                            <tr><td>Commercial offset credit</td><td class="num">-@_assessment?.CommercialRevenueCredit.ToString("N2")</td></tr>
                            <tr><td><strong>Total assessment</strong></td><td class="num"><strong>@_assessment?.TotalAssessment.ToString("N2")</strong></td></tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <h3>Sub-meters & silent leak telemetry</h3>
        @if (Unit.Meters.Count == 0)
        {
            <p style="color: var(--color-text-secondary); font-size: 0.78125rem;">No individual sub-meters assigned to this premise.</p>
        }
        else
        {
            <div class="cg-table-wrap">
                <table class="cg-table">
                    <thead>
                        <tr><th>Kind</th><th>Serial</th><th class="num">Last reading</th><th class="num">Rolling avg</th><th>Calibration</th><th>Status</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var m in Unit.Meters)
                        {
                            <tr @key="m.Id">
                                <td><strong>@m.Kind</strong></td>
                                <td class="mono">@m.SerialNumber</td>
                                <td class="num">@m.LastReadingValue.ToString("N3")</td>
                                <td class="num">@m.RollingMonthlyAverage.ToString("N2")</td>
                                <td class="num">@m.CalibrationExpiryDate.ToString("yyyy-MM-dd")</td>
                                <td>
                                    @if (m.HasSilentLeakAnomaly)
                                    {
                                        <span class="cg-badge cg-badge-err">Silent leak spike</span>
                                        <div style="font-size: 0.72rem; color: var(--status-err-fg); margin-block-start: 0.15rem;">@m.AnomalyNote</div>
                                    }
                                    else
                                    {
                                        <span class="cg-badge cg-badge-ok">Normal</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="cg-toolbar">
                <button type="button" class="cg-btn cg-btn-primary" disabled="@_isBusy" @onclick="OnReadMeter">Read meter from resident photo</button>
            </div>
        }
        @if (!string.IsNullOrWhiteSpace(_message))
        {
            <div role="status" aria-live="polite" class="cg-callout">@_message</div>
        }
    </div>
}

@code {
    [Parameter] public Unit? Unit { get; set; }
    [Parameter] public Community? Community { get; set; }
    [Parameter] public EventCallback OnChanged { get; set; }
    private MonthlyAssessment? _assessment;
    private bool _isBusy;
    private string _message = string.Empty;

    protected override void OnParametersSet()
    {
        if (Unit is not null && Community is not null)
        {
            var credit = AncillaryRevenueEngine.CreditForUnit(Community.CommercialContracts, Unit);
            _assessment = AssessmentCalculator.Compute(Community, Unit, "2026-11", credit);
        }
    }

    private async Task OnReadMeter()
    {
        if (Unit is null || Community is null) return;
        var meter = Unit.Meters.FirstOrDefault();
        if (meter is null) return;
        _isBusy = true;
        try
        {
            var reading = await Workspace.SubmitPhotoOrVoiceMeterReadingAsync(Community.Id, meter.Id, meter.LastReadingValue + meter.RollingMonthlyAverage);
            _message = reading.IsAnomaly ? $"Silent leak suspected: {reading.AnomalyReason}" : $"Reading {reading.ReadingValue:N3} recorded. Consumption normal.";
            await OnChanged.InvokeAsync();
        }
        catch (Exception ex) { _message = $"Meter read failed: {ex.Message}"; }
        finally { _isBusy = false; }
    }
}
