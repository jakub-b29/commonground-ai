@using CommonGround.Application.Services
@inject WorkspaceLocalization Loc
@inject CommonGroundWorkspaceService Workspace
@inject WorkspaceAccessService Access
@implements IDisposable

@if (_dossier is null)
{
    <div class="cg-card"><p role="status">@Loc.T("msg.loadingDossier")</p></div>
}
else
{
    <div class="cg-card" style="border: 1px solid var(--border-subtle); margin-block-start: 1rem;">
        <div class="cg-section-header">
            <div>
                <div style="display: flex; align-items: center; gap: 0.45rem; flex-wrap: wrap;">
                    <span class="cg-badge cg-badge-info mono num">@_dossier.Community.CommunityAccountNumber</span>
                    <span class="cg-badge cg-badge-neutral">@_dossier.Building.Name</span>
                    <span class="cg-badge @GetOccupancyBadgeClass(_dossier.Unit.OccupancyStatus)">@_dossier.Unit.OccupancyStatus</span>
                </div>
                <h2 style="margin-top: 0.25rem;">@Loc.T("unit.dossier.unitLabel") @_dossier.Unit.UnitNumber — @Loc.T("unit.dossier.titleSuffix")</h2>
                <p style="font-size: 0.78rem; color: var(--text-secondary);">
                    @Loc.T("unit.dossier.floor") @_dossier.Unit.FloorNumber · @Loc.T("unit.dossier.stairwell") @_dossier.Unit.StairwellNumber · @Loc.T("unit.dossier.stack") @_dossier.Unit.VerticalStackCode · @_dossier.Unit.Kind · @_dossier.Unit.FloorAreaM2.ToString("N1") m² · @Loc.T("unit.dossier.shareLabel") @_dossier.Unit.ShareNumerator / @_dossier.Unit.ShareDenominator
                </p>
            </div>
            <div style="display: flex; gap: 0.4rem; flex-wrap: wrap;">
                <button type="button" class="cg-btn cg-btn-sm @(_activeTab == "overview" ? "cg-btn-primary" : "")" @onclick='() => _activeTab = "overview"'>@Loc.T("unit.dossier.tabSpecs")</button>
                <button type="button" class="cg-btn cg-btn-sm @(_activeTab == "residents" ? "cg-btn-primary" : "")" @onclick='() => _activeTab = "residents"'>@Loc.T("unit.dossier.tabResidents") (@_dossier.ActiveAssignments.Count)</button>
                <button type="button" class="cg-btn cg-btn-sm @(_activeTab == "links" ? "cg-btn-primary" : "")" @onclick='() => _activeTab = "links"'>@Loc.T("unit.dossier.tabLinks") (@_dossier.RegistrationTokens.Count)</button>
                <button type="button" class="cg-btn cg-btn-sm @(_activeTab == "vault" ? "cg-btn-primary" : "")" @onclick='() => _activeTab = "vault"'>@Loc.T("unit.dossier.tabVault")</button>
                @if (OnClose.HasDelegate)
                {
                    <button type="button" class="cg-btn cg-btn-sm" @onclick="OnClose">@Loc.T("action.close")</button>
                }
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(_message))
        {
            <div role="status" aria-live="polite" class="cg-callout" style="margin-block: 0.65rem;">@_message</div>
        }

        @if (_activeTab == "overview")
        {
            <div class="cg-grid-4" style="margin-block-end: 0.85rem;">
                <MetricCard Label="@Loc.T("unit.dossier.surfaceStorage")"
                            Value="@($"{_dossier.Unit.FloorAreaM2:N1} m²")"
                            Subtitle="@($"+ {_dossier.Unit.StorageAreaM2:N1} m² {Loc.T("unit.dossier.storageSuffix")} · {_dossier.Unit.RoomsCount} {Loc.T("unit.dossier.roomsSuffix")}")"
                            BadgeText="@_dossier.Unit.Kind.ToString()"
                            StatusVariant="info" />
                <MetricCard Label="@Loc.T("unit.dossier.ownershipShare")"
                            Value="@($"{_dossier.Unit.ShareNumerator} / {_dossier.Unit.ShareDenominator}")"
                            Subtitle="@($"{(_dossier.Unit.OwnershipShare * 100m):N2}% {Loc.T("unit.dossier.statutoryWeight")}")"
                            BadgeText="@Loc.T("unit.dossier.statutoryBadge")"
                            StatusVariant="ok" />
                <MetricCard Label="@Loc.T("unit.dossier.activeResidents")"
                            Value="@_dossier.ActiveAssignments.Count.ToString()"
                            Subtitle="@($"{Loc.T("unit.dossier.capacityLabel")}: {_dossier.Unit.OccupancyCapacity} · {Loc.T("unit.dossier.householdLabel")}: {_dossier.HouseholdMembers.Count(h => h.IsActive)}")"
                            BadgeText="@_dossier.Unit.OccupancyStatus.ToString()"
                            StatusVariant="info" />
                <MetricCard Label="@Loc.T("unit.dossier.ledgerBalance")"
                            Value="@($"{_dossier.Unit.CurrentBalance:N2} {_dossier.Community.CurrencyCode}")"
                            Subtitle="@(_dossier.Unit.DaysPastDue > 0 ? $"{_dossier.Unit.DaysPastDue} {Loc.T("unit.dossier.daysPastDue")}" : Loc.T("unit.dossier.currentOk"))"
                            BadgeText="@_dossier.Unit.ArrearsStage.ToString()"
                            StatusVariant="@(_dossier.Unit.CurrentBalance > 0m ? "warn" : "ok")" />
            </div>

            <div class="cg-subcard">
                <strong>@Loc.T("unit.dossier.sectionSpecs")</strong>
                <div class="cg-grid-4" style="margin-top: 0.65rem;">
                    <div><label>@Loc.T("form.unitNumber")</label><input @bind="_editNumber" /></div>
                    <div>
                        <label>@Loc.T("unit.dossier.unitType")</label>
                        <select @bind="_editKind">
                            @foreach (var k in Enum.GetValues<UnitKind>())
                            {
                                <option value="@k" @key="k">@k</option>
                            }
                        </select>
                    </div>
                    <div>
                        <label>@Loc.T("table.status")</label>
                        <select @bind="_editStatus">
                            @foreach (var st in Enum.GetValues<UnitOccupancyStatus>())
                            {
                                <option value="@st" @key="st">@st</option>
                            }
                        </select>
                    </div>
                    <div><label>@Loc.T("unit.dossier.riserStack")</label><input class="mono" @bind="_editStack" /></div>
                    <div><label>@Loc.T("builder.floors")</label><input type="number" @bind="_editFloor" /></div>
                    <div><label>@Loc.T("builder.stairwells")</label><input type="number" @bind="_editStairwell" /></div>
                    <div><label>@Loc.T("builder.area")</label><input type="number" step="0.1" @bind="_editFloorArea" /></div>
                    <div><label>@Loc.T("unit.dossier.storageArea")</label><input type="number" step="0.1" @bind="_editStorageArea" /></div>
                    <div><label>@Loc.T("unit.dossier.rooms")</label><input type="number" @bind="_editRooms" /></div>
                    <div><label>@Loc.T("unit.dossier.bathrooms")</label><input type="number" @bind="_editBathrooms" /></div>
                    <div><label>@Loc.T("unit.dossier.capacity")</label><input type="number" @bind="_editCapacity" /></div>
                    <div><label>@Loc.T("unit.dossier.shareNum")</label><input type="number" @bind="_editShareNum" /></div>
                    <div><label>@Loc.T("unit.dossier.shareDen")</label><input type="number" @bind="_editShareDen" /></div>
                    <div><label>@Loc.T("unit.primaryOwner")</label><input @bind="_editOwnerName" /></div>
                    <div><label>@Loc.T("form.email")</label><input type="email" @bind="_editOwnerEmail" /></div>
                    <div><label>@Loc.T("form.phone")</label><input type="tel" @bind="_editOwnerPhone" /></div>
                    <div><label>@Loc.T("unit.dossier.coOwner")</label><input @bind="_editCoOwner" /></div>
                    <div><label>@Loc.T("unit.dossier.proxy")</label><input @bind="_editProxy" /></div>
                    <div><label>@Loc.T("unit.dossier.parking")</label><input @bind="_editParking" /></div>
                    <div><label>@Loc.T("unit.dossier.fob")</label><input class="mono" @bind="_editFob" /></div>
                    <div><label>@Loc.T("unit.iban")</label><input class="mono" @bind="_editIban" /></div>
                    <div><label>@Loc.T("unit.dossier.notes")</label><input @bind="_editNotes" /></div>
                </div>
                <div class="cg-toolbar" style="margin-top: 0.75rem;">
                    <button type="button" class="cg-btn cg-btn-primary" disabled="@_isBusy" @onclick="SaveUnitDetailsAsync">@Loc.T("builder.saveUnit")</button>
                </div>
            </div>
        }
        else if (_activeTab == "residents")
        {
            <div class="cg-stack">
                <div class="cg-subcard">
                    <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.5rem;">
                        <strong>@Loc.T("unit.dossier.sectionOwnership")</strong>
                        <span class="cg-badge cg-badge-neutral">@_dossier.Ownerships.Count @Loc.T("unit.dossier.recordsSuffix")</span>
                    </div>
                    <div class="cg-table-wrap" style="margin-top: 0.5rem;">
                        <table class="cg-table">
                            <thead>
                                <tr>
                                    <th>@Loc.T("table.ownerName")</th>
                                    <th>@Loc.T("table.role")</th>
                                    <th class="num">@Loc.T("table.shareFraction")</th>
                                    <th>@Loc.T("table.contact")</th>
                                    <th>@Loc.T("table.effectiveDates")</th>
                                    <th>@Loc.T("table.status")</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (_dossier.Ownerships.Count == 0)
                                {
                                    <tr><td colspan="6" style="color: var(--text-secondary);">@Loc.T("unit.dossier.noOwnership")</td></tr>
                                }
                                @foreach (var own in _dossier.Ownerships)
                                {
                                    <tr @key="own.Id">
                                        <td><strong>@own.OwnerFullName</strong></td>
                                        <td><span class="cg-badge cg-badge-neutral">@own.OwnershipRole</span></td>
                                        <td class="mono num">@own.ShareNumerator / @own.ShareDenominator (@own.OwnershipPercentage.ToString("N1")%)</td>
                                        <td class="mono" style="font-size: 0.75rem;">@own.OwnerEmail · @own.OwnerPhone</td>
                                        <td class="mono num" style="font-size: 0.75rem;">@own.EffectiveStartDateUtc.ToString("yyyy-MM-dd")</td>
                                        <td><span class="cg-badge @(own.IsActive ? "cg-badge-ok" : "cg-badge-neutral")">@(own.IsActive ? Loc.T("unit.dossier.activeSuffix") : Loc.T("unit.dossier.historicalSuffix"))</span></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

                <div class="cg-subcard">
                    <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.5rem;">
                        <strong>@Loc.T("unit.dossier.sectionAssign")</strong>
                        <button type="button" class="cg-btn cg-btn-sm cg-btn-primary" @onclick="() => _showQuickAssign = !_showQuickAssign">
                            @(_showQuickAssign ? Loc.T("unit.dossier.hideForm") : Loc.T("unit.dossier.assignCta"))
                        </button>
                    </div>

                    @if (_showQuickAssign)
                    {
                        <div class="cg-card" style="margin-top: 0.65rem; border: 1px solid var(--accent-primary);">
                            <strong>@Loc.T("unit.dossier.assignTitle") @_dossier.Unit.UnitNumber</strong>
                            <div class="cg-grid-3" style="margin-top: 0.5rem;">
                                <div>
                                    <label>@Loc.T("unit.dossier.residentSource")</label>
                                    <select @bind="_assignCreateNew">
                                        <option value="false">@Loc.T("unit.dossier.selectExisting")</option>
                                        <option value="true">@Loc.T("unit.dossier.createNew")</option>
                                    </select>
                                </div>
                                <div>
                                    <label>@Loc.T("unit.dossier.assignmentRole")</label>
                                    <select @bind="_assignType">
                                        @foreach (var t in Enum.GetValues<ResidentAssignmentType>())
                                        {
                                            <option value="@t" @key="t">@t</option>
                                        }
                                    </select>
                                </div>
                                <div>
                                    <label>@Loc.T("unit.dossier.moveIn")</label>
                                    <input type="date" @bind="_assignMoveIn" />
                                </div>
                                @if (!_assignCreateNew)
                                {
                                    <div>
                                        <label>@Loc.T("unit.dossier.existingProfile")</label>
                                        <select @bind="_assignExistingProfileId">
                                            <option value="@Guid.Empty">@Loc.T("unit.dossier.selectResident")</option>
                                            @foreach (var r in ExistingResidents)
                                            {
                                                <option value="@r.Profile.Id" @key="r.Profile.Id">@r.Profile.FullName (@r.Profile.ResidentAccountNumber)</option>
                                            }
                                        </select>
                                    </div>
                                }
                                else
                                {
                                    <div><label>@Loc.T("unit.dossier.firstName")</label><input @bind="_assignFirstName" placeholder="@Loc.T("unit.dossier.firstNamePh")" /></div>
                                    <div><label>@Loc.T("unit.dossier.lastName")</label><input @bind="_assignLastName" placeholder="@Loc.T("unit.dossier.lastNamePh")" /></div>
                                    <div><label>@Loc.T("form.email")</label><input type="email" @bind="_assignEmail" placeholder="@Loc.T("form.emailEx")" /></div>
                                    <div><label>@Loc.T("form.phone")</label><input type="tel" @bind="_assignPhone" placeholder="@Loc.T("form.phoneEx")" /></div>
                                }
                                <div><label>@Loc.T("unit.dossier.assignmentNotes")</label><input @bind="_assignNotes" placeholder="@Loc.T("unit.dossier.assignmentNotesPh")" /></div>
                                <div><label>@Loc.T("unit.dossier.overrideReason")</label><input @bind="_assignOverrideReason" placeholder="@Loc.T("unit.dossier.overridePh")" /></div>
                            </div>
                            <div class="cg-toolbar" style="margin-top: 0.65rem;">
                                <button type="button" class="cg-btn cg-btn-primary" disabled="@_isBusy" @onclick="AssignResidentNowAsync">@Loc.T("unit.dossier.confirmAssign")</button>
                            </div>
                        </div>
                    }

                    <div class="cg-table-wrap" style="margin-top: 0.5rem;">
                        <table class="cg-table">
                            <thead>
                                <tr>
                                    <th>@Loc.T("table.residentAccount")</th>
                                    <th>@Loc.T("table.fullNameContact")</th>
                                    <th>@Loc.T("table.assignmentType")</th>
                                    <th>@Loc.T("table.moveIn")</th>
                                    <th>@Loc.T("table.status")</th>
                                    <th>@Loc.T("table.actions")</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (_dossier.ActiveAssignments.Count == 0)
                                {
                                    <tr><td colspan="6" style="color: var(--text-secondary);">@Loc.T("unit.dossier.noActive")</td></tr>
                                }
                                @foreach (var a in _dossier.ActiveAssignments)
                                {
                                    <tr @key="a.Id">
                                        <td>
                                            <span class="cg-badge cg-badge-info mono num">@(a.ResidentProfile?.ResidentAccountNumber ?? "RES")</span>
                                        </td>
                                        <td>
                                            <strong>@(a.ResidentProfile?.FullName ?? Loc.T("unit.dossier.residentFallback"))</strong>
                                            <div class="mono" style="font-size: 0.73rem; color: var(--text-secondary);">@(a.ResidentProfile?.PrimaryEmail) · @(a.ResidentProfile?.Phone)</div>
                                        </td>
                                        <td>
                                            <span class="cg-badge cg-badge-neutral">@a.AssignmentType</span>
                                            @if (a.IsPrimaryResident)
                                            {
                                                <span class="cg-badge cg-badge-ok" style="margin-left: 0.25rem;">@Loc.T("unit.dossier.primaryBadge")</span>
                                            }
                                        </td>
                                        <td class="mono num">@a.MoveInDateUtc.ToString("yyyy-MM-dd")</td>
                                        <td><span class="cg-badge cg-badge-ok">@a.Status</span></td>
                                        <td>
                                            <div style="display: flex; gap: 0.35rem; flex-wrap: wrap;">
                                                <a class="cg-btn cg-btn-sm" href="@($"/admin/residents/{a.ResidentProfileId}")">@Loc.T("unit.dossier.residentProfile")</a>
                                                <button type="button" class="cg-btn cg-btn-sm" disabled="@_isBusy" @onclick="() => ExecuteMoveOutNowAsync(a.Id)">@Loc.T("unit.dossier.moveOut")</button>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

                <div class="cg-subcard">
                    <strong>@Loc.T("unit.dossier.sectionHouseholdPrefix") (@_dossier.HouseholdMembers.Count(h => h.IsActive))</strong>
                    <div class="cg-table-wrap" style="margin-top: 0.45rem;">
                        <table class="cg-table">
                            <thead>
                                <tr><th>@Loc.T("table.fullName")</th><th>@Loc.T("table.relationship")</th><th>@Loc.T("table.contact")</th><th>@Loc.T("table.portalAccess")</th><th>@Loc.T("table.status")</th><th>@Loc.T("table.actions")</th></tr>
                            </thead>
                            <tbody>
                                @if (_dossier.HouseholdMembers.Count == 0)
                                {
                                    <tr><td colspan="6" style="color: var(--text-secondary);">@Loc.T("unit.dossier.noHousehold")</td></tr>
                                }
                                @foreach (var h in _dossier.HouseholdMembers)
                                {
                                    <tr @key="h.Id">
                                        <td><strong>@h.FullName</strong></td>
                                        <td>@h.RelationshipToPrimary</td>
                                        <td class="mono" style="font-size: 0.75rem;">@h.Email @h.Phone</td>
                                        <td>@(h.HasPortalAccess ? Loc.T("unit.dossier.yes") : Loc.T("unit.dossier.no"))</td>
                                        <td><span class="cg-badge @(h.IsActive ? "cg-badge-ok" : "cg-badge-neutral")">@(h.IsActive ? Loc.T("unit.dossier.activeSuffix") : Loc.T("unit.dossier.endedSuffix"))</span></td>
                                        <td>
                                            @if (h.IsActive)
                                            {
                                                <button type="button" class="cg-btn cg-btn-sm" @onclick="() => RemoveHouseholdAsync(h.Id)">@Loc.T("unit.dossier.endOccupancy")</button>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <div class="cg-grid-4" style="margin-top: 0.55rem;">
                        <div><label>@Loc.T("unit.dossier.hhName")</label><input @bind="_hhName" placeholder="@Loc.T("unit.dossier.hhNamePh")" /></div>
                        <div><label>@Loc.T("table.relationship")</label><input @bind="_hhRel" placeholder="@Loc.T("unit.dossier.relationshipPh")" /></div>
                        <div><label>@Loc.T("table.contact")</label><input @bind="_hhContact" placeholder="@Loc.T("unit.dossier.contactPh")" /></div>
                        <div style="display: flex; align-items: flex-end;">
                            <button type="button" class="cg-btn cg-btn-sm cg-btn-primary" disabled="@_isBusy" @onclick="AddHouseholdAsync">@Loc.T("unit.dossier.addHousehold")</button>
                        </div>
                    </div>
                </div>

                <div class="cg-subcard">
                    <strong>@Loc.T("unit.dossier.sectionTimeline")</strong>
                    <div class="cg-table-wrap" style="margin-top: 0.45rem;">
                        <table class="cg-table">
                            <thead>
                                <tr>
                                    <th>@Loc.T("table.residentAccount")</th>
                                    <th>@Loc.T("table.resident")</th>
                                    <th>@Loc.T("table.assignmentType")</th>
                                    <th>@Loc.T("table.moveIn")</th>
                                    <th>@Loc.T("table.moveOut")</th>
                                    <th>@Loc.T("table.statusNotes")</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var hist in _dossier.ActiveAssignments.Concat(_dossier.HistoricalAssignments))
                                {
                                    <tr @key="hist.Id">
                                        <td class="mono num">@(hist.ResidentProfile?.ResidentAccountNumber ?? "RES")</td>
                                        <td><strong>@(hist.ResidentProfile?.FullName ?? Loc.T("unit.dossier.residentFallback"))</strong></td>
                                        <td>@hist.AssignmentType</td>
                                        <td class="mono num">@hist.MoveInDateUtc.ToString("yyyy-MM-dd")</td>
                                        <td class="mono num">@(hist.MoveOutDateUtc?.ToString("yyyy-MM-dd") ?? Loc.T("unit.dossier.activeSuffix"))</td>
                                        <td style="font-size: 0.75rem;">
                                            <span class="cg-badge @(hist.Status == UnitAssignmentStatus.Active ? "cg-badge-ok" : "cg-badge-neutral")">@hist.Status</span>
                                            <span style="margin-left: 0.35rem; color: var(--text-secondary);">@hist.AssignmentReasonOrNotes</span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        }
        else if (_activeTab == "links")
        {
            <div class="cg-stack">
                <div class="cg-subcard">
                    <strong>@Loc.T("unit.dossier.sectionLinks")</strong>
                    <p style="font-size: 0.78rem; color: var(--text-secondary); margin-top: 0.25rem;">
                        @Loc.T("unit.dossier.linksHintPrefix") @_dossier.Unit.UnitNumber. @Loc.T("unit.dossier.linksHintSuffix")
                    </p>
                    <div class="cg-grid-4" style="margin-top: 0.65rem;">
                        <div>
                            <label>@Loc.T("unit.dossier.approvalPolicy")</label>
                            <select @bind="_linkMode">
                                <option value="@RegistrationApprovalMode.ManualFirmApproval">@Loc.T("property.settings.regManual")</option>
                                <option value="@RegistrationApprovalMode.AutomaticAuthorized">@Loc.T("property.settings.regAuto")</option>
                            </select>
                        </div>
                        <div>
                            <label>@Loc.T("unit.dossier.intendedRole")</label>
                            <select @bind="_linkAssignmentType">
                                <option value="@ResidentAssignmentType.PrimaryResident">@Loc.T("unit.dossier.rolePrimary")</option>
                                <option value="@ResidentAssignmentType.OwnerResident">@Loc.T("unit.dossier.roleOwnerResident")</option>
                                <option value="@ResidentAssignmentType.Tenant">@Loc.T("unit.dossier.roleTenant")</option>
                                <option value="@ResidentAssignmentType.CoResident">@Loc.T("unit.dossier.roleCoResident")</option>
                            </select>
                        </div>
                        <div><label>@Loc.T("unit.dossier.maxUses")</label><input type="number" min="1" max="10" @bind="_linkMaxUses" /></div>
                        <div><label>@Loc.T("unit.dossier.refNote")</label><input @bind="_linkLabel" placeholder="@Loc.T("unit.dossier.refNotePh")" /></div>
                    </div>
                    <div class="cg-toolbar" style="margin-top: 0.65rem;">
                        <button type="button" class="cg-btn cg-btn-primary" disabled="@_isBusy" @onclick="GenerateLinkAsync">@Loc.T("unit.dossier.generateLink")</button>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(_lastGeneratedUrl))
                    {
                        <div class="cg-callout" style="margin-top: 0.65rem;">
                            <strong>@Loc.T("unit.dossier.linkGenerated")</strong>
                            <div class="mono num" style="margin-top: 0.3rem; word-break: break-all;">@_lastGeneratedUrl</div>
                        </div>
                    }
                </div>

                <div class="cg-subcard">
                    <strong>@Loc.T("unit.dossier.issuedTokens") (@_dossier.RegistrationTokens.Count)</strong>
                    <div class="cg-table-wrap" style="margin-top: 0.45rem;">
                        <table class="cg-table">
                            <thead>
                                <tr>
                                    <th>@Loc.T("table.labelRef")</th>
                                    <th>@Loc.T("table.approvalMode")</th>
                                    <th>@Loc.T("table.role")</th>
                                    <th class="num">@Loc.T("table.uses")</th>
                                    <th>@Loc.T("table.expires")</th>
                                    <th>@Loc.T("table.status")</th>
                                    <th>@Loc.T("table.actions")</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (_dossier.RegistrationTokens.Count == 0)
                                {
                                    <tr><td colspan="7" style="color: var(--text-secondary);">@Loc.T("unit.dossier.noLinks")</td></tr>
                                }
                                @foreach (var tk in _dossier.RegistrationTokens)
                                {
                                    <tr @key="tk.Id">
                                        <td><strong>@tk.LabelOrReference</strong></td>
                                        <td><span class="cg-badge cg-badge-info">@tk.ApprovalMode</span></td>
                                        <td>@tk.IntendedAssignmentType</td>
                                        <td class="mono num">@tk.UseCount / @tk.MaxUses</td>
                                        <td class="mono num">@tk.ExpiresAtUtc.ToString("yyyy-MM-dd")</td>
                                        <td><span class="cg-badge @(tk.Status == RegistrationTokenStatus.Active ? "cg-badge-ok" : "cg-badge-neutral")">@tk.Status</span></td>
                                        <td>
                                            @if (tk.Status == RegistrationTokenStatus.Active)
                                            {
                                                <button type="button" class="cg-btn cg-btn-sm" @onclick="() => RevokeLinkAsync(tk.Id)">@Loc.T("unit.dossier.revoke")</button>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        }
        else if (_activeTab == "vault")
        {
            <div class="cg-stack">
                <div class="cg-grid-2">
                    <div class="cg-subcard">
                        <strong>@Loc.T("unit.dossier.sectionMeters") (@_dossier.Meters.Count)</strong>
                        <div class="cg-table-wrap" style="margin-top: 0.45rem;">
                            <table class="cg-table">
                                <thead><tr><th>@Loc.T("table.utility")</th><th>@Loc.T("table.serialNo")</th><th class="num">@Loc.T("table.lastReading")</th><th>@Loc.T("table.status")</th></tr></thead>
                                <tbody>
                                    @if (_dossier.Meters.Count == 0)
                                    {
                                        <tr><td colspan="4" style="color: var(--text-secondary);">@Loc.T("unit.dossier.noMeters")</td></tr>
                                    }
                                    @foreach (var m in _dossier.Meters)
                                    {
                                        <tr @key="m.Id">
                                            <td>@m.Kind</td>
                                            <td class="mono num">@m.SerialNumber</td>
                                            <td class="mono num">@m.LastReadingValue.ToString("N2")</td>
                                            <td><span class="cg-badge @(m.HasSilentLeakAnomaly ? "cg-badge-warn" : "cg-badge-ok")">@(m.HasSilentLeakAnomaly ? Loc.T("unit.dossier.leakAnomaly") : Loc.T("unit.dossier.normal"))</span></td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <div class="cg-subcard">
                        <strong>@Loc.T("unit.dossier.sectionFinance")</strong>
                        <div style="font-size: 0.78rem; margin-top: 0.35rem;">
                            @Loc.T("unit.iban"): <code class="mono num">@_dossier.Unit.VirtualIbanOrLockboxCode</code> · @Loc.T("table.balance"): <strong class="mono num">@_dossier.Unit.CurrentBalance.ToString("N2") @_dossier.Community.CurrencyCode</strong>
                        </div>
                        <div class="cg-table-wrap" style="margin-top: 0.45rem;">
                            <table class="cg-table">
                                <thead><tr><th>@Loc.T("table.period")</th><th class="num">@Loc.T("table.operating")</th><th class="num">@Loc.T("table.reserve")</th><th class="num">@Loc.T("table.total")</th></tr></thead>
                                <tbody>
                                    @if (_dossier.Assessments.Count == 0)
                                    {
                                        <tr><td colspan="4" style="color: var(--text-secondary);">@Loc.T("unit.dossier.noAssessments")</td></tr>
                                    }
                                    @foreach (var a in _dossier.Assessments.Take(6))
                                    {
                                        <tr @key="a.Id">
                                            <td class="mono num">@a.Period</td>
                                            <td class="mono num">@a.OperatingFee.ToString("N2")</td>
                                            <td class="mono num">@a.RepairFundFee.ToString("N2")</td>
                                            <td class="mono num"><strong>@a.TotalAssessment.ToString("N2")</strong></td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <div class="cg-subcard">
                    <strong>@Loc.T("unit.dossier.sectionDocs") (@_dossier.Documents.Count)</strong>
                    <div class="cg-table-wrap" style="margin-top: 0.45rem;">
                        <table class="cg-table">
                            <thead><tr><th>@Loc.T("table.category")</th><th>@Loc.T("table.titleFile")</th><th>@Loc.T("table.summary")</th><th>@Loc.T("table.uploaded")</th></tr></thead>
                            <tbody>
                                @if (_dossier.Documents.Count == 0)
                                {
                                    <tr><td colspan="4" style="color: var(--text-secondary);">@Loc.T("unit.dossier.noDocs")</td></tr>
                                }
                                @foreach (var d in _dossier.Documents)
                                {
                                    <tr @key="d.Id">
                                        <td><span class="cg-badge cg-badge-neutral">@d.Category</span></td>
                                        <td><strong>@d.Title</strong> <span class="mono" style="font-size: 0.72rem; color: var(--text-secondary);">(@d.FileName)</span></td>
                                        <td style="font-size: 0.75rem;">@d.SummaryOrNotes</td>
                                        <td class="mono num" style="font-size: 0.74rem;">@d.UploadedAtUtc.ToString("yyyy-MM-dd") @Loc.T("unit.dossier.byLabel") @d.UploadedByName</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <div class="cg-grid-4" style="margin-top: 0.55rem;">
                        <div>
                            <label>@Loc.T("unit.dossier.docCategory")</label>
                            <select @bind="_docCategory">
                                @foreach (var dc in Enum.GetValues<ResidentDocumentCategory>())
                                {
                                    <option value="@dc" @key="dc">@dc</option>
                                }
                            </select>
                        </div>
                        <div><label>@Loc.T("unit.dossier.docTitle")</label><input @bind="_docTitle" placeholder="@Loc.T("unit.dossier.docTitlePh")" /></div>
                        <div><label>@Loc.T("unit.dossier.docNotes")</label><input @bind="_docNotes" placeholder="@Loc.T("unit.dossier.docNotesPh")" /></div>
                        <div style="display: flex; align-items: flex-end;">
                            <button type="button" class="cg-btn cg-btn-sm cg-btn-primary" disabled="@_isBusy" @onclick="AddDocumentAsync">@Loc.T("unit.dossier.attachDoc")</button>
                        </div>
                    </div>
                </div>

                <div class="cg-subcard">
                    <strong>@Loc.T("unit.dossier.sectionAudit") (@_dossier.AuditEvents.Count)</strong>
                    <div class="cg-table-wrap" style="margin-top: 0.45rem;">
                        <table class="cg-table">
                            <thead><tr><th>@Loc.T("table.timestampUtc")</th><th>@Loc.T("table.category")</th><th>@Loc.T("table.role")</th><th>@Loc.T("table.summary")</th><th>@Loc.T("table.shaChain")</th></tr></thead>
                            <tbody>
                                @foreach (var ev in _dossier.AuditEvents.Take(10))
                                {
                                    <tr @key="ev.Id">
                                        <td class="mono num" style="font-size: 0.74rem;">@ev.OccurredAtUtc.ToString("yyyy-MM-dd HH:mm")</td>
                                        <td><span class="cg-badge cg-badge-neutral mono">@ev.ActionCategory</span></td>
                                        <td>@ev.ActorRole</td>
                                        <td style="font-size: 0.76rem;">@ev.Summary</td>
                                        <td class="mono num" style="font-size: 0.7rem;">@(ev.EntrySha256Hash.Length >= 12 ? ev.EntrySha256Hash[..12] : ev.EntrySha256Hash)…</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        }
    </div>
}

@code {
    [Parameter, EditorRequired] public Guid CommunityId { get; set; }
    [Parameter, EditorRequired] public Guid UnitId { get; set; }
    [Parameter] public IReadOnlyList<ResidentDirectoryRow> ExistingResidents { get; set; } = [];
    [Parameter] public EventCallback OnChanged { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    private UnitFullDossier? _dossier;
    private Guid _loadedUnitId;
    private string _activeTab = "overview";
    private bool _isBusy;
    private string _message = string.Empty;
    private Action? _locHandler;

    private string _editNumber = string.Empty;
    private UnitKind _editKind;
    private UnitOccupancyStatus _editStatus;
    private string _editStack = string.Empty;
    private int _editFloor;
    private int _editStairwell;
    private decimal _editFloorArea;
    private decimal _editStorageArea;
    private int _editRooms;
    private int _editBathrooms;
    private int _editCapacity;
    private int _editShareNum;
    private int _editShareDen;
    private string _editOwnerName = string.Empty;
    private string _editOwnerEmail = string.Empty;
    private string _editOwnerPhone = string.Empty;
    private string _editCoOwner = string.Empty;
    private string _editProxy = string.Empty;
    private string _editParking = string.Empty;
    private string _editFob = string.Empty;
    private string _editIban = string.Empty;
    private string _editNotes = string.Empty;

    private bool _showQuickAssign;
    private bool _assignCreateNew;
    private Guid _assignExistingProfileId;
    private ResidentAssignmentType _assignType = ResidentAssignmentType.PrimaryResident;
    private DateTime _assignMoveIn = DateTime.UtcNow.Date;
    private string _assignFirstName = string.Empty;
    private string _assignLastName = string.Empty;
    private string _assignEmail = string.Empty;
    private string _assignPhone = string.Empty;
    private string _assignNotes = string.Empty;
    private string _assignOverrideReason = string.Empty;

    private string _hhName = string.Empty;
    private string _hhRel = "Household Member";
    private string _hhContact = string.Empty;

    private RegistrationApprovalMode _linkMode = RegistrationApprovalMode.ManualFirmApproval;
    private ResidentAssignmentType _linkAssignmentType = ResidentAssignmentType.PrimaryResident;
    private int _linkMaxUses = 1;
    private string _linkLabel = string.Empty;
    private string _lastGeneratedUrl = string.Empty;

    private ResidentDocumentCategory _docCategory = ResidentDocumentCategory.MoveInMoveOutProtocol;
    private string _docTitle = string.Empty;
    private string _docNotes = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        _locHandler = () => InvokeAsync(StateHasChanged);
        Loc.OnChange += _locHandler;
        await Loc.EnsureLoadedAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        if (UnitId != Guid.Empty && UnitId != _loadedUnitId)
        {
            _loadedUnitId = UnitId;
            await ReloadDossierAsync();
        }
    }

    private async Task ReloadDossierAsync()
    {
        _dossier = await Workspace.GetUnitFullDossierAsync(CommunityId, UnitId);
        if (_dossier is not null)
        {
            var u = _dossier.Unit;
            _editNumber = u.UnitNumber;
            _editKind = u.Kind;
            _editStatus = u.OccupancyStatus;
            _editStack = u.VerticalStackCode;
            _editFloor = u.FloorNumber;
            _editStairwell = u.StairwellNumber;
            _editFloorArea = u.FloorAreaM2;
            _editStorageArea = u.StorageAreaM2;
            _editRooms = u.RoomsCount;
            _editBathrooms = u.BathroomsCount;
            _editCapacity = u.OccupancyCapacity;
            _editShareNum = u.ShareNumerator;
            _editShareDen = u.ShareDenominator;
            _editOwnerName = u.PrimaryOwnerName;
            _editOwnerEmail = u.PrimaryOwnerEmail;
            _editOwnerPhone = u.PrimaryOwnerPhone;
            _editCoOwner = u.CoOwnerName ?? string.Empty;
            _editProxy = u.VotingProxyName ?? string.Empty;
            _editParking = u.ParkingBayNumber ?? string.Empty;
            _editFob = u.AccessFobCode ?? string.Empty;
            _editIban = u.VirtualIbanOrLockboxCode;
            _editNotes = u.Notes;
        }
    }

    private static string GetOccupancyBadgeClass(UnitOccupancyStatus status) => status switch
    {
        UnitOccupancyStatus.OwnerOccupied => "cg-badge-ok",
        UnitOccupancyStatus.TenantOccupied => "cg-badge-info",
        UnitOccupancyStatus.PendingRegistration => "cg-badge-warn",
        _ => "cg-badge-neutral"
    };

    private async Task SaveUnitDetailsAsync()
    {
        if (_dossier is null) return;
        _isBusy = true;
        try
        {
            var role = await Access.GetRoleAsync() ?? WorkspaceSecurityRole.FirmManager;
            await Workspace.UpdateUnitFullDetailsAsync(
                CommunityId,
                UnitId,
                new UnitUpdateInput(
                    _dossier.Unit.BuildingId,
                    _editNumber,
                    _editFloor,
                    _editStairwell,
                    _editStack,
                    _editKind,
                    _editFloorArea,
                    _editStorageArea,
                    _editRooms,
                    _editBathrooms,
                    _editCapacity,
                    _editStatus,
                    _editShareNum,
                    _editShareDen,
                    _editOwnerName,
                    _editOwnerEmail,
                    _editOwnerPhone,
                    _dossier.Unit.PreferredLanguage,
                    _editCoOwner,
                    _editProxy,
                    _editParking,
                    _editFob,
                    _editIban,
                    _editNotes),
                role);
            await ReloadDossierAsync();
            _message = Loc.T("unit.dossier.savedMsg");
            await OnChanged.InvokeAsync();
        }
        catch (Exception ex) { _message = ex.Message; }
        finally { _isBusy = false; }
    }

    private async Task AssignResidentNowAsync()
    {
        if (_dossier is null) return;
        _isBusy = true;
        try
        {
            var role = await Access.GetRoleAsync() ?? WorkspaceSecurityRole.FirmManager;
            var membershipId = await Access.GetActiveMembershipIdAsync();
            await Workspace.AssignResidentToUnitManualAsync(
                new ManualResidentAssignmentRequest(
                    CommunityId,
                    _dossier.Unit.BuildingId,
                    UnitId,
                    _assignCreateNew,
                    _assignExistingProfileId == Guid.Empty ? null : _assignExistingProfileId,
                    _assignFirstName,
                    _assignLastName,
                    _assignEmail,
                    _assignPhone,
                    "EN",
                    string.Empty,
                    string.Empty,
                    _assignType,
                    UnitAssignmentStatus.Active,
                    true,
                    _assignMoveIn,
                    null,
                    _assignNotes,
                    _assignOverrideReason),
                role,
                role.ToString(),
                membershipId);
            _showQuickAssign = false;
            await ReloadDossierAsync();
            _message = Loc.T("unit.dossier.assignedMsg");
            await OnChanged.InvokeAsync();
        }
        catch (Exception ex) { _message = ex.Message; }
        finally { _isBusy = false; }
    }

    private async Task ExecuteMoveOutNowAsync(Guid assignmentId)
    {
        _isBusy = true;
        try
        {
            var role = await Access.GetRoleAsync() ?? WorkspaceSecurityRole.FirmManager;
            await Workspace.ExecuteMoveOutAsync(
                CommunityId,
                assignmentId,
                DateTime.UtcNow,
                "Move-out executed from Unit Dossier",
                role,
                role.ToString());
            await ReloadDossierAsync();
            _message = Loc.T("unit.dossier.moveOutMsg");
            await OnChanged.InvokeAsync();
        }
        catch (Exception ex) { _message = ex.Message; }
        finally { _isBusy = false; }
    }

    private async Task AddHouseholdAsync()
    {
        if (string.IsNullOrWhiteSpace(_hhName)) return;
        _isBusy = true;
        try
        {
            var role = await Access.GetRoleAsync() ?? WorkspaceSecurityRole.FirmManager;
            await Workspace.UpsertHouseholdMemberAsync(
                CommunityId,
                UnitId,
                null,
                _hhName,
                _hhRel,
                _hhContact,
                string.Empty,
                false,
                string.Empty,
                role);
            _hhName = string.Empty;
            _hhContact = string.Empty;
            await ReloadDossierAsync();
            _message = Loc.T("unit.dossier.householdAddedMsg");
        }
        catch (Exception ex) { _message = ex.Message; }
        finally { _isBusy = false; }
    }

    private async Task RemoveHouseholdAsync(Guid memberId)
    {
        _isBusy = true;
        try
        {
            var role = await Access.GetRoleAsync() ?? WorkspaceSecurityRole.FirmManager;
            await Workspace.RemoveHouseholdMemberAsync(CommunityId, memberId, role);
            await ReloadDossierAsync();
            _message = Loc.T("unit.dossier.householdRemovedMsg");
        }
        catch (Exception ex) { _message = ex.Message; }
        finally { _isBusy = false; }
    }

    private async Task GenerateLinkAsync()
    {
        _isBusy = true;
        try
        {
            var role = await Access.GetRoleAsync() ?? WorkspaceSecurityRole.FirmManager;
            var membershipId = await Access.GetActiveMembershipIdAsync();
            var res = await Workspace.GenerateResidentRegistrationLinkAsync(
                CommunityId,
                UnitId,
                _linkMode,
                _linkAssignmentType,
                DateTime.UtcNow.AddDays(14),
                _linkMaxUses,
                _linkLabel,
                role,
                role.ToString(),
                membershipId);
            _lastGeneratedUrl = res.RelativeUrl;
            _linkLabel = string.Empty;
            await ReloadDossierAsync();
            _message = Loc.T("unit.dossier.linkCreatedMsg");
            await OnChanged.InvokeAsync();
        }
        catch (Exception ex) { _message = ex.Message; }
        finally { _isBusy = false; }
    }

    private async Task RevokeLinkAsync(Guid tokenId)
    {
        _isBusy = true;
        try
        {
            var role = await Access.GetRoleAsync() ?? WorkspaceSecurityRole.FirmManager;
            await Workspace.RevokeResidentRegistrationLinkAsync(CommunityId, tokenId, role);
            await ReloadDossierAsync();
            _message = Loc.T("unit.dossier.linkRevokedMsg");
            await OnChanged.InvokeAsync();
        }
        catch (Exception ex) { _message = ex.Message; }
        finally { _isBusy = false; }
    }

    private async Task AddDocumentAsync()
    {
        if (string.IsNullOrWhiteSpace(_docTitle)) return;
        _isBusy = true;
        try
        {
            var role = await Access.GetRoleAsync() ?? WorkspaceSecurityRole.FirmManager;
            var primaryResId = _dossier?.ActiveAssignments.FirstOrDefault()?.ResidentProfileId;
            await Workspace.AddResidentDocumentAsync(
                CommunityId,
                UnitId,
                primaryResId,
                _docCategory,
                _docTitle,
                $"{_docTitle.Trim().ToLowerInvariant().Replace(' ', '-')}.pdf",
                _docNotes,
                true,
                role.ToString(),
                role);
            _docTitle = string.Empty;
            _docNotes = string.Empty;
            await ReloadDossierAsync();
            _message = Loc.T("unit.dossier.docAddedMsg");
        }
        catch (Exception ex) { _message = ex.Message; }
        finally { _isBusy = false; }
    }

    public void Dispose()
    {
        if (_locHandler is not null) Loc.OnChange -= _locHandler;
    }
}
