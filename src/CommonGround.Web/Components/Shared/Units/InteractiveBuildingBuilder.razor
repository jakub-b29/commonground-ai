@using CommonGround.Domain.Entities
@inject CommonGroundWorkspaceService Workspace
@inject WorkspaceAccessService Access
@inject WorkspaceLocalization Loc
@implements IDisposable

<div class="cg-card">
    <div class="cg-section-header">
        <h2>@Loc.T("panel.riser")</h2>
        <span class="cg-badge mono">@_selectedStack</span>
    </div>
    <p style="color: var(--color-text-secondary); font-size: 0.78125rem;">@Loc.T("riser.hint")</p>
    @if (_buildings.Count > 1)
    {
        <div style="margin-block-end: 0.5rem;">
            <label for="builder-bld">@Loc.T("builder.building")</label>
            <select id="builder-bld" @bind="_buildingId">
                @foreach (var b in _buildings)
                {
                    <option value="@b.Id">@b.Name</option>
                }
            </select>
        </div>
    }
    @if (_canEdit)
    {
        <div class="cg-grid-3" style="margin-block-end: 0.5rem;">
            <div>
                <label for="builder-floors">@Loc.T("builder.floors")</label>
                <input id="builder-floors" type="number" min="1" max="20" @bind="_floors" />
            </div>
            <div>
                <label for="builder-stairs">@Loc.T("builder.stairwells")</label>
                <input id="builder-stairs" type="number" min="1" max="10" @bind="_stairwells" />
            </div>
            <div style="display: flex; align-items: end; gap: 0.375rem;">
                <button type="button" class="cg-btn" disabled="@_isBusy" @onclick="OnSaveStructure">@Loc.T("builder.saveStructure")</button>
            </div>
        </div>
        <div style="display: flex; gap: 0.375rem; flex-wrap: wrap; align-items: end; margin-block-end: 0.5rem;">
            <div>
                <label for="builder-stack">@Loc.T("builder.newStack")</label>
                <input id="builder-stack" @bind="_newStackCode" placeholder="STACK-A1" style="min-width: 9rem;" />
            </div>
            <button type="button" class="cg-btn" disabled="@_isBusy" @onclick="OnAddStack">@Loc.T("builder.addStack")</button>
            @foreach (var s in _stacks)
            {
                <span class="cg-badge mono">@s <button type="button" class="cg-btn" style="padding: 0 0.3rem;" disabled="@_isBusy" @onclick="() => OnRemoveStack(s)" title="@Loc.T("builder.removeStack")">×</button></span>
            }
        </div>
    }
    <div class="cg-table-wrap">
        <table class="cg-table">
            <thead>
                <tr>
                    <th>@Loc.T("riser.floor")</th>
                    @foreach (var stack in _stacks)
                    {
                        <th @key="stack" class="mono">@stack</th>
                    }
                </tr>
            </thead>
            <tbody>
                @for (var floor = _floors; floor >= 1; floor--)
                {
                    var f = floor;
                    <tr>
                        <td><strong>@Loc.T("riser.floor") @f</strong></td>
                        @foreach (var stack in _stacks)
                        {
                            var s = stack;
                            var unit = Units.FirstOrDefault(u => u.FloorNumber == f && string.Equals(u.VerticalStackCode, s, StringComparison.OrdinalIgnoreCase) && (_buildingId == Guid.Empty || u.BuildingId == _buildingId));
                            <td @key="@(f + s)" style="@(s == _selectedStack ? "background-color: var(--color-accent-tint);" : string.Empty)">
                                <BuilderUnitCell Unit="unit" IsSelected="unit is not null && SelectedUnitId == unit.Id" CanEdit="_canEdit" Floor="f" StackCode="s" OnSelect="OnSelectUnit" OnAddCell="OnBeginAddCell" />
                            </td>
                        }
                    </tr>
                }
                <tr>
                    <td><strong>@Loc.T("riser.ground")</strong></td>
                    @foreach (var stack in _stacks)
                    {
                        var s = stack;
                        var unit = Units.FirstOrDefault(u => u.FloorNumber == 0 && string.Equals(u.VerticalStackCode, s, StringComparison.OrdinalIgnoreCase) && (_buildingId == Guid.Empty || u.BuildingId == _buildingId));
                        <td @key="@("g" + s)">
                            <BuilderUnitCell Unit="unit" IsSelected="unit is not null && SelectedUnitId == unit.Id" CanEdit="_canEdit" Floor="0" StackCode="s" OnSelect="OnSelectUnit" OnAddCell="OnBeginAddCell" />
                        </td>
                    }
                </tr>
                <tr>
                    <td><strong>@Loc.T("riser.basement")</strong></td>
                    <td colspan="@Math.Max(1, _stacks.Count)" style="font-size: 0.75rem;">
                        <div class="cg-grid-3">
                            @foreach (var stack in _stacks)
                            {
                                var s = stack;
                                var loc = _buildings.FirstOrDefault(b => b.Id == _buildingId)?.RiserStacks.FirstOrDefault(r => string.Equals(r.Code, s, StringComparison.OrdinalIgnoreCase))?.ShutoffValveLocation ?? Loc.T("riser.manifold");
                                <div @key="s">
                                    <ManifoldValveBadge StackCode="s" ShutoffLocation="@loc" IsActive="s == _selectedStack" OnBroadcast="OnBroadcastStackAlert" />
                                </div>
                            }
                        </div>
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
    @if (_pendingFloor.HasValue && !string.IsNullOrWhiteSpace(_pendingStack))
    {
        <div class="cg-subcard" style="margin-block-start: 0.5rem;">
            <strong>@Loc.T("builder.addUnit") – @Loc.T("riser.floor") @_pendingFloor, @_pendingStack</strong>
            <div class="cg-grid-3" style="margin-block-start: 0.375rem;">
                <div>
                    <label for="builder-unit">@Loc.T("builder.unitNumber")</label>
                    <input id="builder-unit" @bind="_newUnitNumber" autocomplete="off" />
                </div>
                <div>
                    <label for="builder-area">@Loc.T("builder.area")</label>
                    <input id="builder-area" type="number" step="0.5" min="10" max="500" @bind="_newUnitArea" />
                </div>
                <div style="display: flex; align-items: end; gap: 0.375rem;">
                    <button type="button" class="cg-btn cg-btn-primary" disabled="@_isBusy" @onclick="OnSaveCell">@Loc.T("builder.saveUnit")</button>
                    <button type="button" class="cg-btn" @onclick="OnCancelCell">@Loc.T("action.close")</button>
                </div>
            </div>
        </div>
    }
    else if (_selectedUnit is not null && _canEdit)
    {
        <div class="cg-toolbar">
            <button type="button" class="cg-btn" disabled="@_isBusy" @onclick="OnRemoveSelected">@Loc.T("builder.removeUnit")</button>
        </div>
    }
    @if (SelectedUnitId != Guid.Empty)
    {
        <div class="cg-toolbar">
            <button type="button" class="cg-btn" @onclick="() => OnBroadcastStackAlert.InvokeAsync(_selectedStack)">@Loc.T("action.broadcastAlert") (@_selectedStack)</button>
        </div>
    }
    @if (!string.IsNullOrWhiteSpace(_message))
    {
        <div role="status" aria-live="polite" class="cg-callout">@_message</div>
    }
</div>

@code {
    [Parameter, EditorRequired] public Community Community { get; set; } = default!;
    [Parameter, EditorRequired] public IReadOnlyList<Unit> Units { get; set; } = [];
    [Parameter] public Guid SelectedUnitId { get; set; }
    [Parameter] public EventCallback<Guid> OnSelectUnit { get; set; }
    [Parameter] public EventCallback<string> OnBroadcastStackAlert { get; set; }
    [Parameter] public EventCallback OnStructureChanged { get; set; }

    private List<Building> _buildings = new();
    private Guid _buildingId = Guid.Empty;
    private List<string> _stacks = new() { "STACK-A1", "STACK-A2", "STACK-B1" };
    private int _floors = 4;
    private int _stairwells = 2;
    private string _newStackCode = string.Empty;
    private int? _pendingFloor;
    private string _pendingStack = string.Empty;
    private string _newUnitNumber = string.Empty;
    private decimal _newUnitArea = 58m;
    private string _message = string.Empty;
    private bool _isBusy;
    private bool _canEdit;
    private Action? _locHandler;

    private string _selectedStack => Units.FirstOrDefault(u => u.Id == SelectedUnitId)?.VerticalStackCode ?? _stacks.FirstOrDefault() ?? "STACK-A1";
    private Unit? _selectedUnit => Units.FirstOrDefault(u => u.Id == SelectedUnitId);

    protected override async Task OnInitializedAsync()
    {
        _locHandler = () => InvokeAsync(StateHasChanged);
        Loc.OnChange += _locHandler;
        await Loc.EnsureLoadedAsync();
        try { _canEdit = DataSecurityAndPrivacyGuard.IsManagerRole(await Access.GetRoleAsync() ?? WorkspaceSecurityRole.Resident); } catch { }
    }

    protected override void OnParametersSet()
    {
        _buildings = Community.Buildings.OrderBy(b => b.Name).ToList();
        var active = _buildings.FirstOrDefault(b => b.Id == _buildingId) ?? _buildings.FirstOrDefault();
        if (active is not null)
        {
            _buildingId = active.Id;
            _floors = active.FloorsCount > 0 ? active.FloorsCount : Math.Max(4, Units.Where(u => u.BuildingId == active.Id).Select(u => u.FloorNumber).DefaultIfEmpty(4).Max());
            _stairwells = active.StairwellsCount > 0 ? active.StairwellsCount : 2;
            if (active.RiserStacks.Count > 0)
            {
                _stacks = active.RiserStacks.OrderBy(r => r.Code).Select(r => r.Code).ToList();
            }
        }
        if (_stacks.Count == 0)
        {
            var distinct = Units.Select(u => u.VerticalStackCode).Where(s => !string.IsNullOrWhiteSpace(s)).Distinct(StringComparer.OrdinalIgnoreCase).OrderBy(s => s).ToList();
            _stacks = distinct.Count > 0 ? distinct : new() { "STACK-A1", "STACK-A2", "STACK-B1" };
        }
        if (_floors < 1) _floors = Math.Max(4, Units.Select(u => u.FloorNumber).DefaultIfEmpty(4).Max());
    }

    private void OnBeginAddCell((int Floor, string StackCode) cell)
    {
        _pendingFloor = cell.Floor;
        _pendingStack = cell.StackCode;
        _newUnitNumber = cell.Floor == 0 ? $"G-{cell.StackCode.Replace("STACK-", string.Empty)}" : $"{cell.Floor}0{cell.StackCode.Replace("STACK-", string.Empty).Replace("A", "1").Replace("B", "2")}";
        _message = string.Empty;
    }

    private void OnCancelCell()
    {
        _pendingFloor = null;
        _pendingStack = string.Empty;
    }

    private async Task OnSaveStructure()
    {
        if (_buildingId == Guid.Empty) return;
        _isBusy = true;
        try
        {
            var role = await Access.GetRoleAsync() ?? WorkspaceSecurityRole.PropertyManager;
            await Workspace.UpdateBuildingStructureAsync(Community.Id, _buildingId, _floors, _stairwells, role);
            _message = Loc.T("msg.membershipUpdated");
            await OnStructureChanged.InvokeAsync();
        }
        catch (Exception ex) { _message = ex.Message; }
        finally { _isBusy = false; }
    }

    private async Task OnAddStack()
    {
        if (_buildingId == Guid.Empty || string.IsNullOrWhiteSpace(_newStackCode)) return;
        _isBusy = true;
        try
        {
            var role = await Access.GetRoleAsync() ?? WorkspaceSecurityRole.PropertyManager;
            await Workspace.UpsertRiserStackAsync(Community.Id, _buildingId, _newStackCode.Trim(), "Basement manifold", role);
            _newStackCode = string.Empty;
            await OnStructureChanged.InvokeAsync();
        }
        catch (Exception ex) { _message = ex.Message; }
        finally { _isBusy = false; }
    }

    private async Task OnRemoveStack(string code)
    {
        if (_buildingId == Guid.Empty) return;
        _isBusy = true;
        try
        {
            var role = await Access.GetRoleAsync() ?? WorkspaceSecurityRole.PropertyManager;
            await Workspace.RemoveRiserStackAsync(Community.Id, _buildingId, code, role);
            await OnStructureChanged.InvokeAsync();
        }
        catch (Exception ex) { _message = ex.Message; }
        finally { _isBusy = false; }
    }

    private async Task OnSaveCell()
    {
        if (!_pendingFloor.HasValue || string.IsNullOrWhiteSpace(_pendingStack) || string.IsNullOrWhiteSpace(_newUnitNumber)) return;
        _isBusy = true;
        try
        {
            var role = await Access.GetRoleAsync() ?? WorkspaceSecurityRole.PropertyManager;
            var saved = await Workspace.UpsertUnitCellAsync(Community.Id, _buildingId, _pendingFloor.Value, _pendingStack, _newUnitNumber.Trim(), _newUnitArea, role);
            _pendingFloor = null;
            _pendingStack = string.Empty;
            await OnStructureChanged.InvokeAsync();
            await OnSelectUnit.InvokeAsync(saved.Id);
        }
        catch (Exception ex) { _message = ex.Message; }
        finally { _isBusy = false; }
    }

    private async Task OnRemoveSelected()
    {
        if (_selectedUnit is null) return;
        _isBusy = true;
        try
        {
            var role = await Access.GetRoleAsync() ?? WorkspaceSecurityRole.PropertyManager;
            await Workspace.RemoveUnitCellAsync(Community.Id, _selectedUnit.Id, role);
            await OnStructureChanged.InvokeAsync();
        }
        catch (Exception ex) { _message = ex.Message; }
        finally { _isBusy = false; }
    }

    public void Dispose()
    {
        if (_locHandler is not null) Loc.OnChange -= _locHandler;
    }
}
