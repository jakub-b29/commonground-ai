@using CommonGround.Domain.Entities
@inject WorkspaceLocalization Loc
@implements IDisposable

<div class="cg-card">
    <div class="cg-section-header">
        <h2>@Loc.T("panel.riser")</h2>
        <span class="cg-badge mono">@_selectedStack</span>
    </div>
    <p style="color: var(--color-text-secondary); font-size: 0.78125rem;">@Loc.T("riser.hint")</p>
    <div class="cg-table-wrap">
        <table class="cg-table">
            <thead>
                <tr>
                    <th>@Loc.T("riser.floor")</th>
                    <th>STACK-A1</th>
                    <th>STACK-A2</th>
                    <th>STACK-B1</th>
                </tr>
            </thead>
            <tbody>
                @for (var floor = 4; floor >= 1; floor--)
                {
                    var f = floor;
                    <tr>
                        <td><strong>@Loc.T("riser.floor") @f</strong></td>
                        @foreach (var stack in new[] { "STACK-A1", "STACK-A2", "STACK-B1" })
                        {
                            var s = stack;
                            var unit = Units.FirstOrDefault(u => u.FloorNumber == f && u.VerticalStackCode == s);
                            <td @key="@(f + s)" style="@(s == _selectedStack ? "background-color: var(--color-accent-tint);" : string.Empty)">
                                @if (unit is not null)
                                {
                                    var isSelected = SelectedUnitId == unit.Id;
                                    var hasLeak = unit.Meters.Any(m => m.HasSilentLeakAnomaly);
                                    <button type="button" class="cg-btn @(isSelected ? "cg-btn-primary" : "")" style="width: 100%; justify-content: space-between;" @onclick="() => OnSelectUnit.InvokeAsync(unit.Id)">
                                        <span class="mono">@unit.UnitNumber</span>
                                        @if (hasLeak)
                                        {
                                            <span class="cg-badge cg-badge-err" style="font-size: 0.65rem; padding: 0.05rem 0.3rem;">@Loc.T("riser.leak")</span>
                                        }
                                        else if (unit.CurrentBalance > 0)
                                        {
                                            <span class="cg-badge cg-badge-warn" style="font-size: 0.65rem; padding: 0.05rem 0.3rem;">@Loc.T("riser.arrears")</span>
                                        }
                                    </button>
                                }
                                else
                                {
                                    <span style="color: var(--color-text-muted);">–</span>
                                }
                            </td>
                        }
                    </tr>
                }
                <tr>
                    <td><strong>@Loc.T("riser.ground")</strong></td>
                    <td colspan="3">
                        <div style="display: flex; gap: 0.375rem; flex-wrap: wrap;">
                            @foreach (var groundUnit in Units.Where(u => u.FloorNumber == 0))
                            {
                                var isSelected = SelectedUnitId == groundUnit.Id;
                                <button type="button" class="cg-btn @(isSelected ? "cg-btn-primary" : "")" @key="groundUnit.Id" @onclick="() => OnSelectUnit.InvokeAsync(groundUnit.Id)">
                                    <span class="mono">@groundUnit.UnitNumber</span> (@groundUnit.Kind)
                                </button>
                            }
                        </div>
                    </td>
                </tr>
                <tr>
                    <td><strong>@Loc.T("riser.basement")</strong></td>
                    <td colspan="3" style="font-size: 0.75rem; color: var(--color-text-secondary);">@Loc.T("riser.manifold")</td>
                </tr>
            </tbody>
        </table>
    </div>
    @if (SelectedUnitId != Guid.Empty)
    {
        <div class="cg-toolbar">
            <button type="button" class="cg-btn" @onclick="() => OnBroadcastStackAlert.InvokeAsync(_selectedStack)">@Loc.T("action.broadcastAlert") (@_selectedStack)</button>
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<Unit> Units { get; set; } = [];
    [Parameter] public Guid SelectedUnitId { get; set; }
    [Parameter] public EventCallback<Guid> OnSelectUnit { get; set; }
    [Parameter] public EventCallback<string> OnBroadcastStackAlert { get; set; }
    private string _selectedStack => Units.FirstOrDefault(u => u.Id == SelectedUnitId)?.VerticalStackCode ?? "STACK-A1";
    private Action? _locHandler;

    protected override async Task OnInitializedAsync()
    {
        _locHandler = () => InvokeAsync(StateHasChanged);
        Loc.OnChange += _locHandler;
        await Loc.EnsureLoadedAsync();
    }

    public void Dispose()
    {
        if (_locHandler is not null)
        {
            Loc.OnChange -= _locHandler;
        }
    }
}
