@implements IAsyncDisposable
@inject WorkspaceUiState UiState
@inject WorkspaceLocalization Loc
@inject IJSRuntime JS

<div class="propai-theme-switcher" role="group" aria-label="@Loc.T("shell.themeSelector")">
    <button type="button"
            class="cg-btn cg-btn-sm @(UiState.IsDarkTheme ? "cg-btn-ai" : "cg-btn-ghost")"
            style="padding: 0.25rem 0.52rem; gap: 0.32rem;"
            title="@Loc.T("shell.themeHintDark")"
            aria-pressed="@(UiState.IsDarkTheme ? "true" : "false")"
            @onclick='() => SelectThemeAsync("dark")'>
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
        </svg>
        @if (!Compact)
        {
            <span>@Loc.T("shell.themeDark")</span>
        }
    </button>
    <button type="button"
            class="cg-btn cg-btn-sm @(!UiState.IsDarkTheme ? "cg-btn-ai" : "cg-btn-ghost")"
            style="padding: 0.25rem 0.52rem; gap: 0.32rem;"
            title="@Loc.T("shell.themeHintLight")"
            aria-pressed="@(!UiState.IsDarkTheme ? "true" : "false")"
            @onclick='() => SelectThemeAsync("light")'>
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="5"></circle>
            <line x1="12" y1="1" x2="12" y2="3"></line>
            <line x1="12" y1="21" x2="12" y2="23"></line>
            <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
            <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
            <line x1="1" y1="12" x2="3" y2="12"></line>
            <line x1="21" y1="12" x2="23" y2="12"></line>
            <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
            <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
        </svg>
        @if (!Compact)
        {
            <span>@Loc.T("shell.themeLight")</span>
        }
    </button>
</div>

@code {
    [Parameter] public bool Compact { get; set; }

    private IJSObjectReference? _module;
    private Action? _stateHandler;
    private Action? _locHandler;

    protected override async Task OnInitializedAsync()
    {
        _stateHandler = () => InvokeAsync(StateHasChanged);
        UiState.OnChange += _stateHandler;
        _locHandler = () => InvokeAsync(StateHasChanged);
        Loc.OnChange += _locHandler;
        await Loc.EnsureLoadedAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                _module = await JS.InvokeAsync<IJSObjectReference>(
                    "import", "./Components/Shared/DesignSystem/ThemeSwitcher.razor.js");
                var initialTheme = await _module.InvokeAsync<string>("getStoredTheme");
                UiState.SetTheme(initialTheme);
            }
            catch (JSDisconnectedException)
            {
            }
            catch (ObjectDisposedException)
            {
            }
        }
    }

    private async Task SelectThemeAsync(string theme)
    {
        UiState.SetTheme(theme);
        if (_module is not null)
        {
            try
            {
                await _module.InvokeVoidAsync("applyTheme", theme);
            }
            catch (JSDisconnectedException)
            {
            }
            catch (ObjectDisposedException)
            {
            }
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_stateHandler is not null)
        {
            UiState.OnChange -= _stateHandler;
        }
        if (_locHandler is not null)
        {
            Loc.OnChange -= _locHandler;
        }
        if (_module is not null)
        {
            try
            {
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
            catch (ObjectDisposedException)
            {
            }
        }
    }
}

