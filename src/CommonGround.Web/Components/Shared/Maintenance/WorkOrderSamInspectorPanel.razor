@using CommonGround.Domain.Entities
@using CommonGround.Domain.Enums
@inject CommonGroundWorkspaceService Workspace
@inject WorkspaceLocalization Loc
@implements IDisposable

<div class="cg-card">
    <div class="cg-section-header">
        <h2>@Loc.T("panel.workOrderInspector")</h2>
        @if (_selected is not null)
        {
            <div style="display: flex; gap: 0.375rem;">
                <span class="cg-badge mono">@_selected.VerticalStackCode</span>
                <span class="cg-badge @(_selected.IsSamVerified ? "cg-badge-ok" : "cg-badge-warn")">@_selected.Status</span>
            </div>
        }
    </div>
    <div>
        <label for="woSelect">@Loc.T("form.workOrder")</label>
        <select id="woSelect" value="@_selectedId" @onchange="OnSelect">
            @foreach (var w in WorkOrders)
            {
                <option value="@w.Id" selected="@(_selectedId == w.Id)">@w.Title (@w.Status)</option>
            }
        </select>
    </div>

    @if (_selected is not null)
    {
        <div class="cg-grid-2" style="margin-block-start: 0.75rem;">
            <div>
                <div class="cg-photo-caption">@Loc.T("wo.beforePhoto")</div>
                @if (!string.IsNullOrWhiteSpace(_selected.BeforePhotoDataUrl))
                {
                    <img class="cg-photo-frame" src="@_selected.BeforePhotoDataUrl" alt="Before" />
                }
            </div>
            <div>
                <div class="cg-photo-caption">@Loc.T("wo.samMask") (<span class="num">@_selected.MeasureAreaM2.ToString("N2") m²</span>)</div>
                @if (!string.IsNullOrWhiteSpace(_selected.SamBeforeOverlayDataUrl))
                {
                    <img class="cg-photo-frame" src="@_selected.SamBeforeOverlayDataUrl" alt="SAM overlay" />
                }
            </div>
        </div>

        <div class="cg-grid-3" style="margin-block-start: 0.75rem;">
            <div class="cg-subcard">
                <div class="kpi-label">@Loc.T("wo.measuredArea")</div>
                <div class="kpi-value num" style="font-size: 1.15rem;">@_selected.MeasureAreaM2.ToString("N2") m²</div>
                <div class="kpi-sub">@Loc.T("wo.concept") <span class="mono">@_selected.DefectConcept</span></div>
            </div>
            <div class="cg-subcard">
                <div class="kpi-label">@Loc.T("wo.boundary")</div>
                <div class="kpi-value" style="font-size: 1rem;">@_selected.Boundary</div>
                <div class="kpi-sub">@Loc.T("wo.cited") <span class="mono">@_selected.CitedLegalDocumentCode</span></div>
            </div>
            <div class="cg-subcard">
                <div class="kpi-label">@Loc.T("wo.boqEstimate")</div>
                <div class="kpi-value num" style="font-size: 1.15rem;">@_selected.InvestorBoqEstimateAmount.ToString("N2")</div>
                <div class="kpi-sub">@_selected.InvestorBoqSummary</div>
            </div>
        </div>

        <div class="cg-callout">
            <strong>@Loc.T("wo.statutoryProvision") (<span class="mono">@_selected.CitedLegalDocumentCode</span>):</strong> @_selected.CitedVerbatimLegalExcerpt
            @if (!string.IsNullOrWhiteSpace(_selected.AttachedAccessCodesSummary))
            {
                <div style="margin-block-start: 0.25rem; color: var(--color-text-secondary);">
                    <strong>@Loc.T("wo.dispatchBundle")</strong> @_selected.AttachedAccessCodesSummary · @_selected.AttachedShutoffValveNote
                </div>
            }
        </div>

        <h3>@Loc.T("wo.rfqTitle")</h3>
        @if (_selected.Quotes.Count == 0)
        {
            <p style="color: var(--color-text-secondary); font-size: 0.78125rem;">@Loc.T("msg.noQuotes")</p>
        }
        else
        {
            <div class="cg-table-wrap">
                <table class="cg-table">
                    <thead>
                        <tr>
                            <th>@Loc.T("wo.vendor")</th>
                            <th class="num">@Loc.T("wo.quotedGross")</th>
                            <th class="num">@Loc.T("wo.variance")</th>
                            <th class="num">@Loc.T("wo.warranty")</th>
                            <th>@Loc.T("table.status")</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var q in _selected.Quotes)
                        {
                            <tr @key="q.Id">
                                <td><strong>@q.VendorName</strong></td>
                                <td class="num">@q.QuotedGrossAmount.ToString("N2")</td>
                                <td class="num">+@q.VarianceVsBoqPercent.ToString("N1") %</td>
                                <td class="num">@q.WarrantyMonths mo</td>
                                <td>
                                    <span class="cg-badge @(q.IsRecommended ? "cg-badge-ok" : "")">@(q.IsRecommended ? Loc.T("wo.recommended") : Loc.T("wo.alternate"))</span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }

        <div class="cg-toolbar">
            <button type="button" class="cg-btn cg-btn-primary" disabled="@_isBusy" @onclick="OnVerify">@Loc.T("action.verifyAfter")</button>
        </div>

        @if (!string.IsNullOrWhiteSpace(_selected.AfterPhotoDataUrl))
        {
            <div class="cg-grid-2" style="margin-block-start: 0.75rem;">
                <div>
                    <div class="cg-photo-caption">@Loc.T("wo.afterPhoto")</div>
                    <img class="cg-photo-frame" src="@_selected.AfterPhotoDataUrl" alt="After" />
                </div>
                <div>
                    <div class="cg-photo-caption">@Loc.T("wo.verificationScan") (<span class="num">@((_selected.AfterDefectAreaM2 ?? 0m).ToString("N2")) m²</span> @Loc.T("wo.remaining"))</div>
                    <img class="cg-photo-frame" src="@_selected.SamAfterOverlayDataUrl" alt="Verification" />
                </div>
            </div>
        }
    }
    @if (!string.IsNullOrWhiteSpace(_message))
    {
        <div role="status" aria-live="polite" class="cg-callout">@_message</div>
    }
</div>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<WorkOrder> WorkOrders { get; set; } = [];
    [Parameter, EditorRequired] public Guid CommunityId { get; set; }
    [Parameter] public EventCallback OnChanged { get; set; }
    private Guid _selectedId;
    private WorkOrder? _selected;
    private bool _isBusy;
    private string _message = string.Empty;
    private Action? _locHandler;

    protected override async Task OnInitializedAsync()
    {
        _locHandler = () => InvokeAsync(StateHasChanged);
        Loc.OnChange += _locHandler;
        await Loc.EnsureLoadedAsync();
    }

    protected override void OnParametersSet()
    {
        if (_selectedId == Guid.Empty && WorkOrders.Count > 0)
        {
            var preferred = WorkOrders.FirstOrDefault(w => w.Status == WorkOrderStatus.PendingSamVerification || w.Quotes.Count > 0) ?? WorkOrders[0];
            _selectedId = preferred.Id;
            _selected = preferred;
        }
        else
        {
            _selected = WorkOrders.FirstOrDefault(w => w.Id == _selectedId);
        }
    }

    private Task OnSelect(ChangeEventArgs e)
    {
        if (Guid.TryParse(e.Value?.ToString(), out var id))
        {
            _selectedId = id;
            _selected = WorkOrders.FirstOrDefault(w => w.Id == id);
        }
        return Task.CompletedTask;
    }

    private async Task OnVerify()
    {
        if (_selected is null) return;
        _isBusy = true;
        try
        {
            var updated = await Workspace.VerifyContractorRepairPhotoAsync(CommunityId, _selected.Id);
            _selected = updated;
            _message = updated.IsSamVerified ? Loc.T("msg.repairVerified") : Loc.T("msg.repairFailed");
            await OnChanged.InvokeAsync();
        }
        catch (Exception ex) { _message = ex.Message; }
        finally { _isBusy = false; }
    }

    public void Dispose()
    {
        if (_locHandler is not null)
        {
            Loc.OnChange -= _locHandler;
        }
    }
}
