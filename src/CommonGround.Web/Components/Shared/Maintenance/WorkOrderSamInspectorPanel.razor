@using CommonGround.Domain.Entities
@inject CommonGroundWorkspaceService Workspace
<div class="cg-card" style="margin-top:0.875rem;">
<h2>Work order inspector</h2>
<label for="woSelect">Work order</label>
<select id="woSelect" value="@_selectedId" @onchange="OnSelect" style="width:100%;">
@foreach (var w in WorkOrders) { <option value="@w.Id" selected="@(_selectedId == w.Id)">@w.Title (@w.Status)</option> }
</select>
@if (_selected is not null) {
<div class="cg-grid-2" style="margin-top:0.5rem;">
<div><div>Before photo</div>@if (!string.IsNullOrWhiteSpace(_selected.BeforePhotoDataUrl)) { <img class="cg-photo-frame" src="@_selected.BeforePhotoDataUrl" alt="Before" /> }</div>
<div><div>SAM segmented overlay</div>@if (!string.IsNullOrWhiteSpace(_selected.SamBeforeOverlayDataUrl)) { <img class="cg-photo-frame" src="@_selected.SamBeforeOverlayDataUrl" alt="SAM overlay" /> }</div>
</div>
<div>Measured area: <span class="num">@_selected.MeasureAreaM2.ToString("N2") m2</span></div>
<div style="font-size:0.8rem;">Cited: @_selected.CitedLegalDocumentCode. @_selected.CitedVerbatimLegalExcerpt</div>
<div style="font-size:0.8rem;">BOQ: <span class="num">@_selected.InvestorBoqEstimateAmount.ToString("N2")</span>. @_selected.InvestorBoqSummary</div>
<div class="cg-table-wrap"><table class="cg-table"><thead><tr><th>Vendor</th><th class="num">Quote</th><th class="num">Variance</th><th>Recommended</th></tr></thead><tbody>
@foreach (var q in _selected.Quotes) { <tr @key="q.Id"><td>@q.VendorName</td><td class="num">@q.QuotedGrossAmount.ToString("N2")</td><td class="num">@q.VarianceVsBoqPercent.ToString("N1") %</td><td>@(q.IsRecommended ? "Yes" : "No")</td></tr> }
</tbody></table></div>
<button type="button" class="cg-btn cg-btn-primary" disabled="@_isBusy" @onclick="OnVerify">Verify contractor after-photo (sam-3.1)</button>
@if (!string.IsNullOrWhiteSpace(_selected.AfterPhotoDataUrl)) {
<div class="cg-grid-2" style="margin-top:0.375rem;"><div><div>After photo</div><img class="cg-photo-frame" src="@_selected.AfterPhotoDataUrl" alt="After" /></div><div><div>SAM verification scan</div><img class="cg-photo-frame" src="@_selected.SamAfterOverlayDataUrl" alt="Verification" /></div></div>
<div>After area: <span class="num">@((_selected.AfterDefectAreaM2 ?? 0m).ToString("N2")) m2</span>. Verified: @_selected.IsSamVerified.</div>
}
}
@if (!string.IsNullOrWhiteSpace(_message)) { <div role="status" aria-live="polite">@_message</div> }
</div>
@code {
[Parameter, EditorRequired] public IReadOnlyList<WorkOrder> WorkOrders { get; set; } = [];
[Parameter, EditorRequired] public Guid CommunityId { get; set; }
[Parameter] public EventCallback OnChanged { get; set; }
private Guid _selectedId;
private WorkOrder? _selected;
private bool _isBusy;
private string _message = string.Empty;
protected override void OnParametersSet() { if (_selectedId == Guid.Empty && WorkOrders.Count > 0) { _selectedId = WorkOrders[0].Id; _selected = WorkOrders[0]; } else { _selected = WorkOrders.FirstOrDefault(w => w.Id == _selectedId); } }
private Task OnSelect(ChangeEventArgs e) { if (Guid.TryParse(e.Value?.ToString(), out var id)) { _selectedId = id; _selected = WorkOrders.FirstOrDefault(w => w.Id == id); } return Task.CompletedTask; }
private async Task OnVerify() { if (_selected is null) return; _isBusy = true; try { var updated = await Workspace.VerifyContractorRepairPhotoAsync(CommunityId, _selected.Id); _selected = updated; _message = updated.IsSamVerified ? "Repair verified. Invoice unlocked for payment." : "Verification failed. Punch-list rejection drafted."; await OnChanged.InvokeAsync(); } catch (Exception ex) { _message = ex.Message; } finally { _isBusy = false; } }
}
