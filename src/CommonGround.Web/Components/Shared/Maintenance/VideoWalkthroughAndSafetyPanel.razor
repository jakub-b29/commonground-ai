@inject CommonGroundWorkspaceService Workspace
@inject WorkspaceLocalization Loc
@implements IDisposable

<div class="cg-card">
    <div class="cg-section-header">
        <h2>@Loc.T("panel.walkthrough")</h2>
        <span class="cg-badge">@Loc.T("walkthrough.splitterBadge")</span>
    </div>
    <p style="color: var(--color-text-secondary); font-size: 0.78125rem;">@Loc.T("walkthrough.hint")</p>
    <div class="cg-toolbar">
        <button type="button" class="cg-btn cg-btn-primary" disabled="@_isBusy" @onclick="OnSplit">@Loc.T("action.segmentVideo")</button>
        <button type="button" class="cg-btn" disabled="@_isBusy" @onclick="OnScan">@Loc.T("action.scanSafety")</button>
    </div>
    @if (!string.IsNullOrWhiteSpace(_message))
    {
        <div role="status" aria-live="polite" class="cg-callout">@_message</div>
    }
</div>

@code {
    [Parameter, EditorRequired] public Guid CommunityId { get; set; }
    [Parameter] public EventCallback OnChanged { get; set; }
    private bool _isBusy;
    private string _message = string.Empty;
    private Action? _locHandler;

    protected override async Task OnInitializedAsync()
    {
        _locHandler = () => InvokeAsync(StateHasChanged);
        Loc.OnChange += _locHandler;
        await Loc.EnsureLoadedAsync();
    }

    private async Task OnSplit()
    {
        _isBusy = true;
        try
        {
            var list = await Workspace.RunWalkthroughVideoSplitAsync(CommunityId);
            _message = $"{list.Count} {Loc.T("msg.walkthroughSplit")}";
            await OnChanged.InvokeAsync();
        }
        catch (Exception ex) { _message = ex.Message; }
        finally { _isBusy = false; }
    }

    private async Task OnScan()
    {
        _isBusy = true;
        try
        {
            var wo = await Workspace.RunSiteSafetyVisionMonitorAsync(CommunityId);
            _message = $"{Loc.T("msg.safetyCreated")} {wo.Title}.";
            await OnChanged.InvokeAsync();
        }
        catch (Exception ex) { _message = ex.Message; }
        finally { _isBusy = false; }
    }

    public void Dispose()
    {
        if (_locHandler is not null)
        {
            Loc.OnChange -= _locHandler;
        }
    }
}
