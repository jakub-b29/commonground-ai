@using CommonGround.Application.Services
@inject CommonGroundWorkspaceService Workspace

<div class="cg-card">
    <div class="cg-section-header">
        <h2>Tariff and inflation simulator</h2>
        <span class="cg-badge">Assessment impact</span>
    </div>
    <div class="cg-grid-2">
        <div>
            <label for="heatPct">Heating change (%)</label>
            <input id="heatPct" type="number" step="0.5" @bind="_heat" />
        </div>
        <div>
            <label for="elecPct">Electricity change (%)</label>
            <input id="elecPct" type="number" step="0.5" @bind="_elec" />
        </div>
        <div>
            <label for="wagePct">Cleaning and wage change (%)</label>
            <input id="wagePct" type="number" step="0.5" @bind="_wage" />
        </div>
        <div>
            <label for="repPct">Reserve rate change (%)</label>
            <input id="repPct" type="number" step="0.5" @bind="_rep" />
        </div>
    </div>
    <div class="cg-toolbar">
        <button type="button" class="cg-btn cg-btn-primary" disabled="@_isBusy" @onclick="OnRun">Run inflation simulation</button>
    </div>

    @if (_result is not null)
    {
        <div class="cg-callout" style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 0.5rem;">
            <span>Average assessment increase: <strong class="num">@_result.AverageIncreasePct.ToString("N2") %</strong></span>
            <span class="cg-badge @(_result.ExceedsUsHoaStatutory20PercentCap ? "cg-badge-warn" : "cg-badge-ok")">
                @(_result.ExceedsUsHoaStatutory20PercentCap ? "Exceeds US HOA 20% cap" : "Within 20% statutory cap")
            </span>
        </div>
        <div class="cg-table-wrap" style="max-height: 220px; overflow-y: auto;">
            <table class="cg-table">
                <thead>
                    <tr>
                        <th>Unit</th>
                        <th class="num">Before</th>
                        <th class="num">After</th>
                        <th class="num">Delta</th>
                        <th class="num">%</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var d in _result.UnitDeltas)
                    {
                        <tr @key="d.UnitId">
                            <td class="mono"><strong>@d.UnitNumber</strong></td>
                            <td class="num">@d.BeforeTotal.ToString("N2")</td>
                            <td class="num">@d.AfterTotal.ToString("N2")</td>
                            <td class="num">+@d.DeltaAmount.ToString("N2")</td>
                            <td class="num">@d.DeltaPercent.ToString("N2") %</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired] public Guid CommunityId { get; set; }
    private decimal _heat = 10, _elec = 10, _wage = 5, _rep = 5;
    private bool _isBusy;
    private InflationSimulationResult? _result;

    private async Task OnRun()
    {
        _isBusy = true;
        try
        {
            _result = await Workspace.RunInflationSimulationAsync(CommunityId, _heat, _elec, _wage, _rep);
        }
        finally
        {
            _isBusy = false;
        }
    }
}
