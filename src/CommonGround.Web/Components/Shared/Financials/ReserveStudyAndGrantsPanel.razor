@using CommonGround.Application.Services
@using CommonGround.Domain.Calculators
<div class="cg-card" style="margin-top:0.875rem;">
<h2>Reserve study and green grants</h2>
@if (_result is null) { <button type="button" class="cg-btn cg-btn-primary" @onclick="OnProject">Project 10-year reserve cashflow</button> }
else {
<div>Percent funded: <span class="num">@_result.PercentFunded.ToString("N2") %</span>. Minimum rate: <span class="num">@_result.MinimumMonthlyRatePerM2ToAvoidDeficit.ToString("N2")</span> per m2.</div>
<div class="cg-table-wrap"><table class="cg-table"><thead><tr><th class="num">Year</th><th class="num">Starting</th><th class="num">Inflow</th><th class="num">Capex</th><th class="num">Ending</th></tr></thead><tbody>
@foreach (var y in _result.Years) { <tr @key="y.Year"><td class="num">@y.Year</td><td class="num">@y.StartingBalance.ToString("N2")</td><td class="num">@y.AnnualInflow.ToString("N2")</td><td class="num">@y.AnnualCapexOutflow.ToString("N2")</td><td class="num">@y.EndingBalance.ToString("N2")</td></tr> }
</tbody></table></div>
}
<h3>Green grants</h3>
@foreach (var g in Snapshot.Community.GreenSubsidies) { <div @key="g.Id" style="font-size:0.8rem;">@g.ProgramName - @g.UpgradeScope: gross <span class="num">@g.EstimatedGrossCapex.ToString("N2")</span>, grant <span class="num">@g.GrantSubsidyAmount.ToString("N2")</span>, net <span class="num">@g.NetCommunityCapex.ToString("N2")</span>, payback <span class="num">@g.PaybackYears.ToString("N1")</span> years.</div> }
</div>
@code {
[Parameter, EditorRequired] public CommunityWorkspaceSnapshot Snapshot { get; set; } = default!;
private ReserveStudyResult? _result;
private void OnProject() {
var c = Snapshot.Community;
_result = ReserveStudyCalculator.Project(c.LedgerAccounts.Where(a => a.Fund == FundKind.RepairReserve).Sum(a => a.Balance), c.Units.Sum(u => u.FloorAreaM2), c.RepairFundRatePerM2, c.ReserveComponents, DateTime.UtcNow.Year);
}
}
