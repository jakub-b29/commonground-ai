@using CommonGround.Application.Services
@using CommonGround.Domain.Calculators
@inject WorkspaceLocalization Loc
@implements IDisposable

<div class="cg-card">
    <div class="cg-section-header">
        <h2>@Loc.T("panel.reserve")</h2>
        <button type="button" class="cg-btn cg-btn-primary" @onclick="OnProject">@Loc.T("action.projectReserve")</button>
    </div>
    @if (_result is not null)
    {
        <div class="cg-callout" style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 0.5rem;">
            <span>@Loc.T("reserve.percentFunded") <strong class="num">@_result.PercentFunded.ToString("N2") %</strong></span>
            <span>@Loc.T("reserve.minRate") <strong class="num">@_result.MinimumMonthlyRatePerM2ToAvoidDeficit.ToString("N2") / m²</strong></span>
        </div>
        <div class="cg-table-wrap" style="max-height: 200px; overflow-y: auto;">
            <table class="cg-table">
                <thead>
                    <tr>
                        <th class="num">@Loc.T("reserve.year")</th>
                        <th class="num">@Loc.T("reserve.starting")</th>
                        <th class="num">@Loc.T("reserve.inflow")</th>
                        <th class="num">@Loc.T("reserve.capex")</th>
                        <th class="num">@Loc.T("reserve.ending")</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var y in _result.Years)
                    {
                        <tr @key="y.Year">
                            <td class="num"><strong>@y.Year</strong></td>
                            <td class="num">@y.StartingBalance.ToString("N2")</td>
                            <td class="num">@y.AnnualInflow.ToString("N2")</td>
                            <td class="num">@y.AnnualCapexOutflow.ToString("N2")</td>
                            <td class="num">@y.EndingBalance.ToString("N2")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    <h3>@Loc.T("reserve.matchedTitle")</h3>
    <div class="cg-table-wrap">
        <table class="cg-table">
            <thead>
                <tr>
                    <th>@Loc.T("reserve.program")</th>
                    <th class="num">@Loc.T("reserve.gross")</th>
                    <th class="num">@Loc.T("reserve.grant")</th>
                    <th class="num">@Loc.T("reserve.net")</th>
                    <th class="num">@Loc.T("reserve.payback")</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var g in Snapshot.Community.GreenSubsidies)
                {
                    <tr @key="g.Id">
                        <td>
                            <strong>@g.ProgramName</strong>
                            <div style="font-size: 0.72rem; color: var(--color-text-secondary);">@g.UpgradeScope</div>
                        </td>
                        <td class="num">@g.EstimatedGrossCapex.ToString("N0")</td>
                        <td class="num">@g.GrantSubsidyAmount.ToString("N0") (@g.GrantSubsidyPercent.ToString("N0")%)</td>
                        <td class="num"><strong>@g.NetCommunityCapex.ToString("N0")</strong></td>
                        <td class="num">@g.PaybackYears.ToString("N1") @Loc.T("reserve.yearsSuffix")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public CommunityWorkspaceSnapshot Snapshot { get; set; } = default!;
    private ReserveStudyResult? _result;
    private Action? _locHandler;

    protected override async Task OnInitializedAsync()
    {
        _locHandler = () => InvokeAsync(StateHasChanged);
        Loc.OnChange += _locHandler;
        await Loc.EnsureLoadedAsync();
    }

    protected override void OnParametersSet()
    {
        if (_result is null)
        {
            OnProject();
        }
    }

    private void OnProject()
    {
        var c = Snapshot.Community;
        _result = ReserveStudyCalculator.Project(
            c.LedgerAccounts.Where(a => a.Fund == FundKind.RepairReserve).Sum(a => a.Balance),
            c.Units.Sum(u => u.FloorAreaM2),
            c.RepairFundRatePerM2,
            c.ReserveComponents,
            DateTime.UtcNow.Year);
    }

    public void Dispose()
    {
        if (_locHandler is not null)
        {
            Loc.OnChange -= _locHandler;
        }
    }
}
