@using CommonGround.Application.Services
@inject WorkspaceLocalization Loc
@implements IDisposable

<div class="cg-card">
    <div class="cg-section-header">
        <h2>@Loc.T("panel.fundLedger")</h2>
        <span class="cg-badge cg-badge-ok">@Loc.T("ledger.balanced")</span>
    </div>
    <div class="cg-table-wrap">
        <table class="cg-table">
            <thead>
                <tr>
                    <th>@Loc.T("table.code")</th>
                    <th>@Loc.T("table.account")</th>
                    <th>@Loc.T("table.fund")</th>
                    <th class="num">@Loc.T("table.balance") (@Snapshot.Community.CurrencyCode)</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var a in Snapshot.Community.LedgerAccounts.OrderBy(a => a.Code))
                {
                    <tr @key="a.Id">
                        <td class="mono"><strong>@a.Code</strong></td>
                        <td>@a.Name</td>
                        <td><span class="cg-badge">@a.Fund</span></td>
                        <td class="num">@a.Balance.ToString("N2")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="cg-grid-2" style="margin-block-start: 0.75rem;">
        <div>
            <h3 style="margin-block-start: 0 !important;">@Loc.T("ledger.journalTitle")</h3>
            <div class="cg-table-wrap">
                <table class="cg-table">
                    <thead>
                        <tr><th>@Loc.T("table.ref")</th><th>@Loc.T("table.description")</th><th>@Loc.T("table.status")</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var j in Snapshot.Community.JournalEntries)
                        {
                            <tr @key="j.Id">
                                <td class="mono">@j.ReferenceNumber</td>
                                <td>@j.Description</td>
                                <td>
                                    <span class="cg-badge @(j.IsBalanced() ? "cg-badge-ok" : "cg-badge-err")">
                                        @(j.IsBalanced() ? Loc.T("ledger.balanced") : Loc.T("ledger.unbalanced"))
                                    </span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <div>
            <h3 style="margin-block-start: 0 !important;">@Loc.T("ledger.commercialTitle")</h3>
            <div class="cg-table-wrap">
                <table class="cg-table">
                    <thead>
                        <tr><th>@Loc.T("ledger.tenant")</th><th class="num">@Loc.T("ledger.monthlyOffset")</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var c in Snapshot.Community.CommercialContracts)
                        {
                            <tr @key="c.Id">
                                <td>
                                    <strong>@c.TenantOrAdvertiserName</strong>
                                    <div style="font-size: 0.72rem; color: var(--color-text-secondary);">@c.AssetType</div>
                                </td>
                                <td class="num">@c.MonthlyGrossRevenue.ToString("N2") @Snapshot.Community.CurrencyCode</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public CommunityWorkspaceSnapshot Snapshot { get; set; } = default!;
    private Action? _locHandler;

    protected override async Task OnInitializedAsync()
    {
        _locHandler = () => InvokeAsync(StateHasChanged);
        Loc.OnChange += _locHandler;
        await Loc.EnsureLoadedAsync();
    }

    public void Dispose()
    {
        if (_locHandler is not null)
        {
            Loc.OnChange -= _locHandler;
        }
    }
}
