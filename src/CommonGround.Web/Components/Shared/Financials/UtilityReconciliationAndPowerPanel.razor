@using CommonGround.Domain.Enums
@using CommonGround.Application.Services
@inject CommonGroundWorkspaceService Workspace

<div class="cg-card">
    <div class="cg-section-header">
        <h2>Utility reconciliation and power audit</h2>
        <span class="cg-badge">Sub-meter & RUBS</span>
    </div>
    <div>
        <label for="rubspolicy">Allocation policy</label>
        <select id="rubspolicy" @bind="_policy">
            @foreach (var p in Enum.GetValues<UtilityAllocationPolicy>())
            {
                <option value="@p">@p</option>
            }
        </select>
    </div>
    <div class="cg-toolbar">
        <button type="button" class="cg-btn cg-btn-primary" disabled="@_isBusy" @onclick="OnSettle">Run bulk utility reconciliation</button>
        <button type="button" class="cg-btn" disabled="@_isBusy" @onclick="OnMatch">Match unstructured bank transfers</button>
        <button type="button" class="cg-btn" disabled="@_isBusy" @onclick="OnAudit">Run contracted power audit</button>
    </div>
    @if (!string.IsNullOrWhiteSpace(_message))
    {
        <div role="status" aria-live="polite" class="cg-callout">@_message</div>
    }
    @if (_period is not null)
    {
        <div class="cg-table-wrap" style="margin-block-start: 0.5rem; max-height: 240px; overflow-y: auto;">
            <table class="cg-table">
                <thead>
                    <tr>
                        <th>Unit</th>
                        <th class="num">Meter (m³)</th>
                        <th class="num">Actual</th>
                        <th class="num">Advances</th>
                        <th class="num">Net delta</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in _period.UnitResults)
                    {
                        <tr @key="r.Id">
                            <td class="mono"><strong>@r.UnitNumber</strong></td>
                            <td class="num">@r.SubMeterConsumption.ToString("N3")</td>
                            <td class="num">@r.TotalActualCost.ToString("N2")</td>
                            <td class="num">@r.AdvancesPaid.ToString("N2")</td>
                            <td class="num">@r.NetBalanceDelta.ToString("N2")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired] public Guid CommunityId { get; set; }
    private UtilityAllocationPolicy _policy = UtilityAllocationPolicy.SubMeterPlusShareLoss;
    private bool _isBusy;
    private string _message = string.Empty;
    private UtilitySettlementPeriod? _period;

    private async Task OnSettle()
    {
        _isBusy = true;
        try
        {
            _period = await Workspace.RunBulkUtilitySettlementAsync(CommunityId, _policy);
            _message = $"Settled {_period.UnitResults.Count} units. Unallocated loss {_period.UnallocatedCommonLossConsumption:N3} m³.";
        }
        catch (Exception ex) { _message = ex.Message; }
        finally { _isBusy = false; }
    }

    private async Task OnMatch()
    {
        _isBusy = true;
        try
        {
            var tx = await Workspace.AutoMatchBankTransfersAsync(CommunityId);
            _message = $"Reviewed {tx.Count} transfers. Applied: {tx.Count(t => t.IsAppliedToLedger)}.";
        }
        catch (Exception ex) { _message = ex.Message; }
        finally { _isBusy = false; }
    }

    private async Task OnAudit()
    {
        _isBusy = true;
        try
        {
            var r = await Workspace.RunContractedPowerAuditAsync(CommunityId);
            _message = r.Summary;
        }
        catch (Exception ex) { _message = ex.Message; }
        finally { _isBusy = false; }
    }
}
