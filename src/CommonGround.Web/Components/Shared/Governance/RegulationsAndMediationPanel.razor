@using CommonGround.Domain.Entities
@inject CommonGroundWorkspaceService Workspace
<div class="cg-card" style="margin-top:0.875rem;">
<h2>Legal corpus studio and dispute mediation</h2>
<button type="button" class="cg-btn" disabled="@_isBusy" @onclick="OnAcquire">Acquire and sync statutory legal texts (muse-wonder)</button>
<div class="cg-table-wrap" style="margin-top:0.375rem;"><table class="cg-table"><thead><tr><th>Code</th><th>Title</th><th>Authority</th><th>Citation</th><th>Model</th></tr></thead><tbody>
@foreach (var d in Documents) { <tr @key="d.Id" @onclick="() => Select(d.Id)" style="@(_selectedId == d.Id ? "background: var(--color-bg-subtle);" : "cursor:pointer;")"><td class="mono">@d.DocumentCode</td><td>@d.Title</td><td>@d.IssuingAuthority</td><td>@d.OfficialCitation</td><td class="mono">@d.AcquiredByModel</td></tr> }
</tbody></table></div>
<div style="margin-top:0.375rem;"><label for="legal-filter">Article filter</label><input id="legal-filter" @bind="_filter" @bind:event="oninput" placeholder="Art. 12, Art. 23, 568, 718.112, warranty, riser, quorum" style="width:100%;" /></div>
@if (_selected is not null) {
<div style="margin-top:0.375rem;"><strong>@_selected.Title</strong><div style="font-size:0.75rem;color:var(--color-text-secondary);">@_selected.KeyProvisionsSummary Applied: @_selected.AppliedInModules</div>
<div style="white-space:pre-wrap;font-size:0.8rem;margin-top:0.25rem;">@FilteredText(_selected.VerbatimLegalText)</div></div>
}
<h3 style="margin-top:0.5rem;">Neighbor dispute mediation</h3>
<div class="cg-grid-2">
<div><label for="repUnit">Reporting unit</label><input id="repUnit" @bind="_reporter" style="width:100%;" /></div>
<div><label for="subUnit">Subject unit</label><input id="subUnit" @bind="_subject" style="width:100%;" /></div>
</div>
<div style="margin-top:0.375rem;"><label for="issueText">Issue description</label><textarea id="issueText" @bind="_issue" rows="2" style="width:100%;"></textarea></div>
<button type="button" class="cg-btn" disabled="@_isBusy" @onclick="OnMediate" style="margin-top:0.375rem;">Draft mediation notice</button>
@if (!string.IsNullOrWhiteSpace(_mediation)) { <div role="status" aria-live="polite" style="margin-top:0.375rem;white-space:pre-wrap;">@_mediation</div> }
@if (!string.IsNullOrWhiteSpace(_message)) { <div role="status" aria-live="polite">@_message</div> }
</div>
@code {
[Parameter, EditorRequired] public IReadOnlyList<LegalDocumentSource> Documents { get; set; } = [];
[Parameter, EditorRequired] public Guid CommunityId { get; set; }
[Parameter] public EventCallback OnChanged { get; set; }
private Guid _selectedId;
private LegalDocumentSource? _selected;
private string _filter = string.Empty;
private string _reporter = "A-201";
private string _subject = "A-202";
private string _issue = "Nighttime noise after 23:00.";
private string _mediation = string.Empty;
private string _message = string.Empty;
private bool _isBusy;
protected override void OnParametersSet() { if (_selectedId == Guid.Empty && Documents.Count > 0) _selectedId = Documents[0].Id; _selected = Documents.FirstOrDefault(d => d.Id == _selectedId); }
private void Select(Guid id) { _selectedId = id; _selected = Documents.FirstOrDefault(d => d.Id == id); }
private string FilteredText(string text) { if (string.IsNullOrWhiteSpace(_filter)) return text; var lines = text.Split('\n'); var matched = lines.Where(l => l.Contains(_filter, StringComparison.OrdinalIgnoreCase)).ToList(); return matched.Count == 0 ? "No article matches the filter." : string.Join("\n", matched); }
private async Task OnAcquire() { _isBusy = true; try { await Workspace.AcquireAndSyncLegalDocumentsAsync(CommunityId); _message = "Statutory legal texts synced."; await OnChanged.InvokeAsync(); } catch (Exception ex) { _message = ex.Message; } finally { _isBusy = false; } }
private async Task OnMediate() { _isBusy = true; try { _mediation = await Workspace.DraftNeighborDisputeMediationAsync(CommunityId, _reporter, _subject, _issue); } catch (Exception ex) { _mediation = ex.Message; } finally { _isBusy = false; } }
}
