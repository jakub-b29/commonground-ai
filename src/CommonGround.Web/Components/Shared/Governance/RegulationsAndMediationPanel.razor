@using CommonGround.Domain.Entities
@inject CommonGroundWorkspaceService Workspace

<div class="cg-split-main-aside">
    <div class="cg-card">
        <div class="cg-section-header">
            <h2>Legal corpus studio</h2>
            <button type="button" class="cg-btn cg-btn-primary" disabled="@_isBusy" @onclick="OnAcquire">Acquire and sync statutory legal texts (muse-wonder)</button>
        </div>
        <div class="cg-table-wrap">
            <table class="cg-table">
                <thead>
                    <tr>
                        <th>Code</th>
                        <th>Title & authority</th>
                        <th>Official citation</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var d in Documents)
                    {
                        var isSelected = _selectedId == d.Id;
                        <tr @key="d.Id" @onclick="() => Select(d.Id)" style="@(isSelected ? "background: var(--color-accent-tint); cursor: pointer;" : "cursor: pointer;")">
                            <td class="mono"><strong>@d.DocumentCode</strong></td>
                            <td>
                                <strong>@d.Title</strong>
                                <div style="font-size: 0.72rem; color: var(--color-text-secondary);">@d.IssuingAuthority</div>
                            </td>
                            <td style="font-size: 0.75rem;">@d.OfficialCitation</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div style="margin-block-start: 0.75rem;">
            <label for="legal-filter">Article & keyword filter</label>
            <input id="legal-filter" @bind="_filter" @bind:event="oninput" placeholder="Art. 12, Art. 23, 568, 718.112, warranty, riser, quorum" />
        </div>

        @if (_selected is not null)
        {
            <div class="cg-subcard" style="margin-block-start: 0.625rem;">
                <div style="display: flex; align-items: center; justify-content: space-between; gap: 0.5rem; flex-wrap: wrap;">
                    <strong>@_selected.Title</strong>
                    <span class="cg-badge mono">@_selected.DocumentCode</span>
                </div>
                <div style="font-size: 0.72rem; color: var(--color-text-secondary); margin-block: 0.25rem 0.45rem;">
                    @_selected.KeyProvisionsSummary · Applied in: @_selected.AppliedInModules
                </div>
                <div class="mono" style="white-space: pre-wrap; font-size: 0.75rem; background: var(--color-bg-surface); padding: 0.625rem; border: 1px solid var(--color-border-subtle); border-radius: var(--radius-control);">@FilteredText(_selected.VerbatimLegalText)</div>
            </div>
        }
        @if (!string.IsNullOrWhiteSpace(_message))
        {
            <div role="status" aria-live="polite" class="cg-callout">@_message</div>
        }
    </div>

    <div class="cg-card">
        <div class="cg-section-header">
            <h2>Neighbor dispute mediation</h2>
            <span class="cg-badge">House rules citation</span>
        </div>
        <p style="color: var(--color-text-secondary); font-size: 0.78125rem;">Draft a neutral mediation notice quoting exact clauses from the community's House Rules and Municipal Ordinances.</p>
        <div class="cg-grid-2">
            <div>
                <label for="repUnit">Reporting unit</label>
                <input id="repUnit" @bind="_reporter" />
            </div>
            <div>
                <label for="subUnit">Subject unit</label>
                <input id="subUnit" @bind="_subject" />
            </div>
        </div>
        <div style="margin-block-start: 0.5rem;">
            <label for="issueText">Issue description</label>
            <textarea id="issueText" @bind="_issue" rows="3"></textarea>
        </div>
        <div class="cg-toolbar">
            <button type="button" class="cg-btn cg-btn-primary" disabled="@_isBusy" @onclick="OnMediate">Draft mediation notice</button>
        </div>
        @if (!string.IsNullOrWhiteSpace(_mediation))
        {
            <div role="status" aria-live="polite" class="cg-callout" style="white-space: pre-wrap;">@_mediation</div>
        }
    </div>
</div>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<LegalDocumentSource> Documents { get; set; } = [];
    [Parameter, EditorRequired] public Guid CommunityId { get; set; }
    [Parameter] public EventCallback OnChanged { get; set; }
    private Guid _selectedId;
    private LegalDocumentSource? _selected;
    private string _filter = string.Empty;
    private string _reporter = "A-201";
    private string _subject = "A-202";
    private string _issue = "Nighttime noise after 23:00.";
    private string _mediation = string.Empty;
    private string _message = string.Empty;
    private bool _isBusy;

    protected override void OnParametersSet()
    {
        if (_selectedId == Guid.Empty && Documents.Count > 0) _selectedId = Documents[0].Id;
        _selected = Documents.FirstOrDefault(d => d.Id == _selectedId);
    }

    private void Select(Guid id)
    {
        _selectedId = id;
        _selected = Documents.FirstOrDefault(d => d.Id == id);
    }

    private string FilteredText(string text)
    {
        if (string.IsNullOrWhiteSpace(_filter)) return text;
        var lines = text.Split('\n');
        var matched = lines.Where(l => l.Contains(_filter, StringComparison.OrdinalIgnoreCase)).ToList();
        return matched.Count == 0 ? "No article matches the filter." : string.Join("\n", matched);
    }

    private async Task OnAcquire()
    {
        _isBusy = true;
        try
        {
            await Workspace.AcquireAndSyncLegalDocumentsAsync(CommunityId);
            _message = "Statutory legal texts synced.";
            await OnChanged.InvokeAsync();
        }
        catch (Exception ex) { _message = ex.Message; }
        finally { _isBusy = false; }
    }

    private async Task OnMediate()
    {
        _isBusy = true;
        try
        {
            _mediation = await Workspace.DraftNeighborDisputeMediationAsync(CommunityId, _reporter, _subject, _issue);
        }
        catch (Exception ex) { _mediation = ex.Message; }
        finally { _isBusy = false; }
    }
}
