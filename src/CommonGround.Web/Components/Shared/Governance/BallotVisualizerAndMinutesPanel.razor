@using CommonGround.Domain.Entities
@inject CommonGroundWorkspaceService Workspace
@inject WorkspaceLocalization Loc
@implements IDisposable

<div class="cg-card">
    <div class="cg-section-header">
        <h2>@Loc.T("panel.ballotVisual")</h2>
        <span class="cg-badge">@Loc.T("ballot.previewsBadge")</span>
    </div>
    <div>
        <label for="visRes">@Loc.T("form.visualizedResolution")</label>
        <select id="visRes" value="@_selectedId" @onchange="OnSelect">
            @foreach (var r in Resolutions.OrderBy(r => r.Number))
            {
                <option value="@r.Id" selected="@(_selectedId == r.Id)">@r.Number – @r.Title</option>
            }
        </select>
    </div>
    <div class="cg-toolbar">
        <button type="button" class="cg-btn cg-btn-primary" disabled="@(_isBusy || _selectedId == Guid.Empty)" @onclick="OnVisuals">@Loc.T("action.generatePreviews")</button>
        <button type="button" class="cg-btn" disabled="@_isBusy" @onclick="OnMinutes">@Loc.T("action.transcribe")</button>
        <a class="cg-btn" href="/api/export/minutes-pdf/@CommunityId">@Loc.T("action.exportPdf")</a>
        <a class="cg-btn" href="/api/export/minutes-docx/@CommunityId">@Loc.T("action.exportDocx")</a>
    </div>

    @if (_selected is not null)
    {
        <div class="cg-grid-2" style="margin-block-start: 0.75rem;">
            <div>
                <div class="cg-photo-caption">@(_selected.OptionALabel ?? "Option A")</div>
                @if (!string.IsNullOrWhiteSpace(_selected.OptionAPreviewDataUrl))
                {
                    <img class="cg-photo-frame" src="@_selected.OptionAPreviewDataUrl" alt="Option A" style="max-height: 150px;" />
                }
            </div>
            <div>
                <div class="cg-photo-caption">@(_selected.OptionBLabel ?? "Option B")</div>
                @if (!string.IsNullOrWhiteSpace(_selected.OptionBPreviewDataUrl))
                {
                    <img class="cg-photo-frame" src="@_selected.OptionBPreviewDataUrl" alt="Option B" style="max-height: 150px;" />
                }
            </div>
        </div>
        @if (!string.IsNullOrWhiteSpace(_selected.QrPosterDataUrl))
        {
            <div class="cg-subcard" style="margin-block-start: 0.625rem; display: flex; align-items: center; gap: 0.75rem;">
                <img class="cg-photo-frame" src="@_selected.QrPosterDataUrl" alt="QR poster" style="width: 72px; height: 72px; object-fit: contain; background: #fff;" />
                <div>
                    <strong style="font-size: 0.8125rem;">@Loc.T("ballot.qrTitle")</strong>
                    <div style="font-size: 0.72rem; color: var(--color-text-secondary);">@Loc.T("ballot.qrHint")</div>
                </div>
            </div>
        }
    }
    @if (!string.IsNullOrWhiteSpace(_message))
    {
        <div role="status" aria-live="polite" class="cg-callout">@_message</div>
    }
</div>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<Resolution> Resolutions { get; set; } = [];
    [Parameter, EditorRequired] public Guid CommunityId { get; set; }
    [Parameter] public EventCallback OnChanged { get; set; }
    private Guid _selectedId;
    private Resolution? _selected;
    private bool _isBusy;
    private string _message = string.Empty;
    private Action? _locHandler;

    protected override async Task OnInitializedAsync()
    {
        _locHandler = () => InvokeAsync(StateHasChanged);
        Loc.OnChange += _locHandler;
        await Loc.EnsureLoadedAsync();
    }

    protected override void OnParametersSet()
    {
        if (_selectedId == Guid.Empty && Resolutions.Count > 0)
        {
            var preferred = Resolutions.FirstOrDefault(r => !string.IsNullOrWhiteSpace(r.OptionAPreviewDataUrl)) ?? Resolutions[0];
            _selectedId = preferred.Id;
        }
        _selected = Resolutions.FirstOrDefault(r => r.Id == _selectedId);
    }

    private Task OnSelect(ChangeEventArgs e)
    {
        if (Guid.TryParse(e.Value?.ToString(), out var id))
        {
            _selectedId = id;
            _selected = Resolutions.FirstOrDefault(r => r.Id == id);
        }
        return Task.CompletedTask;
    }

    private async Task OnVisuals()
    {
        if (_selected is null) return;
        _isBusy = true;
        try
        {
            _selected = await Workspace.GenerateRenovationVisualsAndQrPosterAsync(CommunityId, _selected.Id);
            _message = Loc.T("msg.previewsGenerated");
            await OnChanged.InvokeAsync();
        }
        catch (Exception ex) { _message = ex.Message; }
        finally { _isBusy = false; }
    }

    private async Task OnMinutes()
    {
        _isBusy = true;
        try
        {
            var m = await Workspace.TranscribeMeetingRecordingToMinutesAsync(CommunityId);
            _message = $"{Loc.T("msg.minutesTranscribed")} {m.ExtractedActionItemsSummary}";
            await OnChanged.InvokeAsync();
        }
        catch (Exception ex) { _message = ex.Message; }
        finally { _isBusy = false; }
    }

    public void Dispose()
    {
        if (_locHandler is not null)
        {
            Loc.OnChange -= _locHandler;
        }
    }
}
