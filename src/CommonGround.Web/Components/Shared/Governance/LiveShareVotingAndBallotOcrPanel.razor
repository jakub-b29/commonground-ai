@using CommonGround.Domain.Calculators
@using CommonGround.Domain.Entities
@using CommonGround.Domain.Enums
@inject CommonGroundWorkspaceService Workspace
@inject WorkspaceLocalization Loc
@implements IDisposable

<div class="cg-card">
    <div class="cg-section-header">
        <h2>@Loc.T("panel.voteFull")</h2>
        <span class="cg-badge">@Loc.T("vote.weightBadge")</span>
    </div>
    <div>
        <label for="voteRes">@Loc.T("form.resolution")</label>
        <select id="voteRes" value="@_selectedId" @onchange="OnSelect">
            @foreach (var r in Resolutions.OrderBy(r => r.Number))
            {
                <option value="@r.Id" selected="@(_selectedId == r.Id)">@r.Number – @r.Title</option>
            }
        </select>
    </div>

    @if (_selected is not null)
    {
        var tally = VotingCalculator.CalculateTally(_selected, _selected.Votes);
        var forPct = Math.Clamp((double)(tally.SharesFor * 100m), 0, 100);
        var againstPct = Math.Clamp((double)(tally.SharesAgainst * 100m), 0, 100);
        var abstainPct = Math.Clamp((double)(tally.SharesAbstain * 100m), 0, 100);

        <div style="margin-block: 0.75rem;">
            <div style="display: flex; justify-content: space-between; font-size: 0.75rem; margin-block-end: 0.25rem;">
                <span>@Loc.T("vote.shareFor") <strong class="num">@tally.SharesFor.ToString("P2")</strong> (@Loc.T("vote.threshold"))</span>
                <span class="cg-badge @(tally.IsAdopted ? "cg-badge-ok" : "cg-badge-warn")">@(tally.IsAdopted ? Loc.T("vote.adopted") : Loc.T("vote.inProgress"))</span>
            </div>
            <div class="cg-progress-track">
                <div class="cg-progress-fill-ok" style="width: @(forPct.ToString("F1", System.Globalization.CultureInfo.InvariantCulture))%;"></div>
                <div class="cg-progress-fill-err" style="width: @(againstPct.ToString("F1", System.Globalization.CultureInfo.InvariantCulture))%;"></div>
                <div class="cg-progress-fill-muted" style="width: @(abstainPct.ToString("F1", System.Globalization.CultureInfo.InvariantCulture))%;"></div>
            </div>
        </div>

        <div class="cg-table-wrap">
            <table class="cg-table">
                <thead>
                    <tr>
                        <th>@Loc.T("vote.measure")</th>
                        <th class="num">@Loc.T("vote.for")</th>
                        <th class="num">@Loc.T("vote.against")</th>
                        <th class="num">@Loc.T("vote.abstain")</th>
                        <th>@Loc.T("vote.ruleStatus")</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td><strong>@Loc.T("vote.shareWeight")</strong></td>
                        <td class="num">@tally.SharesFor.ToString("P2")</td>
                        <td class="num">@tally.SharesAgainst.ToString("P2")</td>
                        <td class="num">@tally.SharesAbstain.ToString("P2")</td>
                        <td><span class="cg-badge @(tally.IsAdopted ? "cg-badge-ok" : "cg-badge-warn")">@(tally.IsAdopted ? Loc.T("vote.adopted") : Loc.T("vote.pending"))</span></td>
                    </tr>
                    <tr>
                        <td><strong>@Loc.T("vote.ownersCount")</strong></td>
                        <td class="num">@tally.OwnersFor</td>
                        <td class="num">@tally.OwnersAgainst</td>
                        <td class="num">@tally.OwnersAbstain</td>
                        <td class="mono">@tally.EffectiveRule</td>
                    </tr>
                </tbody>
            </table>
        </div>

        <div class="cg-toolbar">
            <button type="button" class="cg-btn cg-btn-primary" disabled="@_isBusy" @onclick="OnDigitize">@Loc.T("action.digitize")</button>
            <button type="button" class="cg-btn" disabled="@_isBusy" @onclick="() => CastAsync(VoteChoice.For)">@Loc.T("action.voteFor")</button>
            <button type="button" class="cg-btn" disabled="@_isBusy" @onclick="() => CastAsync(VoteChoice.Against)">@Loc.T("action.voteAgainst")</button>
            <button type="button" class="cg-btn" disabled="@_isBusy" @onclick="() => CastAsync(VoteChoice.Abstain)">@Loc.T("action.abstain")</button>
        </div>
    }
    @if (!string.IsNullOrWhiteSpace(_message))
    {
        <div role="status" aria-live="polite" class="cg-callout">@_message</div>
    }
</div>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<Resolution> Resolutions { get; set; } = [];
    [Parameter, EditorRequired] public IReadOnlyList<Unit> Units { get; set; } = [];
    [Parameter, EditorRequired] public Guid CommunityId { get; set; }
    [Parameter] public EventCallback OnChanged { get; set; }
    private Guid _selectedId;
    private Resolution? _selected;
    private bool _isBusy;
    private string _message = string.Empty;
    private Action? _locHandler;

    protected override async Task OnInitializedAsync()
    {
        _locHandler = () => InvokeAsync(StateHasChanged);
        Loc.OnChange += _locHandler;
        await Loc.EnsureLoadedAsync();
    }

    protected override void OnParametersSet()
    {
        if (_selectedId == Guid.Empty && Resolutions.Count > 0)
        {
            var preferred = Resolutions.FirstOrDefault(r => r.Number == "Res 01/2026" || r.Votes.Count > 0) ?? Resolutions[0];
            _selectedId = preferred.Id;
        }
        _selected = Resolutions.FirstOrDefault(r => r.Id == _selectedId);
    }

    private Task OnSelect(ChangeEventArgs e)
    {
        if (Guid.TryParse(e.Value?.ToString(), out var id))
        {
            _selectedId = id;
            _selected = Resolutions.FirstOrDefault(r => r.Id == id);
        }
        return Task.CompletedTask;
    }

    private async Task CastAsync(VoteChoice choice)
    {
        var unit = Units.FirstOrDefault();
        if (unit is null || _selected is null) return;
        _isBusy = true;
        try
        {
            await Workspace.CastVoteAsync(CommunityId, _selected.Id, unit.Id, choice);
            _message = $"{Loc.T("msg.voteRecorded")} {choice} {Loc.T("vote.for")} {unit.UnitNumber}.";
            await OnChanged.InvokeAsync();
        }
        catch (Exception ex) { _message = ex.Message; }
        finally { _isBusy = false; }
    }

    private async Task OnDigitize()
    {
        if (_selected is null) return;
        _isBusy = true;
        try
        {
            var tally = await Workspace.DigitizePaperBallotSheetAsync(CommunityId, _selected.Id);
            _message = $"{Loc.T("msg.ballotsMerged")} Shares for {tally.SharesFor:P2}. Adopted: {tally.IsAdopted}.";
            await OnChanged.InvokeAsync();
        }
        catch (Exception ex) { _message = ex.Message; }
        finally { _isBusy = false; }
    }

    public void Dispose()
    {
        if (_locHandler is not null)
        {
            Loc.OnChange -= _locHandler;
        }
    }
}
