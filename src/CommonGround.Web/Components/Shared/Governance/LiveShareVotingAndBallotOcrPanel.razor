@using CommonGround.Domain.Calculators
@using CommonGround.Domain.Entities
@using CommonGround.Domain.Enums
@inject CommonGroundWorkspaceService Workspace
<div class="cg-card" style="margin-top:0.875rem;">
<h2>Live share voting and paper ballot OCR</h2>
<label for="voteRes">Resolution</label>
<select id="voteRes" value="@_selectedId" @onchange="OnSelect" style="width:100%;">
@foreach (var r in Resolutions) { <option value="@r.Id" selected="@(_selectedId == r.Id)">@r.Number - @r.Title</option> }
</select>
@if (_selected is not null) {
var tally = VotingCalculator.CalculateTally(_selected, _selected.Votes);
<div class="cg-table-wrap"><table class="cg-table"><thead><tr><th>Measure</th><th class="num">For</th><th class="num">Against</th><th class="num">Abstain</th><th>Adopted</th></tr></thead><tbody>
<tr><td>Share weight</td><td class="num">@tally.SharesFor.ToString("P2")</td><td class="num">@tally.SharesAgainst.ToString("P2")</td><td class="num">@tally.SharesAbstain.ToString("P2")</td><td>@tally.IsAdopted</td></tr>
<tr><td>Owners</td><td class="num">@tally.OwnersFor</td><td class="num">@tally.OwnersAgainst</td><td class="num">@tally.OwnersAbstain</td><td>@tally.EffectiveRule</td></tr>
</tbody></table></div>
<div style="display:flex;gap:0.375rem;flex-wrap:wrap;margin-top:0.375rem;">
<button type="button" class="cg-btn" disabled="@_isBusy" @onclick="() => CastAsync(VoteChoice.For)">Vote for</button>
<button type="button" class="cg-btn" disabled="@_isBusy" @onclick="() => CastAsync(VoteChoice.Against)">Vote against</button>
<button type="button" class="cg-btn" disabled="@_isBusy" @onclick="() => CastAsync(VoteChoice.Abstain)">Abstain</button>
<button type="button" class="cg-btn cg-btn-primary" disabled="@_isBusy" @onclick="OnDigitize">Digitize signed paper ballot sheet (sam-3.1 + muse-spark-1.3)</button>
</div>
}
@if (!string.IsNullOrWhiteSpace(_message)) { <div role="status" aria-live="polite">@_message</div> }
</div>
@code {
[Parameter, EditorRequired] public IReadOnlyList<Resolution> Resolutions { get; set; } = [];
[Parameter, EditorRequired] public IReadOnlyList<Unit> Units { get; set; } = [];
[Parameter, EditorRequired] public Guid CommunityId { get; set; }
[Parameter] public EventCallback OnChanged { get; set; }
private Guid _selectedId;
private Resolution? _selected;
private bool _isBusy;
private string _message = string.Empty;
protected override void OnParametersSet() { if (_selectedId == Guid.Empty && Resolutions.Count > 0) _selectedId = Resolutions[0].Id; _selected = Resolutions.FirstOrDefault(r => r.Id == _selectedId); }
private Task OnSelect(ChangeEventArgs e) { if (Guid.TryParse(e.Value?.ToString(), out var id)) { _selectedId = id; _selected = Resolutions.FirstOrDefault(r => r.Id == id); } return Task.CompletedTask; }
private async Task CastAsync(VoteChoice choice) { var unit = Units.FirstOrDefault(); if (unit is null || _selected is null) return; _isBusy = true; try { await Workspace.CastVoteAsync(CommunityId, _selected.Id, unit.Id, choice); _message = $"Recorded {choice} for {unit.UnitNumber}."; await OnChanged.InvokeAsync(); } catch (Exception ex) { _message = ex.Message; } finally { _isBusy = false; } }
private async Task OnDigitize() { if (_selected is null) return; _isBusy = true; try { var tally = await Workspace.DigitizePaperBallotSheetAsync(CommunityId, _selected.Id); _message = $"Merged paper ballots. Shares for {tally.SharesFor:P2}. Adopted: {tally.IsAdopted}."; await OnChanged.InvokeAsync(); } catch (Exception ex) { _message = ex.Message; } finally { _isBusy = false; } }
}
