@using CommonGround.Application.Services
@inject CommonGroundWorkspaceService Workspace
@inject WorkspaceLocalization Loc
@implements IDisposable

<div class="cg-card">
    <div class="cg-section-header">
        <h2>@Loc.T("panel.meetingPack")</h2>
        <div style="display: flex; gap: 0.375rem; flex-wrap: wrap;">
            <button type="button" class="cg-btn cg-btn-primary" disabled="@_isBusy" @onclick="OnPrepare">@Loc.T("action.preparePackage")</button>
            <a class="cg-btn" href="/api/export/meeting-pack/@Snapshot.Community.Id">@Loc.T("action.exportPdf")</a>
        </div>
    </div>
    <div class="cg-table-wrap">
        <table class="cg-table">
            <thead>
                <tr>
                    <th>@Loc.T("meeting.resolution")</th>
                    <th>@Loc.T("meeting.majority")</th>
                    <th>@Loc.T("meeting.compliance")</th>
                    <th>@Loc.T("meeting.cited")</th>
                    <th>@Loc.T("table.actions")</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in Snapshot.Community.Resolutions.OrderBy(r => r.Number))
                {
                    <tr @key="r.Id">
                        <td>
                            <strong class="mono">@r.Number</strong> – <strong>@r.Title</strong>
                            <div style="font-size: 0.72rem; color: var(--color-text-secondary);">@r.Content</div>
                        </td>
                        <td><span class="cg-badge">@r.MajorityRule</span></td>
                        <td>
                            <span class="cg-badge @(r.ComplianceStatus == "VerifiedClean" ? "cg-badge-ok" : "cg-badge-err")">@r.ComplianceStatus</span>
                        </td>
                        <td class="mono">@(string.IsNullOrWhiteSpace(r.CitedLegalDocumentCode) ? Loc.T("msg.allVerified") : r.CitedLegalDocumentCode)</td>
                        <td>
                            @if (r.ComplianceStatus == "ConflictDetected")
                            {
                                <button type="button" class="cg-btn" disabled="@_isBusy" @onclick="() => OnFixAsync(r.Id)">@Loc.T("action.applyFix")</button>
                            }
                            else
                            {
                                <span style="font-size: 0.72rem; color: var(--color-text-secondary);">@Loc.T("msg.readyForBallot")</span>
                            }
                        </td>
                    </tr>
                    @if (!string.IsNullOrWhiteSpace(r.ComplianceConflictSummary))
                    {
                        <tr @key="@(r.Id.ToString() + "-c")">
                            <td colspan="5" style="background-color: var(--status-err-bg); color: var(--status-err-fg); font-size: 0.78125rem;">
                                <strong>@Loc.T("meeting.conflict")</strong> @r.ComplianceConflictSummary · <strong>@Loc.T("meeting.citedLabel") (<span class="mono">@r.CitedLegalDocumentCode</span>):</strong> @r.CitedVerbatimLegalExcerpt
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
    @if (!string.IsNullOrWhiteSpace(_message))
    {
        <div role="status" aria-live="polite" class="cg-callout">@_message</div>
    }
</div>

@code {
    [Parameter, EditorRequired] public CommunityWorkspaceSnapshot Snapshot { get; set; } = default!;
    [Parameter] public EventCallback OnChanged { get; set; }
    private bool _isBusy;
    private string _message = string.Empty;
    private Action? _locHandler;

    protected override async Task OnInitializedAsync()
    {
        _locHandler = () => InvokeAsync(StateHasChanged);
        Loc.OnChange += _locHandler;
        await Loc.EnsureLoadedAsync();
    }

    private async Task OnPrepare()
    {
        _isBusy = true;
        try
        {
            await Workspace.RunAnnualMeetingAutopilotAsync(Snapshot.Community.Id);
            _message = Loc.T("msg.packagePrepared");
            await OnChanged.InvokeAsync();
        }
        catch (Exception ex) { _message = ex.Message; }
        finally { _isBusy = false; }
    }

    private async Task OnFixAsync(Guid id)
    {
        _isBusy = true;
        try
        {
            var r = await Workspace.ApplyStatuteComplianceFixAsync(Snapshot.Community.Id, id);
            _message = $"{r.Number}: {r.ComplianceStatus}.";
            await OnChanged.InvokeAsync();
        }
        catch (Exception ex) { _message = ex.Message; }
        finally { _isBusy = false; }
    }

    public void Dispose()
    {
        if (_locHandler is not null)
        {
            Loc.OnChange -= _locHandler;
        }
    }
}
