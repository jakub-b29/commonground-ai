@using CommonGround.Domain.Entities

<div class="cg-card">
    <div class="cg-section-header">
        <h2>Utility sources and live tariffs</h2>
        <span class="cg-badge">@Sources.Count providers monitored</span>
    </div>
    <div class="cg-table-wrap">
        <table class="cg-table">
            <thead>
                <tr>
                    <th>Operator</th>
                    <th>Links</th>
                    <th class="num">Unit tariff</th>
                    <th>Dispatch</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var src in Sources)
                {
                    <tr @key="src.Id">
                        <td>
                            <strong>@src.ProviderName</strong>
                            <div style="font-size: 0.72rem; color: var(--color-text-secondary);">@src.UtilityKind</div>
                        </td>
                        <td>
                            <a href="@src.OutageBulletinUrl" target="_blank" rel="noopener">Bulletin</a>
                            <span> · </span>
                            <a href="@src.LiveFaultMapUrl" target="_blank" rel="noopener">Fault map</a>
                        </td>
                        <td class="num">@src.CurrentUnitTariff.ToString("N2") @src.TariffUnit</td>
                        <td class="mono">@src.EmergencyPhone</td>
                        <td><span class="cg-badge cg-badge-ok">@src.HealthStatus</span></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <div class="cg-toolbar">
        <button type="button" class="cg-btn cg-btn-primary" @onclick="OnScanNow">Scan sources and weather now</button>
        <button type="button" class="cg-btn" @onclick="OnRefreshSources">Refresh providers via web search</button>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<UtilityProviderSource> Sources { get; set; } = [];
    [Parameter] public EventCallback OnRefreshSources { get; set; }
    [Parameter] public EventCallback OnScanNow { get; set; }
}
