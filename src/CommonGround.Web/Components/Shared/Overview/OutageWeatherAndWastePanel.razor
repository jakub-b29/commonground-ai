@using CommonGround.Application.Services
@inject CommonGroundWorkspaceService Workspace
@inject WorkspaceLocalization Loc
@implements IDisposable

<div class="bento-card" style="height: 100%;">
    <div class="bento-card-header">
        <div class="cg-panel-title">
            <span>@Loc.T("panel.outages")</span>
            <span class="cg-badge @(Snapshot.ActiveOutages.Count > 0 ? "cg-badge-err" : "cg-badge-ok")">
                @(Snapshot.ActiveOutages.Count > 0 ? $"{Snapshot.ActiveOutages.Count} {Loc.T("outage.activeBadge")}" : Loc.T("msg.gridNormal"))
            </span>
        </div>
        <button type="button" class="cg-btn cg-btn-sm cg-btn-ai" disabled="@_isBusy" @onclick="OnGeneratePoster">
            <span class="ai-dot" aria-hidden="true"></span>
            <span>@Loc.T("action.generatePoster")</span>
        </button>
    </div>
    <div class="bento-card-body" style="display: flex; flex-direction: column; gap: 0.75rem;">
        @if (Snapshot is null)
        {
            <p>@Loc.T("msg.loading")</p>
        }
        else
        {
            <div>
                <div style="font-size: 0.75rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.04em; color: var(--text-secondary); margin-bottom: 0.4rem;">
                    @Loc.T("outage.activeTitle")
                </div>
                @if (Snapshot.ActiveOutages.Count == 0)
                {
                    <div class="cg-subcard" style="display: flex; align-items: center; gap: 0.5rem;">
                        <span class="cg-badge cg-badge-ok">@Loc.T("msg.noOutage")</span>
                        <span style="font-size: 0.8rem; color: var(--text-secondary);">@Loc.T("outage.dispatchNormal")</span>
                    </div>
                }
                else
                {
                    @foreach (var outage in Snapshot.ActiveOutages)
                    {
                        <div class="cg-subcard" @key="outage.Id" style="border-inline-start: 3px solid var(--status-danger); margin-block-end: 0.45rem;">
                            <div style="display: flex; align-items: center; justify-content: space-between; gap: 0.5rem; flex-wrap: wrap;">
                                <span class="cg-badge cg-badge-err">@Loc.T("outage.activeBadge")</span>
                                <span class="mono" style="font-size: 0.72rem; color: var(--text-secondary);">ETA @outage.EstimatedEndAt.ToString("HH:mm")</span>
                            </div>
                            <div style="margin-block-start: 0.35rem; font-size: 0.8125rem;">
                                <strong>@outage.UtilityKind – @outage.ProviderName</strong> (@outage.AffectedStreets). @Loc.T("outage.suppressedNote")
                            </div>
                        </div>
                    }
                }
            </div>

            <div>
                <div style="font-size: 0.75rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.04em; color: var(--text-secondary); margin-bottom: 0.4rem;">
                    @Loc.T("waste.scheduleTitle")
                </div>
                <div class="cg-table-wrap">
                    <table class="cg-table">
                        <thead>
                            <tr>
                                <th>@Loc.T("waste.fraction")</th>
                                <th>@Loc.T("waste.schedule")</th>
                                <th class="num">@Loc.T("waste.nextPickup")</th>
                                <th>@Loc.T("table.status")</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var w in Snapshot.Community.WasteSchedules)
                            {
                                <tr @key="w.Id">
                                    <td><strong>@w.WasteFraction</strong></td>
                                    <td>@w.CollectionDaysSummary</td>
                                    <td class="num">@w.NextPickupDate.ToString("yyyy-MM-dd")</td>
                                    <td>
                                        <span class="cg-badge @(w.ContaminationWarningActive ? "cg-badge-warn" : "cg-badge-ok")">
                                            @(w.ContaminationWarningActive ? Loc.T("waste.contamination") : Loc.T("waste.normal"))
                                        </span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <div>
                <label for="wasteCustomInfo" style="font-size: 0.74rem; color: var(--text-secondary);">@Loc.T("image.customInfoLabel")</label>
                <input id="wasteCustomInfo"
                       type="text"
                       class="cg-input"
                       style="font-size: 0.76rem; padding: 0.35rem 0.5rem;"
                       placeholder="@Loc.T("image.linesPlaceholder")"
                       @bind="_customInfoRaw" />
            </div>

            @if (!string.IsNullOrWhiteSpace(_message))
            {
                <div role="status" aria-live="polite" class="ai-callout">@_message</div>
            }
            @if (!string.IsNullOrWhiteSpace(_posterUrl))
            {
                <div class="cg-subcard">
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.4rem;">
                        <span class="mono cg-text-xs" style="color: var(--accent-primary);">@Loc.T("image.metaLabel"): muse-image-1.0 • 640×400 PNG</span>
                        <a href="@_posterUrl" download="waste-segregation-poster.png" class="cg-btn cg-btn-xs cg-btn-outline" style="text-decoration: none;">
                            @Loc.T("image.downloadPng")
                        </a>
                    </div>
                    <img class="cg-photo-frame" src="@_posterUrl" alt="@Loc.T("waste.posterAlt")" style="max-width: 280px;" />
                </div>
            }
        }
    </div>
</div>

@code {
    [Parameter, EditorRequired] public CommunityWorkspaceSnapshot Snapshot { get; set; } = default!;
    private bool _isBusy;
    private string _message = string.Empty;
    private string _posterUrl = string.Empty;
    private string _customInfoRaw = "Flatten cardboard boxes before disposal; No plastic bags in BIO bin; Bulky waste pickup: first Saturday";
    private Action? _locHandler;

    protected override async Task OnInitializedAsync()
    {
        _locHandler = () => InvokeAsync(StateHasChanged);
        Loc.OnChange += _locHandler;
        await Loc.EnsureLoadedAsync();
    }

    private async Task OnGeneratePoster()
    {
        _isBusy = true;
        try
        {
            var customLines = (_customInfoRaw ?? string.Empty)
                .Split(new[] { ';', '\r', '\n' }, StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
                .Where(x => !string.IsNullOrWhiteSpace(x))
                .ToList();
            _posterUrl = await Workspace.GenerateWasteSegregationPosterAsync(Snapshot.Community.Id, default, customLines);
            _message = $"{Loc.T("msg.posterGenerated")} (muse-image-1.0 • 640×400 PNG)";
        }
        catch (Exception ex)
        {
            _message = string.Format(System.Globalization.CultureInfo.InvariantCulture, Loc.T("msg.posterFailedFmt"), ex.Message);
        }
        finally
        {
            _isBusy = false;
        }
    }

    public void Dispose()
    {
        if (_locHandler is not null)
        {
            Loc.OnChange -= _locHandler;
        }
    }
}
