@using CommonGround.Application.Services
@inject CommonGroundWorkspaceService Workspace

<div class="cg-card">
    <div class="cg-section-header">
        <h2>Outages, weather, and waste</h2>
        <span class="cg-badge @(Snapshot.ActiveOutages.Count > 0 ? "cg-badge-err" : "cg-badge-ok")">
            @(Snapshot.ActiveOutages.Count > 0 ? $"{Snapshot.ActiveOutages.Count} active outage" : "Grid normal")
        </span>
    </div>
    @if (Snapshot is null)
    {
        <p>Loading outage and waste status.</p>
    }
    else
    {
        <h3 style="margin-block-start: 0 !important;">Active municipal outages</h3>
        @if (Snapshot.ActiveOutages.Count == 0)
        {
            <div class="cg-subcard">
                <span class="cg-badge cg-badge-ok">No active outage</span>
                <span style="margin-inline-start: 0.375rem;">Contractor dispatch is operating normally.</span>
            </div>
        }
        else
        {
            @foreach (var outage in Snapshot.ActiveOutages)
            {
                <div class="cg-subcard" @key="outage.Id" style="border-inline-start: 3px solid var(--status-err-fg); margin-block-end: 0.5rem;">
                    <div style="display: flex; align-items: center; justify-content: space-between; gap: 0.5rem; flex-wrap: wrap;">
                        <span class="cg-badge cg-badge-err">Active outage</span>
                        <span class="mono" style="font-size: 0.72rem; color: var(--color-text-secondary);">ETA @outage.EstimatedEndAt.ToString("HH:mm")</span>
                    </div>
                    <div style="margin-block-start: 0.35rem; font-size: 0.8125rem;">
                        <strong>@outage.UtilityKind – @outage.ProviderName</strong> (@outage.AffectedStreets). Redundant plumber/HVAC dispatch suppressed automatically.
                    </div>
                </div>
            }
        }

        <h3>Waste collection schedule</h3>
        <div class="cg-table-wrap">
            <table class="cg-table">
                <thead>
                    <tr>
                        <th>Fraction</th>
                        <th>Schedule</th>
                        <th class="num">Next pickup</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var w in Snapshot.Community.WasteSchedules)
                    {
                        <tr @key="w.Id">
                            <td><strong>@w.WasteFraction</strong></td>
                            <td>@w.CollectionDaysSummary</td>
                            <td class="num">@w.NextPickupDate.ToString("yyyy-MM-dd")</td>
                            <td>
                                <span class="cg-badge @(w.ContaminationWarningActive ? "cg-badge-warn" : "cg-badge-ok")">
                                    @(w.ContaminationWarningActive ? "Contamination warning" : "Normal")
                                </span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="cg-toolbar">
            <button type="button" class="cg-btn" disabled="@_isBusy" @onclick="OnGeneratePoster">Generate waste segregation poster</button>
        </div>
        @if (!string.IsNullOrWhiteSpace(_message))
        {
            <div role="status" aria-live="polite" class="cg-callout">@_message</div>
        }
        @if (!string.IsNullOrWhiteSpace(_posterUrl))
        {
            <img class="cg-photo-frame" src="@_posterUrl" alt="Waste segregation poster" style="margin-block-start: 0.5rem; max-width: 220px;" />
        }
    }
</div>

@code {
    [Parameter, EditorRequired] public CommunityWorkspaceSnapshot Snapshot { get; set; } = default!;
    private bool _isBusy;
    private string _message = string.Empty;
    private string _posterUrl = string.Empty;

    private async Task OnGeneratePoster()
    {
        _isBusy = true;
        try
        {
            _posterUrl = await Workspace.GenerateWasteSegregationPosterAsync(Snapshot.Community.Id);
            _message = "Waste segregation poster generated.";
        }
        catch (Exception ex)
        {
            _message = $"Poster generation failed: {ex.Message}";
        }
        finally
        {
            _isBusy = false;
        }
    }
}
