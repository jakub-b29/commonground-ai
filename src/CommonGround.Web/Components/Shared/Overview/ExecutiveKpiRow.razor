@using CommonGround.Application.Services
@inject WorkspaceLocalization Loc
@implements IDisposable

<div class="cg-grid-4" style="margin-bottom: 1rem;">
    <MetricCard Label="@Loc.T("kpi.operatingCash")"
                Value="@($"{Snapshot.OperatingCash:N2} {Snapshot.Community.CurrencyCode}")"
                BadgeText="Ledger verified"
                StatusVariant="ok">
        <SubContent>
            <span>@Loc.T("kpi.reserveFund"): <strong class="num" style="color: var(--text-primary);">@Snapshot.ReserveCash.ToString("N2") @Snapshot.Community.CurrencyCode</strong></span>
        </SubContent>
    </MetricCard>

    <MetricCard Label="@Loc.T("kpi.delinquency")"
                Value="@($"{Snapshot.DelinquencyRate:N2} %")"
                BadgeText="@(Snapshot.DelinquencyRate > 5m ? "Monitor" : "Healthy")"
                StatusVariant="@(Snapshot.DelinquencyRate > 5m ? "warn" : "ok")">
        <SubContent>
            <span>@Loc.T("kpi.arrearsUnits"): <strong class="num" style="color: var(--text-primary);">@Snapshot.ArrearsUnits</strong> of <span class="num">@Snapshot.Community.Units.Count</span></span>
        </SubContent>
    </MetricCard>

    <MetricCard Label="@Loc.T("kpi.openOrders")"
                Value="@Snapshot.OpenWorkOrders.ToString()"
                BadgeText="@(Snapshot.Community.IsUnderDeveloperWarranty ? Loc.T("kpi.warrantyActive") : Loc.T("kpi.standardReserve"))"
                StatusVariant="@(Snapshot.Community.IsUnderDeveloperWarranty ? "ok" : "neutral")">
        <SubContent>
            <span>@Loc.T("kpi.warranty") · <span class="mono">@Snapshot.Community.Buildings.Count</span> bldgs</span>
        </SubContent>
    </MetricCard>

    <MetricCard Label="@Loc.T("kpi.pending")"
                Value="@Snapshot.PendingApprovals.ToString()"
                BadgeText="CommonGround Queue"
                StatusVariant="ai"
                IsAi="true">
        <SubContent>
            <span>@Loc.T("kpi.resolutions"): <strong class="num" style="color: var(--text-primary);">@Snapshot.Community.Resolutions.Count</strong></span>
        </SubContent>
    </MetricCard>
</div>

@code {
    [Parameter, EditorRequired] public CommunityWorkspaceSnapshot Snapshot { get; set; } = default!;
    private Action? _locHandler;

    protected override async Task OnInitializedAsync()
    {
        _locHandler = () => InvokeAsync(StateHasChanged);
        Loc.OnChange += _locHandler;
        await Loc.EnsureLoadedAsync();
    }

    public void Dispose()
    {
        if (_locHandler is not null)
        {
            Loc.OnChange -= _locHandler;
        }
    }
}
