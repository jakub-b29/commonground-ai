@using CommonGround.Application.Services

<div class="cg-grid-4">
    <div class="cg-card">
        <div class="kpi-label">Operating cash</div>
        <div class="kpi-value num">@Snapshot.OperatingCash.ToString("N2") @Snapshot.Community.CurrencyCode</div>
        <div class="kpi-sub">Reserve fund: <strong class="num">@Snapshot.ReserveCash.ToString("N2") @Snapshot.Community.CurrencyCode</strong></div>
    </div>
    <div class="cg-card">
        <div class="kpi-label">Delinquency rate</div>
        <div class="kpi-value num">@Snapshot.DelinquencyRate.ToString("N2") %</div>
        <div class="kpi-sub">Units in arrears: <strong class="num">@Snapshot.ArrearsUnits</strong> of <span class="num">@Snapshot.Community.Units.Count</span></div>
    </div>
    <div class="cg-card">
        <div class="kpi-label">Open work orders</div>
        <div class="kpi-value num">@Snapshot.OpenWorkOrders</div>
        <div class="kpi-sub">Warranty status: <span class="cg-badge @(Snapshot.Community.IsUnderDeveloperWarranty ? "cg-badge-ok" : "")">@(Snapshot.Community.IsUnderDeveloperWarranty ? "5-yr warranty active" : "Standard reserve")</span></div>
    </div>
    <div class="cg-card">
        <div class="kpi-label">Pending approvals & e-votes</div>
        <div class="kpi-value num">@Snapshot.PendingApprovals</div>
        <div class="kpi-sub">Active resolutions: <strong class="num">@Snapshot.Community.Resolutions.Count</strong></div>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public CommunityWorkspaceSnapshot Snapshot { get; set; } = default!;
}
