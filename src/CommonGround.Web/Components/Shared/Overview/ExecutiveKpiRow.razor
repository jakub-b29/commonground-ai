@using CommonGround.Application.Services
@inject WorkspaceLocalization Loc
@implements IDisposable

<div class="cg-grid-4">
    <div class="cg-card">
        <div class="kpi-label">@Loc.T("kpi.operatingCash")</div>
        <div class="kpi-value num">@Snapshot.OperatingCash.ToString("N2") @Snapshot.Community.CurrencyCode</div>
        <div class="kpi-sub">@Loc.T("kpi.reserveFund"): <strong class="num">@Snapshot.ReserveCash.ToString("N2") @Snapshot.Community.CurrencyCode</strong></div>
    </div>
    <div class="cg-card">
        <div class="kpi-label">@Loc.T("kpi.delinquency")</div>
        <div class="kpi-value num">@Snapshot.DelinquencyRate.ToString("N2") %</div>
        <div class="kpi-sub">@Loc.T("kpi.arrearsUnits"): <strong class="num">@Snapshot.ArrearsUnits</strong> of <span class="num">@Snapshot.Community.Units.Count</span></div>
    </div>
    <div class="cg-card">
        <div class="kpi-label">@Loc.T("kpi.openOrders")</div>
        <div class="kpi-value num">@Snapshot.OpenWorkOrders</div>
        <div class="kpi-sub">@Loc.T("kpi.warranty"): <span class="cg-badge @(Snapshot.Community.IsUnderDeveloperWarranty ? "cg-badge-ok" : "")">@(Snapshot.Community.IsUnderDeveloperWarranty ? Loc.T("kpi.warrantyActive") : Loc.T("kpi.standardReserve"))</span></div>
    </div>
    <div class="cg-card">
        <div class="kpi-label">@Loc.T("kpi.pending")</div>
        <div class="kpi-value num">@Snapshot.PendingApprovals</div>
        <div class="kpi-sub">@Loc.T("kpi.resolutions"): <strong class="num">@Snapshot.Community.Resolutions.Count</strong></div>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public CommunityWorkspaceSnapshot Snapshot { get; set; } = default!;
    private Action? _locHandler;

    protected override async Task OnInitializedAsync()
    {
        _locHandler = () => InvokeAsync(StateHasChanged);
        Loc.OnChange += _locHandler;
        await Loc.EnsureLoadedAsync();
    }

    public void Dispose()
    {
        if (_locHandler is not null)
        {
            Loc.OnChange -= _locHandler;
        }
    }
}
