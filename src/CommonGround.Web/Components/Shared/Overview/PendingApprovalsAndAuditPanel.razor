@using CommonGround.Application.Services
@using CommonGround.Domain.Entities
@using CommonGround.Domain.Enums
@inject CommonGroundWorkspaceService Workspace
@inject WorkspaceAccessService Access
@inject WorkspaceLocalization Loc
@implements IDisposable

<BentoGrid>
    <BentoCard Span="6"
               IsAi="true"
               Title="@Loc.T("panel.pendingApprovals")"
               Subtitle="@Loc.T("pending.humanLoopHint")"
               BadgeText="@($"{Snapshot.PendingActions.Count} {Loc.T("pending.queuedSuffix")}")"
               BadgeVariant="ai">
        <HeaderActions>
            @if (Snapshot.PendingActions.Count > 0)
            {
                <button type="button" class="cg-btn cg-btn-sm cg-btn-primary" disabled="@_isBusy" @onclick="ApproveAllAsync">@Loc.T("action.approveAll") (@Snapshot.PendingActions.Count)</button>
            }
        </HeaderActions>
        <ChildContent>
            @if (Snapshot.PendingActions.Count == 0)
            {
                <EmptyState Title="@Loc.T("msg.noPendingActions")" Description="@Loc.T("pending.allReviewed")" />
            }
            else
            {
                <div style="display: flex; flex-direction: column; gap: 0.65rem;">
                    @foreach (var action in Snapshot.PendingActions)
                    {
                        <div @key="action.Id" class="cg-subcard" style="border-inline-start: 3px solid var(--accent-ai);">
                            <div style="display: flex; align-items: flex-start; justify-content: space-between; gap: 0.5rem; flex-wrap: wrap;">
                                <strong>@action.Title</strong>
                                <div style="display: inline-flex; align-items: center; gap: 0.35rem;">
                                    <AIBadge Label="@action.AgentName" Model="@action.ModelUsed" ShowPulseDot="false" />
                                    <span class="cg-badge cg-badge-ok mono">@action.Confidence.ToString("P0")</span>
                                </div>
                            </div>
                            <div style="font-size: 0.73rem; color: var(--text-secondary); margin-block: 0.25rem 0.4rem;">
                                <span>@action.TargetEntitySummary</span>
                            </div>
                            <div style="font-size: 0.8rem; color: var(--text-primary); line-height: 1.45;">@action.Rationale</div>
                            <div class="ai-progress-track" style="margin-top: 0.5rem;">
                                <div class="ai-progress-fill" style="width: @((action.Confidence * 100).ToString("F0", System.Globalization.CultureInfo.InvariantCulture))%;"></div>
                            </div>
                            <div class="cg-toolbar" style="margin-block-start: 0.55rem;">
                                <button type="button" class="cg-btn cg-btn-sm cg-btn-primary" disabled="@_isBusy" @onclick="() => DecideAsync(action.Id, true)">@Loc.T("action.approve")</button>
                                <button type="button" class="cg-btn cg-btn-sm" disabled="@_isBusy" @onclick="() => DecideAsync(action.Id, false)">@Loc.T("action.reject")</button>
                            </div>
                        </div>
                    }
                </div>
            }
            @if (!string.IsNullOrWhiteSpace(_message))
            {
                <div role="status" aria-live="polite" class="ai-callout" style="margin-top: 0.65rem;">@_message</div>
            }
        </ChildContent>
    </BentoCard>

    <BentoCard Span="6"
               Title="@Loc.T("panel.membershipQueue")"
               Subtitle="@Loc.T("pending.membershipHint")"
               BadgeText="@Loc.T("pending.communityPortal")"
               BadgeVariant="neutral">
        <HeaderActions>
            <a class="cg-btn cg-btn-sm" href="/admin/members">@Loc.T("action.openResidentPortal")</a>
        </HeaderActions>
        <ChildContent>
            @{
                var pendingMembers = Snapshot.Community.ResidentMemberships
                    .Where(m => m.Status == ResidentMembershipStatus.PendingApproval)
                    .OrderByDescending(m => m.SubmittedAtUtc)
                    .ToList();
            }
            @if (pendingMembers.Count == 0)
            {
                <div class="cg-subcard" style="margin-bottom: 0.85rem;">
                    <span class="cg-badge cg-badge-ok">@Loc.T("msg.allVerified")</span>
                    <span style="margin-inline-start: 0.375rem; font-size: 0.8rem; color: var(--text-secondary);">@Loc.T("msg.allVerifiedFor") @Snapshot.Community.Name.</span>
                </div>
            }
            else
            {
                <div style="display: flex; flex-direction: column; gap: 0.5rem; margin-bottom: 0.85rem;">
                    @foreach (var app in pendingMembers)
                    {
                        <div @key="app.Id" class="cg-subcard">
                            <div style="display: flex; align-items: center; justify-content: space-between; gap: 0.5rem; flex-wrap: wrap;">
                                <div>
                                    <strong>@app.ApplicantFullName</strong>
                                    <span class="cg-badge mono" style="margin-inline-start: 0.35rem;">@Loc.T("form.unit") @app.UnitNumber</span>
                                    <span class="cg-badge" style="margin-inline-start: 0.25rem;">@app.Provider</span>
                                </div>
                                <span class="cg-badge cg-badge-warn">@Loc.T("msg.pendingApproval")</span>
                            </div>
                            <div style="font-size: 0.75rem; color: var(--text-secondary); margin-block-start: 0.25rem;">
                                @Loc.T("form.proof"): @app.OwnershipOrLeaseProofSummary
                            </div>
                            <div style="font-size: 0.72rem; color: var(--text-secondary); margin-block-start: 0.15rem;">
                                @Loc.T("table.groups"): @app.AssignedGroupsSummary
                            </div>
                            <div class="cg-toolbar" style="margin-block-start: 0.45rem;">
                                <button type="button" class="cg-btn cg-btn-sm cg-btn-primary" disabled="@_isBusy" @onclick="() => DecideResidentAsync(app.Id, true)">@Loc.T("action.approveResident")</button>
                                <button type="button" class="cg-btn cg-btn-sm" disabled="@_isBusy" @onclick="() => DecideResidentAsync(app.Id, false)">@Loc.T("action.reject")</button>
                            </div>
                        </div>
                    }
                </div>
            }

            <div style="font-size: 0.75rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.04em; color: var(--text-secondary); margin-bottom: 0.4rem;">
                @Loc.T("panel.groupMessages")
            </div>
            <div class="cg-table-wrap">
                <table class="cg-table">
                    <thead>
                        <tr>
                            <th>@Loc.T("table.group")</th>
                            <th>@Loc.T("table.sender")</th>
                            <th>@Loc.T("table.subject")</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var msg in Snapshot.Community.CommunityMessages.OrderByDescending(m => m.SentAtUtc).Take(4))
                        {
                            <tr @key="msg.Id">
                                <td><span class="cg-badge cg-badge-neutral">@msg.GroupName</span></td>
                                <td>
                                    <strong>@msg.SenderName</strong>
                                    <div style="font-size: 0.72rem; color: var(--text-secondary);">@msg.SenderUnitOrRole</div>
                                </td>
                                <td>
                                    @if (msg.IsPinnedAnnouncement)
                                    {
                                        <span class="cg-badge cg-badge-ok" style="margin-inline-end: 0.25rem;">@Loc.T("msg.pinned")</span>
                                    }
                                    <span>@msg.Subject</span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </ChildContent>
    </BentoCard>

    @if (Snapshot.RecentAgentRuns.Count > 0)
    {
        <BentoCard Span="12"
                    Title="@Loc.T("pending.execLogTitle")"
                    Subtitle="@Loc.T("pending.execLogHint")"
                    BadgeText="@($"{Snapshot.RecentAgentRuns.Count} {Loc.T("pending.recentRuns")}")"
                   BadgeVariant="ai"
                   BodyStyle="padding: 0;">
            <ChildContent>
                <div class="cg-table-wrap">
                    <table class="cg-table">
                        <thead>
                            <tr>
                                <th>@Loc.T("pending.colAgent")</th>
                                <th>@Loc.T("pending.colTrigger")</th>
                                <th>@Loc.T("pending.colModel")</th>
                                <th class="num">@Loc.T("pending.colLatency")</th>
                                <th class="num">@Loc.T("pending.colTokens")</th>
                                <th class="num">@Loc.T("pending.colTimestamp")</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var run in Snapshot.RecentAgentRuns.Take(6))
                            {
                                <tr @key="run.Id">
                                    <td><strong>@run.AgentName</strong></td>
                                    <td style="color: var(--text-secondary);">@run.TriggerSummary</td>
                                    <td><AIBadge Label="Meta AI" Model="@run.ModelName" ShowPulseDot="false" /></td>
                                    <td class="num">@run.TotalLatencyMs ms</td>
                                    <td class="num">@run.TotalTokens.ToString("N0")</td>
                                    <td class="num">@run.StartedAt.ToString("yyyy-MM-dd HH:mm:ss")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </ChildContent>
        </BentoCard>
    }
</BentoGrid>

@code {
    [Parameter, EditorRequired] public CommunityWorkspaceSnapshot Snapshot { get; set; } = default!;
    [Parameter] public EventCallback OnChanged { get; set; }
    private bool _isBusy;
    private string _message = string.Empty;
    private Action? _locHandler;

    protected override async Task OnInitializedAsync()
    {
        _locHandler = () => InvokeAsync(StateHasChanged);
        Loc.OnChange += _locHandler;
        await Loc.EnsureLoadedAsync();
    }

    private async Task DecideAsync(Guid id, bool approve)
    {
        _isBusy = true;
        try
        {
            var role = await Access.GetRoleAsync() ?? WorkspaceSecurityRole.PropertyManager;
            await Workspace.DecideAiActionAsync(Snapshot.Community.Id, id, approve, role);
            await OnChanged.InvokeAsync();
        }
        finally
        {
            _isBusy = false;
        }
    }

    private async Task ApproveAllAsync()
    {
        _isBusy = true;
        try
        {
            var count = await Workspace.ApproveAllPendingActionsAsync(Snapshot.Community.Id);
            _message = string.Format(System.Globalization.CultureInfo.InvariantCulture, Loc.T("pending.approvedFmt"), count);
            await OnChanged.InvokeAsync();
        }
        finally
        {
            _isBusy = false;
        }
    }

    private async Task DecideResidentAsync(Guid appId, bool approve)
    {
        _isBusy = true;
        try
        {
            var role = await Access.GetRoleAsync() ?? WorkspaceSecurityRole.PropertyManager;
            var res = await Workspace.DecideResidentMembershipAsync(Snapshot.Community.Id, appId, approve, role);
            _message = res.DecisionNote ?? Loc.T("pending.membershipDecision");
            await OnChanged.InvokeAsync();
        }
        finally
        {
            _isBusy = false;
        }
    }

    public void Dispose()
    {
        if (_locHandler is not null)
        {
            Loc.OnChange -= _locHandler;
        }
    }
}
