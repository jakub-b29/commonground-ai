@using CommonGround.Application.Services
@using CommonGround.Domain.Entities
@using CommonGround.Domain.Enums
@inject CommonGroundWorkspaceService Workspace
@inject WorkspaceUiState UiState
@inject WorkspaceLocalization Loc
@implements IDisposable

<div class="cg-grid-2">
    <div class="cg-card">
        <div class="cg-section-header">
            <h2>@Loc.T("panel.pendingApprovals")</h2>
            @if (Snapshot.PendingActions.Count > 0)
            {
                <button type="button" class="cg-btn cg-btn-primary" disabled="@_isBusy" @onclick="ApproveAllAsync">@Loc.T("action.approveAll") (@Snapshot.PendingActions.Count)</button>
            }
        </div>
        @if (Snapshot.PendingActions.Count == 0)
        {
            <p style="color: var(--color-text-secondary);">@Loc.T("msg.noPendingActions")</p>
        }
        else
        {
            <div style="display: flex; flex-direction: column; gap: 0.625rem;">
                @foreach (var action in Snapshot.PendingActions)
                {
                    <div @key="action.Id" class="cg-subcard">
                        <div style="display: flex; align-items: flex-start; justify-content: space-between; gap: 0.5rem;">
                            <strong>@action.Title</strong>
                            <span class="cg-badge mono">@action.Confidence.ToString("P0")</span>
                        </div>
                        <div style="font-size: 0.72rem; color: var(--color-text-secondary); margin-block: 0.2rem 0.35rem;">
                            <span>@action.TargetEntitySummary</span>
                        </div>
                        <div style="font-size: 0.78125rem; color: var(--color-text-primary);">@action.Rationale</div>
                        <div class="cg-toolbar" style="margin-block-start: 0.5rem;">
                            <button type="button" class="cg-btn" disabled="@_isBusy" @onclick="() => DecideAsync(action.Id, true)">@Loc.T("action.approve")</button>
                            <button type="button" class="cg-btn" disabled="@_isBusy" @onclick="() => DecideAsync(action.Id, false)">@Loc.T("action.reject")</button>
                        </div>
                    </div>
                }
            </div>
        }
        @if (!string.IsNullOrWhiteSpace(_message))
        {
            <div role="status" aria-live="polite" class="cg-callout">@_message</div>
        }
    </div>

    <div class="cg-card">
        <div class="cg-section-header">
            <h2>@Loc.T("panel.membershipQueue")</h2>
            <a class="cg-btn" href="/residents">@Loc.T("action.openResidentPortal")</a>
        </div>
        <h3 style="margin-block-start: 0 !important;">@Loc.T("panel.membershipQueue")</h3>
        @{
            var pendingMembers = Snapshot.Community.ResidentMemberships
                .Where(m => m.Status == ResidentMembershipStatus.PendingApproval)
                .OrderByDescending(m => m.SubmittedAtUtc)
                .ToList();
        }
        @if (pendingMembers.Count == 0)
        {
            <div class="cg-subcard">
                <span class="cg-badge cg-badge-ok">@Loc.T("msg.allVerified")</span>
                <span style="margin-inline-start: 0.375rem;">@Loc.T("msg.allVerifiedFor") @Snapshot.Community.Name.</span>
            </div>
        }
        else
        {
            <div style="display: flex; flex-direction: column; gap: 0.5rem;">
                @foreach (var app in pendingMembers)
                {
                    <div @key="app.Id" class="cg-subcard">
                        <div style="display: flex; align-items: center; justify-content: space-between; gap: 0.5rem; flex-wrap: wrap;">
                            <div>
                                <strong>@app.ApplicantFullName</strong>
                                <span class="cg-badge mono" style="margin-inline-start: 0.35rem;">@Loc.T("form.unit") @app.UnitNumber</span>
                                <span class="cg-badge" style="margin-inline-start: 0.25rem;">@app.Provider</span>
                            </div>
                            <span class="cg-badge cg-badge-warn">@Loc.T("msg.pendingApproval")</span>
                        </div>
                        <div style="font-size: 0.75rem; color: var(--color-text-secondary); margin-block-start: 0.25rem;">
                            @Loc.T("form.proof"): @app.OwnershipOrLeaseProofSummary
                        </div>
                        <div style="font-size: 0.72rem; color: var(--color-text-secondary); margin-block-start: 0.15rem;">
                            @Loc.T("table.groups"): @app.AssignedGroupsSummary
                        </div>
                        <div class="cg-toolbar" style="margin-block-start: 0.45rem;">
                            <button type="button" class="cg-btn" disabled="@_isBusy" @onclick="() => DecideResidentAsync(app.Id, true)">@Loc.T("action.approveResident")</button>
                            <button type="button" class="cg-btn" disabled="@_isBusy" @onclick="() => DecideResidentAsync(app.Id, false)">@Loc.T("action.reject")</button>
                        </div>
                    </div>
                }
            </div>
        }

        <h3>@Loc.T("panel.groupMessages")</h3>
        <div class="cg-table-wrap">
            <table class="cg-table">
                <thead>
                    <tr>
                        <th>@Loc.T("table.group")</th>
                        <th>@Loc.T("table.sender")</th>
                        <th>@Loc.T("table.subject")</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var msg in Snapshot.Community.CommunityMessages.OrderByDescending(m => m.SentAtUtc).Take(4))
                    {
                        <tr @key="msg.Id">
                            <td><span class="cg-badge">@msg.GroupName</span></td>
                            <td>
                                <strong>@msg.SenderName</strong>
                                <div style="font-size: 0.72rem; color: var(--color-text-secondary);">@msg.SenderUnitOrRole</div>
                            </td>
                            <td>
                                @if (msg.IsPinnedAnnouncement)
                                {
                                    <span class="cg-badge cg-badge-ok" style="margin-inline-end: 0.25rem;">@Loc.T("msg.pinned")</span>
                                }
                                <span>@msg.Subject</span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public CommunityWorkspaceSnapshot Snapshot { get; set; } = default!;
    [Parameter] public EventCallback OnChanged { get; set; }
    private bool _isBusy;
    private string _message = string.Empty;
    private Action? _locHandler;

    protected override async Task OnInitializedAsync()
    {
        _locHandler = () => InvokeAsync(StateHasChanged);
        Loc.OnChange += _locHandler;
        await Loc.EnsureLoadedAsync();
    }

    private async Task DecideAsync(Guid id, bool approve)
    {
        _isBusy = true;
        try
        {
            await Workspace.DecideAiActionAsync(Snapshot.Community.Id, id, approve, UiState.ActiveSecurityRole);
            await OnChanged.InvokeAsync();
        }
        finally
        {
            _isBusy = false;
        }
    }

    private async Task ApproveAllAsync()
    {
        _isBusy = true;
        try
        {
            var count = await Workspace.ApproveAllPendingActionsAsync(Snapshot.Community.Id);
            _message = $"{count} {Loc.T("msg.approvedCount")}";
            await OnChanged.InvokeAsync();
        }
        finally
        {
            _isBusy = false;
        }
    }

    private async Task DecideResidentAsync(Guid appId, bool approve)
    {
        _isBusy = true;
        try
        {
            var res = await Workspace.DecideResidentMembershipAsync(Snapshot.Community.Id, appId, approve, UiState.ActiveSecurityRole);
            _message = res.DecisionNote ?? Loc.T("msg.membershipUpdated");
            await OnChanged.InvokeAsync();
        }
        finally
        {
            _isBusy = false;
        }
    }

    public void Dispose()
    {
        if (_locHandler is not null)
        {
            Loc.OnChange -= _locHandler;
        }
    }
}
