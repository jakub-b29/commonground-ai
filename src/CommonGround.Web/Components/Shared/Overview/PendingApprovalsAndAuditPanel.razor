@using CommonGround.Application.Services
@inject CommonGroundWorkspaceService Workspace
@inject WorkspaceUiState UiState
<div class="cg-grid-2" style="margin-top: 0.875rem;">
    <div class="cg-card">
        <h2>Pending approvals</h2>
        @if (Snapshot.PendingActions.Count == 0)
        {
            <p>No proposed actions awaiting review.</p>
        }
        else
        {
            @foreach (var action in Snapshot.PendingActions)
            {
                <div @key="action.Id" style="border-top: 1px solid var(--color-border-subtle); padding: 0.5rem 0;">
                    <div><strong>@action.Title</strong></div>
                    <div style="font-size: 0.75rem; color: var(--color-text-secondary);">@action.AgentName · @action.ModelUsed · confidence <span class="num">@action.Confidence.ToString("N2")</span></div>
                    <div style="font-size: 0.8rem;">@action.Rationale</div>
                    <div style="display: flex; gap: 0.375rem; margin-top: 0.375rem;">
                        <button type="button" class="cg-btn cg-btn-primary" disabled="@_isBusy" @onclick="() => DecideAsync(action.Id, true)">Approve action</button>
                        <button type="button" class="cg-btn" disabled="@_isBusy" @onclick="() => DecideAsync(action.Id, false)">Reject</button>
                    </div>
                </div>
            }
            <button type="button" class="cg-btn" disabled="@_isBusy" @onclick="ApproveAllAsync" style="margin-top: 0.5rem;">Approve all pending</button>
        }
    </div>
    <div class="cg-card">
        <h2>Service execution and SHA-256 security audit log</h2>
        <h3>Service execution log</h3>
        <div class="cg-table-wrap">
            <table class="cg-table">
                <thead><tr><th>Agent</th><th>Model</th><th class="num">Latency</th><th class="num">Tokens</th><th>PII</th></tr></thead>
                <tbody>
                    @foreach (var run in Snapshot.RecentAgentRuns)
                    {
                        <tr @key="run.Id">
                            <td>@run.AgentName</td>
                            <td class="mono">@run.ModelName</td>
                            <td class="num">@run.TotalLatencyMs ms</td>
                            <td class="num">@run.TotalTokens</td>
                            <td><span class="cg-badge cg-badge-ok">Redacted</span></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <h3 style="margin-top: 0.5rem;">Tamper-evident audit trail</h3>
        <div class="cg-table-wrap">
            <table class="cg-table">
                <thead><tr><th>Role</th><th>Category</th><th>Resource</th><th>Hash</th></tr></thead>
                <tbody>
                    @foreach (var e in Snapshot.RecentAuditEvents)
                    {
                        <tr @key="e.Id">
                            <td>@e.ActorRole</td>
                            <td>@e.ActionCategory</td>
                            <td>@e.ResourceDescriptor</td>
                            <td class="mono">@(e.EntrySha256Hash.Length > 12 ? e.EntrySha256Hash[..12] : e.EntrySha256Hash)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <button type="button" class="cg-btn" disabled="@_isBusy" @onclick="VerifyChainAsync" style="margin-top: 0.5rem;">Verify SHA-256 chain integrity</button>
        @if (!string.IsNullOrWhiteSpace(_message))
        {
            <div role="status" aria-live="polite" style="margin-top: 0.375rem;">@_message</div>
        }
    </div>
</div>
@code {
    [Parameter, EditorRequired] public CommunityWorkspaceSnapshot Snapshot { get; set; } = default!;
    [Parameter] public EventCallback OnChanged { get; set; }
    private bool _isBusy;
    private string _message = string.Empty;
    private async Task DecideAsync(Guid id, bool approve)
    {
        _isBusy = true;
        try
        {
            await Workspace.DecideAiActionAsync(Snapshot.Community.Id, id, approve, UiState.ActiveSecurityRole);
            await OnChanged.InvokeAsync();
        }
        finally
        {
            _isBusy = false;
        }
    }
    private async Task ApproveAllAsync()
    {
        _isBusy = true;
        try
        {
            var count = await Workspace.ApproveAllPendingActionsAsync(Snapshot.Community.Id);
            _message = $"Approved {count} pending actions.";
            await OnChanged.InvokeAsync();
        }
        finally
        {
            _isBusy = false;
        }
    }
    private async Task VerifyChainAsync()
    {
        var (isValid, count, latest) = await Workspace.VerifySecurityAuditChainAsync(Snapshot.Community.Id);
        _message = isValid ? $"Audit chain valid. Verified {count} events. Latest {latest[..12]}." : "Audit chain verification failed.";
    }
}
