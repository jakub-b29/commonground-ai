@using CommonGround.Domain.Entities
@using CommonGround.Domain.Enums
@inject CommonGroundWorkspaceService Workspace
@inject WorkspaceAccessService Access
@inject WorkspaceLocalization Loc
@implements IDisposable

<div class="cg-card">
    <div class="cg-section-header">
        <h2>@Loc.T("panel.membershipQueue")</h2>
        <span class="cg-badge">@Community.Name</span>
    </div>
    <p style="color: var(--color-text-secondary); font-size: 0.78125rem;">
        @Loc.T("membership.verifyHint") <strong>@Community.Name</strong>.
    </p>

    <div class="cg-table-wrap">
        <table class="cg-table">
            <thead>
                <tr>
                    <th>@Loc.T("table.applicant")</th>
                    <th>@Loc.T("table.unit")</th>
                    <th>@Loc.T("form.provider")</th>
                    <th>@Loc.T("membership.deedVerify")</th>
                    <th>@Loc.T("table.groups")</th>
                    <th>@Loc.T("table.status")</th>
                    <th>@Loc.T("table.actions")</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var app in Community.ResidentMemberships.OrderBy(m => m.Status).ThenByDescending(m => m.SubmittedAtUtc))
                {
                    <tr @key="app.Id">
                        <td>
                            <strong>@app.ApplicantFullName</strong>
                            <div style="font-size: 0.72rem; color: var(--color-text-secondary);">@app.ApplicantEmail · @app.ApplicantPhone</div>
                        </td>
                        <td class="mono"><strong>@app.UnitNumber</strong></td>
                        <td><span class="cg-badge">@app.Provider</span></td>
                        <td>@app.OwnershipOrLeaseProofSummary</td>
                        <td style="font-size: 0.75rem; color: var(--color-text-secondary);">@app.AssignedGroupsSummary</td>
                        <td>
                            <span class="cg-badge @(app.Status == ResidentMembershipStatus.Approved ? "cg-badge-ok" : app.Status == ResidentMembershipStatus.PendingApproval ? "cg-badge-warn" : "cg-badge-err")">
                                @app.Status
                            </span>
                        </td>
                        <td>
                            @if (app.Status == ResidentMembershipStatus.PendingApproval)
                            {
                                <div style="display: flex; gap: 0.375rem; flex-wrap: wrap;">
                                    <button type="button" class="cg-btn" disabled="@_isBusy" @onclick="() => OnDecideAsync(app.Id, true)">@Loc.T("action.approveResident")</button>
                                    <button type="button" class="cg-btn" disabled="@_isBusy" @onclick="() => OnDecideAsync(app.Id, false)">@Loc.T("action.reject")</button>
                                </div>
                            }
                            else
                            {
                                <span style="font-size: 0.72rem; color: var(--color-text-secondary);">@(app.DecidedAtUtc?.ToString("yyyy-MM-dd") ?? Loc.T("membership.verifiedFallback"))</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <h3>@Loc.T("membership.submitTitle")</h3>
    <div class="cg-grid-3">
        <div>
            <label for="app-unit">@Loc.T("form.unitNumber")</label>
            <select id="app-unit" @bind="_unitNumber">
                @foreach (var u in Community.Units)
                {
                    <option value="@u.UnitNumber">@u.UnitNumber (@u.VerticalStackCode)</option>
                }
            </select>
        </div>
        <div>
            <label for="app-name">@Loc.T("form.name")</label>
            <input id="app-name" @bind="_fullName" placeholder="@Loc.T("form.name")" />
        </div>
        <div>
            <label for="app-email">@Loc.T("form.email")</label>
            <input id="app-email" @bind="_email" placeholder="@Loc.T("form.email")" />
        </div>
        <div>
            <label for="app-phone">@Loc.T("form.phone")</label>
            <input id="app-phone" @bind="_phone" placeholder="@Loc.T("form.phone")" />
        </div>
        <div>
            <label for="app-provider">@Loc.T("form.provider")</label>
            <select id="app-provider" @bind="_provider">
                @foreach (var p in Enum.GetValues<IdentityProvider>())
                {
                    <option value="@p">@p</option>
                }
            </select>
        </div>
        <div>
            <label for="app-proof">@Loc.T("form.proof")</label>
            <input id="app-proof" @bind="_proof" placeholder="Notarial Deed Rep. A #8810/2026" />
        </div>
    </div>
    <div class="cg-toolbar">
        <button type="button" class="cg-btn cg-btn-primary" disabled="@_isBusy" @onclick="OnSubmitApplicationAsync">@Loc.T("action.submitApplication")</button>
    </div>

    @if (!string.IsNullOrWhiteSpace(_message))
    {
        <div role="status" aria-live="polite" class="cg-callout">@_message</div>
    }
</div>

@code {
    [Parameter, EditorRequired] public Community Community { get; set; } = default!;
    [Parameter] public EventCallback OnChanged { get; set; }

    private string _unitNumber = string.Empty;
    private string _fullName = string.Empty;
    private string _email = string.Empty;
    private string _phone = string.Empty;
    private IdentityProvider _provider = IdentityProvider.EmailPassword;
    private string _proof = string.Empty;
    private bool _isBusy;
    private string _message = string.Empty;
    private Action? _locHandler;

    protected override async Task OnInitializedAsync()
    {
        _locHandler = () => InvokeAsync(StateHasChanged);
        Loc.OnChange += _locHandler;
        await Loc.EnsureLoadedAsync();
    }

    protected override void OnParametersSet()
    {
        if (Community.Units.Count > 0 && !Community.Units.Any(u => u.UnitNumber == _unitNumber))
        {
            _unitNumber = Community.Units[0].UnitNumber;
        }
    }

    private async Task OnDecideAsync(Guid applicationId, bool approve)
    {
        _isBusy = true;
        try
        {
            var role = await Access.GetRoleAsync();
            var updated = await Workspace.DecideResidentMembershipAsync(Community.Id, applicationId, approve, role);
            _message = updated.DecisionNote ?? Loc.T("msg.membershipUpdated");
            await OnChanged.InvokeAsync();
        }
        catch (Exception ex)
        {
            _message = ex.Message;
        }
        finally
        {
            _isBusy = false;
        }
    }

    private async Task OnSubmitApplicationAsync()
    {
        if (string.IsNullOrWhiteSpace(_fullName) || string.IsNullOrWhiteSpace(_email))
        {
            return;
        }
        _isBusy = true;
        try
        {
            var created = await Workspace.SubmitResidentMembershipApplicationAsync(Community.Id, _unitNumber, _fullName, _email, _phone, _provider, _proof);
            _message = $"{Loc.T("msg.membershipSubmitted")} {created.ApplicantFullName} ({Loc.T("form.unit")} {created.UnitNumber}) {Loc.T("form.community")} {Community.Name}.";
            await OnChanged.InvokeAsync();
        }
        catch (Exception ex)
        {
            _message = ex.Message;
        }
        finally
        {
            _isBusy = false;
        }
    }

    public void Dispose()
    {
        if (_locHandler is not null)
        {
            Loc.OnChange -= _locHandler;
        }
    }
}
