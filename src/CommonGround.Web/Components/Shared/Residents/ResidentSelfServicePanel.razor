@using CommonGround.Domain.Calculators
@using CommonGround.Domain.Entities
@using CommonGround.Domain.Enums
@inject CommonGroundWorkspaceService Workspace
@inject WorkspaceAccessService Access
@inject WorkspaceLocalization Loc
@implements IDisposable

<div class="cg-card">
    <div class="cg-section-header">
        <h2>@Loc.T("panel.selfService")</h2>
        @if (_unit is not null)
        {
            <span class="cg-badge cg-badge-ok">@Loc.T("form.unit") @_unit.UnitNumber · @_unit.VerticalStackCode</span>
        }
    </div>
    <div style="margin-block-end: 0.75rem;">
        <label for="resident-unit-select">@Loc.T("self.activeView")</label>
        <select id="resident-unit-select" value="@_selectedUnitId" @onchange="OnSelectUnit">
            @foreach (var u in Community.Units)
            {
                <option value="@u.Id" selected="@(_selectedUnitId == u.Id)">@u.UnitNumber – @u.PrimaryOwnerName (@u.VerticalStackCode)</option>
            }
        </select>
    </div>

    @if (_unit is not null)
    {
        <div class="cg-grid-3" style="margin-block-end: 0.75rem;">
            <div class="cg-subcard">
                <div class="kpi-label">@Loc.T("self.monthly")</div>
                <div class="kpi-value num" style="font-size: 1.15rem;">@_assessment?.TotalAssessment.ToString("N2") @Community.CurrencyCode</div>
                <div class="kpi-sub">@Loc.T("self.share") <span class="num">@_unit.ShareNumerator / @_unit.ShareDenominator</span></div>
            </div>
            <div class="cg-subcard">
                <div class="kpi-label">@Loc.T("self.balance")</div>
                <div class="kpi-value num" style="font-size: 1.15rem;">@_unit.CurrentBalance.ToString("N2") @Community.CurrencyCode</div>
                <div class="kpi-sub">@Loc.T("self.status") <span class="cg-badge @(_unit.CurrentBalance > 0 ? "cg-badge-warn" : "cg-badge-ok")">@_unit.ArrearsStage</span></div>
            </div>
            <div class="cg-subcard">
                <div class="kpi-label">@Loc.T("self.meters")</div>
                <div class="kpi-value num" style="font-size: 1.15rem;">@_unit.Meters.Count</div>
                <div class="kpi-sub">@Loc.T("self.riser") <span class="mono">@_unit.VerticalStackCode</span></div>
            </div>
        </div>

        <h3 style="margin-block-start: 0 !important;">@Loc.T("self.workOrdersTitle")</h3>
        <div class="cg-table-wrap">
            <table class="cg-table">
                <thead>
                    <tr>
                        <th>@Loc.T("self.item")</th>
                        <th>@Loc.T("self.categoryRule")</th>
                        <th>@Loc.T("table.status")</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var wo in Community.WorkOrders.Where(w => w.UnitId == _unit.Id || w.VerticalStackCode == _unit.VerticalStackCode).Take(3))
                    {
                        <tr @key="wo.Id">
                            <td><strong>@wo.Title</strong></td>
                            <td>@wo.Category (@wo.VerticalStackCode)</td>
                            <td><span class="cg-badge">@wo.Status</span></td>
                        </tr>
                    }
                    @foreach (var res in Community.Resolutions.Take(2))
                    {
                        var voted = res.Votes.FirstOrDefault(v => v.UnitId == _unit.Id);
                        <tr @key="res.Id">
                            <td><strong>@res.Number – @res.Title</strong></td>
                            <td>@res.MajorityRule</td>
                            <td>
                                <span class="cg-badge @(voted is not null ? "cg-badge-ok" : "cg-badge-warn")">
                                    @(voted is not null ? $"{Loc.T("self.voted")} {voted.Choice}" : Loc.T("self.ballotOpen"))
                                </span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired] public Community Community { get; set; } = default!;
    private Guid _selectedUnitId;
    private Unit? _unit;
    private MonthlyAssessment? _assessment;
    private Action? _locHandler;

    protected override async Task OnInitializedAsync()
    {
        _locHandler = () => InvokeAsync(StateHasChanged);
        Loc.OnChange += _locHandler;
        await Loc.EnsureLoadedAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        if (_selectedUnitId == Guid.Empty && Community.Units.Count > 0)
        {
            var linked = await Access.GetLinkedUnitAsync();
            _unit = (!string.IsNullOrWhiteSpace(linked)
                ? Community.Units.FirstOrDefault(u => string.Equals(u.UnitNumber, linked.Trim(), StringComparison.OrdinalIgnoreCase))
                : null) ?? Community.Units[0];
            _selectedUnitId = _unit.Id;
        }
        else
        {
            _unit = Community.Units.FirstOrDefault(u => u.Id == _selectedUnitId);
        }

        if (_unit is not null)
        {
            var credit = AncillaryRevenueEngine.CreditForUnit(Community.CommercialContracts, _unit);
            _assessment = AssessmentCalculator.Compute(Community, _unit, "2026-11", credit);
        }
    }

    private void OnSelectUnit(ChangeEventArgs e)
    {
        if (Guid.TryParse(e.Value?.ToString(), out var id))
        {
            _selectedUnitId = id;
            _unit = Community.Units.FirstOrDefault(u => u.Id == id);
            if (_unit is not null)
            {
                var credit = AncillaryRevenueEngine.CreditForUnit(Community.CommercialContracts, _unit);
                _assessment = AssessmentCalculator.Compute(Community, _unit, "2026-11", credit);
            }
        }
    }

    public void Dispose()
    {
        if (_locHandler is not null)
        {
            Loc.OnChange -= _locHandler;
        }
    }
}
