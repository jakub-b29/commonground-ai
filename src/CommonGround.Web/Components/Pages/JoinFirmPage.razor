@page "/join/{firmCode}"
@layout Layout.AuthLayout
@attribute [AllowAnonymous]
@inject NavigationManager Nav
@inject WorkspaceLocalization Loc
@implements IDisposable

<PageTitle>Join firm - CommonGround</PageTitle>

<div class="cg-auth-heading">
    <h1>Join firm</h1>
    <p>Join firm @FirmCode with a pending approval request.</p>
</div>

<form method="post" action="/auth/join-firm" class="cg-form-stack">
    <input type="hidden" name="firmCode" value="@FirmCode" />
    <div>
        <label for="join-name">Full name</label>
        <input id="join-name" name="fullName" required autocomplete="name" />
    </div>
    <div>
        <label for="join-email">Work email</label>
        <input id="join-email" name="email" type="email" required autocomplete="username" />
    </div>
    <div>
        <label for="join-phone">Phone number</label>
        <input id="join-phone" name="phone" type="tel" autocomplete="tel" />
    </div>
    <div>
        <label for="join-unit">Unit number</label>
        <input id="join-unit" name="unit" autocomplete="off" />
    </div>
    <div>
        <label for="join-proof">Ownership proof or note</label>
        <input id="join-proof" name="proof" autocomplete="off" />
    </div>
    <div>
        <label for="join-pass">Password</label>
        <input id="join-pass" name="password" type="password" required minlength="8" autocomplete="new-password" />
    </div>
    <button type="submit" class="cg-btn cg-btn-primary cg-btn-block">Request to join</button>
</form>

<div class="cg-auth-links">
    <a href="/login">Sign in</a>
    <a href="/register-firm">Register a new firm</a>
</div>

@code {
    [Parameter] public string FirmCode { get; set; } = string.Empty;
    private Action? _locHandler;

    protected override async Task OnInitializedAsync()
    {
        _locHandler = () => InvokeAsync(StateHasChanged);
        Loc.OnChange += _locHandler;
        await Loc.EnsureLoadedAsync();
    }

    public void Dispose()
    {
        if (_locHandler is not null) Loc.OnChange -= _locHandler;
    }
}
