@page "/join/{firmCode}"
@layout Layout.AuthLayout
@attribute [AllowAnonymous]
@inject NavigationManager Nav
@inject WorkspaceLocalization Loc
@implements IDisposable

<PageTitle>@Loc.T("joinFirm.title") - CommonGround</PageTitle>

<div class="cg-auth-heading">
    <h1>@Loc.T("joinFirm.heading")</h1>
    <p>@string.Format(System.Globalization.CultureInfo.InvariantCulture, Loc.T("joinFirm.leadFmt"), FirmCode)</p>
</div>

<form method="post" action="/auth/join-firm" class="cg-form-stack">
    <input type="hidden" name="firmCode" value="@FirmCode" />
    <div>
        <label for="join-name">@Loc.T("form.name")</label>
        <input id="join-name" name="fullName" required autocomplete="name" />
    </div>
    <div>
        <label for="join-email">@Loc.T("form.workEmail")</label>
        <input id="join-email" name="email" type="email" required autocomplete="username" />
    </div>
    <div>
        <label for="join-phone">@Loc.T("form.phone")</label>
        <input id="join-phone" name="phone" type="tel" autocomplete="tel" />
    </div>
    <div>
        <label for="join-unit">@Loc.T("form.unitNumber")</label>
        <input id="join-unit" name="unit" autocomplete="off" />
    </div>
    <div>
        <label for="join-proof">@Loc.T("form.proof")</label>
        <input id="join-proof" name="proof" autocomplete="off" />
    </div>
    <div>
        <label for="join-pass">@Loc.T("form.password")</label>
        <input id="join-pass" name="password" type="password" required minlength="8" autocomplete="new-password" />
    </div>
    <button type="submit" class="cg-btn cg-btn-primary cg-btn-block">@Loc.T("joinFirm.submit")</button>
</form>

<div class="cg-auth-links">
    <a href="/login">@Loc.T("nav.signin")</a>
    <a href="/register-firm">@Loc.T("auth.createFirmLink")</a>
</div>

@code {
    [Parameter] public string FirmCode { get; set; } = string.Empty;
    private Action? _locHandler;

    protected override async Task OnInitializedAsync()
    {
        _locHandler = () => InvokeAsync(StateHasChanged);
        Loc.OnChange += _locHandler;
        await Loc.EnsureLoadedAsync();
    }

    public void Dispose()
    {
        if (_locHandler is not null) Loc.OnChange -= _locHandler;
    }
}
