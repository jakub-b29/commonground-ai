@page "/maintenance/claims"
@attribute [Authorize(Policy = "ManagersOnly")]
@inject NavigationManager Nav
@inject WorkspaceAccessService Access

<PageTitle>Moved - CommonGround</PageTitle>

<p role="status" aria-live="polite">Maintenance has moved to the property workspace. Redirecting.</p>

@code {
    protected override async Task OnInitializedAsync()
    {
        var communities = await Access.GetAllowedCommunitiesAsync();
        var first = communities.FirstOrDefault();
        Nav.NavigateTo(first is null ? "/admin" : $"/properties/{first.Id}/maintenance", forceLoad: false);
    }
}
