@page "/maintenance/claims"
@attribute [Authorize(Policy = "ManagersOnly")]
@using CommonGround.Web.Components.Shared.Maintenance
@inject WorkspaceLocalization Loc
@implements IDisposable

<PageTitle>@Loc.T("panel.insurance") - CommonGround</PageTitle>

<div class="cg-page-header">
    <div>
        <h1>@Loc.T("panel.insurance")</h1>
        <p class="cg-page-lead">@Loc.T("page.walkthroughLead")</p>
    </div>
    <a class="cg-btn" href="/maintenance/walkthroughs">@Loc.T("panel.walkthrough")</a>
</div>

<ScopedCommunityPage>
    <ChildContent>
        <InsuranceClaimDossierPanel WorkOrders="context.Community.WorkOrders" CommunityId="context.Community.Id" />
    </ChildContent>
</ScopedCommunityPage>

@code {
    private Action? _locHandler;

    protected override async Task OnInitializedAsync()
    {
        _locHandler = () => InvokeAsync(StateHasChanged);
        Loc.OnChange += _locHandler;
        await Loc.EnsureLoadedAsync();
    }

    public void Dispose()
    {
        if (_locHandler is not null) Loc.OnChange -= _locHandler;
    }
}
