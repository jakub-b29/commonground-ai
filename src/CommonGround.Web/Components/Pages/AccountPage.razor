@page "/account"
@attribute [Authorize(Policy = "WorkspaceMember")]
@using CommonGround.Application.Services
@inject WorkspaceLocalization Loc
@inject WorkspaceAccessService Access
@inject CommonGroundWorkspaceService Workspace
@implements IDisposable

<PageTitle>@Loc.T("page.accountTitle") — CommonGround</PageTitle>

<div class="cg-page-header">
    <div>
        <h1>@Loc.T("page.accountTitle")</h1>
        <p class="cg-page-lead">@Loc.T("page.accountLead")</p>
    </div>
</div>

@if (!_loaded)
{
    <p role="status" aria-live="polite">@Loc.T("msg.loading")</p>
}
else if (_account is null)
{
    <div class="cg-card"><p class="cg-empty-text">@Loc.T("account.notFound") <a href="/login">@Loc.T("nav.signin")</a></p></div>
}
else
{
    <div class="cg-grid-2">
        <div class="cg-card">
            <div class="cg-section-header">
                <h2>@Loc.T("account.profileTitle")</h2>
                <div style="display: flex; gap: 0.35rem;">
                    @if (_residentDossier is not null)
                    {
                        <span class="cg-badge cg-badge-info mono">@_residentDossier.Profile.ResidentAccountNumber</span>
                    }
                    <span class="cg-badge">@_role</span>
                </div>
            </div>
            <div class="cg-table-wrap">
                <table class="cg-table">
                    <tbody>
                        @if (_residentDossier is not null)
                        {
                            <tr>
                                <td>@Loc.T("resident.accountNumber")</td>
                                <td><strong class="mono">@_residentDossier.Profile.ResidentAccountNumber</strong> (@Loc.T("account.permanentImmutable"))</td>
                            </tr>
                        }
                        <tr><td>@Loc.T("form.name")</td><td><strong>@_account.FullName</strong></td></tr>
                        <tr><td>@Loc.T("form.email")</td><td class="mono">@_account.Email</td></tr>
                        <tr><td>@Loc.T("form.phone")</td><td class="mono">@_account.Phone</td></tr>
                        <tr><td>@Loc.T("form.provider")</td><td>@_account.Provider</td></tr>
                        @if (_residentDossier is not null)
                        {
                            <tr><td>@Loc.T("account.verificationStatus")</td><td><span class="cg-badge">@_residentDossier.Profile.VerificationStatus</span></td></tr>
                            <tr><td>@Loc.T("account.emergencyContact")</td><td>@_residentDossier.Profile.EmergencyContactName · <span class="mono">@_residentDossier.Profile.EmergencyContactPhone</span></td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="cg-card">
            <div class="cg-section-header"><h2>@Loc.T("account.securityTitle")</h2></div>
            <p style="color: var(--color-text-secondary); font-size: 0.78125rem;">
                @Loc.T("account.securityHint") @Loc.T("account.emailStatusPrefix") @(_account.EmailConfirmed ? Loc.T("account.confirmed") : Loc.T("account.pendingConfirm")).
            </p>
            <div class="cg-toolbar">
                <a class="cg-btn" href="/verify-email">@Loc.T("account.verifyEmail")</a>
                <a class="cg-btn" href="/my-unit">@Loc.T("account.openMyUnit")</a>
            </div>
        </div>
    </div>

    @if (_residentDossier is not null)
    {
        <div class="cg-card" style="margin-block-start: 0.75rem;">
            <div class="cg-section-header">
                <h2>@Loc.T("account.assignmentsTitle") (@(_residentDossier.ActiveAssignments.Count + _residentDossier.PastAssignments.Count))</h2>
                <span class="cg-badge mono">@_residentDossier.Profile.ResidentAccountNumber</span>
            </div>
            @if (_residentDossier.ActiveAssignments.Count == 0 && _residentDossier.PastAssignments.Count == 0)
            {
                <p class="cg-empty-text">@Loc.T("account.noAssignments")</p>
            }
            else
            {
                <div class="cg-table-wrap">
                    <table class="cg-table">
                        <thead>
                            <tr>
                                <th>@Loc.T("account.colCommunity")</th>
                                <th>@Loc.T("account.colBuildingUnit")</th>
                                <th>@Loc.T("account.colRole")</th>
                                <th>@Loc.T("table.status")</th>
                                <th>@Loc.T("account.colTenancy")</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var a in _residentDossier.ActiveAssignments.Concat(_residentDossier.PastAssignments))
                            {
                                <tr @key="a.Assignment.Id">
                                    <td>
                                        <strong>@a.CommunityName</strong>
                                        <span class="mono" style="font-size: 0.72rem; color: var(--accent-primary);">@a.CommunityAccountNumber</span>
                                    </td>
                                    <td><strong>@Loc.T("form.unit") @a.UnitNumber</strong> · @a.BuildingName</td>
                                    <td><span class="cg-badge">@a.Assignment.AssignmentType</span></td>
                                    <td><span class="cg-badge @(a.Assignment.Status == UnitAssignmentStatus.Active ? "cg-badge-ok" : "")">@a.Assignment.Status</span></td>
                                    <td class="mono">@a.Assignment.MoveInDateUtc.ToString("yyyy-MM-dd") → @(a.Assignment.MoveOutDateUtc?.ToString("yyyy-MM-dd") ?? Loc.T("account.present"))</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    }
}
@if (!string.IsNullOrWhiteSpace(_message))
{
    <div role="status" aria-live="polite" class="cg-callout" style="margin-block-start: 0.75rem;">@_message</div>
}

@code {
    private WorkspaceUserAccount? _account;
    private ResidentFullDossier? _residentDossier;
    private WorkspaceSecurityRole _role = WorkspaceSecurityRole.Resident;
    private bool _loaded;
    private string _message = string.Empty;
    private Action? _locHandler;

    protected override async Task OnInitializedAsync()
    {
        _locHandler = () => InvokeAsync(StateHasChanged);
        Loc.OnChange += _locHandler;
        await Loc.EnsureLoadedAsync();
        try
        {
            _role = await Access.GetRoleAsync() ?? WorkspaceSecurityRole.Resident;
            _account = await Access.GetAccountAsync();
            if (_account is not null)
            {
                _residentDossier = await Workspace.GetResidentFullDossierByUserAsync(_account.Id, _account.Email, _account.CommunityId);
            }
        }
        catch (Exception ex) { _message = ex.Message; }
        finally { _loaded = true; }
    }

    public void Dispose()
    {
        if (_locHandler is not null) Loc.OnChange -= _locHandler;
    }
}
