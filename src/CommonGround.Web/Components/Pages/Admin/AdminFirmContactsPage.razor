@page "/admin/contacts"
@using CommonGround.Application.Persistence
@using CommonGround.Application.Services
@using Microsoft.EntityFrameworkCore
@inject WorkspaceAccessService Access
@inject IAppDbContextFactory DbFactory
@inject CommonGroundWorkspaceService Workspace
@inject NavigationManager Nav

<PageTitle>Firm contacts — CommonGround</PageTitle>

<PageHeader Category="Firm Administration"
            Title="Firm contacts"
            Subtitle="Firm and association legal details, emergency dispatch numbers, and email confirmation policy.">
    <Actions>
        <a class="cg-btn" href="/admin">Back to overview</a>
    </Actions>
</PageHeader>

@if (!_loaded)
{
    <p role="status" aria-live="polite">Loading firm contacts.</p>
}
else if (!_isAuthorized || _firm is null)
{
    <div class="cg-card"><p class="cg-empty-text">Access denied. Firm manager permission is required.</p></div>
}
else
{
    <div class="cg-stack">
        <div class="cg-card">
            <div class="cg-section-header">
                <h2>Unified Management Firm &amp; Governance Directory</h2>
                <span class="cg-badge mono">Firm Code: @_firm.FirmGroupCode</span>
            </div>
            <p style="color: var(--text-secondary); font-size: 0.8125rem; margin-block-end: 0.85rem;">
                Unified administrative, legal, emergency dispatch, and association governance contacts shared across your portfolio. Individual Community Contacts are configured per property under each Community Profile.
            </p>
            <div class="cg-grid-3">
                <div><label for="admin-firm-legal">Management firm legal name</label><input id="admin-firm-legal" @bind="_firm.ManagingFirmLegalName" /></div>
                <div><label for="admin-firm-tax">Firm tax ID / registration</label><input id="admin-firm-tax" @bind="_firm.FirmTaxIdOrNip" /></div>
                <div><label for="admin-firm-lic">Professional license number</label><input id="admin-firm-lic" @bind="_firm.LicenseNumber" /></div>
                <div><label for="admin-firm-dir">Managing director / principal</label><input id="admin-firm-dir" @bind="_firm.LeadDirectorName" /></div>
                <div><label for="admin-firm-office">Headquarters / office address</label><input id="admin-firm-office" @bind="_firm.OfficeAddress" /></div>
                <div><label for="admin-firm-support">Administration &amp; support email</label><input id="admin-firm-support" type="email" @bind="_firm.SupportEmail" /></div>
                <div><label for="admin-firm-dispatch">24/7 emergency dispatch phone</label><input id="admin-firm-dispatch" type="tel" @bind="_firm.EmergencyDispatchPhone" /></div>
                <div><label for="admin-hoa-pres">Portfolio governance / board liaison</label><input id="admin-hoa-pres" @bind="_firm.BoardPresidentName" /></div>
                <div><label for="admin-hoa-email">Governance &amp; board desk email</label><input id="admin-hoa-email" type="email" @bind="_firm.HoaBoardEmail" /></div>
            </div>
            <div class="cg-toolbar" style="margin-top: 0.85rem;">
                <button type="button" class="cg-btn cg-btn-primary" disabled="@_isBusy" @onclick="OnSaveAsync">Save firm contact directory</button>
            </div>
        </div>

        <div class="cg-card">
            <div class="cg-section-header">
                <h2>Firm security</h2>
                <span class="cg-badge mono">@_firm.FirmGroupCode</span>
            </div>
            <div>
                <label class="cg-check-row" for="admin-require-email">
                    <input id="admin-require-email" type="checkbox" checked="@_firm.RequireEmailConfirmation" @onchange="OnEmailPolicyChangedAsync" disabled="@_isBusy" />
                    <span>Require email confirmation for new members</span>
                </label>
                <p style="color: var(--text-secondary); font-size: 0.78125rem; margin-block-start: 0.375rem;">When enabled, new accounts stay pending until the email link is confirmed.</p>
            </div>
            <div class="cg-subcard" style="margin-block-start: 0.85rem;">
                <strong>Join code approval note</strong>
                <p style="color: var(--text-secondary); font-size: 0.78125rem; margin-block-start: 0.375rem;">Share the join code <code class="mono num">@_firm.FirmGroupCode</code> with new members. They join with the link <a href="/accept-invite?code=@Uri.EscapeDataString(_firm.FirmGroupCode)">@($"/accept-invite?code={_firm.FirmGroupCode}")</a>. Every join request enters the approval queue and needs manager approval before access is granted.</p>
            </div>
        </div>
    </div>
}

@if (!string.IsNullOrWhiteSpace(_message))
{
    <div role="status" aria-live="polite" class="cg-callout" style="margin-block-start: 0.75rem;">@_message</div>
}

@code {
    private ManagementFirm? _firm;
    private Guid? _firmId;
    private bool _loaded;
    private bool _isAuthorized;
    private bool _isBusy;
    private string _message = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var firmId = await Access.GetFirmIdAsync();
            if (firmId is null)
            {
                _loaded = true;
                return;
            }
            _firmId = firmId.Value;
            var role = await Access.GetRoleAsync();
            var hasAdmin = role == WorkspaceSecurityRole.FirmManager
                || await Access.HasPermissionAsync(WorkspacePermissionFlags.FirmFullAdministration);
            if (!hasAdmin)
            {
                Nav.NavigateTo("/no-access", forceLoad: false);
                return;
            }
            _isAuthorized = true;
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            _message = ex.Message;
        }
        finally
        {
            _loaded = true;
        }
    }

    private async Task ReloadAsync()
    {
        if (_firmId is null)
        {
            return;
        }
        await using var db = await DbFactory.CreateDbContextAsync();
        _firm = await db.ManagementFirms.AsNoTracking().FirstOrDefaultAsync(f => f.Id == _firmId.Value);
    }

    private async Task OnEmailPolicyChangedAsync(ChangeEventArgs e)
    {
        if (_firm is null)
        {
            return;
        }
        var enabled = e.Value is bool value && value;
        _isBusy = true;
        try
        {
            var role = await Access.GetRoleAsync() ?? WorkspaceSecurityRole.FirmManager;
            _firm = await Workspace.SetFirmEmailConfirmationPolicyAsync(_firm.Id, enabled, role);
            _message = "Email confirmation policy updated.";
        }
        catch (Exception ex)
        {
            _message = ex.Message;
        }
        finally
        {
            _isBusy = false;
        }
    }

    private async Task OnSaveAsync()
    {
        if (_firm is null)
        {
            return;
        }
        _isBusy = true;
        try
        {
            var role = await Access.GetRoleAsync() ?? WorkspaceSecurityRole.FirmManager;
            _firm = await Workspace.UpdateManagementFirmContactsAsync(
                _firm.Id,
                _firm.ManagingFirmLegalName,
                _firm.FirmTaxIdOrNip,
                _firm.LicenseNumber,
                _firm.LeadDirectorName,
                _firm.OfficeAddress,
                _firm.SupportEmail,
                _firm.EmergencyDispatchPhone,
                _firm.AssociationLegalName,
                _firm.HoaEinNumber,
                _firm.BoardPresidentName,
                _firm.ManagementAgentContact,
                _firm.ClubhouseOrOfficeAddress,
                _firm.HoaBoardEmail,
                _firm.HoaHotlinePhone,
                role);
            _message = "Contact details saved.";
        }
        catch (Exception ex)
        {
            _message = ex.Message;
        }
        finally
        {
            _isBusy = false;
        }
    }
}
