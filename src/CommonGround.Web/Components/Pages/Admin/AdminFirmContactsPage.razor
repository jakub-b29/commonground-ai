@page "/admin/contacts"
@using CommonGround.Application.Persistence
@using CommonGround.Application.Services
@using Microsoft.EntityFrameworkCore
@inject WorkspaceAccessService Access
@inject IAppDbContextFactory DbFactory
@inject CommonGroundWorkspaceService Workspace
@inject NavigationManager Nav
@inject WorkspaceLocalization Loc
@implements IDisposable

<PageTitle>@Loc.T("page.adminContactsTitle") — CommonGround</PageTitle>

<PageHeader Category="@Loc.T("admin.category")"
            Title="@Loc.T("page.adminContactsTitle")"
            Subtitle="@Loc.T("page.adminContactsLead")">
    <Actions>
        <a class="cg-btn" href="/admin">@Loc.T("action.backToOverview")</a>
    </Actions>
</PageHeader>

@if (!_loaded)
{
    <p role="status" aria-live="polite">@Loc.T("msg.loadingContacts")</p>
}
else if (!_isAuthorized || _firm is null)
{
    <div class="cg-card"><p class="cg-empty-text">@Loc.T("msg.accessDeniedFirm")</p></div>
}
else
{
    <div class="cg-stack">
        <div class="cg-card">
            <div class="cg-section-header">
                <h2>@Loc.T("admin.contacts.directoryTitle")</h2>
                <span class="cg-badge mono">@Loc.T("admin.contacts.firmCode"): @_firm.FirmGroupCode</span>
            </div>
            <p style="color: var(--text-secondary); font-size: 0.8125rem; margin-block-end: 0.85rem;">
                @Loc.T("admin.contacts.directoryLead")
            </p>
            <div class="cg-grid-3">
                <div><label for="admin-firm-legal">@Loc.T("admin.contacts.legalName")</label><input id="admin-firm-legal" @bind="_firm.ManagingFirmLegalName" /></div>
                <div><label for="admin-firm-tax">@Loc.T("admin.contacts.taxId")</label><input id="admin-firm-tax" @bind="_firm.FirmTaxIdOrNip" /></div>
                <div><label for="admin-firm-lic">@Loc.T("admin.contacts.license")</label><input id="admin-firm-lic" @bind="_firm.LicenseNumber" /></div>
                <div><label for="admin-firm-dir">@Loc.T("admin.contacts.director")</label><input id="admin-firm-dir" @bind="_firm.LeadDirectorName" /></div>
                <div><label for="admin-firm-office">@Loc.T("admin.contacts.office")</label><input id="admin-firm-office" @bind="_firm.OfficeAddress" /></div>
                <div><label for="admin-firm-support">@Loc.T("admin.contacts.supportEmail")</label><input id="admin-firm-support" type="email" @bind="_firm.SupportEmail" /></div>
                <div><label for="admin-firm-dispatch">@Loc.T("admin.contacts.dispatchPhone")</label><input id="admin-firm-dispatch" type="tel" @bind="_firm.EmergencyDispatchPhone" /></div>
                <div><label for="admin-hoa-pres">@Loc.T("admin.contacts.boardLiaison")</label><input id="admin-hoa-pres" @bind="_firm.BoardPresidentName" /></div>
                <div><label for="admin-hoa-email">@Loc.T("admin.contacts.boardEmail")</label><input id="admin-hoa-email" type="email" @bind="_firm.HoaBoardEmail" /></div>
            </div>
            <div class="cg-toolbar" style="margin-top: 0.85rem;">
                <button type="button" class="cg-btn cg-btn-primary" disabled="@_isBusy" @onclick="OnSaveAsync">@Loc.T("action.saveContacts")</button>
            </div>
        </div>

        <div class="cg-card">
            <div class="cg-section-header">
                <h2>@Loc.T("admin.contacts.securityTitle")</h2>
                <span class="cg-badge mono">@_firm.FirmGroupCode</span>
            </div>
            <div>
                <label class="cg-check-row" for="admin-require-email">
                    <input id="admin-require-email" type="checkbox" checked="@_firm.RequireEmailConfirmation" @onchange="OnEmailPolicyChangedAsync" disabled="@_isBusy" />
                    <span>@Loc.T("admin.contacts.requireEmail")</span>
                </label>
                <p style="color: var(--text-secondary); font-size: 0.78125rem; margin-block-start: 0.375rem;">@Loc.T("admin.contacts.requireEmailHint")</p>
            </div>
            <div class="cg-subcard" style="margin-block-start: 0.85rem;">
                <strong>@Loc.T("admin.contacts.joinNoteTitle")</strong>
                <p style="color: var(--text-secondary); font-size: 0.78125rem; margin-block-start: 0.375rem;">@Loc.T("admin.contacts.joinNoteLead") <code class="mono num">@_firm.FirmGroupCode</code> <a href="/accept-invite?code=@Uri.EscapeDataString(_firm.FirmGroupCode)">@($"/accept-invite?code={_firm.FirmGroupCode}")</a>. @Loc.T("admin.contacts.joinNoteTail")</p>
            </div>
        </div>
    </div>
}

@if (!string.IsNullOrWhiteSpace(_message))
{
    <div role="status" aria-live="polite" class="cg-callout" style="margin-block-start: 0.75rem;">@_message</div>
}

@code {
    private ManagementFirm? _firm;
    private Guid? _firmId;
    private bool _loaded;
    private bool _isAuthorized;
    private bool _isBusy;
    private string _message = string.Empty;
    private Action? _locHandler;

    protected override async Task OnInitializedAsync()
    {
        _locHandler = () => InvokeAsync(StateHasChanged);
        Loc.OnChange += _locHandler;
        await Loc.EnsureLoadedAsync();
        try
        {
            var role = await Access.GetRoleAsync();
            var hasAdmin = role == WorkspaceSecurityRole.FirmManager
                || await Access.HasPermissionAsync(WorkspacePermissionFlags.FirmFullAdministration);
            if (!hasAdmin)
            {
                Nav.NavigateTo("/no-access", forceLoad: false);
                return;
            }
            _isAuthorized = true;

            var firmId = await Access.GetFirmIdAsync();
            if (firmId is null)
            {
                await using var dbF = await DbFactory.CreateDbContextAsync();
                firmId = await dbF.ManagementFirms.Select(f => f.Id).FirstOrDefaultAsync();
            }
            _firmId = firmId;
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            _message = ex.Message;
        }
        finally
        {
            _loaded = true;
        }
    }

    private async Task ReloadAsync()
    {
        if (_firmId is null)
        {
            return;
        }
        await using var db = await DbFactory.CreateDbContextAsync();
        _firm = await db.ManagementFirms.AsNoTracking().FirstOrDefaultAsync(f => f.Id == _firmId.Value);
    }

    private async Task OnEmailPolicyChangedAsync(ChangeEventArgs e)
    {
        if (_firm is null)
        {
            return;
        }
        var enabled = e.Value is bool value && value;
        _isBusy = true;
        try
        {
            var role = await Access.GetRoleAsync() ?? WorkspaceSecurityRole.FirmManager;
            _firm = await Workspace.SetFirmEmailConfirmationPolicyAsync(_firm.Id, enabled, role);
            _message = Loc.T("msg.emailPolicyUpdated");
        }
        catch (Exception ex)
        {
            _message = ex.Message;
        }
        finally
        {
            _isBusy = false;
        }
    }

    private async Task OnSaveAsync()
    {
        if (_firm is null)
        {
            return;
        }
        _isBusy = true;
        try
        {
            var role = await Access.GetRoleAsync() ?? WorkspaceSecurityRole.FirmManager;
            _firm = await Workspace.UpdateManagementFirmContactsAsync(
                _firm.Id,
                _firm.ManagingFirmLegalName,
                _firm.FirmTaxIdOrNip,
                _firm.LicenseNumber,
                _firm.LeadDirectorName,
                _firm.OfficeAddress,
                _firm.SupportEmail,
                _firm.EmergencyDispatchPhone,
                _firm.AssociationLegalName,
                _firm.HoaEinNumber,
                _firm.BoardPresidentName,
                _firm.ManagementAgentContact,
                _firm.ClubhouseOrOfficeAddress,
                _firm.HoaBoardEmail,
                _firm.HoaHotlinePhone,
                role);
            _message = Loc.T("msg.contactsSaved");
        }
        catch (Exception ex)
        {
            _message = ex.Message;
        }
        finally
        {
            _isBusy = false;
        }
    }

    public void Dispose()
    {
        if (_locHandler is not null) Loc.OnChange -= _locHandler;
    }
}
