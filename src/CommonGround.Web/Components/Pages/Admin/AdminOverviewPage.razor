@page "/admin"
@using CommonGround.Application.Interfaces
@using CommonGround.Application.Persistence
@using Microsoft.EntityFrameworkCore
@inject WorkspaceAccessService Access
@inject IAppDbContextFactory DbFactory
@inject IMembershipService MembershipService
@inject NavigationManager Nav
@inject WorkspaceLocalization Loc
@implements IDisposable

<PageTitle>@Loc.T("page.adminOverviewTitle") — CommonGround</PageTitle>

<PageHeader Category="@Loc.T("admin.category")"
            Title="@Loc.T("page.adminOverviewTitle")"
            Subtitle="@Loc.T("page.adminOverviewLead")">
    <Badges>
        <AIBadge Label="CommonGround" Model="muse-spark-1.3" />
    </Badges>
    <Actions>
        <a class="cg-btn" href="/admin/members">@Loc.T("action.reviewApprovals") (@_pendingCount)</a>
        <a class="cg-btn cg-btn-primary" href="/admin/properties/new">@Loc.T("action.createProperty")</a>
    </Actions>
</PageHeader>

@if (!_loaded)
{
    <p role="status" aria-live="polite">@Loc.T("msg.loadingPortfolio")</p>
}
else if (!_isAuthorized)
{
    <div class="cg-card"><p class="cg-empty-text">@Loc.T("msg.accessDeniedFirm")</p></div>
}
else
{
    <div class="cg-grid-4" style="margin-bottom: 1rem;">
        <MetricCard Label="@Loc.T("admin.overview.managedProperties")"
                    Value="@_properties.Count.ToString()"
                    Subtitle="@Loc.T("admin.overview.managedSubtitle")"
                    BadgeText="@Loc.T("status.active")"
                    StatusVariant="ok" />
        <MetricCard Label="@Loc.T("admin.overview.pendingApprovals")"
                    Value="@_pendingCount.ToString()"
                    Subtitle="@Loc.T("admin.overview.pendingApprovalsSubtitle")"
                    BadgeText="@(_pendingCount > 0 ? Loc.T("admin.overview.needsReview") : Loc.T("admin.overview.clear"))"
                    StatusVariant="@(_pendingCount > 0 ? "warn" : "ok")" />
        <MetricCard Label="@Loc.T("admin.overview.pendingActions")"
                    Value="@_pendingActions.ToString()"
                    Subtitle="@Loc.T("admin.overview.pendingActionsSubtitle")"
                    BadgeText="@Loc.T("admin.overview.humanInLoop")"
                    StatusVariant="ai"
                    IsAi="true" />
        <MetricCard Label="@Loc.T("admin.overview.activeInvitations")"
                    Value="@_activeInvitations.ToString()"
                    Subtitle="@Loc.T("admin.overview.activeInvitationsSubtitle")"
                    BadgeText="@Loc.T("admin.overview.outbox")"
                    StatusVariant="info" />
    </div>

    <BentoGrid>
        <BentoCard Span="8"
                   Title="@Loc.T("admin.overview.managedCommunities")"
                   Subtitle="@Loc.T("admin.overview.launchpadSubtitle")"
                   BadgeText="@($"{_properties.Count} {Loc.T("admin.overview.registered")}")"
                   BadgeVariant="neutral"
                   BodyStyle="padding: 0;">
            <HeaderActions>
                <a class="cg-btn cg-btn-sm" href="/admin/properties">@Loc.T("action.openRegistry")</a>
            </HeaderActions>
            <ChildContent>
                <div class="cg-table-wrap">
                    <table class="cg-table">
                        <thead>
                            <tr>
                                <th>@Loc.T("table.property")</th>
                                <th>@Loc.T("table.city")</th>
                                <th class="num">@Loc.T("table.units")</th>
                                <th>@Loc.T("table.modules")</th>
                                <th>@Loc.T("table.registry")</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (_properties.Count == 0)
                            {
                                <tr><td colspan="5" style="color: var(--text-secondary);">@Loc.T("admin.overview.noProperties")</td></tr>
                            }
                            @foreach (var property in _properties)
                            {
                                <tr @key="property.Id">
                                    <td>
                                        <div style="display: flex; align-items: center; gap: 0.45rem; flex-wrap: wrap;">
                                            <strong>@property.Name</strong>
                                            <span class="cg-badge cg-badge-info mono num">@property.CommunityAccountNumber</span>
                                        </div>
                                        <div style="font-size: 0.74rem; color: var(--text-secondary);">@property.StreetAddress</div>
                                    </td>
                                    <td>@property.City</td>
                                    <td class="num">@property.UnitCount</td>
                                    <td>
                                        <div style="display: flex; flex-wrap: wrap; gap: 0.3rem;">
                                            <a class="cg-btn cg-btn-sm cg-btn-ai" href="@($"/properties/{property.Id}/overview")">@Loc.T("action.openWorkspace")</a>
                                            <a class="cg-btn cg-btn-sm" href="@($"/properties/{property.Id}/units")">@Loc.T("action.openUnits")</a>
                                            <a class="cg-btn cg-btn-sm" href="@($"/properties/{property.Id}/financials")">@Loc.T("action.openFinancials")</a>
                                            <a class="cg-btn cg-btn-sm" href="@($"/properties/{property.Id}/maintenance")">@Loc.T("action.openMaintenance")</a>
                                        </div>
                                    </td>
                                    <td><a class="cg-btn cg-btn-sm" href="/admin/properties">@Loc.T("action.openRegistry")</a></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </ChildContent>
        </BentoCard>

        <BentoCard Span="4"
                   IsAi="true"
                   Title="@Loc.T("admin.overview.intelligentOps")"
                   Subtitle="@Loc.T("admin.overview.intelligentOpsSubtitle")"
                   BadgeText="CommonGround Core"
                   BadgeVariant="ai">
            <ChildContent>
                <div style="display: flex; flex-direction: column; gap: 0.55rem;">
                    <a class="cg-btn cg-btn-ai cg-btn-block" style="justify-content: space-between;" href="/admin/properties/new">
                        <span>@Loc.T("admin.overview.createWithAi")</span>
                        <span class="mono" style="font-size: 0.7rem;">muse-spark-1.3</span>
                    </a>
                    <a class="cg-btn cg-btn-block" style="justify-content: space-between;" href="/admin/residents">
                        <span>@Loc.T("admin.overview.residentDirectory")</span>
                        <span class="mono" style="font-size: 0.7rem; color: var(--text-muted);">RES-XXXXXXXX</span>
                    </a>
                    <a class="cg-btn cg-btn-block" style="justify-content: space-between;" href="/units">
                        <span>@Loc.T("admin.overview.globalUnits")</span>
                        <span class="mono" style="font-size: 0.7rem; color: var(--text-muted);">@Loc.T("admin.overview.allBuildings")</span>
                    </a>
                    <a class="cg-btn cg-btn-block" style="justify-content: space-between;" href="/admin/members">
                        <span>@Loc.T("admin.overview.reviewApprovals")</span>
                        <span class="cg-badge cg-badge-warn mono">@_pendingCount</span>
                    </a>
                    <a class="cg-btn cg-btn-block" style="justify-content: space-between;" href="/admin/properties">
                        <span>@Loc.T("admin.overview.openRegistry")</span>
                        <span class="cg-badge cg-badge-neutral mono">@_properties.Count</span>
                    </a>
                    <a class="cg-btn cg-btn-block" style="justify-content: space-between;" href="/admin/contacts">
                        <span>@Loc.T("admin.overview.editContacts")</span>
                        <span class="mono" style="font-size: 0.7rem; color: var(--text-muted);">@Loc.T("admin.overview.dispatch247")</span>
                    </a>
                    <a class="cg-btn cg-btn-block" style="justify-content: space-between;" href="/admin/audit">
                        <span>@Loc.T("admin.overview.openAudit")</span>
                        <span class="mono" style="font-size: 0.7rem; color: var(--text-muted);">@Loc.T("admin.overview.shaChain")</span>
                    </a>
                </div>
                @if (!string.IsNullOrWhiteSpace(_message))
                {
                    <div role="status" aria-live="polite" class="cg-callout" style="margin-top: 0.75rem;">@_message</div>
                }
            </ChildContent>
            <FooterContent>
                <span>@Loc.T("admin.overview.tenantIsolation")</span>
                <span class="mono">DataSecurityAndPrivacyGuard</span>
            </FooterContent>
        </BentoCard>
    </BentoGrid>
}

@code {
    private bool _loaded;
    private bool _isAuthorized;
    private Guid? _firmId;
    private List<PropertyRow> _properties = new();
    private int _pendingCount;
    private int _pendingActions;
    private int _activeInvitations;
    private string _message = string.Empty;
    private Action? _locHandler;

    protected override async Task OnInitializedAsync()
    {
        _locHandler = () => InvokeAsync(StateHasChanged);
        Loc.OnChange += _locHandler;
        await Loc.EnsureLoadedAsync();
        try
        {
            var firmId = await Access.GetFirmIdAsync();
            if (firmId is null)
            {
                _loaded = true;
                return;
            }
            _firmId = firmId.Value;
            var role = await Access.GetRoleAsync();
            var hasAdmin = role == WorkspaceSecurityRole.FirmManager
                || await Access.HasPermissionAsync(WorkspacePermissionFlags.FirmFullAdministration);
            if (!hasAdmin)
            {
                Nav.NavigateTo("/no-access", forceLoad: false);
                return;
            }
            _isAuthorized = true;
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            _message = ex.Message;
        }
        finally
        {
            _loaded = true;
        }
    }

    private async Task ReloadAsync()
    {
        if (_firmId is null)
        {
            return;
        }
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var firmId = _firmId.Value;
            _properties = await db.Communities.AsNoTracking()
                .Where(c => c.ManagementFirmId == firmId)
                .OrderBy(c => c.Name)
                .Select(c => new PropertyRow(c.Id, c.CommunityAccountNumber, c.Name, c.City, c.StreetAddress, c.Units.Count))
                .ToListAsync();
            _pendingCount = (await MembershipService.GetPendingApprovalsAsync(firmId)).Count;
            _pendingActions = await db.AiActions.AsNoTracking()
                .CountAsync(a => a.Status == AiActionStatus.Proposed && _properties.Select(p => p.Id).Contains(a.CommunityId));
            _activeInvitations = await db.Invitations.AsNoTracking()
                .CountAsync(i => i.ManagementFirmId == firmId && i.Status == InvitationStatus.Pending);
        }
        catch (Exception ex)
        {
            _message = ex.Message;
        }
    }

    public void Dispose()
    {
        if (_locHandler is not null) Loc.OnChange -= _locHandler;
    }

    private sealed record PropertyRow(Guid Id, string CommunityAccountNumber, string Name, string City, string StreetAddress, int UnitCount);
}
