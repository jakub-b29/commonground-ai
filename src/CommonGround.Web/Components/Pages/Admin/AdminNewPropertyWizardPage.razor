@page "/admin/properties/new"
@using CommonGround.Application.Interfaces
@using CommonGround.Domain.Calculators
@using CommonGround.Web.Components.Shared.Admin
@using static CommonGround.Web.Components.Shared.Admin.AddressAiDiscoveryReviewPanel
@using static CommonGround.Web.Components.Shared.Admin.ManualPropertyForm
@inject WorkspaceAccessService Access
@inject IPropertyOnboardingService Onboarding
@inject NavigationManager Nav
@inject WorkspaceLocalization Loc
@implements IDisposable

<PageTitle>@Loc.T("page.adminNewPropertyTitle") — CommonGround</PageTitle>

<PageHeader Category="@Loc.T("admin.wizard.category")"
            Title="@Loc.T("page.adminNewPropertyTitle")"
            Subtitle="@Loc.T("page.adminNewPropertyLead")">
    <Badges>
        <AIBadge Label="Public Registry Sync" Model="muse-spark-1.3-contributor" />
    </Badges>
    <Actions>
        <a class="cg-btn" href="/admin/properties">@Loc.T("action.backToRegistry")</a>
    </Actions>
</PageHeader>

@if (!_loaded) { <p role="status" aria-live="polite">@Loc.T("msg.loadingWizard")</p> }
else if (!_isAuthorized) { <div class="cg-card"><p class="cg-empty-text">@Loc.T("msg.accessDeniedFirm")</p></div> }
else
{
    <div style="display: flex; flex-wrap: wrap; gap: 1rem; align-items: flex-start;">
        <div style="flex: 1 1 340px; min-width: 0;"><ManualPropertyForm Model="_manual" IsBusy="_creating" OnSubmit="OnCreateManualAsync" />
            @if (_createdId is not null) { <div role="status" aria-live="polite" class="ai-callout" style="margin-block-start: 0.75rem;">@Loc.T("admin.wizard.createdStep2") <a href="/properties/@_createdId/overview">@Loc.T("admin.wizard.openWorkspace")</a></div> }
            else if (!string.IsNullOrWhiteSpace(_message)) { <div role="status" aria-live="polite" class="cg-callout" style="margin-block-start: 0.75rem;">@_message</div> }
        </div>
        <aside style="flex: 1 1 340px; min-width: 0;"><AiCompletionAssistantPanel IsBusy="@(_discovering || _applying)" IsRunning="_discovering" CanRun="@(!_discovering)" ProgressPercent="_percent" ProgressStage="@_stage" ProgressDetail="@_detail" ThinkingLog="_thinking" IsOfflineFallback="_offlineFallback" Dossier="_dossier" Editable="_editable" Selected="_selected" SelectedChanged="OnSelectedChanged" OnHarvest="OnDiscoverAsync" OnApply="OnApplyAsync" />
            @if (!string.IsNullOrWhiteSpace(_aiMessage)) { <div role="status" aria-live="polite" class="cg-callout" style="margin-block-start: 0.75rem;">@_aiMessage</div> }
        </aside>
    </div>
}
@code {
    private bool _loaded; private bool _isAuthorized;
    private bool _creating; private bool _discovering; private bool _applying;
    private Guid? _firmId; private Guid? _actorId; private Guid? _createdId;
    private ManualPropertyModel _manual = new();
    private string _message = string.Empty; private string _aiMessage = string.Empty;
    private string _stage = string.Empty; private string _detail = string.Empty; private int _percent;
    private readonly List<string> _thinking = [];
    private readonly HashSet<string> _thinkingSeen = new(StringComparer.Ordinal);
    private int _lastMilestone = -1;
    private bool _offlineFallback;
    private PropertyAiDiscoveryDossier? _dossier; private EditableDossier? _editable;
    private DossierSectionFlags _selected = DossierSectionFlags.All;
    private Action? _locHandler;
    protected override async Task OnInitializedAsync()
    {
        _locHandler = () => InvokeAsync(StateHasChanged);
        Loc.OnChange += _locHandler;
        await Loc.EnsureLoadedAsync();
        try
        {
            var firmId = await Access.GetFirmIdAsync(); var actorId = await Access.GetActiveMembershipIdAsync();
            if (firmId is null || actorId is null) { _loaded = true; return; }
            _firmId = firmId.Value; _actorId = actorId.Value;
            var role = await Access.GetRoleAsync();
            if (role != WorkspaceSecurityRole.FirmManager) { Nav.NavigateTo("/no-access", forceLoad: false); return; }
            _isAuthorized = true;
        }
        catch (Exception ex) { _message = ex.Message; }
        finally { _loaded = true; }
    }
    private void OnSelectedChanged(DossierSectionFlags next) => _selected = next;
    private async Task OnCreateManualAsync()
    {
        if (_firmId is null || _actorId is null) return;
        if (string.IsNullOrWhiteSpace(_manual.Name) || string.IsNullOrWhiteSpace(_manual.Street) || string.IsNullOrWhiteSpace(_manual.City)) { _message = Loc.T("msg.propertyNameStreetCityRequired"); return; }
        _creating = true;
        try { var created = await Onboarding.CreatePropertyManualAsync(_firmId.Value, _actorId.Value, _manual.Name.Trim(), _manual.Street.Trim(), _manual.Postal.Trim(), _manual.City.Trim(), _manual.Country.Trim(), _manual.Mode); _createdId = created.Id; _message = string.Empty; }
        catch (Exception ex) { _message = ex.Message; }
        finally { _creating = false; }
    }
    private async Task OnDiscoverAsync()
    {
        if (string.IsNullOrWhiteSpace(_manual.Street) || string.IsNullOrWhiteSpace(_manual.City)) { _aiMessage = Loc.T("msg.streetCityRequired"); return; }
        if (_manual.Name.Length + _manual.Street.Length + _manual.City.Length > 500) { _aiMessage = Loc.T("msg.addressTooLong"); return; }
        _discovering = true; _offlineFallback = false;
        _thinking.Clear(); _thinkingSeen.Clear(); _lastMilestone = -1;
        try
        {
            var request = new AddressLookupRequest(_manual.Street.Trim(), _manual.Postal.Trim(), _manual.City.Trim(), _manual.Country.Trim(), _manual.Mode);
            var reporter = new Progress<DiscoveryProgressStep>(s =>
            {
                _stage = s.Stage; _detail = s.Detail; _percent = s.Percent;
                if (!string.IsNullOrWhiteSpace(s.Thinking))
                {
                    var key = s.Thinking.Trim();
                    if (!string.IsNullOrWhiteSpace(key) && _thinkingSeen.Add(key))
                    {
                        _thinking.Add($"[{DateTime.Now:HH:mm:ss}] {key}");
                        while (_thinking.Count > 200) { _thinking.RemoveAt(0); }
                    }
                }
                if ((s.Percent is 0 or 15 or 70 or 90 or 100) && s.Percent != _lastMilestone)
                {
                    _lastMilestone = s.Percent;
                    _thinking.Add($"[{DateTime.Now:HH:mm:ss}] \u2192 {s.Stage}: {s.Detail}");
                    while (_thinking.Count > 200) { _thinking.RemoveAt(0); }
                }
                InvokeAsync(StateHasChanged);
            });
            _dossier = await Onboarding.DiscoverPropertyDossierFromAddressAsync(request, default, reporter, Loc.ActiveLocale);
            _editable = new EditableDossier(_dossier); _selected = DossierSectionFlags.All;
            _offlineFallback = _dossier.SourceUrls.Any(u => u.Contains("offline-fallback", StringComparison.OrdinalIgnoreCase));
            _aiMessage = string.Empty;
        }
        catch (Exception ex) { _aiMessage = ex.Message; }
        finally { _discovering = false; }
    }
    private async Task OnApplyAsync()
    {
        if (_dossier is null || _editable is null) return;
        if (_selected == DossierSectionFlags.None) { _aiMessage = Loc.T("msg.selectDossierSection"); return; }
        if (_firmId is null || _actorId is null) return;
        _applying = true;
        try
        {
            var merged = _editable.ToMergedDossier(_dossier);
            if (_createdId is not null)
            {
                await Onboarding.ApplyDiscoveryDossierToPropertyAsync(_createdId.Value, _actorId.Value, merged, _selected);
                _aiMessage = Loc.T("msg.dossierApplied");
            }
            else
            {
                var scan = DataSecurityAndPrivacyGuard.InspectAndSanitizeUntrustedInput($"{_editable.SuggestedAssociationName} {_editable.RegistryNumber}");
                if (scan.IsInjectionDetected) { _aiMessage = Loc.T("msg.inputBlockedGuard"); return; }
                var created = await Onboarding.CreatePropertyFromDossierAsync(_firmId.Value, _actorId.Value, merged, _selected, _manual.Street.Trim(), _manual.Postal.Trim(), _manual.City.Trim(), _manual.Country.Trim());
                _createdId = created.Id; _aiMessage = Loc.T("msg.propertyCreatedDossier");
            }
        }
        catch (Exception ex) { _aiMessage = ex.Message; }
        finally { _applying = false; }
    }
    public void Dispose()
    {
        if (_locHandler is not null) Loc.OnChange -= _locHandler;
    }
}
