@page "/admin/residents/{id:guid}"
@attribute [Authorize(Policy = "WorkspaceMember")]
@using CommonGround.Application.Services
@using Microsoft.JSInterop
@inject WorkspaceLocalization Loc
@inject WorkspaceAccessService Access
@inject CommonGroundWorkspaceService Workspace
@inject IJSRuntime JS
@implements IDisposable

<PageTitle>@Loc.T("page.adminProfileTitle") — CommonGround</PageTitle>

@if (!_loaded)
{
    <p role="status" aria-live="polite">@Loc.T("msg.loadingProfile")</p>
}
else if (!_isAuthorized)
{
    <div class="cg-card"><p class="cg-empty-text">@Loc.T("msg.accessDeniedManager")</p></div>
}
else if (_dossier is null)
    {
        <div class="cg-card">
            <p class="cg-empty-text">@Loc.T("admin.profile.notFound")</p>
            <div class="cg-toolbar"><a class="cg-btn" href="/admin/residents">@Loc.T("admin.profile.backDirectory")</a></div>
        </div>
    }
    else
    {
        <PageHeader Category="@Loc.T("admin.profile.category")"
                    ContextCode="@($"{_dossier.Profile.ResidentAccountNumber} · {_dossier.Profile.AccountStatus}")"
                    Title="@($"{_dossier.Profile.FullName} · {_dossier.Profile.ResidentAccountNumber}")"
                    Subtitle="@Loc.T("page.adminProfileLead")">
            <Badges>
                <StatusBadge Text="@_dossier.Profile.ResidentAccountNumber" Variant="info" />
                <StatusBadge Text="@_dossier.Profile.AccountStatus.ToString()" Variant="@(_dossier.Profile.AccountStatus == ResidentAccountStatus.Active ? "ok" : "warn")" />
                <StatusBadge Text="@_dossier.Profile.VerificationStatus.ToString()" Variant="neutral" />
            </Badges>
            <Actions>
                <a class="cg-btn cg-btn-sm" href="/admin/residents">@Loc.T("admin.profile.backDirectory")</a>
                <a class="cg-btn cg-btn-sm" href="/units">@Loc.T("nav.globalUnits")</a>
            </Actions>
        </PageHeader>

        @if (!string.IsNullOrWhiteSpace(_message))
        {
            <div class="ai-callout" style="margin-bottom: 1rem;" role="status" aria-live="polite">@_message</div>
        }
        @if (!string.IsNullOrWhiteSpace(_error))
        {
            <div class="cg-callout" style="margin-bottom: 1rem; border-color: var(--color-danger); color: var(--color-danger);" role="alert">@_error</div>
        }

        <div class="cg-grid-4" style="margin-bottom: 1rem;">
            <MetricCard Label="@Loc.T("admin.profile.kpiAccount")"
                        Value="@_dossier.Profile.ResidentAccountNumber"
                        Subtitle="@Loc.T("admin.profile.kpiAccountSub")"
                        BadgeText="@Loc.T("admin.profile.verifiedId")"
                        StatusVariant="info" />
            <MetricCard Label="@Loc.T("admin.profile.kpiActive")"
                        Value="@_dossier.ActiveAssignments.Count.ToString()"
                        Subtitle="@($"{_dossier.PastAssignments.Count} {Loc.T("admin.profile.historicalPreserved")}")"
                        BadgeText="@(_dossier.ActiveAssignments.Count > 0 ? Loc.T("admin.residents.occupied") : Loc.T("admin.residents.unassigned"))"
                        StatusVariant="@(_dossier.ActiveAssignments.Count > 0 ? "ok" : "neutral")" />
            <MetricCard Label="@Loc.T("admin.profile.kpiOwned")"
                        Value="@_dossier.Ownerships.Count.ToString()"
                        Subtitle="@($"{_dossier.HouseholdMembers.Count} {Loc.T("admin.profile.householdCount")}")"
                        BadgeText="@Loc.T("admin.profile.ownership")"
                        StatusVariant="info" />
            <MetricCard Label="@Loc.T("admin.profile.kpiVault")"
                        Value="@_dossier.Documents.Count.ToString()"
                        Subtitle="@($"{_dossier.AuditEvents.Count} {Loc.T("admin.profile.auditCount")}")"
                        BadgeText="@Loc.T("admin.profile.vault")"
                        StatusVariant="ok" />
        </div>

        <div style="display: flex; gap: 0.35rem; flex-wrap: wrap; margin-bottom: 1rem;">
            <button type="button" class="cg-btn cg-btn-sm @(_section == "identity" ? "cg-btn-primary" : "")" @onclick='() => _section = "identity"'>
                1. @Loc.T("admin.profile.sec1") (@_dossier.Profile.ResidentAccountNumber)
            </button>
            <button type="button" class="cg-btn cg-btn-sm @(_section == "units" ? "cg-btn-primary" : "")" @onclick='() => _section = "units"'>
                2. @Loc.T("admin.profile.sec2") (@(_dossier.ActiveAssignments.Count + _dossier.PastAssignments.Count))
            </button>
            <button type="button" class="cg-btn cg-btn-sm @(_section == "household" ? "cg-btn-primary" : "")" @onclick='() => _section = "household"'>
                3. @Loc.T("admin.profile.sec3") (@_dossier.HouseholdMembers.Count)
            </button>
            <button type="button" class="cg-btn cg-btn-sm @(_section == "comms" ? "cg-btn-primary" : "")" @onclick='() => _section = "comms"'>
                4. @Loc.T("admin.profile.sec4") (@_dossier.DirectMessages.Count)
            </button>
            <button type="button" class="cg-btn cg-btn-sm @(_section == "documents" ? "cg-btn-primary" : "")" @onclick='() => _section = "documents"'>
                5. @Loc.T("admin.profile.sec5") (@_dossier.Documents.Count)
            </button>
            <button type="button" class="cg-btn cg-btn-sm @(_section == "audit" ? "cg-btn-primary" : "")" @onclick='() => _section = "audit"'>
                6. @Loc.T("admin.profile.sec6") (@_dossier.AuditEvents.Count)
            </button>
            <button type="button" class="cg-btn cg-btn-sm @(_section == "registration" ? "cg-btn-primary" : "")" @onclick='() => _section = "registration"'>
                7. Registration &amp; Claim (@_dossier.RegistrationTokens.Count)
            </button>
        </div>

        @if (_section == "identity")
        {
            <div class="cg-card">
                <div class="cg-section-header">
                    <h2>@Loc.T("admin.profile.identityTitle")</h2>
                    <span class="cg-badge cg-badge-info mono">@_dossier.Profile.ResidentAccountNumber (@Loc.T("admin.profile.immutable"))</span>
                </div>
                <div class="cg-grid-4">
                    <div>
                        <label>@Loc.T("admin.profile.permanentNo")</label>
                        <input value="@_dossier.Profile.ResidentAccountNumber" class="mono" disabled />
                    </div>
                    <div>
                        <label>@Loc.T("form.firstName")</label>
                        <input @bind="_firstName" />
                    </div>
                    <div>
                        <label>@Loc.T("form.lastName")</label>
                        <input @bind="_lastName" />
                    </div>
                    <div>
                        <label>@Loc.T("admin.residents.primaryEmail")</label>
                        <input type="email" @bind="_email" />
                    </div>
                </div>
                <div class="cg-grid-4" style="margin-top: 0.65rem;">
                    <div>
                        <label>@Loc.T("form.phone")</label>
                        <input @bind="_phone" />
                    </div>
                    <div>
                        <label>@Loc.T("admin.wizard.language")</label>
                        <select @bind="_preferredLanguage">
                            <option value="EN">EN</option>
                            <option value="PL">PL</option>
                            <option value="DE">DE</option>
                            <option value="ES">ES</option>
                            <option value="FR">FR</option>
                        </select>
                    </div>
                    <div>
                        <label>@Loc.T("admin.profile.contactMethod")</label>
                        <select @bind="_preferredContactMethod">
                            <option value="Email">@Loc.T("contact.channelEmail")</option>
                            <option value="Phone">@Loc.T("admin.profile.phoneOpt")</option>
                            <option value="SMS">SMS</option>
                            <option value="Portal">@Loc.T("admin.profile.portalOpt")</option>
                        </select>
                    </div>
                    <div>
                        <label>@Loc.T("admin.profile.dob")</label>
                        <input type="date" @bind="_dateOfBirth" />
                    </div>
                </div>
                <div class="cg-grid-4" style="margin-top: 0.65rem;">
                    <div>
                        <label>@Loc.T("admin.profile.accountStatus")</label>
                        <select @bind="_accountStatus">
                            @foreach (var st in Enum.GetValues<ResidentAccountStatus>())
                            {
                                <option value="@st" @key="st">@st</option>
                            }
                        </select>
                    </div>
                    <div>
                        <label>@Loc.T("admin.profile.verifyStatus")</label>
                        <select @bind="_verificationStatus">
                            @foreach (var vs in Enum.GetValues<ResidentVerificationStatus>())
                            {
                                <option value="@vs" @key="vs">@vs</option>
                            }
                        </select>
                    </div>
                    <div>
                        <label>@Loc.T("admin.wizard.emergencyName")</label>
                        <input @bind="_emergencyName" />
                    </div>
                    <div>
                        <label>@Loc.T("admin.profile.emergencyPhone")</label>
                        <input @bind="_emergencyPhone" placeholder="@Loc.T("admin.profile.emergencyPh")" />
                    </div>
                </div>
                <div class="cg-grid-2" style="margin-top: 0.65rem;">
                    <div>
                        <label>@Loc.T("admin.profile.additionalContact")</label>
                        <input @bind="_additionalContact" placeholder="@Loc.T("admin.profile.additionalPh")" />
                    </div>
                    <div>
                        <label>@Loc.T("admin.profile.adminNotes")</label>
                        <input @bind="_notes" />
                    </div>
                </div>
                <div class="cg-toolbar" style="margin-top: 0.75rem;">
                    <button type="button" class="cg-btn cg-btn-primary" disabled="@_isBusy" @onclick="SaveIdentityAsync">
                        @Loc.T("admin.profile.saveIdentity")
                    </button>
                </div>
            </div>
        }
        else if (_section == "units")
        {
            <div class="cg-card" style="margin-bottom: 1rem;">
                <div class="cg-section-header">
                    <h2>@Loc.T("admin.profile.activeAssign") (@_dossier.ActiveAssignments.Count)</h2>
                    @if (_dashboard is not null && _dashboard.Units.Count > 0)
                    {
                        <button type="button" class="cg-btn cg-btn-sm cg-btn-primary" @onclick="() => _showQuickAssign = !_showQuickAssign">
                            @(_showQuickAssign ? Loc.T("admin.profile.cancelAssign") : Loc.T("admin.profile.assignAnother"))
                        </button>
                    }
                </div>

                @if (_showQuickAssign && _dashboard is not null)
                {
                    <div class="cg-subcard" style="margin-bottom: 0.85rem;">
                        <h3>@Loc.T("admin.profile.assignTitle") @_dossier.Profile.FullName (@_dossier.Profile.ResidentAccountNumber) @Loc.T("admin.profile.toUnit")</h3>
                        <div class="cg-grid-4" style="margin-top: 0.5rem;">
                            <div>
                                <label>@Loc.T("admin.residents.targetCommunity")</label>
                                <select value="@_assignCommunityId" @onchange="OnQuickAssignCommunityChanged">
                                    @foreach (var c in _dashboard.Communities)
                                    {
                                        <option value="@c.Id" @key="c.Id">@c.Name (@c.CommunityAccountNumber)</option>
                                    }
                                </select>
                            </div>
                            <div>
                                <label>@Loc.T("admin.residents.targetUnit")</label>
                                <select @bind="_assignUnitId">
                                    @foreach (var u in QuickAssignUnits)
                                    {
                                        <option value="@u.UnitId" @key="u.UnitId">@Loc.T("admin.residents.unit") @u.UnitNumber (@u.BuildingName · @u.OccupancyStatus)</option>
                                    }
                                </select>
                            </div>
                            <div>
                                <label>@Loc.T("admin.residents.assignmentRole")</label>
                                <select @bind="_assignType">
                                    @foreach (var t in Enum.GetValues<ResidentAssignmentType>())
                                    {
                                        <option value="@t" @key="t">@t</option>
                                    }
                                </select>
                            </div>
                            <div>
                                <label>
                                    <input type="checkbox" @bind="_assignAsPrimary" style="width: auto; margin-right: 0.35rem;" />
                                    @Loc.T("admin.wizard.primary")
                                </label>
                                <div class="mono" style="font-size: 0.72rem; color: var(--text-secondary); margin-top: 0.25rem;">Additional residents join as co-residents. Only check for the main tenant.</div>
                            </div>
                            <div>
                                <label>@Loc.T("admin.profile.overrideNotes")</label>
                                <input @bind="_assignNotes" placeholder="@Loc.T("admin.profile.overridePh")" />
                            </div>
                        </div>
                        <div class="cg-toolbar" style="margin-top: 0.5rem;">
                            <button type="button" class="cg-btn cg-btn-sm cg-btn-primary" disabled="@_isBusy" @onclick="SubmitQuickAssignAsync">
                                @Loc.T("admin.profile.confirmAssign")
                            </button>
                        </div>
                    </div>
                }

                @if (_dossier.ActiveAssignments.Count == 0)
                {
                    <p class="cg-empty-text">@Loc.T("admin.profile.noActive") (@_dossier.Profile.ResidentAccountNumber) @Loc.T("admin.profile.noActiveTail")</p>
                }
                else
                {
                    <div class="cg-table-wrap">
                        <table class="cg-table">
                            <thead>
                                <tr>
                                    <th>@Loc.T("admin.residents.targetCommunity")</th>
                                    <th>@Loc.T("admin.profile.buildingUnit")</th>
                                    <th>@Loc.T("admin.profile.roleStatus")</th>
                                    <th>@Loc.T("admin.profile.moveIn")</th>
                                    <th>@Loc.T("admin.profile.approvedBy")</th>
                                    <th>@Loc.T("table.actions")</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in _dossier.ActiveAssignments)
                                {
                                    <tr @key="item.Assignment.Id">
                                        <td>
                                            <div><strong>@item.CommunityName</strong></div>
                                            <div class="mono" style="font-size: 0.72rem; color: var(--accent-primary);">@item.CommunityAccountNumber</div>
                                        </td>
                                        <td>
                                            <strong>@Loc.T("admin.residents.unit") @item.UnitNumber</strong> · @item.BuildingName (<span class="num">@item.FloorAreaM2.ToString("F1") m²</span>)
                                        </td>
                                        <td>
                                            <span class="cg-badge cg-badge-ok">@item.Assignment.AssignmentType</span>
                                            @if (item.Assignment.IsPrimaryResident)
                                            {
                                                <span class="cg-badge cg-badge-info" style="margin-left: 0.25rem;">@Loc.T("admin.wizard.primary")</span>
                                            }
                                        </td>
                                        <td class="mono">@item.Assignment.MoveInDateUtc.ToString("yyyy-MM-dd")</td>
                                        <td>@item.Assignment.ApprovedByName</td>
                                        <td>
                                            <div style="display: flex; gap: 0.35rem; flex-wrap: wrap;">
                                                <a class="cg-btn cg-btn-sm" href="@($"/properties/{item.Assignment.CommunityId}/units/{item.Assignment.UnitId}")">@Loc.T("admin.profile.openUnit")</a>
                                                <button type="button" class="cg-btn cg-btn-sm" disabled="@_isBusy" @onclick="() => MoveOutNowAsync(item.Assignment)">
                                                    @Loc.T("admin.profile.moveOut")
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>

            <div class="cg-grid-2">
                <div class="cg-card">
                    <div class="cg-section-header">
                        <h2>@Loc.T("admin.profile.historicalAssign") (@_dossier.PastAssignments.Count)</h2>
                    </div>
                    @if (_dossier.PastAssignments.Count == 0)
                    {
                        <p class="cg-empty-text">@Loc.T("admin.profile.noPast")</p>
                    }
                    else
                    {
                        <div class="cg-table-wrap">
                            <table class="cg-table">
                                <thead>
                                    <tr>
                                        <th>@Loc.T("admin.profile.communityUnit")</th>
                                        <th>@Loc.T("table.type")</th>
                                        <th>@Loc.T("admin.profile.moveInOut")</th>
                                        <th>@Loc.T("admin.profile.notes")</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var past in _dossier.PastAssignments)
                                    {
                                        <tr @key="past.Assignment.Id">
                                            <td>
                                                <strong>@Loc.T("admin.residents.unit") @past.UnitNumber</strong> · @past.CommunityName
                                                <span class="mono" style="font-size: 0.72rem; color: var(--accent-primary);">@past.CommunityAccountNumber</span>
                                            </td>
                                            <td><span class="cg-badge">@past.Assignment.AssignmentType</span></td>
                                            <td class="mono">@past.Assignment.MoveInDateUtc.ToString("yyyy-MM-dd") → @(past.Assignment.MoveOutDateUtc?.ToString("yyyy-MM-dd") ?? Loc.T("admin.profile.ended"))</td>
                                            <td>@past.Assignment.AssignmentReasonOrNotes</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>

                <div class="cg-card">
                    <div class="cg-section-header">
                        <h2>@Loc.T("admin.profile.ownershipTitle") (@_dossier.Ownerships.Count)</h2>
                    </div>
                    @if (_dossier.Ownerships.Count == 0)
                    {
                        <p class="cg-empty-text">@Loc.T("admin.profile.noOwnership")</p>
                    }
                    else
                    {
                        <div class="cg-table-wrap">
                            <table class="cg-table">
                                <thead>
                                    <tr>
                                        <th>@Loc.T("admin.profile.communityUnit")</th>
                                        <th>@Loc.T("table.role")</th>
                                        <th class="num">@Loc.T("admin.profile.share")</th>
                                        <th>@Loc.T("table.status")</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var own in _dossier.Ownerships)
                                    {
                                        <tr @key="own.Ownership.Id">
                                            <td>
                                                <strong>@Loc.T("admin.residents.unit") @own.UnitNumber</strong> · @own.CommunityName
                                                <span class="mono" style="font-size: 0.72rem; color: var(--accent-primary);">@own.CommunityAccountNumber</span>
                                            </td>
                                            <td><span class="cg-badge">@own.Ownership.OwnershipRole</span></td>
                                            <td class="num mono">@own.Ownership.ShareNumerator / @own.Ownership.ShareDenominator (@own.Ownership.OwnershipPercentage.ToString("F1")%)</td>
                                            <td><span class="cg-badge @(own.Ownership.IsActive ? "cg-badge-ok" : "")">@(own.Ownership.IsActive ? Loc.T("status.active") : Loc.T("admin.residents.historical"))</span></td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        }
        else if (_section == "household")
        {
            <div class="cg-card">
                <div class="cg-section-header">
                    <h2>@Loc.T("admin.profile.householdTitle") (@_dossier.HouseholdMembers.Count)</h2>
                </div>
                @if (_dossier.ActiveAssignments.Count > 0)
                {
                    <div class="cg-grid-4" style="margin-bottom: 0.75rem;">
                        <div><label>@Loc.T("admin.profile.fullName")</label><input @bind="_hhName" placeholder="@Loc.T("admin.profile.hhNamePh")" /></div>
                        <div><label>@Loc.T("admin.profile.relationship")</label><input @bind="_hhRelation" placeholder="@Loc.T("admin.profile.relationPh")" /></div>
                        <div><label>@Loc.T("form.phone")</label><input @bind="_hhPhone" /></div>
                        <div><label>@Loc.T("admin.residents.email")</label><input @bind="_hhEmail" /></div>
                    </div>
                    <div class="cg-toolbar" style="margin-bottom: 0.75rem;">
                        <button type="button" class="cg-btn cg-btn-sm cg-btn-primary" disabled="@_isBusy" @onclick="AddHouseholdMemberAsync">
                            @Loc.T("admin.profile.addHousehold")
                        </button>
                    </div>
                }
                @if (_dossier.HouseholdMembers.Count == 0)
                {
                    <p class="cg-empty-text">@Loc.T("admin.profile.noHousehold")</p>
                }
                else
                {
                    <div class="cg-table-wrap">
                        <table class="cg-table">
                            <thead>
                                <tr>
                                    <th>@Loc.T("admin.profile.fullName")</th>
                                    <th>@Loc.T("admin.profile.relationship")</th>
                                    <th>@Loc.T("admin.profile.contact")</th>
                                    <th>@Loc.T("table.status")</th>
                                    <th>@Loc.T("table.actions")</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var h in _dossier.HouseholdMembers)
                                {
                                    <tr @key="h.Id">
                                        <td><strong>@h.FullName</strong></td>
                                        <td><span class="cg-badge">@h.RelationshipToPrimary</span></td>
                                        <td class="mono">@h.Email · @h.Phone</td>
                                        <td><span class="cg-badge @(h.IsActive ? "cg-badge-ok" : "")">@(h.IsActive ? Loc.T("status.active") : Loc.T("admin.profile.ended"))</span></td>
                                        <td>
                                            @if (h.IsActive)
                                            {
                                                <button type="button" class="cg-btn cg-btn-sm" disabled="@_isBusy" @onclick="() => RemoveHouseholdMemberAsync(h)">@Loc.T("admin.profile.remove")</button>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        }
        else if (_section == "comms")
        {
            <div class="cg-card">
                <div class="cg-section-header">
                    <h2>@Loc.T("admin.profile.commsTitle") (@_dossier.DirectMessages.Count)</h2>
                </div>
                @if (_dossier.ActiveAssignments.Count > 0 && !string.IsNullOrWhiteSpace(_dossier.Profile.PrimaryEmail))
                {
                    <div class="cg-grid-2" style="margin-bottom: 0.75rem;">
                        <div><label>@Loc.T("admin.profile.subject")</label><input @bind="_msgSubject" placeholder="@Loc.T("admin.profile.subjectPh")" /></div>
                        <div><label>@Loc.T("admin.profile.msgBody")</label><input @bind="_msgBody" placeholder="@Loc.T("admin.profile.msgBodyPh")" /></div>
                    </div>
                    <div class="cg-toolbar" style="margin-bottom: 0.75rem;">
                        <button type="button" class="cg-btn cg-btn-sm cg-btn-primary" disabled="@_isBusy" @onclick="SendMessageToResidentAsync">
                            @Loc.T("admin.profile.sendMsg")
                        </button>
                    </div>
                }
                @if (_dossier.DirectMessages.Count == 0)
                {
                    <p class="cg-empty-text">@Loc.T("admin.profile.noMessages")</p>
                }
                else
                {
                    @foreach (var m in _dossier.DirectMessages)
                    {
                        <div @key="m.Id" class="cg-subcard" style="margin-bottom: 0.5rem;">
                            <div style="display: flex; justify-content: space-between; gap: 0.5rem;">
                                <strong>@m.Subject</strong>
                                <span class="mono" style="font-size: 0.72rem; color: var(--text-secondary);">@m.SentAtUtc.ToString("yyyy-MM-dd HH:mm")</span>
                            </div>
                            <div style="font-size: 0.8rem; margin-top: 0.25rem;">@m.Body</div>
                            <div style="font-size: 0.72rem; color: var(--text-secondary); margin-top: 0.2rem;">
                                @Loc.T("admin.profile.from"): @m.SenderName (@m.SenderRole) → @m.RecipientName
                            </div>
                        </div>
                    }
                }
            </div>
        }
        else if (_section == "documents")
        {
            <div class="cg-card">
                <div class="cg-section-header">
                    <h2>@Loc.T("admin.profile.vaultTitle") (@_dossier.Documents.Count)</h2>
                </div>
                <div class="cg-grid-4" style="margin-bottom: 0.75rem;">
                    <div>
                        <label>@Loc.T("admin.profile.category")</label>
                        <select @bind="_docCategory">
                            @foreach (var cat in Enum.GetValues<ResidentDocumentCategory>())
                            {
                                <option value="@cat" @key="cat">@cat</option>
                            }
                        </select>
                    </div>
                    <div><label>@Loc.T("admin.profile.docTitle")</label><input @bind="_docTitle" placeholder="@Loc.T("admin.profile.docTitlePh")" /></div>
                    <div><label>@Loc.T("admin.profile.fileName")</label><input @bind="_docFileName" placeholder="@Loc.T("admin.profile.fileNamePh")" /></div>
                    <div><label>@Loc.T("admin.profile.summaryNotes")</label><input @bind="_docNotes" placeholder="@Loc.T("admin.profile.summaryPh")" /></div>
                </div>
                <div class="cg-toolbar" style="margin-bottom: 0.75rem;">
                    <button type="button" class="cg-btn cg-btn-sm cg-btn-primary" disabled="@_isBusy" @onclick="AddDocumentAsync">
                        @Loc.T("admin.profile.addDoc")
                    </button>
                </div>

                @if (_dossier.Documents.Count == 0)
                {
                    <p class="cg-empty-text">@Loc.T("admin.profile.noDocs")</p>
                }
                else
                {
                    <div class="cg-table-wrap">
                        <table class="cg-table">
                            <thead>
                                <tr>
                                    <th>@Loc.T("admin.profile.category")</th>
                                    <th>@Loc.T("admin.profile.titleFile")</th>
                                    <th>@Loc.T("admin.profile.summaryNotes")</th>
                                    <th>@Loc.T("admin.profile.uploadedBy")</th>
                                    <th>@Loc.T("admin.profile.uploadedAt")</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var d in _dossier.Documents)
                                {
                                    <tr @key="d.Id">
                                        <td><span class="cg-badge">@d.Category</span></td>
                                        <td>
                                            <div><strong>@d.Title</strong></div>
                                            <div class="mono" style="font-size: 0.72rem; color: var(--text-secondary);">@d.FileName</div>
                                        </td>
                                        <td>@d.SummaryOrNotes</td>
                                        <td>@d.UploadedByName (@d.UploadedByRole)</td>
                                        <td class="mono">@d.UploadedAtUtc.ToString("yyyy-MM-dd HH:mm")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        }
        else if (_section == "audit")
        {
            <div class="cg-card">
                <div class="cg-section-header">
                    <h2>@Loc.T("admin.profile.auditTitle") (@_dossier.AuditEvents.Count)</h2>
                    <span class="cg-badge mono">@Loc.T("admin.audit.verifiedChain")</span>
                </div>
                <div class="cg-subcard" style="margin-bottom: 0.75rem; font-size: 0.8rem;">
                    <strong>@Loc.T("admin.profile.kpiAccount"):</strong> <span class="mono">@_dossier.Profile.ResidentAccountNumber</span> ·
                    <strong>@Loc.T("admin.profile.registered"):</strong> <span class="mono">@_dossier.Profile.RegistrationDateUtc.ToString("yyyy-MM-dd HH:mm")</span> ·
                    <strong>@Loc.T("admin.profile.linkedUser"):</strong> <span class="mono">@(_dossier.Profile.UserId?.ToString() ?? Loc.T("admin.profile.notLinked"))</span>
                </div>
                @if (_dossier.AuditEvents.Count == 0)
                {
                    <p class="cg-empty-text">@Loc.T("admin.profile.noAudit")</p>
                }
                else
                {
                    <div class="cg-table-wrap">
                        <table class="cg-table">
                            <thead>
                                <tr>
                                    <th>@Loc.T("table.occurredUtc")</th>
                                    <th>@Loc.T("table.category")</th>
                                    <th>@Loc.T("admin.profile.actorRole")</th>
                                    <th>@Loc.T("table.summary")</th>
                                    <th>@Loc.T("table.chainHash")</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var ev in _dossier.AuditEvents)
                                {
                                    <tr @key="ev.Id">
                                        <td class="mono">@ev.OccurredAtUtc.ToString("yyyy-MM-dd HH:mm:ss")</td>
                                        <td><span class="cg-badge">@ev.ActionCategory</span></td>
                                        <td>@ev.ActorRole</td>
                                        <td>@ev.Summary</td>
                                        <td class="mono" style="font-size: 0.72rem;">@ev.EntrySha256Hash[..Math.Min(16, ev.EntrySha256Hash.Length)]…</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        }
        else if (_section == "registration")
        {
            <div class="cg-card">
                <div class="cg-section-header">
                    <h2>Registration &amp; Claim</h2>
                    <span class="cg-badge mono">@_dossier.Profile.ResidentAccountNumber</span>
                </div>
                <div class="cg-subcard" style="margin-bottom: 0.75rem; font-size: 0.8rem;">
                    <strong>Linked login account:</strong>
                    <span class="mono">@(_dossier.Profile.UserId?.ToString() ?? "Not linked to a login account")</span>
                </div>

                <h3>Active registration links (@_dossier.RegistrationTokens.Count(t => t.Status == RegistrationTokenStatus.Active))</h3>
                @if (_dossier.RegistrationTokens.Count == 0)
                {
                    <p class="cg-empty-text">No registration links issued for this profile's units yet. Plaintext links are shown once at generation time only.</p>
                }
                else
                {
                    <div class="cg-table-wrap">
                        <table class="cg-table">
                            <thead>
                                <tr>
                                    <th>Label / ref</th>
                                    <th>Unit</th>
                                    <th>Approval mode</th>
                                    <th class="num">Uses</th>
                                    <th>Expires</th>
                                    <th>Status</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var tk in _dossier.RegistrationTokens)
                                {
                                    var unitLabel = _dossier.ActiveAssignments.Concat(_dossier.PastAssignments)
                                        .FirstOrDefault(a => a.Assignment.UnitId == tk.TargetUnitId)?.UnitNumber ?? tk.TargetUnitId.ToString("N").AsSpan(0, 8).ToString();
                                    <tr @key="tk.Id">
                                        <td><strong>@tk.LabelOrReference</strong></td>
                                        <td><span class="mono">Unit @unitLabel</span></td>
                                        <td><span class="cg-badge">@tk.ApprovalMode</span></td>
                                        <td class="mono num">@tk.UseCount / @tk.MaxUses</td>
                                        <td class="mono num">@tk.ExpiresAtUtc.ToString("yyyy-MM-dd")</td>
                                        <td><span class="cg-badge @(tk.Status == RegistrationTokenStatus.Active ? "cg-badge-ok" : "")">@tk.Status</span></td>
                                        <td>
                                            <span class="cg-empty-text">Stored hash only; copy the plaintext link shown at generation time.</span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }

                @if (!string.IsNullOrWhiteSpace(_generatedLinkUrl))
                {
                    <div class="cg-callout" style="margin-top: 0.65rem;">
                        <strong>Registration link generated (copy now, shown once):</strong>
                        <div class="mono num" style="margin-top: 0.3rem; overflow-wrap: anywhere;">@_generatedLinkUrl</div>
                        <div class="cg-toolbar" style="margin-top: 0.5rem;">
                            <button type="button" class="cg-btn cg-btn-sm cg-btn-primary" @onclick="CopyGeneratedLinkAsync">
                                Copy link
                            </button>
                        </div>
                    </div>
                }

                @if (_dossier.ActiveAssignments.Count > 0)
                {
                    <h3 style="margin-top: 0.85rem;">Generate registration link</h3>
                    <div class="cg-grid-3" style="margin-top: 0.5rem;">
                        <div>
                            <label>Target unit</label>
                            <select @bind="_regUnitId">
                                @foreach (var item in _dossier.ActiveAssignments.Concat(_dossier.PastAssignments))
                                {
                                    <option value="@item.Assignment.UnitId" @key="item.Assignment.UnitId">@item.CommunityName — Unit @item.UnitNumber</option>
                                }
                            </select>
                        </div>
                        <div>
                            <label>Approval mode</label>
                            <select @bind="_regApprovalMode">
                                @foreach (var mode in Enum.GetValues<RegistrationApprovalMode>())
                                {
                                    <option value="@mode" @key="mode">@mode</option>
                                }
                            </select>
                        </div>
                        <div>
                            <label>Reference note</label>
                            <input @bind="_regLabel" placeholder="e.g. Family registration Q1" />
                        </div>
                    </div>
                    <div class="cg-toolbar" style="margin-top: 0.5rem;">
                        <button type="button" class="cg-btn cg-btn-sm cg-btn-primary" disabled="@_isBusy" @onclick="GenerateProfileRegistrationLinkAsync">
                            Generate registration link
                        </button>
                    </div>

                    <h3 style="margin-top: 0.85rem;">Send invitation email</h3>
                    <div class="cg-grid-2" style="margin-top: 0.5rem;">
                        <div>
                            <label>Recipient email</label>
                            <input type="email" @bind="_inviteEmail" placeholder="resident@example.com" />
                        </div>
                        <div style="display: flex; align-items: flex-end;">
                            <button type="button" class="cg-btn cg-btn-sm cg-btn-primary" disabled="@_isBusy" @onclick="SendProfileInvitationAsync">
                                Send invitation email
                            </button>
                        </div>
                    </div>
                }
                else
                {
                    <p class="cg-empty-text" style="margin-top: 0.75rem;">Assign the resident to a unit before generating a registration link or invitation.</p>
                }

                <h3 style="margin-top: 0.85rem;">Claim profile to my account</h3>
                @if (_dossier.Profile.UserId.HasValue && _dossier.Profile.UserId.Value != Guid.Empty)
                {
                    <p class="cg-empty-text">Profile is already linked to login account <span class="mono">@_dossier.Profile.UserId</span>.</p>
                }
                else
                {
                    <div class="cg-toolbar" style="margin-top: 0.5rem;">
                        <button type="button" class="cg-btn cg-btn-sm cg-btn-primary" disabled="@_isBusy" @onclick="ClaimProfileToMyAccountAsync">
                            Claim profile to my account
                        </button>
                    </div>
                }
            </div>
        }
    }

@code {
    [Parameter] public Guid Id { get; set; }

    private ResidentFullDossier? _dossier;
    private GlobalUnitsDashboardSnapshot? _dashboard;
    private string _section = "identity";
    private WorkspaceSecurityRole _role = WorkspaceSecurityRole.FirmManager;
    private bool _isAuthorized = true;
    private string _actorName = "Firm Administrator";
    private Guid? _actorUserId;
    private Guid? _membershipId;
    private Guid? _firmId;
    private IReadOnlyList<Guid> _allowedCommunityIds = [];
    private bool _loaded;
    private bool _isBusy;
    private string _message = string.Empty;
    private string _error = string.Empty;

    // Identity fields
    private string _firstName = string.Empty;
    private string _lastName = string.Empty;
    private string _email = string.Empty;
    private string _phone = string.Empty;
    private DateTime? _dateOfBirth;
    private string _additionalContact = string.Empty;
    private ResidentAccountStatus _accountStatus = ResidentAccountStatus.Active;
    private ResidentVerificationStatus _verificationStatus = ResidentVerificationStatus.Verified;
    private string _preferredLanguage = "EN";
    private string _preferredContactMethod = "Email";
    private string _emergencyName = string.Empty;
    private string _emergencyPhone = string.Empty;
    private string _emergencyRelation = string.Empty;
    private string _notes = string.Empty;

    // Quick assign fields
    private bool _showQuickAssign;
    private Guid _assignCommunityId;
    private Guid _assignUnitId;
    private ResidentAssignmentType _assignType = ResidentAssignmentType.Tenant;
    private bool _assignAsPrimary;
    private string _assignNotes = string.Empty;

    // Household fields
    private string _hhName = string.Empty;
    private string _hhRelation = "Family Member";
    private string _hhPhone = string.Empty;
    private string _hhEmail = string.Empty;

    // Direct message fields
    private string _msgSubject = string.Empty;
    private string _msgBody = string.Empty;

    // Document fields
    private ResidentDocumentCategory _docCategory = ResidentDocumentCategory.LeaseAgreement;
    private string _docTitle = string.Empty;
    private string _docFileName = string.Empty;
    private string _docNotes = string.Empty;

    // Registration & claim fields
    private Guid _regUnitId;
    private RegistrationApprovalMode _regApprovalMode = RegistrationApprovalMode.ManualFirmApproval;
    private string _regLabel = string.Empty;
    private string _inviteEmail = string.Empty;
    private string _generatedLinkUrl = string.Empty;

    private Action? _locHandler;

    private IReadOnlyList<UnitSummaryRow> QuickAssignUnits =>
        _dashboard is null ? [] : _dashboard.Units.Where(u => u.CommunityId == _assignCommunityId).ToList();

    protected override async Task OnInitializedAsync()
    {
        _locHandler = () => InvokeAsync(StateHasChanged);
        Loc.OnChange += _locHandler;
        await Loc.EnsureLoadedAsync();
        await ReloadAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        if (_loaded && _dossier?.Profile.Id != Id)
        {
            await ReloadAsync();
        }
    }

    private async Task ReloadAsync()
    {
        try
        {
            _role = await Access.GetRoleAsync() ?? WorkspaceSecurityRole.FirmManager;
            _isAuthorized = DataSecurityAndPrivacyGuard.IsManagerRole(_role);
            _membershipId = await Access.GetActiveMembershipIdAsync();
            var account = await Access.GetAccountAsync();
            _actorUserId = account?.Id;
            if (!string.IsNullOrWhiteSpace(account?.FullName))
                _actorName = account.FullName;

            var allowedComms = await Access.GetAllowedCommunitiesAsync();
            _allowedCommunityIds = allowedComms.Select(c => c.Id).ToList();
            _firmId = await Access.GetFirmIdAsync() ?? allowedComms.FirstOrDefault()?.ManagementFirmId;

            _dossier = null;
            StateHasChanged();
            _dossier = await Workspace.GetResidentFullDossierAsync(Id);
            if (_dossier is not null)
            {
                var p = _dossier.Profile;
                _firstName = p.FirstName;
                _lastName = p.LastName;
                _email = p.PrimaryEmail;
                _phone = p.Phone;
                _dateOfBirth = p.DateOfBirth;
                _additionalContact = p.AdditionalContactDetails;
                _accountStatus = p.AccountStatus;
                _verificationStatus = p.VerificationStatus;
                _preferredLanguage = p.PreferredLanguage;
                _preferredContactMethod = p.PreferredContactMethod;
                _emergencyName = p.EmergencyContactName;
                _emergencyPhone = p.EmergencyContactPhone;
                _emergencyRelation = p.EmergencyContactRelation;
                _notes = p.Notes;
                if (string.IsNullOrWhiteSpace(_inviteEmail))
                    _inviteEmail = p.PrimaryEmail;
                var firstAssignment = _dossier.ActiveAssignments.FirstOrDefault() ?? _dossier.PastAssignments.FirstOrDefault();
                if (firstAssignment is not null && (_regUnitId == Guid.Empty || !_dossier.ActiveAssignments.Concat(_dossier.PastAssignments).Any(a => a.Assignment.UnitId == _regUnitId)))
                    _regUnitId = firstAssignment.Assignment.UnitId;
            }

            if (_firmId.HasValue && _firmId.Value != Guid.Empty)
            {
                _dashboard = await Workspace.GetGlobalUnitsDashboardAsync(_firmId.Value, _allowedCommunityIds);
                if (_assignCommunityId == Guid.Empty && _dashboard.Communities.Count > 0)
                    _assignCommunityId = _dashboard.Communities[0].Id;
                var units = QuickAssignUnits;
                if (units.Count > 0 && !units.Any(u => u.UnitId == _assignUnitId))
                    _assignUnitId = units[0].UnitId;
            }
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loaded = true;
        }
    }

    private async Task SaveIdentityAsync()
    {
        if (_dossier is null) return;
        _error = string.Empty;
        _message = string.Empty;
        _isBusy = true;
        try
        {
            var input = new ResidentProfileUpdateInput(
                _firstName,
                _lastName,
                _email,
                _phone,
                _dateOfBirth,
                _dossier.Profile.ProfilePhotoUrl,
                _additionalContact,
                _accountStatus,
                _verificationStatus,
                _preferredLanguage,
                _preferredContactMethod,
                _emergencyName,
                _emergencyPhone,
                _emergencyRelation,
                _notes);
            var updated = await Workspace.UpdateResidentFullProfileAsync(_dossier.Profile.Id, input, _role, _actorUserId);
            _message = $"{Loc.T("admin.profile.saved")} {updated.FullName} ({updated.ResidentAccountNumber}).";
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _isBusy = false;
        }
    }

    private void OnQuickAssignCommunityChanged(ChangeEventArgs e)
    {
        if (Guid.TryParse(e.Value?.ToString(), out var cid))
        {
            _assignCommunityId = cid;
            var units = QuickAssignUnits;
            if (units.Count > 0)
                _assignUnitId = units[0].UnitId;
        }
    }

    private async Task SubmitQuickAssignAsync()
    {
        if (_dossier is null || _assignCommunityId == Guid.Empty || _assignUnitId == Guid.Empty) return;
        _error = string.Empty;
        _message = string.Empty;
        _isBusy = true;
        try
        {
            var targetUnit = QuickAssignUnits.FirstOrDefault(u => u.UnitId == _assignUnitId);
            var req = new ManualResidentAssignmentRequest(
                _assignCommunityId,
                targetUnit?.BuildingId ?? Guid.Empty,
                _assignUnitId,
                false,
                _dossier.Profile.Id,
                _dossier.Profile.FirstName,
                _dossier.Profile.LastName,
                _dossier.Profile.PrimaryEmail,
                _dossier.Profile.Phone,
                _dossier.Profile.PreferredLanguage,
                _dossier.Profile.EmergencyContactName,
                _dossier.Profile.EmergencyContactPhone,
                _assignType,
                UnitAssignmentStatus.Active,
                _assignAsPrimary,
                DateTime.UtcNow,
                null,
                _assignNotes,
                string.IsNullOrWhiteSpace(_assignNotes) ? (_assignAsPrimary ? "Primary assignment from Resident Profile" : "Co-resident assignment from Resident Profile") : _assignNotes);
            await Workspace.AssignResidentToUnitManualAsync(req, _role, _actorName, _membershipId);
            _showQuickAssign = false;
            _message = $"{Loc.T("admin.profile.assigned")} {_dossier.Profile.FullName} ({_dossier.Profile.ResidentAccountNumber}) {Loc.T("admin.residents.toUnit")} {targetUnit?.UnitNumber}.";
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _isBusy = false;
        }
    }

    private async Task MoveOutNowAsync(ResidentUnitAssignment assignment)
    {
        _error = string.Empty;
        _message = string.Empty;
        _isBusy = true;
        try
        {
            await Workspace.ExecuteMoveOutAsync(
                assignment.CommunityId,
                assignment.Id,
                DateTime.UtcNow,
                "Move-out executed from Resident Profile",
                _role,
                _actorName);
            _message = $"{Loc.T("admin.profile.movedOut")} {_dossier?.Profile.ResidentAccountNumber} {Loc.T("admin.profile.movedOutTail")}";
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _isBusy = false;
        }
    }

    private async Task AddHouseholdMemberAsync()
    {
        if (_dossier is null || _dossier.ActiveAssignments.Count == 0 || string.IsNullOrWhiteSpace(_hhName)) return;
        _error = string.Empty;
        _message = string.Empty;
        _isBusy = true;
        try
        {
            var primary = _dossier.ActiveAssignments[0].Assignment;
            await Workspace.UpsertHouseholdMemberAsync(
                primary.CommunityId,
                primary.UnitId,
                null,
                _hhName,
                _hhRelation,
                _hhPhone,
                _hhEmail,
                false,
                string.Empty,
                _role);
            _hhName = string.Empty;
            _hhPhone = string.Empty;
            _hhEmail = string.Empty;
            _message = Loc.T("msg.householdAdded");
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _isBusy = false;
        }
    }

    private async Task RemoveHouseholdMemberAsync(ResidentHouseholdMember member)
    {
        _isBusy = true;
        try
        {
            await Workspace.RemoveHouseholdMemberAsync(member.CommunityId, member.Id, _role);
            _message = $"{Loc.T("admin.profile.hhRemoved")} {member.FullName} {Loc.T("admin.profile.endedMark")}";
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _isBusy = false;
        }
    }

    private async Task SendMessageToResidentAsync()
    {
        if (_dossier is null || _dossier.ActiveAssignments.Count == 0 || string.IsNullOrWhiteSpace(_msgSubject) || string.IsNullOrWhiteSpace(_msgBody))
            return;
        _isBusy = true;
        try
        {
            var first = _dossier.ActiveAssignments[0];
            await Workspace.PostResidentDirectMessageAsync(
                first.Assignment.CommunityId,
                _actorName,
                "management@commonground.local",
                _role,
                first.UnitNumber,
                "Resident",
                $"{_dossier.Profile.FullName} <{_dossier.Profile.PrimaryEmail}>",
                _msgSubject,
                _msgBody);
            _msgSubject = string.Empty;
            _msgBody = string.Empty;
            _message = Loc.T("msg.directSent");
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _isBusy = false;
        }
    }

    private async Task AddDocumentAsync()
    {
        if (_dossier is null || string.IsNullOrWhiteSpace(_docTitle)) return;
        _isBusy = true;
        try
        {
            var commId = _dossier.ActiveAssignments.FirstOrDefault()?.Assignment.CommunityId
                ?? _dossier.PastAssignments.FirstOrDefault()?.Assignment.CommunityId
                ?? _dashboard?.Communities.FirstOrDefault()?.Id
                ?? Guid.Empty;
            var unitId = _dossier.ActiveAssignments.FirstOrDefault()?.Assignment.UnitId;
            if (commId == Guid.Empty)
            {
                _error = Loc.T("msg.selectCommunityFirst");
                return;
            }
            await Workspace.AddResidentDocumentAsync(
                commId,
                unitId,
                _dossier.Profile.Id,
                _docCategory,
                _docTitle,
                _docFileName,
                _docNotes,
                true,
                _actorName,
                _role);
            _docTitle = string.Empty;
            _docFileName = string.Empty;
            _docNotes = string.Empty;
            _message = Loc.T("msg.docAddedVault");
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _isBusy = false;
        }
    }

    private async Task GenerateProfileRegistrationLinkAsync()
    {
        if (_dossier is null) return;
        _error = string.Empty;
        _message = string.Empty;
        _generatedLinkUrl = string.Empty;
        _isBusy = true;
        try
        {
            var target = _dossier.ActiveAssignments.Concat(_dossier.PastAssignments)
                .FirstOrDefault(a => a.Assignment.UnitId == _regUnitId)
                ?? _dossier.ActiveAssignments.FirstOrDefault();
            if (target is null)
            {
                _error = Loc.T("msg.selectCommunityFirst");
                return;
            }
            var link = await Workspace.GenerateResidentRegistrationLinkAsync(
                target.Assignment.CommunityId,
                target.Assignment.UnitId,
                _regApprovalMode,
                target.Assignment.AssignmentType,
                DateTime.UtcNow.AddDays(14),
                1,
                string.IsNullOrWhiteSpace(_regLabel) ? $"Profile link for {_dossier.Profile.FullName}" : _regLabel.Trim(),
                _role,
                _actorName,
                _membershipId);
            _generatedLinkUrl = link.RelativeUrl;
            _message = $"Registration link generated for Unit {target.UnitNumber}: {link.RelativeUrl}";
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _isBusy = false;
        }
    }

    private async Task SendProfileInvitationAsync()
    {
        if (_dossier is null || string.IsNullOrWhiteSpace(_inviteEmail)) return;
        _error = string.Empty;
        _message = string.Empty;
        _isBusy = true;
        try
        {
            if (!_firmId.HasValue || _firmId.Value == Guid.Empty)
            {
                _error = Loc.T("msg.selectCommunityFirst");
                return;
            }
            var target = _dossier.ActiveAssignments.FirstOrDefault()
                ?? _dossier.PastAssignments.FirstOrDefault();
            if (target is null)
            {
                _error = Loc.T("msg.selectCommunityFirst");
                return;
            }
            var invited = await Workspace.CreateWorkspaceInvitationAsync(
                _firmId.Value,
                _inviteEmail.Trim(),
                _dossier.Profile.FullName,
                _dossier.Profile.Phone,
                WorkspaceSecurityRole.Resident,
                InvitationAssignmentMode.AutoAssignSpecificProperty,
                target.Assignment.CommunityId,
                target.UnitNumber,
                null,
                _actorName,
                _role,
                [target.Assignment.CommunityId],
                WorkspacePermissionPresets.DefaultForRole(WorkspaceSecurityRole.Resident),
                true);
            _message = $"Invitation created for {_inviteEmail.Trim()} ({_dossier.Profile.FullName}): {invited.RegistrationRelativeUrl}";
            _inviteEmail = _dossier.Profile.PrimaryEmail;
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _isBusy = false;
        }
    }

    private async Task CopyGeneratedLinkAsync()
    {
        if (string.IsNullOrWhiteSpace(_generatedLinkUrl)) return;
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", _generatedLinkUrl);
            _message = "Registration link copied to clipboard.";
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    private async Task ClaimProfileToMyAccountAsync()
    {
        if (_dossier is null || _actorUserId is null || _actorUserId.Value == Guid.Empty) return;
        _error = string.Empty;
        _message = string.Empty;
        _isBusy = true;
        try
        {
            var claimed = await Workspace.ClaimResidentProfileAsync(_dossier.Profile.Id, _actorUserId.Value, _role);
            _message = $"Profile {claimed.FullName} ({claimed.ResidentAccountNumber}) linked to your login account.";
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _isBusy = false;
        }
    }

    public void Dispose()
    {
        if (_locHandler is not null) Loc.OnChange -= _locHandler;
    }
}
