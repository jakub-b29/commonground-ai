@page "/verify-email"
@layout Layout.AuthLayout
@attribute [AllowAnonymous]
@inject WorkspaceLocalization Loc
@implements IDisposable

<PageTitle>@Loc.T("verifyEmail.title") - CommonGround</PageTitle>

<div class="cg-auth-heading">
    <h1>@Loc.T("verifyEmail.heading")</h1>
    <p>@Loc.T("verifyEmail.lead")</p>
</div>

@if (!string.IsNullOrWhiteSpace(ErrorCode))
{
    <div role="alert" class="cg-auth-error">@Loc.T("verifyEmail.failed")</div>
}

<form method="post" action="/auth/verify-email" class="cg-form-stack">
    <div>
        <label for="ve-email">@Loc.T("form.workEmail")</label>
        <input id="ve-email" name="email" type="email" value="@Email" required autocomplete="username" />
    </div>
    <div>
        <label for="ve-token">@Loc.T("verifyEmail.tokenLabel")</label>
        <input id="ve-token" name="token" required autocomplete="off" placeholder="@Loc.T("verifyEmail.tokenPlaceholder")" />
    </div>
    <button type="submit" class="cg-btn cg-btn-primary cg-btn-block">@Loc.T("verifyEmail.submit")</button>
</form>

<div class="cg-auth-links">
    <a href="/login">@Loc.T("nav.signin")</a>
    <a href="/register-firm">@Loc.T("auth.createFirmLink")</a>
</div>

@code {
    [SupplyParameterFromQuery(Name = "email")] public string? Email { get; set; }
    [SupplyParameterFromQuery(Name = "error")] public string? ErrorCode { get; set; }
    private Action? _locHandler;

    protected override async Task OnInitializedAsync()
    {
        _locHandler = () => InvokeAsync(StateHasChanged);
        Loc.OnChange += _locHandler;
        await Loc.EnsureLoadedAsync();
    }

    public void Dispose()
    {
        if (_locHandler is not null) Loc.OnChange -= _locHandler;
    }
}
