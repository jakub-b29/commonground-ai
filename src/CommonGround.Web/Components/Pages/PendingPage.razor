@page "/pending"
@layout Layout.AuthLayout
@attribute [AllowAnonymous]
@inject WorkspaceLocalization Loc
@implements IDisposable

<PageTitle>@Loc.T("pendingPage.title") - CommonGround</PageTitle>

<div class="cg-auth-heading">
    <h1>@Loc.T("pendingPage.heading")</h1>
    <p>@Loc.T("pendingPage.lead")</p>
</div>

<div class="cg-auth-note" role="status" aria-live="polite">
    <p>@Loc.T("pendingPage.contactHint")</p>
</div>

<div class="cg-auth-links">
    <a href="/login">@Loc.T("nav.signin")</a>
    <a href="/choose-membership">@Loc.T("pendingPage.chooseMembershipLink")</a>
</div>

@code {
    private Action? _locHandler;

    protected override async Task OnInitializedAsync()
    {
        _locHandler = () => InvokeAsync(StateHasChanged);
        Loc.OnChange += _locHandler;
        await Loc.EnsureLoadedAsync();
    }

    public void Dispose()
    {
        if (_locHandler is not null) Loc.OnChange -= _locHandler;
    }
}
