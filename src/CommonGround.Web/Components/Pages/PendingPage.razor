@page "/pending"
@layout Layout.AuthLayout
@attribute [AllowAnonymous]
@inject WorkspaceLocalization Loc
@implements IDisposable

<PageTitle>Pending approval - CommonGround</PageTitle>

<div class="cg-auth-heading">
    <h1>Pending approval</h1>
    <p>Your membership is waiting for manager approval. You will gain property access after approval.</p>
</div>

<div class="cg-auth-note" role="status" aria-live="polite">
    <p>Contact the firm manager if approval takes longer than expected.</p>
</div>

<div class="cg-auth-links">
    <a href="/login">Sign in</a>
    <a href="/choose-membership">Choose membership</a>
</div>

@code {
    private Action? _locHandler;

    protected override async Task OnInitializedAsync()
    {
        _locHandler = () => InvokeAsync(StateHasChanged);
        Loc.OnChange += _locHandler;
        await Loc.EnsureLoadedAsync();
    }

    public void Dispose()
    {
        if (_locHandler is not null) Loc.OnChange -= _locHandler;
    }
}
