@page "/settings/firm-contacts"
@attribute [Authorize(Policy = "FirmManagerOnly")]
@inject WorkspaceLocalization Loc
@inject WorkspaceAccessService Access
@inject CommonGroundWorkspaceService Workspace
@implements IDisposable

<PageTitle>@Loc.T("settings.firmContacts") - CommonGround</PageTitle>

<div class="cg-page-header">
    <div>
        <h1>@Loc.T("settings.firmContacts")</h1>
        <p class="cg-page-lead">@Loc.T("settings.lead")</p>
    </div>
    <div class="cg-toolbar" style="margin-block-start: 0;">
        <a class="cg-btn" href="/settings/property">@Loc.T("settings.propertyTitle")</a>
        <a class="cg-btn" href="/settings/account">@Loc.T("settings.accountTitle")</a>
    </div>
</div>

@if (!_loaded)
{
    <p role="status" aria-live="polite">@Loc.T("msg.loading")</p>
}
else if (_firm is null)
{
    <div class="cg-card"><p class="cg-empty-text">@Loc.T("firm.selectFirmHint")</p></div>
}
else
{
    <div class="cg-card">
        <div class="cg-section-header">
            <h2>@Loc.T("settings.firmContacts")</h2>
            <span class="cg-badge">@_firm.OperatingMode · @_firm.FirmGroupCode</span>
        </div>
        <div class="cg-grid-3">
            <div><label for="set-firm-legal">@Loc.T("settings.firmLegal")</label><input id="set-firm-legal" @bind="_firm.ManagingFirmLegalName" /></div>
            <div><label for="set-firm-tax">@Loc.T("settings.firmTax")</label><input id="set-firm-tax" @bind="_firm.FirmTaxIdOrNip" /></div>
            <div><label for="set-firm-lic">@Loc.T("settings.firmLicense")</label><input id="set-firm-lic" @bind="_firm.LicenseNumber" /></div>
            <div><label for="set-firm-dir">@Loc.T("settings.firmDirector")</label><input id="set-firm-dir" @bind="_firm.LeadDirectorName" /></div>
            <div><label for="set-firm-office">@Loc.T("settings.firmOffice")</label><input id="set-firm-office" @bind="_firm.OfficeAddress" /></div>
            <div><label for="set-firm-support">@Loc.T("settings.firmSupport")</label><input id="set-firm-support" @bind="_firm.SupportEmail" /></div>
            <div><label for="set-firm-dispatch">@Loc.T("settings.firmDispatch")</label><input id="set-firm-dispatch" @bind="_firm.EmergencyDispatchPhone" /></div>
        </div>
        <h3>@Loc.T("settings.hoaContacts")</h3>
        <div class="cg-grid-3">
            <div><label for="set-hoa-legal">@Loc.T("settings.hoaLegal")</label><input id="set-hoa-legal" @bind="_firm.AssociationLegalName" /></div>
            <div><label for="set-hoa-ein">@Loc.T("settings.hoaEin")</label><input id="set-hoa-ein" @bind="_firm.HoaEinNumber" /></div>
            <div><label for="set-hoa-pres">@Loc.T("settings.hoaPresident")</label><input id="set-hoa-pres" @bind="_firm.BoardPresidentName" /></div>
            <div><label for="set-hoa-agent">@Loc.T("settings.hoaAgent")</label><input id="set-hoa-agent" @bind="_firm.ManagementAgentContact" /></div>
            <div><label for="set-hoa-office">@Loc.T("settings.hoaOffice")</label><input id="set-hoa-office" @bind="_firm.ClubhouseOrOfficeAddress" /></div>
            <div><label for="set-hoa-email">@Loc.T("settings.hoaEmail")</label><input id="set-hoa-email" @bind="_firm.HoaBoardEmail" /></div>
            <div><label for="set-hoa-hotline">@Loc.T("settings.hoaHotline")</label><input id="set-hoa-hotline" @bind="_firm.HoaHotlinePhone" /></div>
        </div>
        <div class="cg-toolbar"><button type="button" class="cg-btn cg-btn-primary" disabled="@_isBusy" @onclick="OnSaveFirm">@Loc.T("action.submit")</button></div>
    </div>
}

@if (!string.IsNullOrWhiteSpace(_message))
{
    <div role="status" aria-live="polite" class="cg-callout" style="margin-block-start: 0.75rem;">@_message</div>
}

@code {
    private ManagementFirm? _firm;
    private string _message = string.Empty;
    private bool _isBusy;
    private bool _loaded;
    private Action? _locHandler;

    protected override async Task OnInitializedAsync()
    {
        _locHandler = () => InvokeAsync(StateHasChanged);
        Loc.OnChange += _locHandler;
        await Loc.EnsureLoadedAsync();
        try
        {
            _firm = await Access.GetFirmAsync();
        }
        catch { }
        finally
        {
            _loaded = true;
        }
    }

    private async Task OnSaveFirm()
    {
        if (_firm is null) return;
        _isBusy = true;
        try
        {
            var role = await Access.GetRoleAsync();
            _firm = await Workspace.UpdateManagementFirmContactsAsync(_firm.Id, _firm.ManagingFirmLegalName, _firm.FirmTaxIdOrNip, _firm.LicenseNumber, _firm.LeadDirectorName, _firm.OfficeAddress, _firm.SupportEmail, _firm.EmergencyDispatchPhone, _firm.AssociationLegalName, _firm.HoaEinNumber, _firm.BoardPresidentName, _firm.ManagementAgentContact, _firm.ClubhouseOrOfficeAddress, _firm.HoaBoardEmail, _firm.HoaHotlinePhone, role);
            _message = Loc.T("msg.membershipUpdated");
        }
        catch (Exception ex) { _message = ex.Message; }
        finally { _isBusy = false; }
    }

    public void Dispose()
    {
        if (_locHandler is not null) Loc.OnChange -= _locHandler;
    }
}
