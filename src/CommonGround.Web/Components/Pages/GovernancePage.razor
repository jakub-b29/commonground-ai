@page "/governance"
@using CommonGround.Web.Components.Shared.Governance
@inject WorkspaceUiState UiState
@inject WorkspaceLocalization Loc
@inject CommonGroundWorkspaceService Workspace
@implements IDisposable

<PageTitle>@Loc.T("nav.governance") - CommonGround</PageTitle>

<div class="cg-page-header">
    <div>
        <h1>@Loc.T("page.governanceTitle")</h1>
        <p class="cg-page-lead" style="margin-block-end: 0;">@Loc.T("page.governanceLead")</p>
    </div>
</div>

@if (_snapshot is null)
{
    <p role="status" aria-live="polite">@Loc.T("msg.loading")</p>
}
else if (UiState.IsContractor)
{
    <div class="cg-callout" role="status" aria-live="polite">@Loc.T("msg.contractorLimited")</div>
}
else
{
    <div class="cg-stack">
        <MeetingPackageAndCompliancePanel Snapshot="_snapshot" OnChanged="ReloadAsync" />
        <div class="cg-grid-2">
            <LiveShareVotingAndBallotOcrPanel Resolutions="_snapshot.Community.Resolutions" Units="_snapshot.Community.Units" CommunityId="_snapshot.Community.Id" OnChanged="ReloadAsync" />
            <BallotVisualizerAndMinutesPanel Resolutions="_snapshot.Community.Resolutions" CommunityId="_snapshot.Community.Id" OnChanged="ReloadAsync" />
        </div>
        <RegulationsAndMediationPanel Documents="_snapshot.Community.LegalDocuments" CommunityId="_snapshot.Community.Id" OnChanged="ReloadAsync" />
    </div>
}

@code {
    private Action? _stateHandler;
    private Action? _locHandler;
    private CommunityWorkspaceSnapshot? _snapshot;

    protected override async Task OnInitializedAsync()
    {
        _stateHandler = () => InvokeAsync(ReloadAsync);
        UiState.OnChange += _stateHandler;
        _locHandler = () => InvokeAsync(StateHasChanged);
        Loc.OnChange += _locHandler;
        await Loc.EnsureLoadedAsync();
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        if (UiState.SelectedCommunityId is null)
        {
            var all = await Workspace.GetCommunitiesAsync();
            var first = all.FirstOrDefault();
            if (first is null) return;
            UiState.SelectCommunity(first.Id, first.OperatingMode == SystemOperatingMode.UsHoa ? "US HOA & Condo Mode" : "Housing Association Mode");
        }
        _snapshot = await Workspace.GetSnapshotAsync(UiState.SelectedCommunityId!.Value);
        StateHasChanged();
    }

    public void Dispose()
    {
        if (_stateHandler is not null) UiState.OnChange -= _stateHandler;
        if (_locHandler is not null) Loc.OnChange -= _locHandler;
    }
}
