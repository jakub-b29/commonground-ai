@page "/financials/reserves"
@attribute [Authorize(Policy = "ManagersOnly")]
@using CommonGround.Web.Components.Shared.Financials
@inject WorkspaceLocalization Loc
@implements IDisposable

<PageTitle>@Loc.T("panel.reserve") - CommonGround</PageTitle>

<div class="cg-page-header">
    <div>
        <h1>@Loc.T("panel.reserve")</h1>
        <p class="cg-page-lead">@Loc.T("page.simulationsLead")</p>
    </div>
    <a class="cg-btn" href="/financials/simulations">@Loc.T("panel.tariffSim")</a>
</div>

<ScopedCommunityPage>
    <ChildContent>
        <ReserveStudyAndGrantsPanel Snapshot="context" />
    </ChildContent>
</ScopedCommunityPage>

@code {
    private Action? _locHandler;

    protected override async Task OnInitializedAsync()
    {
        _locHandler = () => InvokeAsync(StateHasChanged);
        Loc.OnChange += _locHandler;
        await Loc.EnsureLoadedAsync();
    }

    public void Dispose()
    {
        if (_locHandler is not null) Loc.OnChange -= _locHandler;
    }
}
