@page "/residents"
@using CommonGround.Web.Components.Shared.Residents
@inject WorkspaceUiState UiState
@inject CommonGroundWorkspaceService Workspace
@implements IDisposable

<PageTitle>Resident Portal and Groups - CommonGround</PageTitle>

<div class="cg-page-header">
    <div>
        <h1>Resident portal, groups, and association approvals</h1>
        <p class="cg-page-lead" style="margin-block-end: 0;">Approve residents for specific housing associations, manage building and riser groups, post community announcements, and inspect unit self-service dossiers.</p>
    </div>
</div>

@if (_snapshot is null)
{
    <p role="status" aria-live="polite">Loading resident portal and groups.</p>
}
else
{
    <div class="cg-stack">
        <ResidentMembershipApprovalPanel Community="_snapshot.Community" OnChanged="ReloadAsync" />
        <ResidentGroupsAndMessagingPanel Community="_snapshot.Community" OnChanged="ReloadAsync" />
        <ResidentSelfServicePanel Community="_snapshot.Community" />
    </div>
}

@code {
    private Action? _stateHandler;
    private CommunityWorkspaceSnapshot? _snapshot;

    protected override async Task OnInitializedAsync()
    {
        _stateHandler = () => InvokeAsync(ReloadAsync);
        UiState.OnChange += _stateHandler;
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        if (UiState.SelectedCommunityId is null)
        {
            var all = await Workspace.GetCommunitiesAsync();
            var first = all.FirstOrDefault();
            if (first is null) return;
            UiState.SelectCommunity(first.Id, first.OperatingMode == SystemOperatingMode.UsHoa ? "US HOA & Condo Mode" : "Housing Association Mode");
        }
        _snapshot = await Workspace.GetSnapshotAsync(UiState.SelectedCommunityId!.Value);
        StateHasChanged();
    }

    public void Dispose()
    {
        if (_stateHandler is not null)
        {
            UiState.OnChange -= _stateHandler;
        }
    }
}
