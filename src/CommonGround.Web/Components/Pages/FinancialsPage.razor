@page "/financials"
@using CommonGround.Web.Components.Shared.Financials
@inject WorkspaceUiState UiState
@inject CommonGroundWorkspaceService Workspace
@implements IDisposable

<PageTitle>Accounting and Utilities - CommonGround</PageTitle>

<div class="cg-page-header">
    <div>
        <h1>Accounting and utilities</h1>
        <p class="cg-page-lead" style="margin-block-end: 0;">Double-entry fund accounting, ancillary commercial revenue offsets, tariff inflation simulation, sub-meter / RUBS utility reconciliation, 10-year reserve study, and arrears recovery.</p>
    </div>
</div>

@if (_snapshot is null)
{
    <p role="status" aria-live="polite">Loading accounting workspace.</p>
}
else
{
    <div class="cg-stack">
        <div class="cg-split-main-aside">
            <FundLedgerAndAncillaryPanel Snapshot="_snapshot" />
            <TariffInflationSimulatorPanel CommunityId="_snapshot.Community.Id" />
        </div>
        <div class="cg-grid-2">
            <UtilityReconciliationAndPowerPanel CommunityId="_snapshot.Community.Id" />
            <ReserveStudyAndGrantsPanel Snapshot="_snapshot" />
        </div>
        <ArrearsAndLegalDossierTable Snapshot="_snapshot" />
    </div>
}

@code {
    private Action? _stateHandler;
    private CommunityWorkspaceSnapshot? _snapshot;

    protected override async Task OnInitializedAsync()
    {
        _stateHandler = () => InvokeAsync(ReloadAsync);
        UiState.OnChange += _stateHandler;
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        if (UiState.SelectedCommunityId is null)
        {
            var all = await Workspace.GetCommunitiesAsync();
            var first = all.FirstOrDefault();
            if (first is null) return;
            UiState.SelectCommunity(first.Id, first.OperatingMode == SystemOperatingMode.UsHoa ? "US HOA & Condo Mode" : "Housing Association Mode");
        }
        _snapshot = await Workspace.GetSnapshotAsync(UiState.SelectedCommunityId!.Value);
        StateHasChanged();
    }

    public void Dispose()
    {
        if (_stateHandler is not null) UiState.OnChange -= _stateHandler;
    }
}
