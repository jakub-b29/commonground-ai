@page "/properties/{id:guid}/maintenance"
@attribute [Authorize(Policy = "WorkspaceMember")]
@using Microsoft.EntityFrameworkCore
@using CommonGround.Application.Persistence
@using CommonGround.Web.Components.Shared.Maintenance
@inject WorkspaceLocalization Loc
@inject WorkspaceAccessService Access
@inject IAppDbContextFactory DbFactory
@inject CommonGroundWorkspaceService Workspace
@implements IDisposable

<PageTitle>@Loc.T("property.maint.pageTitle")</PageTitle>

<RequirePropertyAccess PropertyId="Id">
    @if (!_loaded)
    {
        <p role="status" aria-live="polite">@Loc.T("msg.loading")</p>
    }
    else if (_snapshot is null)
    {
        <div class="cg-card"><p class="cg-empty-text">@Loc.T("property.common.notFound")</p></div>
    }
    else
    {
        <PageHeader Category="@Loc.T("property.maint.category")"
                    ContextCode="@($"{_snapshot.Community.WorkOrders.Count} {Loc.T("property.maint.ordersSuffix")}")"
                    Title="@($"{_snapshot.Community.Name} · {Loc.T("property.maint.titleSuffix")}")"
                    Subtitle="@Loc.T("property.maint.subtitle")">
            <Badges>
                <AIBadge Label="@Loc.T("property.maint.visionBadge")" Model="sam-3.1" />
                <AIBadge Label="@Loc.T("property.maint.triageBadge")" Model="muse-wonder" ShowPulseDot="false" />
            </Badges>
            <Actions>
                <a class="cg-btn cg-btn-sm" href="@($"/properties/{Id}/infrastructure")">@Loc.T("property.maint.atlasLink")</a>
                <a class="cg-btn cg-btn-sm" href="@($"/properties/{Id}/overview")">@Loc.T("property.common.backToOverview")</a>
            </Actions>
        </PageHeader>

        <ResidentIntakeSimulatorPanel CommunityId="_snapshot.Community.Id" OnChanged="ReloadAsync" />
        <div style="margin-block-start: 1rem;">
            <WorkOrderSamInspectorPanel WorkOrders="_snapshot.Community.WorkOrders" CommunityId="_snapshot.Community.Id" OnChanged="ReloadAsync" />
        </div>
        <div class="cg-card" style="margin-block-start: 1rem;">
            <div class="cg-section-header">
                <h2>@Loc.T("property.maint.threadTitle")</h2>
                <span class="cg-badge cg-badge-info">@_threads.Count @Loc.T("property.maint.messagesSuffix")</span>
            </div>
            <div>
                <label for="pm-order">@Loc.T("form.workOrder")</label>
                <select id="pm-order" value="@_selectedOrderId" @onchange="OnSelectOrder">
                    @foreach (var w in _snapshot.Community.WorkOrders)
                    {
                        <option value="@w.Id" selected="@(_selectedOrderId == w.Id)">@w.Title (@w.Status)</option>
                    }
                </select>
            </div>
            <div class="cg-table-wrap" style="margin-block-start: 0.65rem; max-height: 240px; overflow-y: auto;">
                <table class="cg-table">
                    <thead>
                        <tr>
                            <th>@Loc.T("table.timestampUtc")</th>
                            <th>@Loc.T("table.message")</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (_threads.Count == 0)
                        {
                            <tr><td colspan="2" style="color: var(--text-secondary);">@Loc.T("property.maint.noDispatch")</td></tr>
                        }
                        @foreach (var m in _threads)
                        {
                            <tr @key="m.Id">
                                <td class="mono num" style="width: 165px;">@m.CreatedAtUtc.ToString("yyyy-MM-dd HH:mm")</td>
                                <td>@m.Body</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div style="margin-block-start: 0.65rem;">
                <label for="pm-body">@Loc.T("property.maint.noteLabel")</label>
                <textarea id="pm-body" rows="2" @bind="_draft" placeholder="@Loc.T("property.maint.notePlaceholder")"></textarea>
            </div>
            <div class="cg-toolbar">
                <button type="button" class="cg-btn cg-btn-primary" disabled="@(_isBusy || _selectedOrderId == Guid.Empty || string.IsNullOrWhiteSpace(_draft))" @onclick="OnPostMessage">@Loc.T("action.postMessage")</button>
            </div>
        </div>
        <div style="margin-block-start: 1rem;">
            <VideoWalkthroughAndSafetyPanel CommunityId="_snapshot.Community.Id" OnChanged="ReloadAsync" />
        </div>
        <div style="margin-block-start: 1rem;">
            <InsuranceClaimDossierPanel WorkOrders="_snapshot.Community.WorkOrders" CommunityId="_snapshot.Community.Id" />
        </div>
    }
    @if (!string.IsNullOrWhiteSpace(_message))
    {
        <div role="status" aria-live="polite" class="cg-callout" style="margin-block-start: 0.75rem;">@_message</div>
    }
</RequirePropertyAccess>

@code {
    [Parameter] public Guid Id { get; set; }
    private CommunityWorkspaceSnapshot? _snapshot;
    private List<WorkOrderMessage> _threads = new();
    private Guid _selectedOrderId = Guid.Empty;
    private string _draft = string.Empty;
    private bool _loaded;
    private bool _isBusy;
    private string _message = string.Empty;
    private Action? _locHandler;

    protected override async Task OnInitializedAsync()
    {
        _locHandler = () => InvokeAsync(StateHasChanged);
        Loc.OnChange += _locHandler;
        await Loc.EnsureLoadedAsync();
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        try
        {
            _snapshot = await Workspace.GetSnapshotAsync(Id);
            if (_snapshot is not null && _snapshot.Community.WorkOrders.Count > 0)
            {
                if (_selectedOrderId == Guid.Empty || !_snapshot.Community.WorkOrders.Any(w => w.Id == _selectedOrderId))
                    _selectedOrderId = _snapshot.Community.WorkOrders[0].Id;
                await LoadThreadsAsync();
            }
        }
        catch (Exception ex) { _message = ex.Message; }
        finally { _loaded = true; }
    }

    private async Task OnSelectOrder(ChangeEventArgs e)
    {
        if (Guid.TryParse(e.Value?.ToString(), out var orderId))
        {
            _selectedOrderId = orderId;
            await LoadThreadsAsync();
        }
    }

    private async Task LoadThreadsAsync()
    {
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            _threads = await db.WorkOrderMessages.AsNoTracking()
                .Where(m => m.WorkOrderId == _selectedOrderId)
                .OrderBy(m => m.CreatedAtUtc)
                .ToListAsync();
        }
        catch (Exception ex) { _message = ex.Message; }
    }

    private async Task OnPostMessage()
    {
        if (_selectedOrderId == Guid.Empty || string.IsNullOrWhiteSpace(_draft)) return;
        _isBusy = true;
        try
        {
            var membershipId = await Access.GetActiveMembershipIdAsync();
            await using var db = await DbFactory.CreateDbContextAsync();
            db.WorkOrderMessages.Add(new WorkOrderMessage
            {
                WorkOrderId = _selectedOrderId,
                SenderMembershipId = membershipId,
                Body = _draft.Trim()
            });
            await db.SaveChangesAsync();
            _draft = string.Empty;
            await LoadThreadsAsync();
        }
        catch (Exception ex) { _message = ex.Message; }
        finally { _isBusy = false; }
    }

    public void Dispose()
    {
        if (_locHandler is not null) Loc.OnChange -= _locHandler;
    }
}
