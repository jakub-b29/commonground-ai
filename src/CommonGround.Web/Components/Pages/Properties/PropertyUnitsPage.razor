@page "/properties/{id:guid}/units"
@page "/properties/{id:guid}/units/{unitId:guid}"
@attribute [Authorize(Policy = "WorkspaceMember")]
@using CommonGround.Application.Services
@using CommonGround.Web.Components.Shared.Units
@inject WorkspaceLocalization Loc
@inject WorkspaceAccessService Access
@inject CommonGroundWorkspaceService Workspace
@inject NavigationManager Nav
@implements IDisposable

<PageTitle>@Loc.T("property.units.pageTitle")</PageTitle>

<RequirePropertyAccess PropertyId="Id">
    @if (!_loaded)
    {
        <p role="status" aria-live="polite">@Loc.T("property.units.loading")</p>
    }
    else if (_snapshot is null || _dashboard is null)
    {
        <div class="cg-card"><p class="cg-empty-text">@Loc.T("property.common.notFound")</p></div>
    }
    else
    {
        <PageHeader Category="@Loc.T("property.units.category")"
                    ContextCode="@($"{_snapshot.Community.CommunityAccountNumber} · {_dashboard.TotalUnits} {Loc.T("property.units.unitsSuffix")}")"
                    Title="@($"{_snapshot.Community.Name} · {Loc.T("property.units.titleSuffix")}")"
                    Subtitle="@Loc.T("property.units.subtitle")">
            <Badges>
                <StatusBadge Text="@_snapshot.Community.CommunityAccountNumber" Variant="info" />
                <AIBadge Label="@Loc.T("property.units.meterBadge")" Model="sam-3.1 + muse-spark-1.3" />
            </Badges>
            <Actions>
                @if (_isManager)
                {
                    <button type="button" class="cg-btn cg-btn-sm cg-btn-primary" @onclick="() => _showWizard = !_showWizard">
                        @(_showWizard ? Loc.T("property.units.closeWizard") : Loc.T("property.units.addWizard"))
                    </button>
                    <button type="button" class="cg-btn cg-btn-sm" @onclick="() => _showAddBuilding = !_showAddBuilding">
                        @Loc.T("builder.addBuilding")
                    </button>
                }
                <button type="button" class="cg-btn cg-btn-sm @(_showMatrix ? "cg-btn-ai" : "")" @onclick="() => _showMatrix = !_showMatrix">
                    @(_showMatrix ? Loc.T("property.units.hideMatrix") : Loc.T("property.units.showMatrix"))
                </button>
                <a class="cg-btn cg-btn-sm" href="@($"/properties/{Id}/overview")">@Loc.T("property.common.backToOverview")</a>
            </Actions>
        </PageHeader>

        @if (!string.IsNullOrWhiteSpace(_message))
        {
            <div class="ai-callout" style="margin-bottom: 1rem;" role="status" aria-live="polite">@_message</div>
        }

        <div class="cg-grid-4" style="margin-bottom: 1rem;">
            <MetricCard Label="@Loc.T("property.units.totalUnits")"
                        Value="@_dashboard.TotalUnits.ToString()"
                        Subtitle="@string.Format(Loc.T("property.units.buildingsIn"), _dashboard.Buildings.Count, _snapshot.Community.Name)"
                        BadgeText="@_snapshot.Community.CommunityAccountNumber"
                        StatusVariant="info" />
            <MetricCard Label="@Loc.T("property.units.occupiedUnits")"
                        Value="@_dashboard.OccupiedUnits.ToString()"
                        Subtitle="@string.Format(Loc.T("property.units.activeResidents"), _dashboard.TotalActiveResidents)"
                        BadgeText="@Loc.T("property.units.activeBadge")"
                        StatusVariant="ok" />
            <MetricCard Label="@Loc.T("property.units.vacantUnits")"
                        Value="@_dashboard.VacantUnits.ToString()"
                        Subtitle="@Loc.T("property.units.vacantHint")"
                        BadgeText="@Loc.T("property.units.availableBadge")"
                        StatusVariant="neutral" />
            <MetricCard Label="@Loc.T("property.units.pendingRegs")"
                        Value="@_dashboard.PendingRegistrationUnits.ToString()"
                        Subtitle="@string.Format(Loc.T("property.units.openBalance"), _dashboard.ArrearsUnitsCount)"
                        BadgeText="@(_dashboard.PendingRegistrationUnits > 0 ? Loc.T("property.units.linksActive") : Loc.T("property.units.clearBadge"))"
                        StatusVariant="@(_dashboard.PendingRegistrationUnits > 0 ? "warn" : "ok")" />
        </div>

        @if (_showAddBuilding && _isManager)
        {
            <div class="cg-card" style="margin-bottom: 1rem; border: 1px solid var(--accent-primary);">
                <div class="cg-section-header">
                    <h2>@string.Format(Loc.T("property.units.addBuildingTitle"), _snapshot.Community.Name, _snapshot.Community.CommunityAccountNumber)</h2>
                    <button type="button" class="cg-btn cg-btn-sm" @onclick="() => _showAddBuilding = false">@Loc.T("action.close")</button>
                </div>
                <div class="cg-grid-4">
                    <div><label>@Loc.T("property.units.buildingName")</label><input @bind="_newBldName" placeholder="@Loc.T("property.units.buildingNamePh")" /></div>
                    <div><label>@Loc.T("property.units.streetAddress")</label><input @bind="_newBldStreet" placeholder="@_snapshot.Community.StreetAddress" /></div>
                    <div><label>@Loc.T("property.units.floorsCount")</label><input type="number" min="1" max="50" @bind="_newBldFloors" /></div>
                    <div><label>@Loc.T("property.units.stairwellsCount")</label><input type="number" min="1" max="15" @bind="_newBldStairwells" /></div>
                </div>
                <div class="cg-toolbar" style="margin-top: 0.65rem;">
                    <button type="button" class="cg-btn cg-btn-primary" @onclick="CreateBuildingNowAsync">@Loc.T("property.units.createBuilding")</button>
                </div>
            </div>
        }

        @if (_showWizard && _isManager)
        {
            <UnitCreationWizardModal Communities="_dashboard.Communities"
                                     Buildings="_dashboard.Buildings"
                                     ExistingResidents="_residents"
                                     InitialCommunityId="Id"
                                     InitialBuildingId="_wizardBuildingId"
                                     LockCommunity="true"
                                     OnUnitCreated="OnWizardCreatedAsync"
                                     OnCancel="() => _showWizard = false" />
        }

        @if (_showMatrix)
        {
            <div style="margin-bottom: 1rem;">
                <InteractiveBuildingBuilder Community="_snapshot.Community"
                                            Units="_units"
                                            SelectedBuildingId="_builderSelectedBuildingId"
                                            SelectedUnitId="_selectedUnitId"
                                            OnSelectUnit="OnSelectUnit"
                                            OnBroadcastStackAlert="OnBroadcastStackAlert"
                                            OnStructureChanged="ReloadAsync" />
            </div>
        }

        @if (_snapshot.Community.Buildings.Count > 0)
        {
            <div class="cg-card" style="margin-bottom: 1rem;">
                <div class="cg-section-header">
                    <div style="display: flex; align-items: center; gap: 0.5rem; flex-wrap: wrap;">
                        <h2>@Loc.T("property.units.buildingsTitle") (@_snapshot.Community.Buildings.Count)</h2>
                        <span class="cg-badge cg-badge-info mono num">@_snapshot.Community.Buildings.Count @Loc.T("property.overview.buildings")</span>
                    </div>
                    @if (_isManager)
                    {
                        <button type="button" class="cg-btn cg-btn-sm cg-btn-primary" @onclick="() => _showAddBuilding = true">
                            + @Loc.T("builder.addBuilding")
                        </button>
                    }
                </div>
                <div class="cg-grid-3">
                    @foreach (var bld in _snapshot.Community.Buildings.OrderBy(b => b.Name))
                    {
                        var bldUnitsCount = _units.Count(u => u.BuildingId == bld.Id);
                        var isSelectedBld = _filterBuildingId == bld.Id;
                        <div class="cg-subcard" style="@(isSelectedBld ? "border-color: var(--accent-primary); box-shadow: 0 0 0 1px var(--accent-primary);" : "")">
                            <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 0.35rem; gap: 0.5rem;">
                                <strong style="font-size: 0.95rem;">@bld.Name</strong>
                                <span class="cg-badge @(bldUnitsCount > 0 ? "cg-badge-ok" : "cg-badge-warn") mono num">
                                    @(bldUnitsCount > 0 ? $"{bldUnitsCount} {Loc.T("table.units")}" : Loc.T("property.units.noUnitsYet"))
                                </span>
                            </div>
                            <div style="font-size: 0.74rem; color: var(--text-secondary); margin-bottom: 0.35rem;">
                                @(string.IsNullOrWhiteSpace(bld.StreetAddress) ? _snapshot.Community.StreetAddress : bld.StreetAddress)
                            </div>
                            <div class="cg-grid-2 mono num" style="font-size: 0.72rem; color: var(--text-muted); margin-bottom: 0.5rem;">
                                <div>@Loc.T("builder.floors"): <strong>@bld.FloorsCount</strong></div>
                                <div>@Loc.T("builder.stairwells"): <strong>@bld.StairwellsCount</strong></div>
                                <div>@Loc.T("property.units.year"): <strong>@bld.ConstructionYear</strong></div>
                                <div>@Loc.T("property.units.risers"): <strong>@bld.RiserStacks.Count</strong></div>
                            </div>
                            <div style="display: flex; gap: 0.3rem; flex-wrap: wrap;">
                                <button type="button" class="cg-btn cg-btn-sm @(isSelectedBld ? "cg-btn-primary" : "")" @onclick="() => SelectBuildingFilter(bld.Id)">
                                    @(isSelectedBld ? Loc.T("property.units.filtered") : Loc.T("property.units.viewUnits"))
                                </button>
                                <button type="button" class="cg-btn cg-btn-sm" @onclick="() => OpenMatrixForBuilding(bld.Id)">
                                    @Loc.T("property.units.matrixBtn")
                                </button>
                                @if (_isManager)
                                {
                                    <button type="button" class="cg-btn cg-btn-sm cg-btn-ghost" @onclick="() => OpenWizardForBuilding(bld.Id)">
                                        + @Loc.T("property.units.addUnitBtn")
                                    </button>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>
        }

        <div class="cg-card">
            <div class="cg-section-header">
                <h2>@string.Format(Loc.T("property.units.directoryTitle"), FilteredUnits.Count, _dashboard.Units.Count)</h2>
                <div style="display: flex; gap: 0.5rem; flex-wrap: wrap;">
                    <input style="min-width: 240px;"
                           placeholder="@Loc.T("property.units.searchPh")"
                           @bind="_searchQuery"
                           @bind:event="oninput" />
                    <select @bind="_filterBuildingId">
                        <option value="@Guid.Empty">@string.Format(Loc.T("property.units.allBuildings"), _dashboard.Buildings.Count)</option>
                        @foreach (var b in _dashboard.Buildings)
                        {
                            <option value="@b.Id" @key="b.Id">@b.Name</option>
                        }
                    </select>
                    <select @bind="_filterOccupancy">
                        <option value="">@Loc.T("property.units.allOccupancy")</option>
                        @foreach (var st in Enum.GetValues<UnitOccupancyStatus>())
                        {
                            <option value="@st.ToString()" @key="st">@st</option>
                        }
                    </select>
                    <select @bind="_filterKind">
                        <option value="">@Loc.T("property.units.allTypes")</option>
                        @foreach (var k in Enum.GetValues<UnitKind>())
                        {
                            <option value="@k.ToString()" @key="k">@k</option>
                        }
                    </select>
                </div>
            </div>

            <div class="cg-table-wrap">
                <table class="cg-table">
                    <thead>
                        <tr>
                            <th>@Loc.T("property.units.colUnitNo")</th>
                            <th>@Loc.T("property.units.colBuilding")</th>
                            <th>@Loc.T("property.units.colType")</th>
                            <th class="num">@Loc.T("property.units.colShare")</th>
                            <th>@Loc.T("table.owner")</th>
                            <th>@Loc.T("property.units.colResident")</th>
                            <th>@Loc.T("table.status")</th>
                            <th class="num">@Loc.T("table.balance")</th>
                            <th>@Loc.T("table.actions")</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (FilteredUnits.Count == 0)
                        {
                            <tr><td colspan="9" style="color: var(--text-secondary);">@Loc.T("property.units.noMatch")</td></tr>
                        }
                        @foreach (var row in FilteredUnits)
                        {
                            var isSelected = row.UnitId == _selectedUnitId;
                            <tr @key="row.UnitId" style="@(isSelected ? "background: var(--bg-elevated);" : "")">
                                <td>
                                    <strong class="mono num">@row.UnitNumber</strong>
                                </td>
                                <td>
                                    <div>@row.BuildingName · @Loc.T("property.units.floorLabel") @row.FloorNumber · @Loc.T("property.units.stairLabel") @row.StairwellNumber</div>
                                    <div class="mono" style="font-size: 0.72rem; color: var(--text-secondary);">@row.VerticalStackCode</div>
                                </td>
                                <td>
                                    <div>@row.Kind</div>
                                    <div class="mono num" style="font-size: 0.74rem; color: var(--text-secondary);">@row.FloorAreaM2.ToString("N1") m² · @row.RoomsCount @Loc.T("property.units.roomsSuffix")</div>
                                </td>
                                <td class="mono num">@row.ShareNumerator / @row.ShareDenominator</td>
                                <td>
                                    <strong>@(string.IsNullOrWhiteSpace(row.PrimaryOwnerName) ? "—" : row.PrimaryOwnerName)</strong>
                                    @if (!string.IsNullOrWhiteSpace(row.PrimaryOwnerEmail))
                                    {
                                        <div class="mono" style="font-size: 0.72rem; color: var(--text-secondary);">@row.PrimaryOwnerEmail</div>
                                    }
                                </td>
                                <td>
                                    @if (row.ActiveResidentNames.Count == 0)
                                    {
                                        <span style="color: var(--text-muted); font-size: 0.76rem;">@Loc.T("property.units.noResident")</span>
                                    }
                                    else
                                    {
                                        for (var i = 0; i < row.ActiveResidentNames.Count; i++)
                                        {
                                            var rName = row.ActiveResidentNames[i];
                                            var rAcc = i < row.ActiveResidentAccountNumbers.Count ? row.ActiveResidentAccountNumbers[i] : string.Empty;
                                            <div style="display: flex; align-items: center; gap: 0.35rem; flex-wrap: wrap;">
                                                <strong>@rName</strong>
                                                @if (!string.IsNullOrWhiteSpace(rAcc))
                                                {
                                                    <span class="cg-badge cg-badge-info mono num">@rAcc</span>
                                                }
                                            </div>
                                        }
                                    }
                                </td>
                                <td>
                                    <span class="cg-badge @GetBadgeClass(row.OccupancyStatus)">@row.OccupancyStatus</span>
                                    @if (row.ActiveRegistrationLinksCount > 0)
                                    {
                                        <span class="cg-badge cg-badge-info mono num" style="margin-left: 0.25rem;">@row.ActiveRegistrationLinksCount @Loc.T("property.units.linkSuffix")</span>
                                    }
                                </td>
                                <td class="mono num">@row.CurrentBalance.ToString("N2")</td>
                                <td>
                                    <div style="display: flex; gap: 0.35rem; flex-wrap: wrap;">
                                        <button type="button" class="cg-btn cg-btn-sm @(isSelected ? "cg-btn-primary" : "")" @onclick="() => OnSelectUnit(row.UnitId)">
                                            @(isSelected ? Loc.T("property.units.inspecting") : Loc.T("property.units.openDossier"))
                                        </button>
                                        @if (row.PrimaryResidentProfileId.HasValue)
                                        {
                                            <a class="cg-btn cg-btn-sm" href="@($"/admin/residents/{row.PrimaryResidentProfileId.Value}")">@Loc.T("property.units.residentLink")</a>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        @if (_selectedUnitId != Guid.Empty)
        {
            <UnitDossierPanel CommunityId="Id"
                              UnitId="_selectedUnitId"
                              ExistingResidents="_residents"
                              OnChanged="ReloadAsync"
                              OnClose="() => _selectedUnitId = Guid.Empty" />
        }
    }
</RequirePropertyAccess>

@code {
    [Parameter] public Guid Id { get; set; }
    [Parameter] public Guid? UnitId { get; set; }

    private CommunityWorkspaceSnapshot? _snapshot;
    private GlobalUnitsDashboardSnapshot? _dashboard;
    private IReadOnlyList<ResidentDirectoryRow> _residents = [];
    private IReadOnlyList<Unit> _units = [];
    private Guid _selectedUnitId = Guid.Empty;
    private bool _loaded;
    private bool _isManager;
    private bool _showWizard;
    private bool _showAddBuilding;
    private bool _showMatrix;
    private string _message = string.Empty;
    private Action? _locHandler;

    private string _searchQuery = string.Empty;
    private Guid _filterBuildingId = Guid.Empty;
    private Guid? _builderSelectedBuildingId;
    private Guid? _wizardBuildingId;
    private string _filterOccupancy = string.Empty;
    private string _filterKind = string.Empty;

    private string _newBldName = string.Empty;
    private string _newBldStreet = string.Empty;
    private int _newBldFloors = 4;
    private int _newBldStairwells = 2;

    private IReadOnlyList<UnitSummaryRow> FilteredUnits
    {
        get
        {
            if (_dashboard is null) return [];
            var q = _dashboard.Units.AsEnumerable();
            if (_filterBuildingId != Guid.Empty)
                q = q.Where(u => u.BuildingId == _filterBuildingId);
            if (!string.IsNullOrWhiteSpace(_filterOccupancy) && Enum.TryParse<UnitOccupancyStatus>(_filterOccupancy, out var occ))
                q = q.Where(u => u.OccupancyStatus == occ);
            if (!string.IsNullOrWhiteSpace(_filterKind) && Enum.TryParse<UnitKind>(_filterKind, out var kind))
                q = q.Where(u => u.Kind == kind);
            if (!string.IsNullOrWhiteSpace(_searchQuery))
            {
                var term = _searchQuery.Trim();
                q = q.Where(u =>
                    u.UnitNumber.Contains(term, StringComparison.OrdinalIgnoreCase)
                    || u.BuildingName.Contains(term, StringComparison.OrdinalIgnoreCase)
                    || u.VerticalStackCode.Contains(term, StringComparison.OrdinalIgnoreCase)
                    || u.PrimaryOwnerName.Contains(term, StringComparison.OrdinalIgnoreCase)
                    || u.PrimaryOwnerEmail.Contains(term, StringComparison.OrdinalIgnoreCase)
                    || u.ActiveResidentNames.Any(n => n.Contains(term, StringComparison.OrdinalIgnoreCase))
                    || u.ActiveResidentAccountNumbers.Any(a => a.Contains(term, StringComparison.OrdinalIgnoreCase)));
            }
            return q.ToList();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        _locHandler = () => InvokeAsync(StateHasChanged);
        Loc.OnChange += _locHandler;
        await Loc.EnsureLoadedAsync();
        await ReloadAsync();
    }

    protected override void OnParametersSet()
    {
        if (UnitId.HasValue && UnitId.Value != Guid.Empty)
        {
            _selectedUnitId = UnitId.Value;
        }
    }

    private async Task ReloadAsync()
    {
        try
        {
            await Workspace.EnsureCommunityAccountNumberAsync(Id);
            _snapshot = await Workspace.GetSnapshotAsync(Id);
            var role = await Access.GetRoleAsync();
            _isManager = role is WorkspaceSecurityRole.FirmManager or WorkspaceSecurityRole.PropertyManager;
            if (_snapshot is not null)
            {
                var firmId = _snapshot.Community.ManagementFirmId ?? await Access.GetFirmIdAsync() ?? Guid.Empty;
                _dashboard = await Workspace.GetGlobalUnitsDashboardAsync(firmId, [Id]);
                _residents = await Workspace.GetFirmResidentsDirectoryAsync(firmId, [Id]);
                _units = _snapshot.Community.Units;
                if (_selectedUnitId == Guid.Empty && _dashboard.Units.Count > 0)
                {
                    _selectedUnitId = UnitId.HasValue && UnitId.Value != Guid.Empty
                        ? UnitId.Value
                        : _dashboard.Units[0].UnitId;
                }
            }
        }
        catch (Exception ex) { _message = ex.Message; }
        finally { _loaded = true; }
    }

    private static string GetBadgeClass(UnitOccupancyStatus status) => status switch
    {
        UnitOccupancyStatus.OwnerOccupied => "cg-badge-ok",
        UnitOccupancyStatus.TenantOccupied => "cg-badge-info",
        UnitOccupancyStatus.PendingRegistration => "cg-badge-warn",
        _ => "cg-badge-neutral"
    };

    private Task OnSelectUnit(Guid unitId)
    {
        _selectedUnitId = unitId;
        return Task.CompletedTask;
    }

    private async Task OnWizardCreatedAsync(UnitCreationWizardResult result)
    {
        _showWizard = false;
        _selectedUnitId = result.Unit.Id;
        _message = string.Format(Loc.T("property.units.createdMsg"), result.Unit.UnitNumber, result.Building.Name);
        await ReloadAsync();
    }

    private async Task CreateBuildingNowAsync()
    {
        if (string.IsNullOrWhiteSpace(_newBldName)) return;
        try
        {
            var role = await Access.GetRoleAsync() ?? WorkspaceSecurityRole.FirmManager;
            var b = await Workspace.CreateBuildingAsync(
                Id,
                _newBldName,
                string.IsNullOrWhiteSpace(_newBldStreet) ? (_snapshot?.Community.StreetAddress ?? string.Empty) : _newBldStreet,
                _newBldFloors,
                _newBldStairwells,
                2024,
                role);
            _showAddBuilding = false;
            _newBldName = string.Empty;
            _filterBuildingId = b.Id;
            _builderSelectedBuildingId = b.Id;
            _wizardBuildingId = b.Id;
            _showMatrix = true;
            _message = string.Format(Loc.T("property.units.buildingCreatedMsg"), b.Name);
            await ReloadAsync();
        }
        catch (Exception ex) { _message = ex.Message; }
    }

    private void SelectBuildingFilter(Guid bldId)
    {
        _filterBuildingId = _filterBuildingId == bldId ? Guid.Empty : bldId;
    }

    private void OpenMatrixForBuilding(Guid bldId)
    {
        _builderSelectedBuildingId = bldId;
        _showMatrix = true;
    }

    private void OpenWizardForBuilding(Guid bldId)
    {
        _wizardBuildingId = bldId;
        _showWizard = true;
    }

    private async Task OnBroadcastStackAlert(string stack)
    {
        try
        {
            var action = await Workspace.TriggerOneClickSosBroadcastAsync(Id, stack);
            _message = $"{action.Title}. {action.Rationale}";
        }
        catch (Exception ex) { _message = ex.Message; }
    }

    public void Dispose()
    {
        if (_locHandler is not null) Loc.OnChange -= _locHandler;
    }
}
