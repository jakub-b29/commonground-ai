@page "/properties/{id:guid}/overview"
@attribute [Authorize(Policy = "WorkspaceMember")]
@using CommonGround.Web.Components.Shared.Documents
@using CommonGround.Web.Components.Shared.Overview
@inject WorkspaceLocalization Loc
@inject CommonGroundWorkspaceService Workspace
@implements IDisposable

<PageTitle>@Loc.T("property.overview.pageTitle")</PageTitle>

<RequirePropertyAccess PropertyId="Id">
    @if (!_loaded)
    {
        <p role="status" aria-live="polite">@Loc.T("msg.loading")</p>
    }
    else if (_snapshot is null)
    {
        <div class="cg-card"><p class="cg-empty-text">@Loc.T("property.common.notFound")</p></div>
    }
    else
    {
        <PageHeader Category="@Loc.T("property.overview.category")"
                    ContextCode="@($"{_snapshot.Community.CommunityAccountNumber} · {_snapshot.Community.TaxIdOrEin}")"
                    Title="@_snapshot.Community.Name"
                    Subtitle="@($"{_snapshot.Community.StreetAddress}, {_snapshot.Community.PostalOrZipCode} {_snapshot.Community.City} · {_snapshot.Community.PropertyTypeConfiguration} · {Loc.T("property.overview.buildings")}: {_snapshot.Community.Buildings.Count} · {Loc.T("property.overview.units")}: {_snapshot.Community.Units.Count}")">
            <Badges>
                <StatusBadge Text="@_snapshot.Community.CommunityAccountNumber" Variant="info" />
                <StatusBadge Text="@_snapshot.Community.Status.ToString()" Variant="ok" />
                <AIBadge Label="@Loc.T("property.overview.autonomousMonitoring")" Model="muse-spark-1.3" />
            </Badges>
            <Actions>
                <a class="cg-btn cg-btn-sm cg-btn-ai" href="@($"/properties/{Id}/units")">@Loc.T("property.overview.unitsOccupancy") (@_snapshot.Community.Units.Count)</a>
                <a class="cg-btn cg-btn-sm" href="@($"/properties/{Id}/maintenance")">@Loc.T("property.overview.workOrders") (@_snapshot.OpenWorkOrders)</a>
                <a class="cg-btn cg-btn-sm" href="@($"/properties/{Id}/financials")">@Loc.T("property.overview.financialsLedger")</a>
                <a class="cg-btn cg-btn-sm" href="@($"/properties/{Id}/settings")">@Loc.T("property.overview.communityProfile")</a>
                <button type="button" class="cg-btn cg-btn-sm cg-btn-primary" @onclick="OnScan">@Loc.T("action.scanNow")</button>
            </Actions>
        </PageHeader>

        <ExecutiveKpiRow Snapshot="_snapshot" />

        <BentoGrid Style="margin-block-end: 1rem;">
            <BentoCard Span="6"
                       Title="@Loc.T("property.overview.accountTitle")"
                       Subtitle="@Loc.T("property.overview.accountSubtitle")"
                       BadgeText="@_snapshot.Community.CommunityAccountNumber"
                       BadgeVariant="info">
                <HeaderActions>
                    <a class="cg-btn cg-btn-sm" href="@($"/properties/{Id}/settings")">@Loc.T("property.overview.editCommunity")</a>
                </HeaderActions>
                <ChildContent>
                    <div class="cg-grid-3" style="font-size: 0.8rem;">
                        <div>
                            <div style="color: var(--text-muted); font-size: 0.7rem;">@Loc.T("property.overview.accountNo")</div>
                            <strong class="mono num">@_snapshot.Community.CommunityAccountNumber</strong>
                        </div>
                        <div>
                            <div style="color: var(--text-muted); font-size: 0.7rem;">@Loc.T("property.overview.statusConfig")</div>
                            <strong>@_snapshot.Community.Status · @_snapshot.Community.PropertyTypeConfiguration</strong>
                        </div>
                        <div>
                            <div style="color: var(--text-muted); font-size: 0.7rem;">@Loc.T("property.overview.buildingsUnits")</div>
                            <strong class="mono num">@_snapshot.Community.Buildings.Count @Loc.T("property.overview.buildings") · @_snapshot.Community.Units.Count @Loc.T("property.overview.units")</strong>
                        </div>
                        <div>
                            <div style="color: var(--text-muted); font-size: 0.7rem;">@Loc.T("property.overview.adminEmail")</div>
                            <span class="mono">@(string.IsNullOrWhiteSpace(_snapshot.Community.AdministrativeEmail) ? "office@commonground.local" : _snapshot.Community.AdministrativeEmail)</span>
                        </div>
                        <div>
                            <div style="color: var(--text-muted); font-size: 0.7rem;">@Loc.T("property.overview.adminPhone")</div>
                            <span class="mono num">@(string.IsNullOrWhiteSpace(_snapshot.Community.AdministrativePhone) ? "+1 (800) 555-0199" : _snapshot.Community.AdministrativePhone)</span>
                        </div>
                        <div>
                            <div style="color: var(--text-muted); font-size: 0.7rem;">@Loc.T("property.overview.regLinkPolicy")</div>
                            <span class="cg-badge cg-badge-neutral">@_snapshot.Community.DefaultRegistrationApprovalMode</span>
                        </div>
                    </div>
                    <div style="display: flex; flex-wrap: wrap; gap: 0.35rem; margin-top: 0.75rem;">
                        @if (_snapshot.Community.EnableHoaGovernance) { <span class="cg-badge cg-badge-info">@Loc.T("property.overview.capHoa")</span> }
                        @if (_snapshot.Community.EnableShareWeightedVoting) { <span class="cg-badge cg-badge-info">@Loc.T("property.overview.capVoting")</span> }
                        @if (_snapshot.Community.EnableArcRequests) { <span class="cg-badge cg-badge-info">@Loc.T("property.overview.capArc")</span> }
                        @if (_snapshot.Community.EnableSubMeterReconciliation) { <span class="cg-badge cg-badge-info">@Loc.T("property.overview.capSubmeter")</span> }
                        @if (_snapshot.Community.EnableReserveStudy) { <span class="cg-badge cg-badge-info">@Loc.T("property.overview.capReserve")</span> }
                    </div>
                </ChildContent>
            </BentoCard>

            <BentoCard Span="6"
                       Title="@Loc.T("property.overview.contactsTitle")"
                       Subtitle="@Loc.T("property.overview.contactsSubtitle")"
                       BadgeText="@($"{_contacts.Count} {Loc.T("property.overview.contactsSuffix")}")"
                       BadgeVariant="neutral"
                       BodyStyle="padding: 0;">
                <HeaderActions>
                    <a class="cg-btn cg-btn-sm" href="@($"/properties/{Id}/settings")">@Loc.T("property.overview.manageContacts")</a>
                </HeaderActions>
                <ChildContent>
                    <div class="cg-table-wrap">
                        <table class="cg-table">
                            <thead>
                                <tr>
                                    <th>@Loc.T("table.category")</th>
                                    <th>@Loc.T("table.contactRole")</th>
                                    <th>@Loc.T("table.phoneEmail")</th>
                                    <th>@Loc.T("table.hours")</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var ctItem in _contacts.Take(5))
                                {
                                    <tr @key="ctItem.Id">
                                        <td><span class="cg-badge cg-badge-neutral">@ctItem.Category</span></td>
                                        <td>
                                            <strong>@ctItem.ContactName</strong>
                                            <div style="font-size: 0.72rem; color: var(--text-secondary);">@ctItem.RoleTitle</div>
                                        </td>
                                        <td class="mono num" style="font-size: 0.75rem;">
                                            <div>@ctItem.Phone</div>
                                            <div style="color: var(--text-secondary);">@ctItem.Email</div>
                                        </td>
                                        <td style="font-size: 0.74rem; color: var(--text-secondary);">@ctItem.OfficeHours</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </ChildContent>
            </BentoCard>

            <BentoCard Span="12"
                       Title="@Loc.T("property.units.buildingsTitle")"
                       Subtitle="@($"{_snapshot.Community.Buildings.Count} {Loc.T("property.overview.buildings")} · {_snapshot.Community.Units.Count} {Loc.T("property.overview.units")}")"
                       BadgeText="@($"{_snapshot.Community.Buildings.Count} {Loc.T("property.overview.buildings")}")"
                       BadgeVariant="info">
                <HeaderActions>
                    <a class="cg-btn cg-btn-sm cg-btn-primary" href="@($"/properties/{Id}/units")">+ @Loc.T("builder.addBuilding")</a>
                    <a class="cg-btn cg-btn-sm" href="@($"/properties/{Id}/units")">@Loc.T("action.openUnits")</a>
                </HeaderActions>
                <ChildContent>
                    <div class="cg-grid-3">
                        @foreach (var bld in _snapshot.Community.Buildings.OrderBy(b => b.Name))
                        {
                            var bldUnits = _snapshot.Community.Units.Count(u => u.BuildingId == bld.Id);
                            <div class="cg-subcard">
                                <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 0.35rem; gap: 0.5rem;">
                                    <strong>@bld.Name</strong>
                                    <span class="cg-badge @(bldUnits > 0 ? "cg-badge-ok" : "cg-badge-warn") mono num">
                                        @(bldUnits > 0 ? $"{bldUnits} {Loc.T("table.units")}" : Loc.T("property.units.noUnitsYet"))
                                    </span>
                                </div>
                                <div style="font-size: 0.74rem; color: var(--text-secondary); margin-bottom: 0.35rem;">
                                    @(string.IsNullOrWhiteSpace(bld.StreetAddress) ? _snapshot.Community.StreetAddress : bld.StreetAddress)
                                </div>
                                <div class="cg-grid-2 mono num" style="font-size: 0.72rem; color: var(--text-muted); margin-bottom: 0.5rem;">
                                    <div>@Loc.T("builder.floors"): <strong>@bld.FloorsCount</strong></div>
                                    <div>@Loc.T("builder.stairwells"): <strong>@bld.StairwellsCount</strong></div>
                                    <div>@Loc.T("property.units.year"): <strong>@bld.ConstructionYear</strong></div>
                                    <div>@Loc.T("property.units.risers"): <strong>@bld.RiserStacks.Count</strong></div>
                                </div>
                                <div style="display: flex; gap: 0.3rem;">
                                    <a class="cg-btn cg-btn-sm" href="@($"/properties/{Id}/units")">@Loc.T("property.units.viewUnits")</a>
                                </div>
                            </div>
                        }
                    </div>
                </ChildContent>
            </BentoCard>
        </BentoGrid>

        @if (!string.IsNullOrWhiteSpace(_message))
        {
            <div role="status" aria-live="polite" class="ai-callout" style="margin-block-end: 1rem;">@_message</div>
        }

        <BentoGrid>
            <div class="bento-span-7">
                <UtilitySourcesTable Sources="_snapshot.UtilitySources" OnRefreshSources="OnRefresh" OnScanNow="OnScan" />
            </div>
            <div class="bento-span-5">
                <OutageWeatherAndWastePanel Snapshot="_snapshot" />
            </div>
        </BentoGrid>

        <div style="margin-block-start: 1rem;">
            <PropertyDocumentsPanel CommunityId="_snapshot.Community.Id" Documents="_snapshot.Community.LegalDocuments" OnChanged="ReloadAsync" />
        </div>

        <div style="margin-block-start: 1rem;">
            <PendingApprovalsAndAuditPanel Snapshot="_snapshot" OnChanged="ReloadAsync" />
        </div>
    }
</RequirePropertyAccess>

@code {
    [Parameter] public Guid Id { get; set; }
    private CommunityWorkspaceSnapshot? _snapshot;
    private IReadOnlyList<CommunityContact> _contacts = [];
    private bool _loaded;
    private string _message = string.Empty;
    private Action? _locHandler;

    protected override async Task OnInitializedAsync()
    {
        _locHandler = () => InvokeAsync(StateHasChanged);
        Loc.OnChange += _locHandler;
        await Loc.EnsureLoadedAsync();
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        try
        {
            _snapshot = await Workspace.GetSnapshotAsync(Id);
            _contacts = await Workspace.GetCommunityContactsAsync(Id);
        }
        catch (Exception ex) { _message = ex.Message; }
        finally { _loaded = true; }
    }

    private async Task OnRefresh()
    {
        try
        {
            var result = await Workspace.TriggerWebAutoEnrichmentAsync(Id, string.Empty);
            _message = result.SummaryReport;
            await ReloadAsync();
        }
        catch (Exception ex) { _message = ex.Message; }
    }

    private async Task OnScan()
    {
        try
        {
            _message = await Workspace.ScanUtilitySourcesAndWeatherAsync(Id);
            await ReloadAsync();
        }
        catch (Exception ex) { _message = ex.Message; }
    }

    public void Dispose()
    {
        if (_locHandler is not null) Loc.OnChange -= _locHandler;
    }
}
