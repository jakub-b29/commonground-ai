@page "/properties/{id:guid}/financials"
@attribute [Authorize(Policy = "WorkspaceMember")]
@using CommonGround.Web.Components.Shared.Financials
@inject WorkspaceLocalization Loc
@inject CommonGroundWorkspaceService Workspace
@implements IDisposable

<PageTitle>@Loc.T("property.financials.pageTitle")</PageTitle>

<RequirePropertyAccess PropertyId="Id">
    @if (!_loaded)
    {
        <p role="status" aria-live="polite">@Loc.T("msg.loading")</p>
    }
    else if (_snapshot is null)
    {
        <div class="cg-card"><p class="cg-empty-text">@Loc.T("property.common.notFound")</p></div>
    }
    else
    {
        <PageHeader Category="@Loc.T("property.financials.category")"
                    ContextCode="@_snapshot.Community.CurrencyCode"
                    Title="@($"{_snapshot.Community.Name} · {Loc.T("property.financials.titleSuffix")}")"
                    Subtitle="@Loc.T("property.financials.subtitle")">
            <Badges>
                <StatusBadge Text="@Loc.T("property.financials.ledgerBadge")" Variant="ok" />
                <AIBadge Label="@Loc.T("property.financials.auditBadge")" Model="muse-spark-1.3" />
            </Badges>
            <Actions>
                <a class="cg-btn cg-btn-sm" href="@($"/properties/{Id}/overview")">@Loc.T("property.common.backToOverview")</a>
            </Actions>
        </PageHeader>

        <div class="cg-grid-4" style="margin-bottom: 1rem;">
            <MetricCard Label="@Loc.T("kpi.operatingCash")"
                        Value="@($"{_snapshot.OperatingCash:N2} {_snapshot.Community.CurrencyCode}")"
                        Subtitle="@($"{Loc.T("settings.operatingRate")}: {_snapshot.Community.OperatingRatePerM2:N2} / m²")"
                        BadgeText="100-OP"
                        StatusVariant="ok" />
            <MetricCard Label="@Loc.T("kpi.reserveFund")"
                        Value="@($"{_snapshot.ReserveCash:N2} {_snapshot.Community.CurrencyCode}")"
                        Subtitle="@($"{Loc.T("settings.repairRate")}: {_snapshot.Community.RepairFundRatePerM2:N2} / m²")"
                        BadgeText="200-RF"
                        StatusVariant="info" />
            <MetricCard Label="@Loc.T("kpi.delinquency")"
                        Value="@($"{_snapshot.DelinquencyRate:N2} %")"
                        Subtitle="@($"{_snapshot.ArrearsUnits} {Loc.T("property.financials.arrearsSuffix")}")"
                        BadgeText="@(_snapshot.DelinquencyRate > 5m ? Loc.T("property.financials.collectionActive") : Loc.T("property.financials.onTarget"))"
                        StatusVariant="@(_snapshot.DelinquencyRate > 5m ? "warn" : "ok")" />
            <MetricCard Label="@Loc.T("property.financials.commercialOffsets")"
                        Value="@_snapshot.Community.CommercialContracts.Count.ToString()"
                        Subtitle="@Loc.T("property.financials.activeLeases")"
                        BadgeText="@Loc.T("property.financials.ancillaryBadge")"
                        StatusVariant="ai"
                        IsAi="true" />
        </div>

        <FundLedgerAndAncillaryPanel Snapshot="_snapshot" />
        <div style="margin-block-start: 1rem;">
            <UtilityReconciliationAndPowerPanel CommunityId="_snapshot.Community.Id" />
        </div>
        <div class="cg-grid-2" style="margin-block-start: 1rem;">
            <TariffInflationSimulatorPanel CommunityId="_snapshot.Community.Id" />
            <ReserveStudyAndGrantsPanel Snapshot="_snapshot" />
        </div>
        <div style="margin-block-start: 1rem;">
            <ArrearsAndLegalDossierTable Snapshot="_snapshot" />
        </div>
    }
    @if (!string.IsNullOrWhiteSpace(_message))
    {
        <div role="status" aria-live="polite" class="cg-callout" style="margin-block-start: 0.75rem;">@_message</div>
    }
</RequirePropertyAccess>

@code {
    [Parameter] public Guid Id { get; set; }
    private CommunityWorkspaceSnapshot? _snapshot;
    private bool _loaded;
    private string _message = string.Empty;
    private Action? _locHandler;

    protected override async Task OnInitializedAsync()
    {
        _locHandler = () => InvokeAsync(StateHasChanged);
        Loc.OnChange += _locHandler;
        await Loc.EnsureLoadedAsync();
        try { _snapshot = await Workspace.GetSnapshotAsync(Id); }
        catch (Exception ex) { _message = ex.Message; }
        finally { _loaded = true; }
    }

    public void Dispose()
    {
        if (_locHandler is not null) Loc.OnChange -= _locHandler;
    }
}
