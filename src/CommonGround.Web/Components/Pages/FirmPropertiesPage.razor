@page "/firm/properties"
@page "/firm"
@attribute [Authorize(Policy = "FirmManagerOnly")]
@inject NavigationManager Nav

<PageTitle>Moved - CommonGround</PageTitle>

<p role="status" aria-live="polite">This page has moved to firm administration. Redirecting.</p>

@code {
    protected override void OnInitialized()
    {
        var path = new Uri(Nav.Uri).AbsolutePath;
        if (string.Equals(path, "/firm", StringComparison.OrdinalIgnoreCase))
            Nav.NavigateTo("/admin", forceLoad: false);
        else
            Nav.NavigateTo("/admin/properties", forceLoad: false);
    }
}
