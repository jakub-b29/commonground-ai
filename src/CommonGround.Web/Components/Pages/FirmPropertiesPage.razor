@page "/firm/properties"
@page "/firm"
@attribute [Authorize(Policy = "FirmManagerOnly")]
@inject NavigationManager Nav
@inject WorkspaceLocalization Loc
@implements IDisposable

<PageTitle>@Loc.T("page.moved.title") - CommonGround</PageTitle>

<p role="status" aria-live="polite">@Loc.T("page.moved.firmAdmin")</p>

@code {
    private Action? _locHandler;

    protected override async Task OnInitializedAsync()
    {
        _locHandler = () => InvokeAsync(StateHasChanged);
        Loc.OnChange += _locHandler;
        await Loc.EnsureLoadedAsync();
        var path = new Uri(Nav.Uri).AbsolutePath;
        if (string.Equals(path, "/firm", StringComparison.OrdinalIgnoreCase))
            Nav.NavigateTo("/admin", forceLoad: false);
        else
            Nav.NavigateTo("/admin/properties", forceLoad: false);
    }

    public void Dispose()
    {
        if (_locHandler is not null) Loc.OnChange -= _locHandler;
    }
}
