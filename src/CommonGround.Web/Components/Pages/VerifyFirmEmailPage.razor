@page "/verify-firm-email"
@layout Layout.AuthLayout
@attribute [AllowAnonymous]
@inject CommonGroundWorkspaceService Workspace
@inject WorkspaceLocalization Loc
@implements IDisposable

<PageTitle>@Loc.T("verifyFirm.title") - CommonGround</PageTitle>

<div class="cg-auth-heading">
    <h1>@Loc.T("verifyFirm.title")</h1>
    <p>@Loc.T("verifyFirm.lead")</p>
</div>

@if (!string.IsNullOrWhiteSpace(ErrorCode))
{
    <div role="alert" class="cg-auth-error">@Loc.T("verifyFirm.failed")</div>
}
@if (!string.IsNullOrWhiteSpace(SuccessMessage))
{
    <div role="status" aria-live="polite" class="cg-auth-note">@SuccessMessage</div>
}

@if (_loading)
{
    <p role="status" aria-live="polite">@Loc.T("msg.loading")</p>
}
else if (_preview is not null)
{
    <div class="cg-auth-note" role="status" aria-live="polite">
        <strong>@_preview.FirmName</strong> · @_preview.FirmGroupCode
        <div>@_preview.ManagerEmail · @Loc.T("table.status"): @(_preview.IsEmailConfirmed ? Loc.T("verifyFirm.confirmed") : Loc.T("verifyFirm.pending"))</div>
    </div>
}
else if (!string.IsNullOrWhiteSpace(FirmIdRaw))
{
    <div class="cg-auth-note" role="status" aria-live="polite">
        <p>@Loc.T("verifyFirm.notFound")</p>
    </div>
}

<form method="post" action="/auth/verify-firm-email" class="cg-form-stack">
    <div>
        <label for="vfe-token">@Loc.T("verifyFirm.tokenLabel")</label>
        <input id="vfe-token" name="token" value="@_tokenInput" required autocomplete="off" placeholder="@Loc.T("verifyFirm.tokenPlaceholder")" />
    </div>
    <button type="submit" class="cg-btn cg-btn-primary cg-btn-block">@Loc.T("verifyFirm.submit")</button>
</form>

<div class="cg-auth-links">
    <a href="/login">@Loc.T("nav.signin")</a>
    <a href="/register-firm">@Loc.T("auth.createFirmLink")</a>
</div>

@code {
    [SupplyParameterFromQuery(Name = "firmId")] public string? FirmIdRaw { get; set; }
    [SupplyParameterFromQuery(Name = "token")] public string? Token { get; set; }
    [SupplyParameterFromQuery(Name = "error")] public string? ErrorCode { get; set; }

    private CommonGroundWorkspaceService.FirmEmailConfirmationPreview? _preview;
    private bool _loading = true;
    private string _tokenInput = string.Empty;
    private string SuccessMessage = string.Empty;
    private Action? _locHandler;

    protected override async Task OnInitializedAsync()
    {
        _locHandler = () => InvokeAsync(StateHasChanged);
        Loc.OnChange += _locHandler;
        await Loc.EnsureLoadedAsync();
        _tokenInput = Token?.Trim() ?? string.Empty;
        await ReloadAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        var incomingToken = Token?.Trim() ?? string.Empty;
        if (!string.Equals(_tokenInput, incomingToken, StringComparison.Ordinal) && string.IsNullOrWhiteSpace(_tokenInput))
        {
            _tokenInput = incomingToken;
        }
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        _loading = true;
        try
        {
            if (Guid.TryParse(FirmIdRaw?.Trim(), out var firmId) && firmId != Guid.Empty)
            {
                _preview = await Workspace.GetFirmEmailConfirmationPreviewAsync(firmId);
                if (_preview is not null && _preview.IsEmailConfirmed)
                {
                    SuccessMessage = Loc.T("verifyFirm.confirmedHint");
                }
            }
            else
            {
                _preview = null;
            }
        }
        catch
        {
            _preview = null;
        }
        finally
        {
            _loading = false;
        }
    }

    public void Dispose()
    {
        if (_locHandler is not null) Loc.OnChange -= _locHandler;
    }
}
