@page "/firm/invitations"
@attribute [Authorize(Policy = "ManagersOnly")]
@inject NavigationManager Nav
@inject WorkspaceLocalization Loc
@implements IDisposable

<PageTitle>@Loc.T("page.moved.title") - CommonGround</PageTitle>

<p role="status" aria-live="polite">@Loc.T("page.moved.invitations")</p>

@code {
    private Action? _locHandler;

    protected override async Task OnInitializedAsync()
    {
        _locHandler = () => InvokeAsync(StateHasChanged);
        Loc.OnChange += _locHandler;
        await Loc.EnsureLoadedAsync();
        Nav.NavigateTo("/admin/members", forceLoad: false);
    }

    public void Dispose()
    {
        if (_locHandler is not null) Loc.OnChange -= _locHandler;
    }
}
