@page "/community/groups"
@page "/community-groups"
@attribute [Authorize(Policy = "WorkspaceMember")]
@using CommonGround.Web.Components.Shared.Residents
@inject WorkspaceLocalization Loc
@implements IDisposable

<PageTitle>@Loc.T("panel.groups") - CommonGround</PageTitle>

<div class="cg-page-header">
    <div>
        <h1>@Loc.T("page.groupsTitle")</h1>
        <p class="cg-page-lead">@Loc.T("page.groupsLead")</p>
    </div>
    <a class="cg-btn" href="/community/messages">@Loc.T("panel.directMessages")</a>
</div>

<ScopedCommunityPage @ref="_loader">
    <ChildContent>
        <ResidentGroupsAndMessagingPanel Community="context.Community" OnChanged="OnReload" />
    </ChildContent>
</ScopedCommunityPage>

@code {
    private ScopedCommunityPage? _loader;
    private Action? _locHandler;

    protected override async Task OnInitializedAsync()
    {
        _locHandler = () => InvokeAsync(StateHasChanged);
        Loc.OnChange += _locHandler;
        await Loc.EnsureLoadedAsync();
    }

    private async Task OnReload()
    {
        if (_loader is not null) await _loader.ReloadAsync();
    }

    public void Dispose()
    {
        if (_locHandler is not null) Loc.OnChange -= _locHandler;
    }
}
