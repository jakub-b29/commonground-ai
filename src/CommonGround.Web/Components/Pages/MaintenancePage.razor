@page "/maintenance"
@using CommonGround.Web.Components.Shared.Maintenance
@inject WorkspaceUiState UiState
@inject CommonGroundWorkspaceService Workspace
@implements IDisposable

<PageTitle>Work Orders and Inspections - CommonGround</PageTitle>

<div class="cg-page-header">
    <div>
        <h1>Work orders and inspections</h1>
        <p class="cg-page-lead" style="margin-block-end: 0;">Omnichannel resident intake with outage & warranty routing, SAM 3.1 defect area segmentation, investor BOQ cost estimation, before/after repair verification, and insurance claim dossiers.</p>
    </div>
</div>

@if (_snapshot is null)
{
    <p role="status" aria-live="polite">Loading maintenance workspace.</p>
}
else
{
    <div class="cg-stack">
        <div class="cg-split-sidebar-main">
            <div class="cg-stack">
                <ResidentIntakeSimulatorPanel CommunityId="_snapshot.Community.Id" OnChanged="ReloadAsync" />
                <VideoWalkthroughAndSafetyPanel CommunityId="_snapshot.Community.Id" OnChanged="ReloadAsync" />
                <InsuranceClaimDossierPanel WorkOrders="_snapshot.Community.WorkOrders" CommunityId="_snapshot.Community.Id" />
            </div>
            <WorkOrderSamInspectorPanel WorkOrders="_snapshot.Community.WorkOrders" CommunityId="_snapshot.Community.Id" OnChanged="ReloadAsync" />
        </div>
    </div>
}

@code {
    private Action? _stateHandler;
    private CommunityWorkspaceSnapshot? _snapshot;

    protected override async Task OnInitializedAsync()
    {
        _stateHandler = () => InvokeAsync(ReloadAsync);
        UiState.OnChange += _stateHandler;
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        if (UiState.SelectedCommunityId is null)
        {
            var all = await Workspace.GetCommunitiesAsync();
            var first = all.FirstOrDefault();
            if (first is null) return;
            UiState.SelectCommunity(first.Id, first.OperatingMode == SystemOperatingMode.UsHoa ? "US HOA & Condo Mode" : "Housing Association Mode");
        }
        _snapshot = await Workspace.GetSnapshotAsync(UiState.SelectedCommunityId!.Value);
        StateHasChanged();
    }

    public void Dispose()
    {
        if (_stateHandler is not null) UiState.OnChange -= _stateHandler;
    }
}
