@page "/infrastructure/permits"
@attribute [Authorize(Policy = "ManagersOnly")]
@using CommonGround.Web.Components.Shared.Units
@inject WorkspaceLocalization Loc
@implements IDisposable

<PageTitle>@Loc.T("panel.renovation") - CommonGround</PageTitle>

<div class="cg-page-header">
    <div>
        <h1>@Loc.T("panel.renovation")</h1>
        <p class="cg-page-lead">@Loc.T("page.infrastructureLead")</p>
    </div>
    <div class="cg-toolbar" style="margin-block-start: 0;">
        <a class="cg-btn" href="/infrastructure/atlas">@Loc.T("panel.atlas")</a>
        <a class="cg-btn" href="/infrastructure/inspections">@Loc.T("panel.inspections")</a>
    </div>
</div>

<ScopedCommunityPage @ref="_loader">
    <ChildContent>
        <RenovationPermitsPanel Requests="context.Community.ModificationRequests" CommunityId="context.Community.Id" OnChanged="OnReload" />
    </ChildContent>
</ScopedCommunityPage>

@code {
    private ScopedCommunityPage? _loader;
    private Action? _locHandler;

    protected override async Task OnInitializedAsync()
    {
        _locHandler = () => InvokeAsync(StateHasChanged);
        Loc.OnChange += _locHandler;
        await Loc.EnsureLoadedAsync();
    }

    private async Task OnReload()
    {
        if (_loader is not null) await _loader.ReloadAsync();
    }

    public void Dispose()
    {
        if (_locHandler is not null) Loc.OnChange -= _locHandler;
    }
}
