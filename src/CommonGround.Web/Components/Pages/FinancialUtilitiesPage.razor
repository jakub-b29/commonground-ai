@page "/financials/utilities"
@attribute [Authorize(Policy = "ManagersOnly")]
@using CommonGround.Web.Components.Shared.Financials
@inject WorkspaceLocalization Loc
@implements IDisposable

<PageTitle>@Loc.T("panel.utilityRecon") - CommonGround</PageTitle>

<div class="cg-page-header">
    <div>
        <h1>@Loc.T("panel.utilityRecon")</h1>
        <p class="cg-page-lead">@Loc.T("page.ledgerLead")</p>
    </div>
    <div class="cg-toolbar" style="margin-block-start: 0;">
        <a class="cg-btn" href="/financials/ledger">@Loc.T("panel.fundLedger")</a>
        <a class="cg-btn" href="/financials/arrears">@Loc.T("panel.arrears")</a>
    </div>
</div>

<ScopedCommunityPage>
    <ChildContent>
        <UtilityReconciliationAndPowerPanel CommunityId="context.Community.Id" />
    </ChildContent>
</ScopedCommunityPage>

@code {
    private Action? _locHandler;

    protected override async Task OnInitializedAsync()
    {
        _locHandler = () => InvokeAsync(StateHasChanged);
        Loc.OnChange += _locHandler;
        await Loc.EnsureLoadedAsync();
    }

    public void Dispose()
    {
        if (_locHandler is not null) Loc.OnChange -= _locHandler;
    }
}
