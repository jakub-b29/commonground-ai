@page "/residents/approvals"
@page "/residents"
@attribute [Authorize(Policy = "ManagersOnly")]
@using CommonGround.Web.Components.Shared.Residents
@inject WorkspaceLocalization Loc
@implements IDisposable

<PageTitle>@Loc.T("panel.membershipQueue") - CommonGround</PageTitle>

<div class="cg-page-header">
    <div>
        <h1>@Loc.T("page.residentsTitle")</h1>
        <p class="cg-page-lead">@Loc.T("page.residentsLead")</p>
    </div>
    <div class="cg-toolbar" style="margin-block-start: 0;">
        <a class="cg-btn" href="/residents/my-unit">@Loc.T("panel.selfService")</a>
        <a class="cg-btn" href="/account/profile">@Loc.T("panel.profileEditor")</a>
    </div>
</div>

<ScopedCommunityPage @ref="_loader">
    <ChildContent>
        <ResidentMembershipApprovalPanel Community="context.Community" OnChanged="OnReload" />
    </ChildContent>
</ScopedCommunityPage>

@code {
    private ScopedCommunityPage? _loader;
    private Action? _locHandler;

    protected override async Task OnInitializedAsync()
    {
        _locHandler = () => InvokeAsync(StateHasChanged);
        Loc.OnChange += _locHandler;
        await Loc.EnsureLoadedAsync();
    }

    private async Task OnReload()
    {
        if (_loader is not null) await _loader.ReloadAsync();
    }

    public void Dispose()
    {
        if (_locHandler is not null) Loc.OnChange -= _locHandler;
    }
}
