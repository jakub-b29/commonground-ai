@page "/residents/my-unit"
@attribute [Authorize(Policy = "WorkspaceMember")]
@using CommonGround.Web.Components.Shared.Residents
@inject WorkspaceLocalization Loc
@inject WorkspaceAccessService Access
@implements IDisposable

<PageTitle>@Loc.T("panel.selfService") - CommonGround</PageTitle>

<div class="cg-page-header">
    <div>
        <h1>@Loc.T("panel.selfService")</h1>
        <p class="cg-page-lead">@Loc.T("page.residentsLead")</p>
    </div>
    <a class="cg-btn" href="/account/profile">@Loc.T("panel.profileEditor")</a>
</div>

<ScopedCommunityPage @ref="_loader" OnSnapshotLoaded="OnSnapshot">
    <ChildContent>
        <ResidentSelfServicePanel Community="_community ?? context.Community" />
    </ChildContent>
</ScopedCommunityPage>

@code {
    private ScopedCommunityPage? _loader;
    private Community? _community;
    private Action? _locHandler;

    protected override async Task OnInitializedAsync()
    {
        _locHandler = () => InvokeAsync(StateHasChanged);
        Loc.OnChange += _locHandler;
        await Loc.EnsureLoadedAsync();
    }

    private async Task OnSnapshot(CommunityWorkspaceSnapshot snapshot)
    {
        var role = await Access.GetRoleAsync();
        var linked = await Access.GetLinkedUnitAsync();
        if (role == WorkspaceSecurityRole.Resident && !string.IsNullOrWhiteSpace(linked))
        {
            var match = snapshot.Community.Units.FirstOrDefault(u => string.Equals(u.UnitNumber, linked.Trim(), StringComparison.OrdinalIgnoreCase));
            if (match is not null)
            {
                _community = new Community
                {
                    Id = snapshot.Community.Id,
                    ManagementFirmId = snapshot.Community.ManagementFirmId,
                    FirmGroupCode = snapshot.Community.FirmGroupCode,
                    Name = snapshot.Community.Name,
                    OperatingMode = snapshot.Community.OperatingMode,
                    CurrencyCode = snapshot.Community.CurrencyCode,
                    Units = [match],
                    WorkOrders = snapshot.Community.WorkOrders.Where(w => w.UnitId == match.Id || string.Equals(w.VerticalStackCode, match.VerticalStackCode, StringComparison.OrdinalIgnoreCase)).ToList(),
                    Resolutions = snapshot.Community.Resolutions,
                    CommercialContracts = snapshot.Community.CommercialContracts
                };
                return;
            }
        }
        _community = snapshot.Community;
    }

    public void Dispose()
    {
        if (_locHandler is not null) Loc.OnChange -= _locHandler;
    }
}
