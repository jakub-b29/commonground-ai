@page "/register-resident"
@page "/register-resident/{token}"
@layout Layout.AuthLayout
@attribute [AllowAnonymous]
@using CommonGround.Application.Services
@inject WorkspaceLocalization Loc
@inject CommonGroundWorkspaceService Workspace
@implements IDisposable

<PageTitle>@Loc.T("resident.registrationTitle") - CommonGround</PageTitle>

<div class="cg-auth-heading">
    <h1>@Loc.T("registerResident.heading")</h1>
    <p>@Loc.T("registerResident.lead")</p>
</div>

@if (!string.IsNullOrWhiteSpace(_error))
{
    <div role="alert" class="cg-auth-error">@_error</div>
}

@if (_result is not null && _result.Succeeded)
{
    <div class="cg-auth-note" role="status" aria-live="polite" style="border-left: 3px solid var(--color-success); padding: 1rem;">
        <div style="font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-secondary);">@Loc.T("registerResident.accountNumberLabel")</div>
        <div class="mono" style="font-size: 1.35rem; font-weight: 700; color: var(--accent-primary); margin: 0.25rem 0;">@_result.ResidentAccountNumber</div>
        <p style="margin: 0.35rem 0; font-size: 0.85rem;">@_result.StatusMessage</p>
        @if (_result.IsAutoApproved)
        {
            <div style="margin-top: 0.75rem;">
                <a class="cg-btn cg-btn-primary cg-btn-block" href="/login">@Loc.T("page.loginTitle")</a>
            </div>
        }
        else
        {
            <div style="margin-top: 0.75rem; font-size: 0.78rem; color: var(--text-secondary);">
                @string.Format(System.Globalization.CultureInfo.InvariantCulture, Loc.T("registerResident.queuedNoteFmt"), _result.ResidentAccountNumber)
            </div>
            <div style="margin-top: 0.75rem;">
                <a class="cg-btn cg-btn-block" href="/login">@Loc.T("registerResident.returnToSignIn")</a>
            </div>
        }
    </div>
}
else if (_loading)
{
    <p role="status" aria-live="polite">@Loc.T("registerResident.validating")</p>
}
else if (_validation is null || !_validation.IsValid)
{
    <div class="cg-auth-note" role="status" aria-live="polite">
        <p>@(_validation?.StatusMessage ?? Loc.T("registerResident.enterTokenPrompt"))</p>
    </div>
    <form class="cg-form-stack" @onsubmit="OnVerifyTokenAsync" @onsubmit:preventDefault="true">
        <div>
            <label for="rr-token">@Loc.T("registerResident.tokenLabel")</label>
            <input id="rr-token" @bind="_tokenInput" class="mono" autocomplete="off" placeholder="@Loc.T("registerResident.tokenPlaceholder")" required />
        </div>
        <button type="submit" class="cg-btn cg-btn-primary cg-btn-block" disabled="@_isBusy">@Loc.T("registerResident.verifyLink")</button>
    </form>
    <div class="cg-auth-links">
        <a href="/login">@Loc.T("registerResident.haveAccountSignIn")</a>
    </div>
}
else
{
    <div class="cg-auth-note" role="status" aria-live="polite">
        <strong>@Loc.T("registerResident.verifiedLink")</strong>
        <div style="font-size: 0.76rem; color: var(--text-secondary); margin-top: 0.2rem;">
            @Loc.T("registerResident.zeroDisclosure")
            @(_validation.ApprovalMode == RegistrationApprovalMode.AutomaticAuthorized
                ? Loc.T("registerResident.modeAuto")
                : Loc.T("registerResident.modeManual"))
        </div>
    </div>

    <form class="cg-form-stack" @onsubmit="OnSubmitRegistrationAsync" @onsubmit:preventDefault="true">
        <div class="cg-grid-2">
            <div>
                <label for="rr-first">@Loc.T("registerResident.firstName")</label>
                <input id="rr-first" @bind="_firstName" required autocomplete="given-name" />
            </div>
            <div>
                <label for="rr-last">@Loc.T("registerResident.lastName")</label>
                <input id="rr-last" @bind="_lastName" required autocomplete="family-name" />
            </div>
        </div>
        <div>
            <label for="rr-email">@Loc.T("form.email")</label>
            <input id="rr-email" type="email" @bind="_email" required autocomplete="email" />
        </div>
        <div class="cg-grid-2">
            <div>
                <label for="rr-phone">@Loc.T("form.phone")</label>
                <input id="rr-phone" type="tel" @bind="_phone" autocomplete="tel" placeholder="@Loc.T("registerResident.phonePlaceholder")" />
            </div>
            <div>
                <label for="rr-lang">@Loc.T("registerResident.preferredLanguage")</label>
                <select id="rr-lang" @bind="_preferredLanguage">
                    <option value="EN">EN</option>
                    <option value="PL">PL</option>
                    <option value="DE">DE</option>
                    <option value="ES">ES</option>
                    <option value="FR">FR</option>
                </select>
            </div>
        </div>
        <div>
            <label for="rr-pass">@Loc.T("registerResident.passwordLabel")</label>
            <input id="rr-pass" type="password" @bind="_password" required minlength="8" autocomplete="new-password" />
        </div>
        <div class="cg-grid-2">
            <div>
                <label for="rr-em-name">@Loc.T("registerResident.emergencyName")</label>
                <input id="rr-em-name" @bind="_emergencyName" />
            </div>
            <div>
                <label for="rr-em-phone">@Loc.T("registerResident.emergencyPhone")</label>
                <input id="rr-em-phone" @bind="_emergencyPhone" />
            </div>
        </div>
        <div>
            <label for="rr-notes">@Loc.T("registerResident.notesLabel")</label>
            <input id="rr-notes" @bind="_notes" placeholder="@Loc.T("registerResident.notesPlaceholder")" />
        </div>
        <button type="submit" class="cg-btn cg-btn-primary cg-btn-block" disabled="@_isBusy">
            @(_isBusy ? Loc.T("registerResident.submitting") : Loc.T("registerResident.complete"))
        </button>
    </form>

    <div class="cg-auth-links">
        <a href="/login">@Loc.T("registerResident.registeredSignIn")</a>
    </div>
}

@code {
    [Parameter] public string? Token { get; set; }
    [SupplyParameterFromQuery(Name = "token")] public string? QueryToken { get; set; }

    private string _tokenInput = string.Empty;
    private string _effectiveToken = string.Empty;
    private bool _loading = true;
    private bool _isBusy;
    private string _error = string.Empty;
    private PublicRegistrationTokenValidation? _validation;
    private PublicResidentRegistrationResult? _result;

    private string _firstName = string.Empty;
    private string _lastName = string.Empty;
    private string _email = string.Empty;
    private string _phone = string.Empty;
    private string _password = string.Empty;
    private string _preferredLanguage = "EN";
    private string _emergencyName = string.Empty;
    private string _emergencyPhone = string.Empty;
    private string _notes = string.Empty;

    private Action? _locHandler;

    protected override async Task OnInitializedAsync()
    {
        _locHandler = () => InvokeAsync(StateHasChanged);
        Loc.OnChange += _locHandler;
        await Loc.EnsureLoadedAsync();
        _tokenInput = !string.IsNullOrWhiteSpace(Token) ? Token! : (QueryToken ?? string.Empty);
        _effectiveToken = _tokenInput.Trim();
        await ValidateTokenNowAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        var candidate = !string.IsNullOrWhiteSpace(Token) ? Token! : (QueryToken ?? string.Empty);
        if (!string.IsNullOrWhiteSpace(candidate) && !string.Equals(candidate.Trim(), _effectiveToken, StringComparison.Ordinal))
        {
            _tokenInput = candidate.Trim();
            _effectiveToken = _tokenInput;
            await ValidateTokenNowAsync();
        }
    }

    private async Task OnVerifyTokenAsync()
    {
        _effectiveToken = (_tokenInput ?? string.Empty).Trim();
        await ValidateTokenNowAsync();
    }

    private async Task ValidateTokenNowAsync()
    {
        _loading = true;
        _error = string.Empty;
        try
        {
            if (string.IsNullOrWhiteSpace(_effectiveToken))
            {
                _validation = null;
            }
            else
            {
                _validation = await Workspace.ValidateRegistrationTokenMinimalAsync(_effectiveToken);
            }
        }
        catch (Exception ex)
        {
            _error = ex.Message;
            _validation = null;
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task OnSubmitRegistrationAsync()
    {
        _error = string.Empty;
        _isBusy = true;
        try
        {
            var input = new PublicResidentRegistrationInput(
                _effectiveToken,
                _firstName,
                _lastName,
                _email,
                _phone,
                _password,
                _preferredLanguage,
                _emergencyName,
                _emergencyPhone,
                _notes);
            _result = await Workspace.SubmitPublicResidentRegistrationAsync(input);
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _isBusy = false;
        }
    }

    public void Dispose()
    {
        if (_locHandler is not null) Loc.OnChange -= _locHandler;
    }
}
