@page "/not-found"
@layout Layout.AuthLayout
@attribute [AllowAnonymous]
@inject WorkspaceLocalization Loc
@implements IDisposable

<div class="cg-auth-heading">
    <h1>@Loc.T("error.notFoundTitle")</h1>
    <p>@Loc.T("error.notFoundBody")</p>
</div>
<div class="cg-auth-links">
    <a href="/login">@Loc.T("nav.signin")</a>
    <a href="/register-firm">@Loc.T("auth.createFirmLink")</a>
</div>

@code {
    private Action? _locHandler;

    protected override async Task OnInitializedAsync()
    {
        _locHandler = () => InvokeAsync(StateHasChanged);
        Loc.OnChange += _locHandler;
        await Loc.EnsureLoadedAsync();
    }

    public void Dispose()
    {
        if (_locHandler is not null)
        {
            Loc.OnChange -= _locHandler;
        }
    }
}
