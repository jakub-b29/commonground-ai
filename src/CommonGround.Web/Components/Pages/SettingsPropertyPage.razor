@page "/settings/property"
@attribute [Authorize(Policy = "ManagersOnly")]
@inject WorkspaceLocalization Loc
@inject WorkspaceAccessService Access
@inject WorkspaceUiState UiState
@inject CommonGroundWorkspaceService Workspace
@implements IDisposable

<PageTitle>@Loc.T("settings.propertyTitle") - CommonGround</PageTitle>

<div class="cg-page-header">
    <div>
        <h1>@Loc.T("settings.propertyTitle")</h1>
        <p class="cg-page-lead">@Loc.T("settings.lead")</p>
    </div>
    <div class="cg-toolbar" style="margin-block-start: 0;">
        <a class="cg-btn" href="/settings/firm-contacts">@Loc.T("settings.firmContacts")</a>
        <a class="cg-btn" href="/settings/account">@Loc.T("settings.accountTitle")</a>
    </div>
</div>

@if (!_loaded)
{
    <p role="status" aria-live="polite">@Loc.T("msg.loading")</p>
}
else if (_property is null)
{
    <div class="cg-card"><p class="cg-empty-text">@Loc.T("firm.selectProperty")</p></div>
}
else
{
    <div class="cg-card">
        <div class="cg-section-header"><h2>@Loc.T("settings.propertyTitle")</h2><span class="cg-badge">@_property.Name</span></div>
        <div class="cg-grid-3">
            <div><label for="set-prop-name">@Loc.T("form.community")</label><input id="set-prop-name" @bind="_property.Name" disabled="@(!_canEdit)" /></div>
            <div><label for="set-prop-addr">@Loc.T("form.registryInput")</label><input id="set-prop-addr" @bind="_property.StreetAddress" disabled="@(!_canEdit)" /></div>
            <div><label for="set-prop-city">@Loc.T("firm.city")</label><input id="set-prop-city" @bind="_property.City" disabled="@(!_canEdit)" /></div>
            <div><label for="set-prop-tax">@Loc.T("firm.taxId")</label><input id="set-prop-tax" @bind="_property.TaxIdOrEin" disabled="@(!_canEdit)" /></div>
            <div><label for="set-prop-op">@Loc.T("settings.operatingRate")</label><input id="set-prop-op" type="number" step="0.01" @bind="_property.OperatingRatePerM2" disabled="@(!_canEdit)" /></div>
            <div><label for="set-prop-repair">@Loc.T("settings.repairRate")</label><input id="set-prop-repair" type="number" step="0.01" @bind="_property.RepairFundRatePerM2" disabled="@(!_canEdit)" /></div>
            <div><label for="set-prop-waste">@Loc.T("settings.wasteFee")</label><input id="set-prop-waste" type="number" step="0.01" @bind="_property.WasteFeePerOccupant" disabled="@(!_canEdit)" /></div>
            <div><label for="set-prop-cold">@Loc.T("settings.coldTariff")</label><input id="set-prop-cold" type="number" step="0.01" @bind="_property.ColdWaterTariffPerM3" disabled="@(!_canEdit)" /></div>
            <div><label for="set-prop-hot">@Loc.T("settings.hotTariff")</label><input id="set-prop-hot" type="number" step="0.01" @bind="_property.HotWaterHeatingCostPerM3" disabled="@(!_canEdit)" /></div>
            <div><label for="set-prop-heat">@Loc.T("settings.heatTariff")</label><input id="set-prop-heat" type="number" step="0.01" @bind="_property.DistrictHeatingTariffPerGj" disabled="@(!_canEdit)" /></div>
            <div><label for="set-prop-elec">@Loc.T("settings.elecTariff")</label><input id="set-prop-elec" type="number" step="0.01" @bind="_property.CommonElectricityTariffPerKwh" disabled="@(!_canEdit)" /></div>
        </div>
        @if (!_canEdit)
        {
            <div class="cg-callout" style="margin-block-start: 0.5rem;">@Loc.T("msg.managerOnly")</div>
        }
        else
        {
            <div class="cg-toolbar"><button type="button" class="cg-btn cg-btn-primary" disabled="@_isBusy" @onclick="OnSaveProperty">@Loc.T("action.submit")</button></div>
        }
    </div>
}

@if (!string.IsNullOrWhiteSpace(_message))
{
    <div role="status" aria-live="polite" class="cg-callout" style="margin-block-start: 0.75rem;">@_message</div>
}

@code {
    private Community? _property;
    private string _message = string.Empty;
    private bool _isBusy;
    private bool _loaded;
    private bool _canEdit;
    private Action? _stateHandler;
    private Action? _locHandler;

    protected override async Task OnInitializedAsync()
    {
        _stateHandler = () => InvokeAsync(ReloadAsync);
        UiState.OnChange += _stateHandler;
        _locHandler = () => InvokeAsync(StateHasChanged);
        Loc.OnChange += _locHandler;
        await Loc.EnsureLoadedAsync();
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        try
        {
            var allowed = await Access.GetAllowedCommunitiesAsync();
            Community? target = null;
            if (UiState.SelectedCommunityId.HasValue)
                target = allowed.FirstOrDefault(c => c.Id == UiState.SelectedCommunityId.Value);
            target ??= allowed.OrderBy(c => c.Name).FirstOrDefault();
            if (target is not null)
            {
                if (!await Access.CanAccessCommunityAsync(target.Id))
                {
                    _property = null;
                    _canEdit = false;
                    return;
                }
                _property = await Workspace.GetCommunityAsync(target.Id);
                var role = await Access.GetRoleAsync();
                var account = await Access.GetAccountAsync();
                _canEdit = role == WorkspaceSecurityRole.FirmManager
                    || (role == WorkspaceSecurityRole.PropertyManager && _property is not null && account is not null && _property.AssignedPropertyManagerId == account.Id);
            }
        }
        catch { }
        finally
        {
            _loaded = true;
            StateHasChanged();
        }
    }

    private async Task OnSaveProperty()
    {
        if (_property is null) return;
        _isBusy = true;
        try
        {
            var role = await Access.GetRoleAsync();
            var account = await Access.GetAccountAsync();
            _property = await Workspace.UpdatePropertySettingsAsync(_property.Id, _property.Name, _property.StreetAddress, _property.City, _property.TaxIdOrEin, _property.OperatingRatePerM2, _property.RepairFundRatePerM2, _property.WasteFeePerOccupant, _property.ColdWaterTariffPerM3, _property.HotWaterHeatingCostPerM3, _property.DistrictHeatingTariffPerGj, _property.CommonElectricityTariffPerKwh, role, account?.Id);
            _message = Loc.T("msg.membershipUpdated");
        }
        catch (Exception ex) { _message = ex.Message; }
        finally { _isBusy = false; }
    }

    public void Dispose()
    {
        if (_stateHandler is not null) UiState.OnChange -= _stateHandler;
        if (_locHandler is not null) Loc.OnChange -= _locHandler;
    }
}
