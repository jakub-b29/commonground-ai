@page "/governance/voting"
@attribute [Authorize(Policy = "WorkspaceMember")]
@inject NavigationManager Nav
@inject WorkspaceAccessService Access
@inject WorkspaceLocalization Loc
@implements IDisposable

<PageTitle>@Loc.T("page.moved.title") - CommonGround</PageTitle>

<p role="status" aria-live="polite">@Loc.T("page.moved.governance")</p>

@code {
    private Action? _locHandler;

    protected override async Task OnInitializedAsync()
    {
        _locHandler = () => InvokeAsync(StateHasChanged);
        Loc.OnChange += _locHandler;
        await Loc.EnsureLoadedAsync();
        var communities = await Access.GetAllowedCommunitiesAsync();
        var first = communities.FirstOrDefault();
        Nav.NavigateTo(first is null ? "/admin" : $"/properties/{first.Id}/governance", forceLoad: false);
    }

    public void Dispose()
    {
        if (_locHandler is not null) Loc.OnChange -= _locHandler;
    }
}
