@page "/"
@attribute [Authorize(Policy = "WorkspaceMember")]
@using CommonGround.Web.Components.Shared.Overview
@inject WorkspaceLocalization Loc
@implements IDisposable

<PageTitle>@Loc.T("nav.portfolio") - CommonGround</PageTitle>

<div class="cg-page-header">
    <div>
        <h1>@Loc.T("page.portfolioTitle")</h1>
        <p class="cg-page-lead">@Loc.T("page.portfolioLead")</p>
    </div>
</div>

<ScopedCommunityPage>
    <ChildContent>
        <ExecutiveKpiRow Snapshot="context" />
    </ChildContent>
</ScopedCommunityPage>

@code {
    private Action? _locHandler;

    protected override async Task OnInitializedAsync()
    {
        _locHandler = () => InvokeAsync(StateHasChanged);
        Loc.OnChange += _locHandler;
        await Loc.EnsureLoadedAsync();
    }

    public void Dispose()
    {
        if (_locHandler is not null) Loc.OnChange -= _locHandler;
    }
}
