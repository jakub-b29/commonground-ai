@page "/login"
@layout Layout.AuthLayout
@attribute [AllowAnonymous]
@inject WorkspaceLocalization Loc
@implements IDisposable

<PageTitle>@Loc.T("page.loginTitle") - CommonGround</PageTitle>

<div class="cg-auth-heading">
    <h1>@Loc.T("page.loginTitle")</h1>
    <p>@Loc.T("page.loginLead")</p>
</div>

@if (!string.IsNullOrWhiteSpace(_error))
{
    <div role="alert" class="cg-auth-error">@Loc.T("msg.signInFailed")</div>
}
@if (_registered)
{
    <div role="status" aria-live="polite" class="cg-auth-note">@Loc.T("auth.registeredNote")</div>
}

<form method="post" action="/auth/login" class="cg-form-stack">
    <input type="hidden" name="returnUrl" value="@ReturnUrl" />
    <div>
        <label for="login-code">@Loc.T("firm.groupCode")</label>
        <input id="login-code" name="firmCode" value="@FirmCode" placeholder="CG-FIRM-2026-AB12" autocomplete="organization" required />
    </div>
    <div>
        <label for="login-email">@Loc.T("form.workEmail")</label>
        <input id="login-email" name="email" type="email" placeholder="manager@example.com" autocomplete="username" required />
    </div>
    <div>
        <label for="login-password">@Loc.T("form.password")</label>
        <input id="login-password" name="password" type="password" autocomplete="current-password" required />
    </div>
    <button type="submit" class="cg-btn cg-btn-primary cg-btn-block">@Loc.T("action.signInEmail")</button>
</form>

<div class="cg-auth-links">
    <a href="/register-firm">@Loc.T("auth.createFirmLink")</a>
    <a href="@InviteHref">@Loc.T("auth.haveInviteLink")</a>
</div>

@code {
    [SupplyParameterFromQuery(Name = "returnUrl")] public string? ReturnUrl { get; set; }
    [SupplyParameterFromQuery(Name = "code")] public string? QueryCode { get; set; }
    [SupplyParameterFromQuery(Name = "token")] public string? QueryToken { get; set; }
    [SupplyParameterFromQuery(Name = "error")] public string? ErrorCode { get; set; }
    [SupplyParameterFromQuery(Name = "registered")] public string? RegisteredFlag { get; set; }

    private string FirmCode = string.Empty;
    private string _error = string.Empty;
    private bool _registered;
    private string InviteHref = "/accept-invite";
    private Action? _locHandler;

    protected override async Task OnInitializedAsync()
    {
        _locHandler = () => InvokeAsync(StateHasChanged);
        Loc.OnChange += _locHandler;
        await Loc.EnsureLoadedAsync();
        FirmCode = QueryCode ?? string.Empty;
        _error = string.IsNullOrWhiteSpace(ErrorCode) ? string.Empty : ErrorCode;
        _registered = string.Equals(RegisteredFlag, "1", StringComparison.Ordinal);
        if (!string.IsNullOrWhiteSpace(QueryToken))
            InviteHref = $"/accept-invite?token={Uri.EscapeDataString(QueryToken.Trim())}&code={Uri.EscapeDataString(QueryCode ?? string.Empty)}";
        else if (!string.IsNullOrWhiteSpace(QueryCode))
            InviteHref = $"/accept-invite?code={Uri.EscapeDataString(QueryCode.Trim())}";
    }

    public void Dispose()
    {
        if (_locHandler is not null) Loc.OnChange -= _locHandler;
    }
}
