@page "/login"
@using CommonGround.Domain.Enums
@inject WorkspaceUiState UiState
@inject CommonGroundWorkspaceService Workspace
@inject WorkspaceAuthenticationStateProvider AuthProvider
@inject NavigationManager Nav
@implements IDisposable

<PageTitle>Sign in - CommonGround</PageTitle>

<h1>Sign in to CommonGround</h1>
<p>Select an identity provider. Every sign-in is recorded in the SHA-256 security audit chain.</p>

<div class="cg-grid-2">
    <div class="cg-card">
        <h2>Continue with a provider</h2>
        <div style="display: flex; flex-direction: column; gap: 0.375rem;">
            <button type="button" class="cg-btn" disabled="@_isBusy" @onclick='() => SignInAsync(IdentityProvider.Facebook, "manager.fb@amberpark.example.com", null)'>
                <svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true"><path fill="#1E3A8A" d="M13.5 21v-7h2.4l.4-3h-2.8V9.1c0-.9.3-1.5 1.6-1.5h1.3V4.9c-.3 0-1.1-.1-2-.1-2 0-3.4 1.2-3.4 3.5V11H8.5v3H11v7h2.5z" /></svg>
                Continue with Facebook
            </button>
            <button type="button" class="cg-btn" disabled="@_isBusy" @onclick='() => SignInAsync(IdentityProvider.Google, "auditor@amberpark.example.com", null)'>
                <svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true"><path fill="#1E3A8A" d="M12 11v3.5h5c-.2 1.4-1.6 4-5 4-3 0-5.5-2.5-5.5-5.5S9 7.5 12 7.5c1.4 0 2.4.6 3 1.1l2.4-2.3C16 4.9 14.2 4 12 4 7.6 4 4 7.6 4 12s3.6 8 8 8c4.6 0 7.6-3.2 7.6-7.7 0-.3 0-.6-.1-.8H12z" /></svg>
                Continue with Google
            </button>
            <button type="button" class="cg-btn" disabled="@_isBusy" @onclick='() => SignInAsync(IdentityProvider.Apple, "owner.a301@privaterelay.example.com", null)'>
                <svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true"><path fill="#0F172A" d="M16.7 12.9c0-2.4 2-3.6 2.1-3.7-1.1-1.7-2.9-1.9-3.5-1.9-1.5-.2-2.9.9-3.7.9-.8 0-1.9-.9-3.2-.9-1.6 0-3.1 1-4 2.4-1.7 2.9-.4 7.3 1.2 9.7.8 1.2 1.8 2.5 3.1 2.4 1.2-.1 1.7-.8 3.2-.8s1.9.8 3.2.8c1.3 0 2.2-1.2 3-2.4.9-1.4 1.3-2.7 1.3-2.8-.1 0-2.7-1-2.7-3.7zM14.3 5.4c.7-.8 1.1-1.9 1-3-1 0-2.1.6-2.8 1.4-.6.7-1.2 1.9-1 3 1.1.1 2.1-.6 2.8-1.4z" /></svg>
                Continue with Apple
            </button>
        </div>
        <h2 style="margin-top: 0.75rem;">Sign in with email and password</h2>
        <EditForm Model="_emailModel" OnValidSubmit="OnEmailSubmit">
            <div>
                <label for="login-email">Work email</label>
                <InputText id="login-email" @bind-Value="_emailModel.Email" style="width: 100%;" />
            </div>
            <div style="margin-top: 0.375rem;">
                <label for="login-password">Password</label>
                <InputText id="login-password" type="password" @bind-Value="_emailModel.Password" style="width: 100%;" />
            </div>
            <div style="margin-top: 0.375rem;">
                <label for="login-code">6-digit verification code (optional)</label>
                <InputText id="login-code" @bind-Value="_emailModel.Code" style="width: 100%;" />
            </div>
            <button type="submit" class="cg-btn cg-btn-primary" disabled="@_isBusy" style="margin-top: 0.5rem;">Sign in with email</button>
        </EditForm>
    </div>
    <div class="cg-card">
        <h2>Quick demo identity selector</h2>
        <p style="color: var(--color-text-secondary);">One-click cards to test each seeded provider and role.</p>
        <div style="display: flex; flex-direction: column; gap: 0.375rem;">
            <button type="button" class="cg-btn" disabled="@_isBusy" @onclick='() => SignInAsync(IdentityProvider.Facebook, "manager.fb@amberpark.example.com", null)'>Facebook - Property manager</button>
            <button type="button" class="cg-btn" disabled="@_isBusy" @onclick='() => SignInAsync(IdentityProvider.Google, "auditor@amberpark.example.com", null)'>Google - Accounting auditor</button>
            <button type="button" class="cg-btn" disabled="@_isBusy" @onclick='() => SignInAsync(IdentityProvider.Apple, "owner.a301@privaterelay.example.com", null)'>Apple - Unit A-301 owner</button>
            <button type="button" class="cg-btn" disabled="@_isBusy" @onclick='() => SignInAsync(IdentityProvider.EmailPassword, "dispatch@amberpark.example.com", "Dispatch-2026!")'>Email - Maintenance dispatcher</button>
            <button type="button" class="cg-btn" disabled="@_isBusy" @onclick='() => SignInAsync(IdentityProvider.EmailPassword, "manager@amberpark.example.com", "Manager-2026!")'>Email - Board chair read-only</button>
        </div>
        @if (!string.IsNullOrWhiteSpace(_message))
        {
            <div role="status" aria-live="polite" style="margin-top: 0.5rem;">@_message</div>
        }
    </div>
</div>

@code {
    private Action? _stateHandler;
    private bool _isBusy;
    private string _message = string.Empty;
    private EmailModel _emailModel = new();

    protected override void OnInitialized()
    {
        _stateHandler = () => InvokeAsync(StateHasChanged);
        UiState.OnChange += _stateHandler;
    }

    private async Task SignInAsync(IdentityProvider provider, string email, string? secret)
    {
        if (UiState.SelectedCommunityId is null)
        {
            var communities = await Workspace.GetCommunitiesAsync();
            var first = communities.FirstOrDefault();
            if (first is null)
            {
                _message = "No community is available yet.";
                return;
            }
            UiState.SelectCommunity(first.Id, first.OperatingMode == SystemOperatingMode.UsHoa ? "US HOA & Condo Mode" : "Housing Association Mode");
        }
        _isBusy = true;
        try
        {
            var user = await Workspace.AuthenticateUserAsync(UiState.SelectedCommunityId!.Value, provider, email, secret);
            if (user is null)
            {
                _message = "Sign-in failed. Check the provider, email, and password.";
                return;
            }
            UiState.SetUser(user);
            AuthProvider.NotifyChanged();
            _message = $"Signed in as {user.FullName} ({user.Provider}, {user.Role}).";
            Nav.NavigateTo("/");
        }
        finally
        {
            _isBusy = false;
        }
    }

    private Task OnEmailSubmit()
    {
        return SignInAsync(IdentityProvider.EmailPassword, _emailModel.Email, _emailModel.Password);
    }

    public void Dispose()
    {
        if (_stateHandler is not null)
        {
            UiState.OnChange -= _stateHandler;
        }
    }

    private sealed class EmailModel
    {
        public string Email { get; set; } = "manager@amberpark.example.com";
        public string Password { get; set; } = "Manager-2026!";
        public string Code { get; set; } = string.Empty;
    }
}
