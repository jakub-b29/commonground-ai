@page "/Error"
@using System.Diagnostics
@layout Layout.AuthLayout
@attribute [AllowAnonymous]
@inject WorkspaceLocalization Loc
@implements IDisposable

<PageTitle>@Loc.T("error.title")</PageTitle>

<div class="cg-auth-heading">
    <h1>@Loc.T("error.title")</h1>
    <p>@Loc.T("error.body")</p>
</div>

@if (ShowRequestId)
{
    <p class="cg-auth-note">
        <strong>@Loc.T("error.requestId")</strong> <code class="mono">@RequestId</code>
    </p>
}

<div class="cg-auth-links">
    <a href="/login">@Loc.T("nav.signin")</a>
    <a href="/register-firm">@Loc.T("auth.createFirmLink")</a>
</div>

@code{
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);
    private Action? _locHandler;

    protected override async Task OnInitializedAsync()
    {
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
        _locHandler = () => InvokeAsync(StateHasChanged);
        Loc.OnChange += _locHandler;
        await Loc.EnsureLoadedAsync();
    }

    public void Dispose()
    {
        if (_locHandler is not null)
        {
            Loc.OnChange -= _locHandler;
        }
    }
}
