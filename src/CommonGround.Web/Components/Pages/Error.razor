@page "/Error"
@using System.Diagnostics
@inject WorkspaceLocalization Loc
@implements IDisposable

<PageTitle>@Loc.T("error.title")</PageTitle>

<h1 class="text-danger">@Loc.T("error.title")</h1>
<h2 class="text-danger">@Loc.T("error.body")</h2>

@if (ShowRequestId)
{
    <p>
        <strong>@Loc.T("error.requestId")</strong> <code>@RequestId</code>
    </p>
}

<h3>@Loc.T("error.devMode")</h3>
<p>
    @Loc.T("error.devHint")
</p>
<p>
    <strong>@Loc.T("error.devWarn")</strong>
</p>

@code{
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);
    private Action? _locHandler;

    protected override async Task OnInitializedAsync()
    {
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
        _locHandler = () => InvokeAsync(StateHasChanged);
        Loc.OnChange += _locHandler;
        await Loc.EnsureLoadedAsync();
    }

    public void Dispose()
    {
        if (_locHandler is not null)
        {
            Loc.OnChange -= _locHandler;
        }
    }
}
